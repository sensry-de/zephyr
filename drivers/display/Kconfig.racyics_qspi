config DISPLAY_RACYICS_QSPI
    bool "Racyics QSPI display driver"
    depends on DT_HAS_RACYICS_QSPI_DISPLAY_ENABLED
    help
        Enable Racyics QSPI display driver

config DISPLAY_RACYICS_QSPI_BUFFER
    bool "Allocate the display buffer into data_sram1 region"
    depends on DISPLAY_RACYICS_QSPI
    default y
    help
        Allocate the display buffer into data_sram1 region
