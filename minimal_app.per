         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIHANDSHAKEDELAYS0_PHYUPDACKDELAY0 ,Adds 0-15 DfiClks of delay after dfi0_phyupd_ack asserts, before the PHY takes any action (such as starting DDL calibration). RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIHANDSHAKEDELAYS0_PHYUPDREQDELAY0 ,Adds 0-15 DfiClks of delay after the PHY completes all PHY update activities, before de-asserting dfi0_phyupd_req. RESET:0x0"
          
         hexmask.long 0x00 8.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIHANDSHAKEDELAYS0_CTRLUPDACKDELAY0 ,Adds 0-15 DfiClks of delay after dfi0_ctrlupd_req asserts, before the PHY takes any action. RESET:0x0"
          
