    line.long 0x00 "ETHOS_U85_STATUS, Register describes the current operating status of the NPU RESET:0x8"
         bitfld.long 0x00 0. " ETHOS_U85_STATUS_STATE ,0 = NPU is in stopped state. 1 = NPU is in running state RESET:0x0"
          
         bitfld.long 0x00 1. " ETHOS_U85_STATUS_IRQ_RAISED ,0 = IRQ not raised. 1 = IRQ raised RESET:0x0"
          
         bitfld.long 0x00 2. " ETHOS_U85_STATUS_BUS_STATUS ,0 = No bus fault. 1 = Bus abort detected and processing halted RESET:0x0"
          
         bitfld.long 0x00 3. " ETHOS_U85_STATUS_RESET_STATUS ,0 = No reset in progress. 1 = Reset in progress RESET:0x1"
          
         bitfld.long 0x00 4. " ETHOS_U85_STATUS_CMD_PARSE_ERROR ,0 = No parsing error. 1 = Command stream parsing error detected RESET:0x0"
          
         bitfld.long 0x00 5. " ETHOS_U85_STATUS_CMD_END_REACHED ,0 = Command stream end is not reached. 1 = Command stream end is reached RESET:0x0"
          
         bitfld.long 0x00 6. " ETHOS_U85_STATUS_PMU_IRQ_RAISED ,0 = No PMU IRQ raised. 1 = PMU IRQ raised RESET:0x0"
          
         bitfld.long 0x00 7. " ETHOS_U85_STATUS_RES0 ,Reserved field RESET:0x0"
          
         bitfld.long 0x00 8. " ETHOS_U85_STATUS_ECC_FAULT ,0 = No ECC fault detected. 1 = ECC fault detected RESET:0x0"
          
         bitfld.long 0x00 9. " ETHOS_U85_STATUS_BRANCH_FAULT ,0 = No branch fault. 1 = Branch fault detected RESET:0x0"
          
         bitfld.long 0x00 10. " ETHOS_U85_STATUS_RES1 ,Reserved field RESET:0x0"
          
         bitfld.long 0x00 11. " ETHOS_U85_STATUS_FAULTING_INTERFACE ,The faulting interface on bus abort RESET:0x0"
          
         hexmask.long 0x00 12.--15. 1. " ETHOS_U85_STATUS_FAULTING_CHANNEL ,The faulting channel on a bus abort RESET:0x0"
          
         hexmask.long 0x00 16.--31. 1. " ETHOS_U85_STATUS_IRQ_HISTORY_MASK ,The IRQ History mask RESET:0x0"
          
group.long  0x8++0x3
    line.long 0x00 "ETHOS_U85_CMD, The command register. This register reads as last written command RESET:0xc"
         bitfld.long 0x00 0. " ETHOS_U85_CMD_TRANSITION_TO_RUNNING_STATE ,Write 1 to transition the NPU to running state. Writing 0 has no effect RESET:0x0"
          
         bitfld.long 0x00 1. " ETHOS_U85_CMD_CLEAR_IRQ ,Write 1 to clear the IRQ status in the STATUS register. Writing 0 has no effect RESET:0x0"
          
         bitfld.long 0x00 2. " ETHOS_U85_CMD_CLOCK_Q_ENABLE ,Write 1 to this bit to enable clock off using clock q-interface and enable the requester clock gate RESET:0x1"
          
         bitfld.long 0x00 3. " ETHOS_U85_CMD_POWER_Q_ENABLE ,Write 1 to this bit to enable power off using power q-interface RESET:0x1"
          
         bitfld.long 0x00 4. " ETHOS_U85_CMD_STOP_REQUEST ,Write 1 to this bit to request STOP after completing any already-started commands RESET:0x0"
          
         hexmask.long 0x00 5.--15. 1. " ETHOS_U85_CMD_RES0 ,Reserved field RESET:0x0"
          
