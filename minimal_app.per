tree "DUALTIMER1__ADDRESSBLOCK0"
base e:0x40050000
width 80.
group.long  0x0++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER1LOAD, Contains the value from which the Timer 1 counter is to decrement. This is the value used to reload the counter when Periodic mode is enabled, and the current count reaches 0. When this register is written to directly, the current count is immediately reset to the new value. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DUALTIMER1_ADDRESSBLOCK0_TIMER1LOAD_TIMER1LOAD ,Timer 1 Load value. A write sets the current value RESET:0x0"
          
rgroup.long 0x4++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER1VALUE, This register provides the current value of the Timer 1 decrementing counter. RESET:0xffffffff"
         hexmask.long 0x00 0.--31. 1. " DUALTIMER1_ADDRESSBLOCK0_TIMER1VALUE_VALUE ,Timer 1 Current value RESET:0xffffffff"
          
group.long  0x8++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER1CONTROL, This is a read or write register RESET:0x20"
         bitfld.long 0x00 0. " DUALTIMER1_ADDRESSBLOCK0_TIMER1CONTROL_ONESHOTCOUNT ,Selects one-shot or wrapping counter mode (default 0, wrapping) RESET:0x0" "ONESHOTCOUNT_0X0-0,ONESHOTCOUNT_0X1-1"
          
         bitfld.long 0x00 1. " DUALTIMER1_ADDRESSBLOCK0_TIMER1CONTROL_TIMERSIZE ,Selects 16-bit or 32-bit counter operation (default 0, 16-bit) RESET:0x0" "TIMERSIZE_0X0-0,TIMERSIZE_0X1-1"
          
         bitfld.long 0x00 2.--3. " DUALTIMER1_ADDRESSBLOCK0_TIMER1CONTROL_TIMERPRE ,Prescale bits (default 00, 0 stages of prescale, clock is divided by 1) RESET:0x0" "TIMERPRE_0X0-0,TIMERPRE_0X1-1,TIMERPRE_0X2-2,TIMERPRE_0X3-3"
          
          
         bitfld.long 0x00 5. " DUALTIMER1_ADDRESSBLOCK0_TIMER1CONTROL_INTERRUPTENABLE ,Interrupt enable bit (default 1, enabled) RESET:0x1" "INTERRUPT_DISABLE-0,INTERRUPT_ENABLE-1"
          
         bitfld.long 0x00 6. " DUALTIMER1_ADDRESSBLOCK0_TIMER1CONTROL_TIMERMODE ,Timer mode bit (default 0, free-running) RESET:0x0" "TIMERMODE_0X0-0,TIMERMODE_0X1-1"
          
         bitfld.long 0x00 7. " DUALTIMER1_ADDRESSBLOCK0_TIMER1CONTROL_TIMERENABLE ,Timer enable bit (default 0, disabled) RESET:0x0" "TIMER_DISABLE-0,TIMER_ENABLE-1"
          
          
group.long  0xc++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER1INTCLR, A write to the this register clears the interrupt output from Timer 1 counter RESET:0x0"
         bitfld.long 0x00 0. " DUALTIMER1_ADDRESSBLOCK0_TIMER1INTCLR_TIMER1INTCLR ,Timer 1 Interrupt clear RESET:0x0"
          
          
rgroup.long 0x10++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER1RIS, This register indicates the raw interrupt status from Timer 1 counter. This value is ANDed with the Interrupt enable bit from Timer 1 Control Register to create the masked interrupt, that is passed to the Timer 1 Interrupt output pin. RESET:0x0"
         bitfld.long 0x00 0. " DUALTIMER1_ADDRESSBLOCK0_TIMER1RIS_RAWTIMERINTERRUPT ,Timer 1 Raw interrupt status from the counter RESET:0x0" "TIMER1RIS_DISABLED-0,TIMER1RIS_ENABLED-1"
          
          
rgroup.long 0x14++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER1MIS, This register indicates the masked interrupt status from Timer 1 counter. This value is the logical AND of the Raw interrupt status with the Timer interrupt enable bit from Timer 1 Timer Control Register, and is the same value that is passed to the Timer 1 Interrupt output pin. RESET:0x0"
         bitfld.long 0x00 0. " DUALTIMER1_ADDRESSBLOCK0_TIMER1MIS_TIMERINTERRUPT ,Timer 1 Enabled interrupt status from the counter RESET:0x0" "TIMER1MIS_DISABLED-0,TIMER1MIS_ENABLED-1"
          
          
group.long  0x18++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER1BGLOAD, This register contains the value from which Timer 1 counter is to decrement. This is the value used to reload the Timer 1 counter when Periodic mode is enabled, and the current count reaches 0. This register provides an alternative method of accessing Timer 1 Load value register. The difference is that writes to this register do not cause Timer 1 counter to immediately restart from the new value. Reading from this register returns the same value returned from Timer 1 Load value. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DUALTIMER1_ADDRESSBLOCK0_TIMER1BGLOAD_TIMER1BGLOAD ,Timer 1 Background load value. A write does not cause Timer 1 counter to immediately restart from the new value. RESET:0x0"
          
group.long  0x20++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER2LOAD, Contains the value from which the Timer 2 counter is to decrement. This is the value used to reload the counter when Periodic mode is enabled, and the current count reaches 0. When this register is written to directly, the current count is immediately reset to the new value. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DUALTIMER1_ADDRESSBLOCK0_TIMER2LOAD_TIMER2LOAD ,Timer 2 Load value. A write sets the current value RESET:0x0"
          
rgroup.long 0x24++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER2VALUE, This register provides the current value of the Timer 2 decrementing counter. RESET:0xffffffff"
         hexmask.long 0x00 0.--31. 1. " DUALTIMER1_ADDRESSBLOCK0_TIMER2VALUE_VALUE ,Timer 2 Current value RESET:0xffffffff"
          
group.long  0x28++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER2CONTROL, This is a read or write register RESET:0x20"
         bitfld.long 0x00 0. " DUALTIMER1_ADDRESSBLOCK0_TIMER2CONTROL_ONESHOTCOUNT ,Selects one-shot or wrapping counter mode (default 0, wrapping) RESET:0x0" "ONESHOTCOUNT_0X0-0,ONESHOTCOUNT_0X1-1"
          
         bitfld.long 0x00 1. " DUALTIMER1_ADDRESSBLOCK0_TIMER2CONTROL_TIMERSIZE ,Selects 16-bit or 32-bit counter operation (default 0, 16-bit) RESET:0x0" "TIMERSIZE_0X0-0,TIMERSIZE_0X1-1"
          
         bitfld.long 0x00 2.--3. " DUALTIMER1_ADDRESSBLOCK0_TIMER2CONTROL_TIMERPRE ,Prescale bits (default 00, 0 stages of prescale, clock is divided by 1) RESET:0x0" "TIMERPRE_0X0-0,TIMERPRE_0X1-1,TIMERPRE_0X2-2,TIMERPRE_0X3-3"
          
          
         bitfld.long 0x00 5. " DUALTIMER1_ADDRESSBLOCK0_TIMER2CONTROL_INTERRUPTENABLE ,Interrupt enable bit (default 1, enabled) RESET:0x1" "INTERRUPT_DISABLE-0,INTERRUPT_ENABLE-1"
          
         bitfld.long 0x00 6. " DUALTIMER1_ADDRESSBLOCK0_TIMER2CONTROL_TIMERMODE ,Timer mode bit (default 0, free-running) RESET:0x0" "TIMERMODE_0X0-0,TIMERMODE_0X1-1"
          
         bitfld.long 0x00 7. " DUALTIMER1_ADDRESSBLOCK0_TIMER2CONTROL_TIMERENABLE ,Timer enable bit (default 0, disabled) RESET:0x0" "TIMER_DISABLE-0,TIMER_ENABLE-1"
          
          
group.long  0x2c++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER2INTCLR, A write to the this register clears the interrupt output from Timer 2 counter RESET:0x0"
         bitfld.long 0x00 0. " DUALTIMER1_ADDRESSBLOCK0_TIMER2INTCLR_TIMER2INTCLR ,Timer 2 Interrupt clear RESET:0x0"
          
          
rgroup.long 0x30++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER2RIS, This register indicates the raw interrupt status from Timer 2 counter. This value is ANDed with the Interrupt enable bit from Timer 2 Control Register to create the masked interrupt, that is passed to the Timer 2 Interrupt output pin. RESET:0x0"
         bitfld.long 0x00 0. " DUALTIMER1_ADDRESSBLOCK0_TIMER2RIS_RAWTIMERINTERRUPT ,Timer 2 Raw interrupt status from the counter RESET:0x0" "TIMER2RIS_DISABLED-0,TIMER2RIS_ENABLED-1"
          
          
rgroup.long 0x34++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER2MIS, This register indicates the masked interrupt status from Timer 2 counter. This value is the logical AND of the Raw interrupt status with the Timer interrupt enable bit from Timer 2 Timer Control Register, and is the same value that is passed to the Timer 2 Interrupt output pin. RESET:0x0"
         bitfld.long 0x00 0. " DUALTIMER1_ADDRESSBLOCK0_TIMER2MIS_TIMERINTERRUPT ,Timer 2 Enabled interrupt status from the counter RESET:0x0" "TIMER2MIS_DISABLED-0,TIMER2MIS_ENABLED-1"
          
          
group.long  0x38++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMER2BGLOAD, This register contains the value from which Timer 2 counter is to decrement. This is the value used to reload the Timer 2 counter when Periodic mode is enabled, and the current count reaches 0. This register provides an alternative method of accessing Timer 2 Load value register. The difference is that writes to this register do not cause Timer 2 counter to immediately restart from the new value. Reading from this register returns the same value returned from Timer 2 Load value. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DUALTIMER1_ADDRESSBLOCK0_TIMER2BGLOAD_TIMER2BGLOAD ,Timer 2 Background load value. A write does not cause the counter to immediately restart from the new value RESET:0x0"
          
group.long  0xf00++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMERITCR, This register enables Integration test mode. When in this mode, the Integration test output set register directly controls the masked interrupt outputs. The combined interrupt output of Timer 1 and Timer 2 then becomes the logical OR of the interrupt values set in the Integration test output set register. RESET:0x0"
         bitfld.long 0x00 0. " DUALTIMER1_ADDRESSBLOCK0_TIMERITCR_INTEGRATIONTESTMODEENABLE ,When set high places dualtimers into Integration test mode. RESET:0x0" "TESTMODE_DISABLE-0,TESTMODE_ENABLE-1"
          
          
group.long  0xf04++0x3
    line.long 0x00 "DUALTIMER1_ADDRESSBLOCK0_TIMERITOP, When in Integration test mode, the values in this write-only register directly drive the enabled interrupt outputs of Timer 1 and Timer 2. RESET:0x0"
         bitfld.long 0x00 0. " DUALTIMER1_ADDRESSBLOCK0_TIMERITOP_INTEGRATIONTESTTIMINT1VALUE ,Value output on Timer 1 Interrupt, TIMINT1, when in Integration test mode RESET:0x0"
          
         bitfld.long 0x00 1. " DUALTIMER1_ADDRESSBLOCK0_TIMERITOP_INTEGRATIONTESTTIMINT2VALUE ,Value output on Timer 2 Interrupt, TIMINT2, when in Integration test mode RESET:0x0"
          
          
