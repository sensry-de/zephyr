    line.long 0x00 "WATCHDOG_ADDRESSBLOCK0_WDOGVALUE, Watchdog Current value register gives the current value of the decrementing counter RESET:0xffffffff"
         hexmask.long 0x00 0.--31. 1. " WATCHDOG_ADDRESSBLOCK0_WDOGVALUE_VALUE ,Watchdog Current value RESET:0xffffffff"
          
group.long  0x8++0x3
    line.long 0x00 "WATCHDOG_ADDRESSBLOCK0_WDOGCONTROL, Watchdog Control register enables the software to control the watchdog unit RESET:0x0"
         bitfld.long 0x00 0. " WATCHDOG_ADDRESSBLOCK0_WDOGCONTROL_INTEN ,Interrupt enable (default 0, disable). Enable the interrupt output event. Set HIGH to enable the counter and the interrupt or LOW to disable the counter and interrupt. Reloads the counter from the load value when the interrupt is enabled after being disabled. RESET:0x0" "INTERRUPT_DISABLE-0,INTERRUPT_ENABLE-1"
          
         bitfld.long 0x00 1. " WATCHDOG_ADDRESSBLOCK0_WDOGCONTROL_RESEN ,Reset enable (default 0, disable). Enable watchdog reset output. Acts as a mask for the reset output. Set HIGH to enable the reset, or LOW to disable the reset. RESET:0x0" "RESET_DISABLE-0,RESET_ENABLE-1"
          
          
group.long  0xc++0x3
    line.long 0x00 "WATCHDOG_ADDRESSBLOCK0_WDOGINTCLR, A write to this register clears the watchdog interrupt and reloads the counter from the value in WDOGLOAD RESET:0x0"
         bitfld.long 0x00 0. " WATCHDOG_ADDRESSBLOCK0_WDOGINTCLR_WDOGINTCLR ,Watchdog Interrupt clear RESET:0x0"
          
          
rgroup.long 0x10++0x3
    line.long 0x00 "WATCHDOG_ADDRESSBLOCK0_WDOGRIS, Watchdog Raw interrupt status register indicates the raw interrupt status from the counter. This value is ANDed with the interrupt enable bit from the control register to create the masked interrupt that is passed to the interrupt output pin. RESET:0x0"
         bitfld.long 0x00 0. " WATCHDOG_ADDRESSBLOCK0_WDOGRIS_RAWWATCHDOGINTERRUPT ,Raw interrupt status from the counter RESET:0x0" "WDOGRIS_DISABLED-0,WDOGRIS_ENABLED-1"
          
          
