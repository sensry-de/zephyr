tree "EMMC_QSPI_REG__QSPI__MST"
base e:0x40300140
width 80.
group.long  0x0++0x3
    line.long 0x00 "EMMC_QSPI_REG_QSPI_MST_CFG_ITF, Configuration for (Q)SPI master interface RESET:0x40"
         bitfld.long 0x00 0.--1. " EMMC_QSPI_REG_QSPI_MST_CFG_ITF_SPI_MODE ,SPI interface mode - 00: 1 bit SPI (single SPI) (default) - 01: 2 bit SPI (dual SPI) - 10: 4 bit SPI (quad SPI) - 11: reserved RESET:0x0" "SNGL_SPI-0,DUAL_SPI-1,QUAD_SPI-2"
          
         bitfld.long 0x00 2. " EMMC_QSPI_REG_QSPI_MST_CFG_ITF_CPHA ,SPI clock phase - 0: change data on falling egde, sample data on rising  edge (default) - 1: change data on rising  egde, sample data on falling edge RESET:0x0"
          
         bitfld.long 0x00 3. " EMMC_QSPI_REG_QSPI_MST_CFG_ITF_CPOL ,SPI clock polarity - 0: clock in idle state is low (default) - 1: clock in idle state is high RESET:0x0"
          
         bitfld.long 0x00 4.--5. " EMMC_QSPI_REG_QSPI_MST_CFG_ITF_MOSI_SEL ,select QSPI data port for SPI MOSI (output) in single SPI mode - 0: MOSI[0] (default) - 1: MOSI[1] - 2: MOSI[2] - 3: MOSI[3] RESET:0x0" "MOSI_0-0,MOSI_1-1,MOSI_2-2,MOSI_3-3"
          
         bitfld.long 0x00 6.--7. " EMMC_QSPI_REG_QSPI_MST_CFG_ITF_MISO_SEL ,select QSPI data port for SPI MISO (input) in single SPI mode - 0: MISO[0] - 1: MISO[1] (default) - 2: MISO[2] - 3: MISO[3] RESET:0x1" "MISO_0-0,MISO_1-1,MISO_2-2,MISO_3-3"
          
group.long  0x4++0x3
    line.long 0x00 "EMMC_QSPI_REG_QSPI_MST_CFG_SCLK, Configuration for SPI clock RESET:0x10001"
         hexmask.long 0x00 0.--7. 1. " EMMC_QSPI_REG_QSPI_MST_CFG_SCLK_CDIV ,SPI clock divider SPI clock[freq] = sys_clk / (2*(cdiv+1))     duty cycle is 50% RESET:0x1"
          
         hexmask.long 0x00 16.--24. 1. " EMMC_QSPI_REG_QSPI_MST_CFG_SCLK_SMPL_POINT ,sample point - [8]   : SPI clock high/low - [7:0] : clk_div_phase example: sample at rising edge: [8]   = 0 [7:0] = cdiv RESET:0x1"
          
group.long  0x8++0x3
