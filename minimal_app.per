         bitfld.long 0x00 4. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG1_HAS_TRIG ,Has trigger capability. RESET:0x1"
          
         bitfld.long 0x00 5. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG1_HAS_TRIGIN ,Has hardware trigger input ports. RESET:0x0"
          
         bitfld.long 0x00 6. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG1_HAS_TRIGOUT ,Has hardware trigger output port. RESET:0x0"
          
