group.long  0x60++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_VREFDAC1_R0, VrefDAC1 control for DQ Receiver (used only when DFE is enabled in DDR4) RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_VREFDAC1_R0_VREFDAC1_R0 ,VrefDAC1 controls the alternate VREF setting for DFE (used only when DFE is enabled in DDR4) DAC control for rxdq cell internal VREF, trained by Firmware. The VREF generators have different ranges, depending on the Mission Mode settings for  - [DqDqsRcvCntrl::MajorModeDbyte,DqDqsRcvCntrl::ExtVrefRange]  - [011,0] :: VREF = VDDQ*(0.510 + VrefDAC1[6:0]*0.00345)  - [011,1] :: VREF = VDDQ*(0.453 + VrefDAC1[6:0]*0.00385)  - [non-enumerated encodings are reserved]  - Register Block Offset Address 0x030 is the VrefDAC1 for lane0.  - Register Block Offset Address 0x130 is the VrefDAC1 for lane1.  - Register Block Offset Address 0x230 is the VrefDAC1 for lane2.  - Register Block Offset Address 0x330 is the VrefDAC1 for lane3.  - Register Block Offset Address 0x430 is the VrefDAC1 for lane4.  - Register Block Offset Address 0x530 is the VrefDAC1 for lane5.  - Register Block Offset Address 0x630 is the VrefDAC1 for lane6.  - Register Block Offset Address 0x730 is the VrefDAC1 for lane7.  - Register Block Offset Address 0x830 is the VrefDAC1 for lane[DBI]. RESET:0x0"
          
group.long  0x64++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TRAININGCNTR_R0, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TRAININGCNTR_R0_RFU_TRAININGCNTR_R0 ,None RESET:0x0"
          
group.long  0x80++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_VREFDAC0_R0, VrefDAC0 control for DQ Receiver RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_VREFDAC0_R0_VREFDAC0_R0 ,PHY RX VREF DAC control for rxdq cell internal VREF, (used only when 2D training is enabled in LPDDR4,DDR4 DAC control for rxdq cell internal VREF, trained by Firmware. The VREF generators have different ranges, depending on the Mission Mode settings for  - [DqDqsRcvCntrl::MajorModeDbyte,DqDqsRcvCntrl::ExtVrefRange]  - [000,0] :: VREF = VDDQ*(0.287 + VrefDAC0[6:0]*0.00330)  - [000,1] :: VREF = VDDQ*(0.250 + VrefDAC0[6:0]*0.00385)  - [011,0] :: VREF = VDDQ*(0.510 + VrefDAC0[6:0]*0.00345)  - [011,1] :: VREF = VDDQ*(0.453 + VrefDAC0[6:0]*0.00385)  - [010,0] :: VREF = VDDQ*(0.047 + VrefDAC0[6:0]*0.00367)  - [non-enumerated encodings are reserved]  - Register Block Offset Address 0x040 is the VrefDAC0 for lane0.  - Register Block Offset Address 0x140 is the VrefDAC0 for lane1.  - Register Block Offset Address 0x240 is the VrefDAC0 for lane2.  - Register Block Offset Address 0x340 is the VrefDAC0 for lane3.  - Register Block Offset Address 0x440 is the VrefDAC0 for lane4.  - Register Block Offset Address 0x540 is the VrefDAC0 for lane5.  - Register Block Offset Address 0x640 is the VrefDAC0 for lane6.  - Register Block Offset Address 0x740 is the VrefDAC0 for lane7.  - Register Block Offset Address 0x840 is the VrefDAC0 for lane[DBI]. RESET:0x0"
          
group.long  0x82++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXIMPEDANCECTRL0_B0_P0, - Tx DQ driver impedance when equalization is enabled per nibble. - Register Block Offset Address 0x041 controls the lower DQ nibble - Register Block Offset Address 0x141 controls the upper DQ nibble RESET:0xfff"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXIMPEDANCECTRL0_B0_P0_DRVSTRENDQP ,Refer to Technology specific PHY DATABOOK for supported options. The 6-bit bus is used to select the target pull-down output impedance. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStren120P[2:0], Csr_DrvStren240P[1:0],Csr_DrvStren480P[0:0]] = [csrDrvStrenDqP]  - 000000 - HiZ.  - 000001 - 480.0  - 000010 - 240.0  - 000011 - 160.0  - 001000 - 120.0  - 001001 - 96.0  - 001010 - 80.0  - 001011 - 68.6  - 011000 - 60.0  - 011001 - 53.3  - 011010 - 48.0  - 011011 - 43.6  - 111000 - 40.0  - 111001 - 36.9  - 111010 - 34.3  - 111011 - 32.0  - 111110 - 30.0  - 111111 - 28.2 RESET:0x3f"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXIMPEDANCECTRL0_B0_P0_DRVSTRENDQN ,Refer to Technology specific PHY DATABOOK for supported options. This 6-bit bus is used to select the target pull-down output impedance. Connects to the DrvStren pins of the driver thus:  [Csr_DrvStren120N[2:0],Csr_DrvStren240N[1:0],Csr_DrvStren480N[0:0]] = [csrDrvStrenDqN]  Note:See table of csr DrvStrenDqP for list of possible impedances. RESET:0x3f"
          
group.long  0x86++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL_B0_P0, Connected to the rxdqs and rxdq Mode selects and trim controls, per nibble.  - Register Block Offset Address 0x043 controls the lower DQ nibble  - Register Block Offset Address 0x143 controls the upper DQ nibble This DFE feature may be used with MajorModeDbyte=011 only. RESET:0x5b0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL_B0_P0_SELANALOGVREF ,Setting this signal high will force the local per-bit VREF generator to pass the global VREFA to the samplers. RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL_B0_P0_EXTVREFRANGE ,Extends the range available in the local per-bit VREF generator. RESET:0x0"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL_B0_P0_DFECTRL ,This field is programmable as follows  - 00 - DFE off  - 01 - DFE on  - 10 - Train DFE0 Amplifier  - 11 - Train DFE1 Amplifier These settings are determined by PHY Training FW and should not be overridden. RESET:0x0"
          
         hexmask.long 0x00 4.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL_B0_P0_MAJORMODEDBYTE ,Selects the major mode of operation for the receiver. These settings are determined by PHY Configuration based on DRAM protocol  - 000 - Input signal is terminated/referenced to VDDQ/2 (or unterminated)  - 001 - reserved  - 010 - Input signal is terminated/referenced to VSSQ  - 011 - Input signal is terminated/referenced to VDDQ  - 100 - reserved  - 101 - reserved  - 110 - reserved  - 111 - reserved RESET:0x3"
          
         hexmask.long 0x00 7.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL_B0_P0_GAINCURRADJ ,Adjust gain current of RX amplifier stage. It is recommended to use default values for this CSR. RESET:0xb"
          
          
group.long  0x90++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXEQUALIZATIONMODE_P0, Tx DQ driver equalization is a technique for improving the write-data eye at the DRAMs. The driver can drive with full strength (configured with DrvStrenFSHiDqP and DrvStrenFSLoDqN0 or with weak strength (configured with DrvStrenEQHiDqP and DrvStrenEQLoDqN) depending on the dq value sequence.  - TxEqMode = 00 Off; drive with full strength only  - TxEqMode = 01 Mode0 drive with full strength.or weak strength depending on  present logical value and the previous logical value.  - TxEqMode = 10 Mode1 drive with full strength.or weak strength depending on  present logical value and the next logical value. Mode1 is a lower power mode.  - TxEqMode = 11 reserved RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXEQUALIZATIONMODE_P0_TXEQMODE ,Tx dq driver equalization mode controls. FFE, de-emphasis DDR43 PHY ONLY RESET:0x0"
          
group.long  0x92++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXIMPEDANCECTRL1_B0_P0, Tx impedance of DQ driver cells when equalization is disabled. - Register Block Offset Address 0x049 controls the lower DQ nibble - Register Block Offset Address 0x149 controls the upper DQ nibble RESET:0xfff"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXIMPEDANCECTRL1_B0_P0_DRVSTRENFSDQP ,Refer to Technology specific PHY DATABOOK for supported options This 6-bit bus is used to select the target pull-up output impedance. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStrenFS120P[2:0], Csr_DrvStrenFS240P[1:0], Csr_DrvStrenFS480P[0]] = [csrFSDrvStrenDq]  - 000000 - HiZ.  - 000001 - 480.0  - 000010 - 240.0  - 000011 - 160.0  - 001000 - 120.0  - 001001 - 96.0  - 001010 - 80.0  - 001011 - 68.6  - 011000 - 60.0  - 011001 - 53.3  - 011010 - 48.0  - 011011 - 43.6  - 111000 - 40.0  - 111001 - 36.9  - 111010 - 34.3  - 111011 - 32.0  - 111110 - 30.0  - 111111 - 28.2 RESET:0x3f"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXIMPEDANCECTRL1_B0_P0_DRVSTRENFSDQN ,Refer to Technology specific PHY DATABOOK for supported options. This 6-bit bus is used to select the target pull-down output impedance. Connects to the DrvStren pins of the driver thus:  [Csr_DrvStrenFS120N[2:0], Csr_DrvStrenFS240N[1:0], Csr_DrvStrenFS480N[0:0]] = [csrDrvStrenDqN]  Note: See table of csr DrvStrenFSDqP for list of possible impedances. RESET:0x3f"
          
group.long  0x94++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL1, Misc control of rxdq cell and rxdqs cell RESET:0x400"
         hexmask.long 0x00 0.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL1_POWERDOWNRCVR ,Active high signal which powers down the receiver.  - 7:0 -> dq[7:0]  - 8 -> dbi After this pin is deasserted the receiver cannot be used for a minimum of 100 ns. RESET:0x0"
          
         bitfld.long 0x00 9. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL1_POWERDOWNRCVRDQS ,Active high signal which powers down the receiver. After this pin is deasserted the receiver cannot be used for a minimum of 100 ns. This control powers down both the upper and lower DQS receivers. If Register X4TG[3:0]=0000, then the upper DQS receiver is powered down. RESET:0x0"
          
         bitfld.long 0x00 10. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL1_RXPADSTANDBYEN ,Enables the rxdq/rxdqs StandBy power savings, per pad-group. RESET:0x1"
          
         bitfld.long 0x00 11. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL1_ENLPREQPDR ,Reserved for future use RESET:0x0"
          
group.long  0x96++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXIMPEDANCECTRL2_B0_P0, Tx DQ driver opposition impedance when equalization is enabled. - Register Block Offset Address 0x04b controls the lower DQ nibble - Register Block Offset Address 0x14b controls the upper DQ nibble RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXIMPEDANCECTRL2_B0_P0_DRVSTRENEQHIDQP ,Refer to Technology specific PHY DATABOOK for supported options This 6-bit bus is used to select the target pull-up output impedance used in equalization. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStrenEQHi120P[2:0], Csr_DrvStrenEQHi240P[1:0], Csr_DrvStrenEQHi480P[0]] = [csrDrvStrenEQHiDq] RESET:0x0"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXIMPEDANCECTRL2_B0_P0_DRVSTRENEQLODQN ,Refer to Technology specific PHY DATABOOK for supported options This 6-bit bus is used to select the target pull-down output impedance used in equalization. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStrenEQLo120N[2:0], Csr_DrvStrenEQLo240N[1:0], Csr_DrvStrenEQLo480P[0]] = [csrDrvStrenEQLoDq] RESET:0x0"
          
group.long  0x98++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL2_P0, Control for an aggressive power-saving feature to powerdown dq and dqs receiver cells dynamically. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DQDQSRCVCNTRL2_P0_ENRXAGRESSIVEPDR ,reserved RESET:0x0"
          
group.long  0x9a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXODTDRVSTREN_B0_P0, Selects desired impedance value for Host ODT. Must be set by user before PHY initialization. Setting for each protocol: DDR3:  - OdtStrenP - non-zero value  - OdtStrenN - same as OdtStrenP LPDDR3:  - OdtStrenP - non-zero value  - OdtStrenN - high-impedance DDR4:  - OdtStrenP - non-zero value  - OdtStrenN - high-impedance LPDDR4:  - OdtStrenP - high-impedance  - OdtStrenN - non-zero value  - Register Block Offset Address 0x04d controls the lower DQ nibble  - Register Block Offset Address 0x14d controls the upper DQ nibble RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXODTDRVSTREN_B0_P0_ODTSTRENP ,Selects the ODT pull-up impedance.  Refer to Technology specific PHY DATABOOK for supported options  - [ODTStren120P[2:0], ODTStren240P[1:0],ODTStren480P[0:0]]  - 000_00_0 = High Impedance  - 000_00_1 = 480 ohms  - 000_01_0 = 240 ohms  - 000_01_1 = 160 ohms  - 001_00_0 = 120 ohms  - 001_00_1 = 96.0 ohms  - 001_01_0 = 80.0 ohms  - 001_01_1 = 68.6 ohms  - 011_00_0 = 60.0 ohms  - 011_00_1 = 53.3 ohms  - 011_01_0 = 48.0 ohms  - 011_01_1 = 43.6 ohms  - 111_00_0 = 40.0 ohms  - 111_00_1 = 36.9 ohms  - 111_01_0 = 34.3 ohms  - 111_01_1 = 32.0 ohms  - 111_11_0 = 30.0 ohms  - 111_11_1 = 28.2 ohms RESET:0x0"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXODTDRVSTREN_B0_P0_ODTSTRENN ,Selects the ODT pull-down impedance.  Refer to Technology specific PHY DATABOOK for supported options  - [ODTStren120N[2:0], ODTStren240N[1:0],ODTStren480N[0:0]]  - 000_00_0 = High Impedance  - 000_00_1 = 480 ohms  - 000_01_0 = 240 ohms  - 000_01_1 = 160 ohms  - 001_00_0 = 120 ohms  - 001_00_1 = 96.0 ohms  - 001_01_0 = 80.0 ohms  - 001_01_1 = 68.6 ohms  - 011_00_0 = 60.0 ohms  - 011_00_1 = 53.3 ohms  - 011_01_0 = 48.0 ohms  - 011_01_1 = 43.6 ohms  - 111_00_0 = 40.0 ohms  - 111_00_1 = 36.9 ohms  - 111_01_0 = 34.3 ohms  - 111_01_1 = 32.0 ohms  - 111_11_0 = 30.0 ohms  - 111_11_1 = 28.2 ohms RESET:0x0"
          
rgroup.long 0xac++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCHECKSTATUS, When a PhyRxFifoCheck interrupt is posted these bits indicate which pair of fifo pointers didn't match as expected. The non-zero pointer values can be read from the RxFifoCheckStatusValues register. Setting the PhyRxFifoCheckClr in the PhyInterruptClear register clears these bits. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCHECKSTATUS_RXFIFOLOCERR ,If set, the read pointer (DFI side) on the read FIFO associated with data bits [3:0] didn't match the write pointer (DQS side) on the read FIFO associated with data bits [3:0]; RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCHECKSTATUS_RXFIFOLOCUERR ,If set, the read pointer (DFI side) on the read FIFO associated with data bits [7:4] didn't match the write pointer (DQS side) on the read FIFO associated with data bits [7:4]; RESET:0x0"
          
rgroup.long 0xae++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCHECKERRVALUES, Contains the value of the fifo pointer for the first mismatch captured in the RxFifoCheckStatus register. Setting the PhyRxFifoCheckClr in the PhyInterruptClear register clears these bits. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCHECKERRVALUES_RXFIFORDLOCERRVALUE ,The first error value captured for the read pointer (DFI side) on the read FIFO associated with data bits [3:0]; RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCHECKERRVALUES_RXFIFOWRLOCERRVALUE ,The first error value captured for the write pointer (DQS side) on the read FIFO associated with data bits [3:0]; RESET:0x0"
          
         hexmask.long 0x00 8.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCHECKERRVALUES_RXFIFORDLOCUERRVALUE ,The first error value captured for the read pointer (DFI side) on the read FIFO associated with data bits [7:4]; RESET:0x0"
          
         hexmask.long 0x00 12.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCHECKERRVALUES_RXFIFOWRLOCUERRVALUE ,The first error value captured for the write pointer (DQS side) on the read FIFO associated with data bits [7:4]; RESET:0x0"
          
rgroup.long 0xb0++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOINFO, Provides visibility of the read and write pointers of the RxFifos for debug purposes. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOINFO_RXFIFORDLOC ,The Mission mode read pointer of the lower-nibble Rx fifo. RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOINFO_RXFIFOWRLOC ,The Mission mode write pointer of the lower-nibble Rx fifo. RESET:0x0"
          
         hexmask.long 0x00 8.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOINFO_RXFIFORDLOCU ,The Mission mode read pointer of the upper-nibble Rx fifo. RESET:0x0"
          
         hexmask.long 0x00 12.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOINFO_RXFIFOWRLOCU ,The Mission mode write pointer of the upper-nibble Rx fifo. RESET:0x0"
          
group.long  0xb2++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOVISIBILITY, Allows the contents of the data rx fifo to be read via CSRs RxFifoContentsDBI,RxFifoContentsDQ7654,RxFifoContentsDQ3210. The fifo must be quiescent, i.e. no actual operations in progress, while reading the fifo. That is, the read from the RxFifo must be after the max-read-latency (DFIMRL) time.  Procedure to read the contents of the entire RxFifo:  - wait for any outstanding reads to complete (min 2*DFIMRL MemClks)  - read and store RxFifoWrLoc[3:0] and RxFifoWrLocU[3:0] (they should be equal).  - perform four BL8 memory reads  - wait at least 2*DFIMRL MemClks.  - for (iNib=0, iNib<8, iNib++)  - [  - 1. myRdPtr[2:0] = (stored RxFifoWrLoc[3:0]>>1) + iNib (may wrap 7 to 0)  - 2. write addr=RxFifoVisibility, data=[csrRxFifoRdEn=0,csrFifoRdPtrOvr=1,csrRxFifoRdPtr=myRdPtr]  - 3. write addr=RxFifoVisibility, data=[csrRxFifoRdEn=1,csrFifoRdPtrOvr=1,csrRxFifoRdPtr=myRdPtr]  - 4. write addr=RxFifoVisibility, data=[csrRxFifoRdEn=0,csrFifoRdPtrOvr=1,csrRxFifoRdPtr=myRdPtr]  - 5. wait for 8 DfiClk.  - 6. read addr=RxFifoContentsDBI  - 7. read addr=RxFifoContentsDQ7654  - 8. read addr=RxFifoContentsDQ3210  - 9. unpack/align resulting data as described in descriptions of RxFifoContents registers, and map according to the configuration of the csr Dq<7..0>LnSel[2:0].  - ]  - evaluate/compare with data that travels through normal read path (dfi_read_data_dbi,dfi_read_data).  - write [csrRxFifoRdEn=0,csrFifoRdPtrOvr=0,csrRxFifoRdPtr = 0]  - PHY is now available for normal mission-mode operation.  end of Procedure RESET:0x0"
         hexmask.long 0x00 0.--2. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOVISIBILITY_RXFIFORDPTR ,If CSR RxFifoRdPtrOVr is set, then this CSR selects the rxfifo entry is visible in CSR. This 3b field addresses 4b units of the 8x4b (32entry) fifo; that is, rdfifo_nibble_address[2:0]=csrRxFifoRdPtr[2:0]  For example, Register RxFifoRdPtr[2:0]=2 will enable reading bit-entries 11..8. The exact location of read data will depend on the prior history of reads and PHY initialization. RESET:0x0"
          
         bitfld.long 0x00 3. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOVISIBILITY_RXFIFORDPTROVR ,This field is programmable as follows: - 0 : Normal operation - mission mode read pointer is enabled - 1 : Override - Control of the rx fifo read pointer is ceded to CSR RxFifoRdPtr. RESET:0x0"
          
         bitfld.long 0x00 4. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOVISIBILITY_RXFIFORDEN ,Pulse [set 0-->1-->0] this bit to capture the Fifo Contents. RESET:0x0"
          
rgroup.long 0xb4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCONTENTSDQ3210, RX FIFO contents, lane[3:0] RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCONTENTSDQ3210_RXFIFOCONTENTSDQ3210 ,A window into the contents of the RxFifo, as controlled by CSR RxFifoVisibility. This register reads 4b at a time from lane0..3 from the four fifo entries addressed by rdfifo_nibble_address[2:0]=RxFifoRdPtr[2:0] Register  - [15:12] = [lane3_ui3,lane3_ui2,lane3_ui1,lane3_ui0] where ui0 is the first occurring bit  - [11: 8] = [lane2_ui3,lane2_ui2,lane2_ui1,lane2_ui0]  - [ 7: 4] = [lane1_ui3,lane1_ui2,lane1_ui1,lane1_ui0]  - [ 3: 0] = [lane0_ui3,lane0_ui2,lane0_ui1,lane0_ui0]  Note: The DBYTE lane of a given index is not the same as a memory DQ of the same index unless the csr Dq<7..0>LnSel[2:0] have their default/reset value. RESET:0x0"
          
rgroup.long 0xb6++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCONTENTSDQ7654, RX FIFO contents, lane[7:4] RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCONTENTSDQ7654_RXFIFOCONTENTSDQ7654 ,A window into the contents of the RxFifo, as controlled by CSR RxFifoVisibility. This register reads 4b at a time from lane4..7 from the four fifo entries addressed by rdfifo_nibble_address[2:0]=RxFifoRdPtr[2:0] Register  - [15:12] = [lane7_ui3,lane7_ui2,lane7_ui1,lane7_ui0]  - [11: 8] = [lane6_ui3,lane6_ui2,lane6_ui1,lane6_ui0]  - [ 7: 4] = [lane5_ui3,lane5_ui2,lane5_ui1,lane5_ui0]  - [ 3: 0] = [lane4_ui3,lane4_ui2,lane4_ui1,lane4_ui0]  Note that the DBYTE lane of a given index is not the same as a memory DQ of the same index unless the csr Dq<7..0>LnSel[2:0] have their default/reset value. RESET:0x0"
          
rgroup.long 0xb8++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCONTENTSDBI, RX FIFO contents, dbi RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXFIFOCONTENTSDBI_RXFIFOCONTENTSDBI ,A window into the contents of the RxFifo, as controlled by CSR RxFifoVisibility. This register reads 4b at a time from DBI from the four fifo entries addressed by rdfifo_nibble_address[2:0]=RxFifoRdPtr[2:0] Register [ 3: 0] = [dbi_ui3,dbi_ui2,dbi_ui1,dbi_ui0]  Note that the DBYTE DBI lane is the same as the memory DBI; it is not subject to mapping using csr Dq<7..0>LnSel[2:0] as the DQ are. RESET:0x0"
          
group.long  0xbe++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXSLEWRATE_B0_P0, Controls slew rates of the DQ/DQS drivers per nibble. - Tx predriver cal trims driver timing to account for clock duty cycle variation. - Register Block Offset Address 0x05f is the TxSlewRate for the lower nibble. - Register Block Offset Address 0x15f is the TxSlewRate for the upper nibble. RESET:0x7ff"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXSLEWRATE_B0_P0_TXPREP ,This is the 4-bit binary trim for the driver pull-up slew rate. 4'b0000 has a slower slew rate than 4'b1111 RESET:0xf"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXSLEWRATE_B0_P0_TXPREN ,4 bit binary trim for the driver pull-down slew rate. 4'b0000 has a slower slew rate than 4'b1111 RESET:0xf"
          
         hexmask.long 0x00 8.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TXSLEWRATE_B0_P0_TXPREDRVMODE ,Controls predrivers to adjust timing of turn-on and turn-off of pull-up and pull-down segments. Recommended settings:  - DDR3 = 3'b011.  - DDR4 = 3'b010.  - LPDDR3 = 3'b010.  - LPDDR4 = 3'b001 RESET:0x7"
          
group.long  0xc4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TRAININGINCDECDTSMEN_R0, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_TRAININGINCDECDTSMEN_R0_TRAININGINCDECDTSMEN_R0 ,Reserved for PHY training firmware use. RESET:0x0"
          
group.long  0xd0++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXPBDLYTG0_R0, Read DQ per-bit BDL delay (Timing Group 0). RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXPBDLYTG0_R0_RXPBDLYTG0_R0 ,Read DQ per-bit BDL delay (Timing Group 0). Trained to deskew the read DQ data that will be sampled by the incoming per-nibble read DQS, to improve the composite eye.  Bits 5-0 convey the BDL delay value. Bit 6 is Reserved.  The unit of change is a LSB in the control of the delay circuit, and is not denoninated in units of UI.  - Register Block Offset Address 0x068 controls the lane0 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x168 controls the lane1 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x268 controls the lane2 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x368 controls the lane3 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x468 controls the lane4 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x568 controls the lane5 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x668 controls the lane6 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x768 controls the lane7 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x868 controls the lane[DBI] read deskew timing. (For Timing Group 0)  Note: This register is not per-pstate. The same deskew (for channel-routing differences) is used for all pstates.  Note: Timing Group 0 = RANK0. RESET:0x0"
          
group.long  0xd2++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXPBDLYTG1_R0, Read DQ per-bit BDL delay (Timing Group 1). RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXPBDLYTG1_R0_RXPBDLYTG1_R0 ,Read DQ per-bit BDL delay (Timing Group 1). Trained to deskew the read DQ data that will be sampled by the incoming per-nibble read DQS, to improve the composite eye.  Bits 5-0 convey the BDL delay value. Bit 6 is Reserved.  The unit of change is a LSB in the control of the delay circuit, and is not denoninated in units of UI.  - Register Block Offset Address 0x069 controls the lane0 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x169 controls the lane1 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x269 controls the lane2 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x369 controls the lane3 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x469 controls the lane4 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x569 controls the lane5 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x669 controls the lane6 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x769 controls the lane7 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x869 controls the lane[DBI] read deskew timing. (For Timing Group 1)  Note: This register is not per-pstate. The same deskew (for channel-routing differences) is used for all pstates.  Note: Timing Group 1 = RANK1. RESET:0x0"
          
group.long  0xd4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXPBDLYTG2_R0, Read DQ per-bit BDL delay (Timing Group 2). RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_RXPBDLYTG2_R0_RXPBDLYTG2_R0 ,Read DQ per-bit BDL delay (Timing Group 2). Trained to deskew the read DQ data that will be sampled by the incoming per-nibble read DQS, to improve the composite eye.  Bits 5-0 convey the BDL delay value. Bit 6 is Reserved.  The unit of change is a LSB in the control of the delay circuit, and is not denoninated in units of UI.  - Register Block Offset Address 0x06a controls the lane0 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x16a controls the lane1 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x26a controls the lane2 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x36a controls the lane3 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x46a controls the lane4 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x56a controls the lane5 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x66a controls the lane6 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x76a controls the lane7 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x86a controls the lane[DBI] read deskew timing. (For Timing Group 2)  Note: This register is not per-pstate. The same deskew (for channel-routing differences) is used for all pstates.  Note: Timing Group 2 = RANK2. RESET:0x0"
          
