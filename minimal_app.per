         hexmask.long 0x00 3.--10. 1. " ETHERNET_REG_RDMA_CTRL_BURST_LEN ,AXI burst length RESET:0x0"
          
         bitfld.long 0x00 11. " ETHERNET_REG_RDMA_CTRL_TERMINATE ,Manual termination of stream, concludes transaction and sends tlast. Self-clearing RESET:0x0"
          
group.long  0x4++0x3
    line.long 0x00 "ETHERNET_REG_RDMA_STARTADDR, the start address of the DMA buffer. The last two bits are zero for word alignment RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " ETHERNET_REG_RDMA_STARTADDR_WORD_ALIGNMENT ,None RESET:0x0"
          
         hexmask.long 0x00 2.--31. 1. " ETHERNET_REG_RDMA_STARTADDR_VALUE ,None RESET:0x0"
          
group.long  0x8++0x3
    line.long 0x00 "ETHERNET_REG_RDMA_STARTADDR_DB, the second start address of the DMA in double buffering mode. The last two bits are zero for word alignment RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " ETHERNET_REG_RDMA_STARTADDR_DB_WORD_ALIGNMENT ,None RESET:0x0"
          
         hexmask.long 0x00 2.--31. 1. " ETHERNET_REG_RDMA_STARTADDR_DB_VALUE ,None RESET:0x0"
          
group.long  0xc++0x3
    line.long 0x00 "ETHERNET_REG_RDMA_MAXSIZE, the size in bytes of the buffer allocated for DMA operations RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " ETHERNET_REG_RDMA_MAXSIZE_VALUE ,None RESET:0x0"
          
group.long  0x10++0x3
    line.long 0x00 "ETHERNET_REG_RDMA_SIZE1, SIZE1 interrupt triggers in case size1 byte have been read from the buffer / can be used for double buffering RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " ETHERNET_REG_RDMA_SIZE1_VALUE ,None RESET:0x0"
          
rgroup.long 0x14++0x3
    line.long 0x00 "ETHERNET_REG_RDMA_CURR_ADDR, the current address of the DMA read pointer RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " ETHERNET_REG_RDMA_CURR_ADDR_VALUE ,None RESET:0x0"
          
group.long  0x18++0x3
    line.long 0x00 "ETHERNET_REG_RDMA_IRQ_STATUS, interrupt status bits reflect the occurrence of an event / whether these bits generate an interrupt is contolled via irq_status_enable RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_REG_RDMA_IRQ_STATUS_MAXSIZE ,Buffer is filled to MAXSIZE RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_REG_RDMA_IRQ_STATUS_SIZE1 ,Buffer is filled to size1 RESET:0x0"
          
         bitfld.long 0x00 2. " ETHERNET_REG_RDMA_IRQ_STATUS_BERR ,Bus error: system bus returns an error response. Use curr_addr as a hint where the bus error occurred RESET:0x0"
          
         bitfld.long 0x00 3. " ETHERNET_REG_RDMA_IRQ_STATUS_UNFL ,Underflow: data towards AXI-4S is consumed faster than the DMA is able to read data from the bus system in time. NOTE: This can also be detected from the interface axi wrappers (e.g. spi_axi4s_wrap) RESET:0x0"
          
group.long  0x1c++0x3
    line.long 0x00 "ETHERNET_REG_RDMA_IRQ_STATUS_ENABLE, Enables the selected events to generate interrupts on the interrupt line RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_REG_RDMA_IRQ_STATUS_ENABLE_MAXSIZE ,Enable interrupt maxsize RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_REG_RDMA_IRQ_STATUS_ENABLE_SIZE1 ,Enable interrupt size1 RESET:0x0"
          
         bitfld.long 0x00 2. " ETHERNET_REG_RDMA_IRQ_STATUS_ENABLE_BERR ,Enable interrupt berr RESET:0x0"
          
         bitfld.long 0x00 3. " ETHERNET_REG_RDMA_IRQ_STATUS_ENABLE_UNFL ,Enable interrupt unfl RESET:0x0"
          
wgroup.long 0x20++0x3
    line.long 0x00 "ETHERNET_REG_RDMA_IRQ_STATUS_SET, Set irq_status register bits. Used to the emulate interrupt event (for SW debug or dev) RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_REG_RDMA_IRQ_STATUS_SET_MAXSIZE ,Set interrupt maxsize RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_REG_RDMA_IRQ_STATUS_SET_SIZE1 ,Set interrupt size1 RESET:0x0"
          
         bitfld.long 0x00 2. " ETHERNET_REG_RDMA_IRQ_STATUS_SET_BERR ,Set interrupt berr RESET:0x0"
          
         bitfld.long 0x00 3. " ETHERNET_REG_RDMA_IRQ_STATUS_SET_UNFL ,Set interrupt unfl RESET:0x0"
          
tree.end

