    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRANSCFG, Channel Destination Transfer Configuration Register  This register provides transfer attribute settings in the write direction of the DMA command.  The content of this register can be updated during command linking by setting bit[11] in the command link header. RESET:0xf0400"
         hexmask.long 0x00 0.--3. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRANSCFG_DESMEMATTRLO ,Destination Transfer Memory Attribute field [3:0]. When DESMEMATTRHI is Device type (0000) then this field means:  - 0000: Device-nGnRnE  - 0100: Device-nGnRE  - 1000: Device-nGRE  - 1100: Device-GRE  - Others: Invalid resulting in UNPREDICTABLE behavior When DESMEMATTRHI is Normal Memory type (other than 0000) then this field means:  - 0000: Reserved  - 0001: Normal memory, Inner Write allocate, Inner Write-through transient  - 0010: Normal memory, Inner Read allocate, Inner Write-through transient  - 0011: Normal memory, Inner Read/Write allocate, Inner Write-through transient  - 0100: Normal memory, Inner non-cacheable  - 0101: Normal memory, Inner Write allocate, Inner Write-back transient  - 0110: Normal memory, Inner Read allocate, Inner Write-back transient  - 0111: Normal memory, Inner Read/Write allocate, Inner Write-back transient  - 1000: Normal memory, Inner Write-through non-transient  - 1001: Normal memory, Inner Write allocate, Inner Write-through non-transient  - 1010: Normal memory, Inner Read allocate, Inner Write-through non-transient  - 1011: Normal memory, Inner Read/Write allocate, Inner Write-through non-transient  - 1100: Normal memory, Inner Write-back non-transient  - 1101: Normal memory, Inner Write allocate, Inner Write-back non-transient  - 1110: Normal memory, Inner Read allocate, Inner Write-back non-transient  - 1111: Normal memory, Inner Read/Write allocate, Inner Write-back non-transient RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRANSCFG_DESMEMATTRHI ,Destination Transfer Memory Attribute field [7:4]. - 0000: Device memory - 0001: Normal memory, Outer Write allocate, Outer Write-through transient - 0010: Normal memory, Outer Read allocate, Outer Write-through transient - 0011: Normal memory, Outer Read/Write allocate, Outer Write-through transient - 0100: Normal memory, Outer non-cacheable - 0101: Normal memory, Outer Write allocate, Outer Write-back transient - 0110: Normal memory, Outer Read allocate, Outer Write-back transient - 0111: Normal memory, Outer Read/Write allocate, Outer Write-back transient - 1000: Normal memory, Outer Write-through non-transient - 1001: Normal memory, Outer Write allocate, Outer Write-through non-transient - 1010: Normal memory, Outer Read allocate, Outer Write-through non-transient - 1011: Normal memory, Outer Read/Write allocate, Outer Write-through non-transient - 1100: Normal memory, Outer Write-back non-transient - 1101: Normal memory, Outer Write allocate, Outer Write-back non-transient - 1110: Normal memory, Outer Read allocate, Outer Write-back non-transient - 1111: Normal memory, Outer Read/Write allocate, Outer Write-back non-transient RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRANSCFG_DESSHAREATTR ,Destination Transfer Shareability Attribute. - 00: Non-shareable - 01: Reserved - 10: Outer shareable - 11: Inner shareable RESET:0x0"
          
         bitfld.long 0x00 10. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRANSCFG_DESNONSECATTR ,Destination Transfer Non-secure Attribute. - 0: Secure - 1: Non-secure When a channel is Non-secure this bit is tied to 1. RESET:0x1"
          
         bitfld.long 0x00 11. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRANSCFG_DESPRIVATTR ,Destination Transfer Privilege Attribute. - 0: Unprivileged - 1: Privileged When a channel is unprivileged this bit is tied to 0. RESET:0x0"
          
         hexmask.long 0x00 12.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRANSCFG_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         hexmask.long 0x00 16.--19. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRANSCFG_DESMAXBURSTLEN ,Destination Max Burst Length. Hint for the DMA on what is the maximum allowed burst size it can use for write transfers. The maximum number of beats sent by the DMA for a write burst is equal to DESMAXBURSTLEN + 1. Default value is 16 beats, which allows the DMA to set all burst sizes. Note: Limited by the DATA_BUFF_SIZE so larger settings may not always result in larger bursts. RESET:0xf"
          
         hexmask.long 0x00 20.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRANSCFG_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x1130++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_XADDRINC, Channel X Dimension Address Increment Register  This register sets the increment values used to update the source and destination addresses after each transferred data unit.  The content of this register can be updated during command linking by setting bit[12] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_XADDRINC_SRCXADDRINC ,Source X dimension Address Increment. This value is used as the increment between each TRANSIZE transfer. When a single bit is used then only 0 and 1 can be set. For wider increment registers, two's complement used with a range between -32768 to 32767 when the counter is 16-bits wide. The width of the register is indicated by the INC_WIDTH parameter. SRCADDR_next = SRCADDR + 2^TRANSIZE * SRCXADDRINC RESET:0x0"
          
         hexmask.long 0x00 16.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_XADDRINC_DESXADDRINC ,Destination X dimension Address Increment. This value is used as the increment between each TRANSIZE transfer. When a single bit is used then only 0 and 1 can be set. For wider increment registers, two's complement used with a range between -32768 to 32767 when the counter is 16-bits wide. The width of the register is indicated by the INC_WIDTH parameter. DESADDR_next = DESADDR + 2^TRANSIZE * DESXADDRINC RESET:0x0"
          
group.long  0x1134++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_YADDRSTRIDE, Channel Y Dimension Address Stride Register  This register sets the increment values used to update the source and destination line base addresses after each line is transferred.  The content of this register can be updated during command linking by setting bit[13] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_YADDRSTRIDE_SRCYADDRSTRIDE ,Source Address Stride between lines. Calculated in TRANSIZE aligned steps. This value is used to increment the SRCADDR after completing the transfer of a source line. SRCADDR_next_line_base = SRCADDR_line_base + 2^TRANSIZE * SRCYADDRSTRIDE. Two's complement used with a range between -32768 to 32767. When set to 0 the SRCADDR is not incremented after completing one line. Not present when HAS_2D is 0. RESET:0x0"
          
         hexmask.long 0x00 16.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_YADDRSTRIDE_DESYADDRSTRIDE ,Destination Address Stride between lines. Calculated in TRANSIZE aligned steps. This value is used to increment the DESADDR after completing the transfer of a destination line. DESADDR_next_line_base = DESADDR_line_base + 2^TRANSIZE * DESYADDRSTRIDE. Two's complement used with a range between -32768 to 32767. When set to 0 the DESADDR is not incremented after completing one line. Not present when HAS_2D is 0. RESET:0x0"
          
group.long  0x1138++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_FILLVAL, Channel Fill Pattern Value Register  This register provides a predefined value to be used to fill the remaining part of the destination memory area when the source side of the command is finished.  The content of this register can be updated during command linking by setting bit[14] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_FILLVAL_FILLVAL ,Fill pattern value. When XTYPE or YTYPE is set to fill mode, then this register value is used on the write data bus when the command starts to fill the memory area. The TRANSIZE defines the width of the FILLVAL used for the command. For byte transfers the FILLVAL[7:0] is used, other bits are ignored. For halfword transfers the FILLVAL[15:0] is used, other bits are ignored. For 64-bit and wider transfers the FILLVAL[31:0] pattern is repeated on the full width of the data bus. Not present when HAS_WRAP is 0. RESET:0x0"
          
group.long  0x113c++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_YSIZE, Channel Y Dimensions Size Register  This register defines the number of lines copied during the DMA command up to 16 bits in the Y dimension. The read and write size of the command may be different for some transfer types. When read during the execution of the DMA command, the register shows the remaining number of lines in both read and write directions.  The content of this register can be updated during command linking by setting bit[15] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_YSIZE_SRCYSIZE ,Source Y dimension or number of lines. Not present when HAS_2D is 0. RESET:0x0"
          
         hexmask.long 0x00 16.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_YSIZE_DESYSIZE ,Destination Y dimension or number of lines. Not present when HAS_2D is 0. HAS_WRAP or HAS_STREAM configuration needs to be set to allow writes to this register, otherwise it is read-only. RESET:0x0"
          
group.long  0x1140++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_TMPLTCFG, Channel Template Configuration Register  This register provides configuration settings when using template pattern based copy operations.  The content of this register can be updated during command linking by setting bit[16] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_TMPLTCFG_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         hexmask.long 0x00 8.--12. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_TMPLTCFG_SRCTMPLTSIZE ,Source Template Size in number of transfers plus one. - 0: Source template is disabled. - 1 to 31: Bits SRCTMPLT[SRCTMPLTSIZE:0] is used as the source template. Not present when HAS_TMPLT is 0. RESET:0x0"
          
         hexmask.long 0x00 13.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_TMPLTCFG_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         hexmask.long 0x00 16.--20. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_TMPLTCFG_DESTMPLTSIZE ,Destination Template Size in number of transfers plus one. - 0: Destination template is disabled. - 1 to 31: DESTMPLT[DESTMPLTSIZE:0] is used as the destination template. Not present when HAS_TMPLT is 0. RESET:0x0"
          
         hexmask.long 0x00 21.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_TMPLTCFG_RAZWI_2 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x1144++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_SRCTMPLT, Channel Source Template Pattern Register  This register sets the template pattern used for reading the source memory area.  The content of this register can be updated during command linking by setting bit[17] in the command link header. RESET:0x1"
         bitfld.long 0x00 0. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_SRCTMPLT_SRCTMPLTLSB ,Source Packing Template Least Significant Bit. This bit of the template is read only and always set to 1 as template patterns can only start from the base address of the transfer. Not present when HAS_TMPLT is 0. RESET:0x1"
          
         hexmask.long 0x00 1.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_SRCTMPLT_SRCTMPLT ,Source Packing Template. Bit[0] is read only and always set to 1 as template patterns can only start from the base address of the transfer. Not present when HAS_TMPLT is 0. RESET:0x0"
          
group.long  0x1148++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTMPLT, Channel Destination Template Pattern Register  This register sets the template pattern used for writing the destination memory area.  The content of this register can be updated during command linking by setting bit[18] in the command link header. RESET:0x1"
         bitfld.long 0x00 0. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTMPLT_DESTMPLTLSB ,Destination Packing Template Least Significant Bit. This bit of the template is read only and always set to 1 as template patterns can only start from the base address of the transfer. Not present when HAS_TMPLT is 0. RESET:0x1"
          
         hexmask.long 0x00 1.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTMPLT_DESTMPLT ,Destination Packing Template.  Bit[0] is read only and always set to 1 as template patterns can only start from the base address of the transfer. Not present when HAS_TMPLT is 0. RESET:0x0"
          
group.long  0x114c++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_SRCTRIGINCFG, Channel Source Trigger In Configuration Register  This register provides configuration settings when using source side trigger input for the current DMA command.  The content of this register can be updated during command linking by setting bit[19] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_SRCTRIGINCFG_SRCTRIGINSEL ,Source Trigger Input Select RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_SRCTRIGINCFG_SRCTRIGINTYPE ,Source Trigger Input Type:  - 00: Software only Trigger Request. SRCTRIGINSEL is ignored.  - 01: Reserved  - 10: HW Trigger Request. Only allowed when HAS_TRIGIN is enabled. SRCTRIGINSEL selects between external trigger inputs if HAS_TRIGSEL is enabled.  - 11: Internal Trigger Request. Only allowed when HAS_TRIGSEL is enabled and the DMAC has multiple channels, otherwise treated as HW Trigger Request. SRCTRIGINSEL selects between DMA channels. Note: SW triggers are also available when HW or Internal types are selected, but is is not recommended and caution must be taken when the these modes are combined. RESET:0x0"
          
         hexmask.long 0x00 10.--11. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_SRCTRIGINCFG_SRCTRIGINMODE ,Source Trigger Input Mode:  - 00: Command  - 01: Reserved  - 10: DMA driven Flow control. Only allowed when HAS_TRIGIN is enabled.  - 11: Peripheral driven Flow control. Only allowed when HAS_TRIGIN is enabled. Note: This field is ignored for Internal triggers as they only support Command triggers. RESET:0x0"
          
         hexmask.long 0x00 12.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_SRCTRIGINCFG_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x1150++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRIGINCFG, Channel Destination Trigger In Configuration Register  This register provides configuration settings when using destination side trigger input for the current DMA command.  The content of this register can be updated during command linking by setting bit[20] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRIGINCFG_DESTRIGINSEL ,Destination Trigger Input Select RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRIGINCFG_DESTRIGINTYPE ,Destination Trigger Input Type:  - 00: Software only Trigger Request. DESTRIGINSEL is ignored.  - 01: Reserved  - 10: HW Trigger Request. Only allowed when HAS_TRIGIN is enabled. DESTRIGINSEL selects between external trigger inputs if HAS_TRIGSEL is enabled.  - 11: Internal Trigger Request. Only allowed when HAS_TRIGSEL is enabled and the DMAC has multiple channels, otherwise treated as HW Trigger Request. DESTRIGINSEL selects between DMA channels. Note: SW triggers are also available when HW or Internal types are selected, but is is not recommended and caution must be taken when the these modes are combined. RESET:0x0"
          
         hexmask.long 0x00 10.--11. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRIGINCFG_DESTRIGINMODE ,Destination Trigger Input Mode:  - 00: Command  - 01: Reserved  - 10: DMA driven Flow control. Only allowed when HAS_TRIGIN is enabled.  - 11: Peripheral driven Flow control. Only allowed when HAS_TRIGIN is enabled. Note: This field is ignored for Internal triggers as they only support Command triggers. RESET:0x0"
          
         hexmask.long 0x00 12.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_DESTRIGINCFG_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x1154++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_TRIGOUTCFG, Channel Trigger Out Configuration Register  This register provides configuration settings when using trigger output for the current DMA command.  The content of this register can be updated during command linking by setting bit[21] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_TRIGOUTCFG_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_TRIGOUTCFG_TRIGOUTTYPE ,Trigger Output Type - 00: Software only Trigger Acknowledgement. - 01: Reserved - 10: HW Trigger Acknowledgement. Only allowed when HAS_TRIGOUT is enabled. - 11: Internal Trigger Acknowledgement. Only allowed when HAS_TRIGSEL is enabled and the DMAC has multiple channels, otherwise treated as HW Trigger Acknowledgement. RESET:0x0"
          
         hexmask.long 0x00 10.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_TRIGOUTCFG_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x1170++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKATTR, Channel Link Address Memory Attributes Register  This register provides transfer attribute settings for the command link related read transfers. The security and privilege attributes cannot be adjusted, they match the attributes of the channel.  The content of this register can be updated during command linking by setting bit[28] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKATTR_LINKMEMATTRLO ,Link Address Read Transfer Memory Attribute field [3:0]. When LINKMEMATTRHI is Device type (0000) then this field means:  - 0000: Device-nGnRnE  - 0100: Device-nGnRE  - 1000: Device-nGRE  - 1100: Device-GRE  - Others: Invalid resulting in UNPREDICTABLE behavior When LINKMEMATTRHI is Normal memory type (other than 0000) then this field means:  - 0000: Reserved  - 0001: Normal memory, Inner Write allocate, Inner Write-through transient  - 0010: Normal memory, Inner Read allocate, Inner Write-through transient  - 0011: Normal memory, Inner Read/Write allocate, Inner Write-through transient  - 0100: Normal memory, Inner non-cacheable  - 0101: Normal memory, Inner Write allocate, Inner Write-back transient  - 0110: Normal memory, Inner Read allocate, Inner Write-back transient  - 0111: Normal memory, Inner Read/Write allocate, Inner Write-back transient  - 1000: Normal memory, Inner Write-through non-transient  - 1001: Normal memory, Inner Write allocate, Inner Write-through non-transient  - 1010: Normal memory, Inner Read allocate, Inner Write-through non-transient  - 1011: Normal memory, Inner Read/Write allocate, Inner Write-through non-transient  - 1100: Normal memory, Inner Write-back non-transient  - 1101: Normal memory, Inner Write allocate, Inner Write-back non-transient  - 1110: Normal memory, Inner Read allocate, Inner Write-back non-transient  - 1111: Normal memory, Inner Read/Write allocate, Inner Write-back non-transient RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKATTR_LINKMEMATTRHI ,Link Address Read Transfer Memory Attribute field [7:4]. - 0000: Device memory - 0001: Normal memory, Outer Write allocate, Outer Write-through transient - 0010: Normal memory, Outer Read allocate, Outer Write-through transient - 0011: Normal memory, Outer Read/Write allocate, Outer Write-through transient - 0100: Normal memory, Outer non-cacheable - 0101: Normal memory, Outer Write allocate, Outer Write-back transient - 0110: Normal memory, Outer Read allocate, Outer Write-back transient - 0111: Normal memory, Outer Read/Write allocate, Outer Write-back transient - 1000: Normal memory, Outer Write-through non-transient - 1001: Normal memory, Outer Write allocate, Outer Write-through non-transient - 1010: Normal memory, Outer Read allocate, Outer Write-through non-transient - 1011: Normal memory, Outer Read/Write allocate, Outer Write-through non-transient - 1100: Normal memory, Outer Write-back non-transient - 1101: Normal memory, Outer Write allocate, Outer Write-back non-transient - 1110: Normal memory, Outer Read allocate, Outer Write-back non-transient - 1111: Normal memory, Outer Read/Write allocate, Outer Write-back non-transient RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKATTR_LINKSHAREATTR ,Link Address Transfer Shareability Attribute. - 00: Non-shareable - 01: Reserved - 10: Outer shareable - 11: Inner shareable RESET:0x0"
          
         hexmask.long 0x00 10.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKATTR_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x1174++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_AUTOCFG, Channel Automatic Command Restart Configuration Register  This register configures the automatic restart behavior of the currently running command.  The content of this register can be updated during command linking by setting bit[29] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_AUTOCFG_CMDRESTARTCNT ,Automatic Command Restart Counter. Defines the number of times automatic restarting will occur at end of DMA command. Auto restarting will occur after the command is completed, including output triggering if enabled and autoreloading the registers, but it will only perfrom a link to the next command when CMDRESTARTCNT == 0. When CMDRESTARTCNT and CMDRESTARTINF are both set to '0', autorestart is disabled. RESET:0x0"
          
         bitfld.long 0x00 16. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_AUTOCFG_CMDRESTARTINFEN ,Enable Infinite Automatic Command Restart. When set, CMDRESTARTCNT is ignored and the command is always restarted after it is completed, including output triggering if enabled and autoreloading the registers but it will not perform a link to the next command. This means that the infinite loop of automatic restarts can only be broken by DISABLECMD or STOPCMD. When CMDRESTARTINFEN is set to '0', then the autorestarting of a command depends on CMDRESTARTCNT and when that counter is set to 0 the autorestarting is finished. In this case the next linked command is read or the command is complete. RESET:0x0"
          
         hexmask.long 0x00 17.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_AUTOCFG_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x1178++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKADDR, Channel Link Address Register  This register sets the 32-bit address of the next element in a command link. When the command execution is finished and this register is set then the DMA channel starts loading the next command from this address.  The content of this register can be updated during command linking by setting bit[30] in the command link header. RESET:0x0"
         bitfld.long 0x00 0. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKADDR_LINKADDREN ,Enable Link Address. When set to '1', the DMAC fetches the next command defined by LINKADDR. When set to '0' the DMAC will return to idle at the end of the current command.  NOTE: the linked command fetched by the DMAC needs to clear this field to mark the end of the command chain. Otherwise it may result in an infinite loop of the same command. RESET:0x0"
          
         bitfld.long 0x00 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKADDR_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         hexmask.long 0x00 2.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKADDR_LINKADDR ,Link Address Pointer [31:2]. The DMAC fetches the next command from this address if LINKADDREN is set. NOTE: Commands are fetched with the security and privilege attribute of the channel and cannot be adjusted for the command link reads. RESET:0x0"
          
group.long  0x117c++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKADDRHI, Channel Link Address Register, High Bits [63:32]  This register sets the upper address bits of the next element in a command link.  The content of this register can be updated during command linking by setting bit[31] in the command link header. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_LINKADDRHI_LINKADDRHI ,Link Address Pointer [63:32]. Allows 64-bit addressing but the system might need less address bits. Limited by ADDR_WIDTH and the not implemented bits remain reserved. RESET:0x0"
          
group.long  0x1188++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_WRKREGPTR, Channel Working Register Pointer Register  This register can be used to select an internal work register of the DMA channel that will be visible in the CH_WRKREGVAL register. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_WRKREGPTR_WRKREGPTR ,Internal Working Register Pointer. These pointer refers to the following:  - 0: Reserved  - 1: SRCADDR_INITIAL  - 2: SRCADDRHI_INITIAL  - 3: DESADDR_INITIAL  - 4: DESADDRHI_INITIAL  - 5: SRCXSIZEHI_INITIAL, SRCXSIZE_INITIAL  - 6: DESXSIZEHI_INITIAL, DESXSIZE_INITIAL  - 7: SRCADDR_LINEINITIAL  - 8: SRCADDRHI_LINEINITIAL  - 9: DESADDR_LINEINITIAL  - 10: DESADDRHI_LINEINITIAL  - 11: SRCYSIZE_INITIAL (HAS_2D only)  - 12: DESYSIZE_INITIAL (HAS_2D only)  - Others: Reserved. NOTE: When the selected register is not supported by the DMA then it is read as 0 in the CH_WRKREGVAL register. For 1D modes the INITIAL and LINEINITIAL registers contain the same values. RESET:0x0"
          
         hexmask.long 0x00 4.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_WRKREGPTR_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
rgroup.long 0x118c++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_WRKREGVAL, Channel - Working Register Value Register  This register shows the internal value of a work register of the DMA channel selected by the CH_WRKREGPTR register. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_WRKREGVAL_WRKREGVAL ,Internal Working Register Values. WRKREGPTR points to the register that is visible here. The values are only guaranteed to be stable for the current command when STAT_PAUSED is asserted, otherwise they depend on the current status of the channel which makes them UNPREDICTABLE. RESET:0x0"
          
rgroup.long 0x1190++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ERRINFO, Channel Error Information Register  This register provides information about internal errors encountered during command exectuion by the DMA channel. RESET:0x0"
         bitfld.long 0x00 0. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ERRINFO_BUSERR ,Bus Error Flag. Set when the DMA encounters a bus error during data or command read transfers. RESET:0x0"
          
         bitfld.long 0x00 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ERRINFO_CFGERR ,Configuration Error Flag. Set when the DMA command is enabled or a linked command is read but it is configured in a mode that is not supported by the implementation. RESET:0x0"
          
         bitfld.long 0x00 2. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ERRINFO_SRCTRIGINSELERR ,Source Trigger Input Selection Error Flag. Set when the command selects a source trigger input that is not allowed for this channel. RESET:0x0"
          
         bitfld.long 0x00 3. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ERRINFO_DESTRIGINSELERR ,Destination Trigger Input Selection Error Flag. Set when the command selects a destination trigger input that is not allowed for this channel. RESET:0x0"
          
         bitfld.long 0x00 4. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ERRINFO_TRIGOUTSELERR ,Trigger Output Selection Error Flag. Set when the command selects a trigger output that is not allowed for this channel. RESET:0x0"
          
         hexmask.long 0x00 5.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ERRINFO_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         hexmask.long 0x00 16.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ERRINFO_ERRINFO ,Error information Register. Additional information for the error that is encountered by the DMA. The meaning of the bits are detailed in the Error Handling section. RESET:0x0"
          
rgroup.long 0x11c8++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_IIDR, Channel Implementation Identification Register  This register provides information about the revision of the product implementing the DMA channel. RESET:0x3a00043b"
         hexmask.long 0x00 0.--11. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_IIDR_IMPLEMENTER ,Contains the JEP106 code of the company that implemented the IP:  - [11:8]: JEP106 continuation code of implementer.  - [7]: Always 0.  - [6:0]: JEP106 identity code of implementer. For Arm this field reads as 0x43B. RESET:0x43b"
          
         hexmask.long 0x00 12.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_IIDR_REVISION ,Indicates the minor revision of the product rxpy identifier RESET:0x0"
          
         hexmask.long 0x00 16.--19. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_IIDR_VARIANT ,Indicates the major revision, or variant, of the product rxpy identifier RESET:0x0"
          
         hexmask.long 0x00 20.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_IIDR_PRODUCTID ,Indicates the product ID RESET:0x3a0"
          
rgroup.long 0x11cc++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_AIDR, Channel Architecture Identification Register  This register provides information about the architecture version supported by the DMA channel. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_AIDR_ARCH_MINOR_REV ,Architecture Minor Revision. RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_AIDR_ARCH_MAJOR_REV ,Architecture Major Revision. RESET:0x0"
          
         hexmask.long 0x00 8.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_AIDR_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x11e8++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ISSUECAP, Used for setting issuing capability threshold. RESET:0x7"
         hexmask.long 0x00 0.--2. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ISSUECAP_ISSUECAP ,ISSUECAP can be used by software to place a constraint on allowed issuing capability in both read and write direction. RESET:0x7"
          
         hexmask.long 0x00 3.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_ISSUECAP_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
rgroup.long 0x11f8++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG0, Channel Build Configuration and Capability Register 0  This register contains the configuration parameters can capabilities of the DMA channel. RESET:0x3d27000f"
         hexmask.long 0x00 0.--7. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG0_DATA_BUFF_SIZE ,Data Buffer Size in entries - 1. Total Size = ((DATA_BUFF_SIZE + 1) * DATA_WIDTH /8) bytes. RESET:0xf"
          
         hexmask.long 0x00 8.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG0_CMD_BUFF_SIZE ,Command Buffer Size in command words - 1. Total Size = (CMD_BUFF_SIZE + 1) * 4 bytes. RESET:0x0"
          
         hexmask.long 0x00 16.--21. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG0_ADDR_WIDTH ,Address Width in bits = ADDR_WIDTH + 1 RESET:0x27"
          
         hexmask.long 0x00 22.--24. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG0_DATA_WIDTH ,Data Width. - 000: 8-bit - 001: 16-bit - 010: 32-bit - 011: 64-bit - 100: 128-bit - 101: 256-bit - 110: 512-bit - 111: 1024-bit RESET:0x4"
          
         bitfld.long 0x00 25. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG0_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         hexmask.long 0x00 26.--29. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG0_INC_WIDTH ,Width of the increment register = INC_WIDTH + 1. When set to 0, then only 0 and 1 can be set as an increment. When larger values are used, then negative increments can be set using 2's complement: INC_WIDTH = 0: 0..1 INC_WIDTH = 1: -2..1 INC_WIDTH = 2: -4..3 INC_WIDTH = 3: -8..7 … INC_WIDTH = 15: -32768..32767 RESET:0xf"
          
         hexmask.long 0x00 30.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG0_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
rgroup.long 0x11fc++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1, Channel Build Configuration and Capability Register 1  This register contains the configuration parameters can capabilities of the DMA channel. RESET:0x79f"
         bitfld.long 0x00 0. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_XSIZEHI ,Has 32-bit XSIZE counters. RESET:0x1"
          
         bitfld.long 0x00 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_WRAP ,Has wrap capability. RESET:0x1"
          
         bitfld.long 0x00 2. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_2D ,Has 2D capability. RESET:0x1"
          
         bitfld.long 0x00 3. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_TMPLT ,Has template based pack and unpack capability. RESET:0x1"
          
         bitfld.long 0x00 4. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_TRIG ,Has trigger capability. RESET:0x1"
          
         bitfld.long 0x00 5. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_TRIGIN ,Has hardware trigger input ports. RESET:0x0"
          
         bitfld.long 0x00 6. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_TRIGOUT ,Has hardware trigger output port. RESET:0x0"
          
         bitfld.long 0x00 7. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_TRIGSEL ,Has selectable triggers. RESET:0x1"
          
         bitfld.long 0x00 8. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_CMDLINK ,Has command link list capability. RESET:0x1"
          
         bitfld.long 0x00 9. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_AUTO ,Has automatic reload and restart capability. RESET:0x1"
          
         bitfld.long 0x00 10. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_WRKREG ,Has internal register view capability. RESET:0x1"
          
         bitfld.long 0x00 11. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_STREAM ,Has stream interface support. RESET:0x0"
          
         bitfld.long 0x00 12. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_STREAMSEL ,Has selectable stream interfaces. RESET:0x0"
          
         hexmask.long 0x00 13.--17. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         bitfld.long 0x00 18. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_HAS_GPOSEL ,Has shared GPO ports between channels. RESET:0x0"
          
         hexmask.long 0x00 19.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_BUILDCFG1_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
tree.end

