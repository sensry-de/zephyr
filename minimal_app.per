group.long  0x1186++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXDQDLYTG3_R8_P0, Write DQ Delay (Timing Group 3). RESET:0x10"
         hexmask.long 0x00 0.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXDQDLYTG3_R8_P0_TXDQDLYTG3_R8_P0 ,Write DQ Delay (Timing Group 3). Trained to center the delay between the write DQ to the write DQS.  - Tx DQ Delay ( 9 bits, includes 3b coarse and 6b fine delays); (For Timing Group 3)  - TxDqDlyTg3[8:6] is the coarse delay, ie one unit of delay is 1 UI.  - TxDqDlyTg3[4:0] is the fine (fractional UI) delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - TxDqDlyTg3[5] is reserved.  - Register Block Offset Address 0x0C3 controls the lane0 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x1C3 controls the lane1 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x2C3 controls the lane2 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x3C3 controls the lane3 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x4C3 controls the lane4 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x5C3 controls the lane5 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x6C3 controls the lane6 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x7C3 controls the lane7 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x8C3 controls the lane[DMDBI] write DQ timing. (For Timing Group 3) Note: These Registers are replicated per pstate.  Note: Timing Group 3 = RANK3. RESET:0x10"
          
tree.end
    

tree "LPDDR4_PUB__DWC_DDRPHYA_MASTER0_P0"
base e:0x42040000
width 80.
group.long  0x0++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_RXFIFOINIT, This Register enables overrides of the PHY RXDATAFIFO pointers. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_RXFIFOINIT_RXFIFOINITPTR ,Setting this bit will reset the PHY RXDATAFIFO read and write pointers. This bit must be Cleared to return to normal operation. This is not required in normal operation, but can be used instead of a dfi_ctrlupdate (for controllers that don't support ctrlupdate) RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_RXFIFOINIT_INHIBITRXFIFORD ,This field is reserved for training FW use. Setting this inhibits reads of the PHYRXDATAFIFO. RESET:0x0"
          
group.long  0x2++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_FORCECLKDISABLE, Clock gating control RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_FORCECLKDISABLE_FORCECLKDISABLE ,This CSR forces the gating of MEMCLKs driven from the PHY - ForceClkDisable[0] - controls CLK_[H/L]0 - ForceClkDisable[1] - controls CLK_[H/L]1 (if present) - ForceClkDisable[2] - controls CLK_[H/L]2 (if present) - ForceClkDisable[3] - controls CLK_[H/L]3 (if present) RESET:0x0"
          
group.long  0x4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CLOCKINGCTRL, This register is dynamically written by PHY Initialization Engine during frequency changes and should not be written by the user. RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CLOCKINGCTRL_RFU_CLOCKINGCTRL ,None RESET:0x0"
          
group.long  0x6++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_FORCEINTERNALUPDATE, This Register used by Training Firmware to force an internal PHY Update Event. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_FORCEINTERNALUPDATE_FORCEINTERNALUPDATE ,This Register is used by Training Firmware to force an internal PHY Update Event. Optionally can be used by System Software to issue a PHY update Event. The register may be written to 1'b1 only when all of the following are true:  - The DFI interface is offline.  - The Training Hardware is sending only DES and all transactions have retired. Additionally, this Register must stay asserted for at least 32 DFICLKs before clearing. Prematurely clearing this register may result in an incomplete update. RESET:0x0"
          
rgroup.long 0x8++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYCONFIG, Displays PHY Configuration RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYCONFIG_PHYCONFIGANIBS ,Returns the following value depending on the chosen define: - 0x3 if DWC_DDRPHY_NUM_ANIBS_3 - 0x6 if DWC_DDRPHY_NUM_ANIBS_6 - 0x8 if DWC_DDRPHY_NUM_ANIBS_8 - 0xA if DWC_DDRPHY_NUM_ANIBS_10 - 0xC if DWC_DDRPHY_NUM_ANIBS_12 RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYCONFIG_PHYCONFIGDBYTES ,Returns the following value depending on the chosen define: - 0x1 if DWC_DDRPHY_NUM_DBYTES_1 - 0x2 if DWC_DDRPHY_NUM_DBYTES_2 - 0x3 if DWC_DDRPHY_NUM_DBYTES_3 - 0x4 if DWC_DDRPHY_NUM_DBYTES_4 - 0x5 if DWC_DDRPHY_NUM_DBYTES_5 - 0x6 if DWC_DDRPHY_NUM_DBYTES_6 - 0x7 if DWC_DDRPHY_NUM_DBYTES_7 - 0x8 if DWC_DDRPHY_NUM_DBYTES_8 - 0x9 if DWC_DDRPHY_NUM_DBYTES_9 - 0xA if DWC_DDRPHY_NUM_DBYTES_10 RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYCONFIG_PHYCONFIGDFI ,Returns the following value depending on the define: - 0x1 if DWC_DDRPHY_DFI1_EXISTS is not defined - 0x2 if DWC_DDRPHY_DFI1_EXISTS is defined RESET:0x0"
          
group.long  0xa++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PGCR, PHY General Configuration Register(PGCR) RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PGCR_RXCLKRISEFALLMODE ,This register field controls independent training for RxClk_c and RxClk_t.  - 0: Independent training for RxClk_c and RxClk_t is disabled.  - 1: Independent training for RxClk_c and RxClk_t is enabled. Default Value is 0. RESET:0x0"
          
group.long  0xe++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL1, Control for Test Bumps RESET:0xb03"
         hexmask.long 0x00 0.--2. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL1_TESTMAJORMODE ,Selects the major mode of operation for the receiver. These modes are mutually exclusive. - 000 - reserved - 001 - reserved - 010 - reserved - 011 - setting for DDR4 systems to receive Alert_n - 100 - reserved for debug - 101 - reserved - 110 - reserved - 111 - reserved for debug RESET:0x3"
          
         bitfld.long 0x00 3. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL1_TESTBIASBYPASSEN ,Do not use, for debug only RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL1_TESTANALOGOUTCTRL ,Reserved and returns zero on reads. RESET:0x0"
          
         hexmask.long 0x00 8.--12. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL1_TESTGAINCURRADJ ,Adjust gain and current of analog observe RX amplifier stage at analog test point. Recommended mission mode default = 5'b01011 RESET:0xb"
          
         bitfld.long 0x00 13. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL1_TESTSELEXTERNALVREF ,Do not use, for debug only RESET:0x0"
          
         bitfld.long 0x00 14. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL1_TESTEXTVREFRANGE ,Setting this bit will extend the VREF DAC range for debug. MUST BE SET TO ZERO in mission mode when MemAlert is enabled RESET:0x0"
          
         bitfld.long 0x00 15. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL1_TESTPOWERGATEEN ,Do not use, for debug only RESET:0x0"
          
group.long  0x10++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALUCLKINFO_P0, Informs the impedance calibration engine about frequency of DfiClk RESET:0x320"
         hexmask.long 0x00 0.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALUCLKINFO_P0_CALUCLKTICKSPER1US ,Must be programmed to the number of DfiClks in 1us (rounded up), with minimum value of 24. - if (DfiClk < 24MHz) CalUclkInfo = 24 - else CalUclkInfo = (number of DfiClks in 1us) RESET:0x320"
          
group.long  0x14++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL, Control for Test Bumps RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL_TESTBUMPEN ,Field TestBumpEn[1:0] controls the output function of the signal BP_ALERT_N.  TestBumpEn Value on [BP_ALERT_N] | output  - 2'b00 high-z,  - 2'b01 Pllout-divided-by-2, works up to full data rate  - 2'b10 PllDigTst[1], works up to 400MHz  - 2'b11 PllDigTst[1], works up to 400MHz RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL_TESTBUMPTOGGLE ,This field controls the output function of the signal. Digital Observation Pin, if available in the configuration of the PHY.  - When set to 1'b0 -- the output will be tristated  - When set to 1'b1 -- the output will be selected by MtestMuxSel RESET:0x0"
          
         hexmask.long 0x00 3.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL_TESTBUMPDATASEL ,RVSD. RESET:0x0"
          
         bitfld.long 0x00 9. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TESTBUMPCNTRL_FORCEMTESTONALERT ,When set, causes the Digital Observation output pin to be driven onto BP_ALERT_N RESET:0x0"
          
group.long  0x16++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SEQ0BDLY0_P0, PHY Initialization Engine (PIE) Delay Register 0 RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SEQ0BDLY0_P0_SEQ0BDLY0_P0 ,PHY Initialization Engine (PIE) Delay Register 0. This register is available for selection by the NOP and WAIT instructions in the PIE for the delay value. Programmed by dwc_ddrphy_phyinit_I_loadPIEImage() to support frequency changes.  Programming Seq0BDLY[3,2,1,0] Registers:  - These registers are used to control various delays during PLL, DLL initialization.  - These registers should be programmed with the corresponding number of MEMCLK cycles representing a fixed amount of delay irrespective of DfiClk Frequency.  - When calculating the number of cycles to be programmed for each PState, it should be noted that the sequencer multiplies programmed values by a factor of 8 and values are round down to the closest integer.  Register | Required Delay | Programmed Value   - Seq0BDLY0 | 0.5us | ( 0.5us / MEMCLK period) / 8)  - Seq0BDLY1 | 1.0us | ( 1.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | (10.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | 64/4 if (MEMCLK Freq <= 400MHz)  - Seq0BDLY3 | - | 132/4 if (400MHz Freq < MEMCLK Freq <= 533MHz)  - Seq0BDLY3 | - | 176/4 if (MEMCLK Freq > 533MHz) RESET:0x0"
          
group.long  0x18++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SEQ0BDLY1_P0, PHY Initialization Engine (PIE) Delay Register 1 RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SEQ0BDLY1_P0_SEQ0BDLY1_P0 ,PHY Initialization Engine (PIE) Delay Register 1. This register is available for selection by the NOP and WAIT instructions in the PIE for the delay value. Programmed by dwc_ddrphy_phyinit_I_loadPIEImage() to support frequency changes.  Programming Seq0BDLY[3,2,1,0] Registers:  - These registers are used to control various delays during PLL, DLL initialization.  - These registers should be programmed with the corresponding number of MEMCLK cycles representing a fixed amount of delay irrespective of DfiClk Frequency.  - When calculating the number of cycles to be programmed for each PState, it should be noted that the sequencer multiplies programmed values by a factor of 8 and values are round down to the closest integer.  Register | Required Delay | Programmed Value   - Seq0BDLY0 | 0.5us | ( 0.5us / MEMCLK period) / 8)  - Seq0BDLY1 | 1.0us | ( 1.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | (10.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | 64/4 if (MEMCLK Freq <= 400MHz)  - Seq0BDLY3 | - | 132/4 if (400MHz Freq < MEMCLK Freq <= 533MHz)  - Seq0BDLY3 | - | 176/4 if (MEMCLK Freq > 533MHz) RESET:0x0"
          
group.long  0x1a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SEQ0BDLY2_P0, PHY Initialization Engine (PIE) Delay Register 2 RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SEQ0BDLY2_P0_SEQ0BDLY2_P0 ,PHY Initialization Engine (PIE) Delay Register 2. This register is available for selection by the NOP and WAIT instructions in the PIE for the delay value. Programmed by dwc_ddrphy_phyinit_I_loadPIEImage() to support frequency changes.  Programming Seq0BDLY[3,2,1,0] Registers:  - These registers are used to control various delays during PLL, DLL initialization.  - These registers should be programmed with the corresponding number of MEMCLK cycles representing a fixed amount of delay irrespective of DfiClk Frequency.  - When calculating the number of cycles to be programmed for each PState, it should be noted that the sequencer multiplies programmed values by a factor of 8 and values are round down to the closest integer.  Register | Required Delay | Programmed Value   - Seq0BDLY0 | 0.5us | ( 0.5us / MEMCLK period) / 8)  - Seq0BDLY1 | 1.0us | ( 1.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | (10.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | 64/4 if (MEMCLK Freq <= 400MHz)  - Seq0BDLY3 | - | 132/4 if (400MHz Freq < MEMCLK Freq <= 533MHz)  - Seq0BDLY3 | - | 176/4 if (MEMCLK Freq > 533MHz) RESET:0x0"
          
group.long  0x1c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SEQ0BDLY3_P0, PHY Initialization Engine (PIE) Delay Register 3 RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SEQ0BDLY3_P0_SEQ0BDLY3_P0 ,PHY Initialization Engine (PIE) Delay Register 3. This register is available for selection by the NOP and WAIT instructions in the PIE for the delay value. Programmed by dwc_ddrphy_phyinit_I_loadPIEImage() to support frequency changes.  Programming Seq0BDLY[3,2,1,0] Registers:  - These registers are used to control various delays during PLL, DLL initialization.  - These registers should be programmed with the corresponding number of MEMCLK cycles representing a fixed amount of delay irrespective of DfiClk Frequency.  - When calculating the number of cycles to be programmed for each PState, it should be noted that the sequencer multiplies programmed values by a factor of 8 and values are round down to the closest integer.  Register | Required Delay | Programmed Value   - Seq0BDLY0 | 0.5us | ( 0.5us / MEMCLK period) / 8)  - Seq0BDLY1 | 1.0us | ( 1.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | (10.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | 64/4 if (MEMCLK Freq <= 400MHz)  - Seq0BDLY3 | - | 132/4 if (400MHz Freq < MEMCLK Freq <= 533MHz)  - Seq0BDLY3 | - | 176/4 if (MEMCLK Freq > 533MHz) RESET:0x0"
          
rgroup.long 0x1e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYALERTSTATUS, This Read Only CSR represents the status of the ALERT_N pin to the PHY RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYALERTSTATUS_PHYALERT ,Current state of ALERT_N. RESET:0x0"
          
group.long  0x20++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PPTTRAINSETUP_P0, For LPDDR3/4 some tracking is required periodically using the DFI PHY MASTER interface. This register control the interval. Setting the register to 0 completely disables the PHY Master Interface. Programmed by dwc_ddrphy_phyinit_I_loadPIEImage() to support LPDDR3/LPDDR4 DRAM drift compensation. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PPTTRAINSETUP_P0_PHYMSTRTRAININTERVAL ,Bits 3:0 of this register specifies the time between the end of one training and the start of the next. Note that, to account for the delay to receive the acknowledge from the MC, the dfi_phymstr_req signal is asserted in advance so that the effective update (after acknowledge from the MC) occurs inside the interval defined by PhyMstrTrainInterval.  - 4'b0000 Disable PHY Master Interface  - 4'b0001 PHY MASTER Request Interval = 524288 MEMCLKs  - 4'b0010 PHY MASTER Request Interval = 1048576 MEMCLKs  - 4'b0011 PHY MASTER Request Interval = 2097152 MEMCLKs  - 4'b0100 PHY MASTER Request Interval = 4194304 MEMCLKs  - 4'b0101 PHY MASTER Request Interval = 8388608 MEMCLKs  - 4'b0110 PHY MASTER Request Interval = 16777216 MEMCLKs  - 4'b0111 PHY MASTER Request Interval = 33554432 MEMCLKs  - 4'b1000 PHY MASTER Request Interval = 67108864 MEMCLKs  - 4'b1001 PHY MASTER Request Interval = 134217728 MEMCLKs  - 4'b1010 PHY MASTER Request Interval = 268435456 MEMCLKs  - 4'b1011 - 4'b1111 PHY MASTER Request Interval = undefined RESET:0x0"
          
         hexmask.long 0x00 4.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PPTTRAINSETUP_P0_PHYMSTRMAXREQTOACK ,The value in bits 6:4 of this register specify the max time from tdfi_phymstr_req asserted to tdfi_phymstr_ack asserted. If the request is not acknowledged by this time, dfi_error will be asserted.  - 3'b000 Disable PHY Master Interface  - 3'b001 set tPHYMSTR_resp. = 512 MEMCLKs  - 3'b010 set tPHYMSTR_resp. = 1024 MEMCLKs  - 3'b011 set tPHYMSTR_resp. = 2048 MEMCLKs  - 3'b100 set tPHYMSTR_resp. = 4096 MEMCLKs  - 3'b101 set tPHYMSTR_resp. = 8192 MEMCLKs  - 3'b110 set tPHYMSTR_resp. = 32768 MEMCLKs  - 3'b111 set tPHYMSTR_resp. = undefined  Note: The above are nominal values. The actual values are reduced by (2 + (DWC_DDRPHY_PIPE_DFI_MISC * MEMCLK/DfiCtlClk)) * 2  Note: This signal interacts with dfi_phyupd_req. See Section Collisions Between PHY Update and DFI LP of the PUB Databook. RESET:0x0"
          
group.long  0x22++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PPTTRAINSETUP2_P0, Programmed by PHY training firmware to support LPDDR3/LPDDR4 DRAM drift compensation. RESET:0x2"
         hexmask.long 0x00 0.--2. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PPTTRAINSETUP2_P0_RFU_PPTTRAINSETUP2_P0 ,None RESET:0x2"
          
group.long  0x24++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ATESTMODE, Controls for Address Command Loopback. This CSR is written by ATE firmware. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ATESTMODE_ATESTPRBSEN ,Enables loopback PRBS7 testing of all the. DDR output pins in this chiplet. The asserting edge resets all the individual. TestPrbsErrCnt & consequently TestPrbsErr; there is no other reset for the TestPrbsErrCnt. RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ATESTMODE_ATESTCLKEN ,Obsolete. Unused. RESET:0x0"
          
         hexmask.long 0x00 2.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ATESTMODE_ATESTMODESEL ,Master Mode select for ATest (Loopback) - 000 - Mission mode, all ATest disabled, loopback receivers powered down - 001 - External Loopback mode [Single data rate pattern - dfi_cas sent to all lanes] - 010 - Internal Loopback mode [Single data rate pattern] - 011 - Internal Loopback mode [Double data rate pattern] - 100 - External Loopback mode [Single data rate pattern - corresponding DFI signal sent to each lane] RESET:0x0"
          
rgroup.long 0x28++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXCALBINP, TX P Impedance Calibration observation RESET:0x0"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXCALBINP_TXCALBINP ,This csr holds the binary result of the 31 bit thermometer pull-up code. RESET:0x0"
          
rgroup.long 0x2a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXCALBINN, TX N Impedance Calibration observation RESET:0x0"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXCALBINN_TXCALBINN ,This csr holds the binary result of the 31 bit thermometer pull-down code. RESET:0x0"
          
group.long  0x2c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXCALPOVR, Override values for Register TxCalBinP. RESET:0x0"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXCALPOVR_TXCALBINPOVRVAL ,The binary value which can override the Register TxCalBinP calibrator results if Register TxCalBinPOvrEn is set. RESET:0x0"
          
         bitfld.long 0x00 5. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXCALPOVR_TXCALBINPOVREN ,This field is programmable as follows: - 1: use the override value present in Register TxCalBinPOvrVal - 0: don't. RESET:0x0"
          
group.long  0x2e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXCALNOVR, Override values for Register TxCalBinN. RESET:0x0"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXCALNOVR_TXCALBINNOVRVAL ,The binary value which can override the Register TxCalBinN calibrator results if Register TxCalBinPOvrEn is set. RESET:0x0"
          
         bitfld.long 0x00 5. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXCALNOVR_TXCALBINNOVREN ,This field is programmable as follows: - 1: use the override value present in Register TxCalBinNOvrVal - 0: don't. RESET:0x0"
          
group.long  0x30++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIMODE, Each bit enables the Phy Update, Phy Master Update, and low power logic for the respective interfaces. There are 3 valid configurations:  - 'b101: DFI0 is enabled and controls the entire PHY  - 'b001: DFI0 controls 1/2 the PHY, external logic ties off inputs to DFI1  - 'b011: DFI0 and DFI1 are active and are separately controlled. This field interacts with the DWC_DDRPHY_DFI1_EXISTS define as follows:  - DfiMode=001, DWC_DDRPHY_DFI1_EXISTS defined: ANIBs/DBYTEs assigned to DFI1 are idle  - DfiMode=011, DWC_DDRPHY_DFI1_EXISTS defined: DFI0 controls 1/2 PHY (CH. A), DFI1 controls 1/2 PHY (CH. B)  - DfiMode=101, DWC_DDRPHY_DFI1_EXISTS defined: ANIBs/DBYTEs assigned to DFI1 are controlled by DFI0. Only DFI0 sideband signals are active.  - DfiMode=001, DWC_DDRPHY_DFI1_EXISTS undefined: DFI0 controls entire PHY  - DfiMode=011, DWC_DDRPHY_DFI1_EXISTS undefined: illegal  - DfiMode=101, DWC_DDRPHY_DFI1_EXISTS undefined: not applicable RESET:0x5"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIMODE_DFI0ENABLE ,Enables operation for the PHY logic associated with DFI0 RESET:0x1"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIMODE_DFI1ENABLE ,Enables operation for the PHY logic associated with DFI1 RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIMODE_DFI1OVERRIDE ,DFI0 is used to control the PHY logic associated with both DFI0 and DFI1 RESET:0x1"
          
group.long  0x32++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TRISTATEMODECA_P0, This register is used to control the PHY Dynamic Address/Command Tristate Feature, and the stopped MEMCLK state. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TRISTATEMODECA_P0_DISDYNADRTRI ,When DisDynAdrTri=1, Dynamic Tristating is disabled. Dynamic Tristating is on by default. Dynamic Tristating should be disabled (DisDynAdrTri=1) for these modes:  - DR3/2T if the controller cannot follow the 2T PHY tristate protocol.  - DDR4/2T/2N if the controller cannot follow the 2T PHY tristate protocol.  - LPDDR4 When DisDynAdrTri=0 (default),  - In DDR4 mode, The following SDRAM pins can be dynamically tristated: A,BA,BG,ACT_n  - In LPDDR3 mode, The following SDRAM pins can be dynamically tristated: CA[*]  - In 1T mode, the PHY will tristate the relevant pins when all ranks are DESelected  - In 2T mode (or geardown), the PHY will tristate the relevant pins when:  -- DDR3 -- All ranks DESelected (all CS_L==1) AND [RAS_n,CAS_n,WE_n,BA0] = [1,1,1,0]  -- DDR4 -- All ranks DESelected (all CS_L==1) AND [RAS_n,CAS_n,WE_n,BA0,ACT_n] = [1,1,1,0,1]  - When in this mode, the controller should avoid sending the above patterns with any rank selected. [e.g. NOPs sent by the controller should have BA0 set to a non-zero value] RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TRISTATEMODECA_P0_DDR2TMODE ,Must be set to 1 for Dynamic Tristate to work when CA bus is 2T or Geardown mode. This CSR bit has no effect when DisDynAdrTri==1 RESET:0x0"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TRISTATEMODECA_P0_CKDISVAL ,The PHY provides 4 memory clocks, n=0..3.  - When the toggling of memory clock CK_t[n] is disabled with dfi_clk_disable[n]=1, the memory clock CK_t[n] is driven with Register CkDisVal[1].  - When the toggling of memory clock CK_c[n] is disabled with dfi_clk_disable[n]=1, the memory clock CK_c[n] is driven with ~(Register CkDisVal[0]) (ie inverted).  Note that the non-toggling differential memory clock [CK_t[n],CK_c[n]] may be driven with any combination, LL,LH,HL,HH; the default [CK_t[n],CK_c[n]]=LH. RESET:0x0"
          
group.long  0x34++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MTESTMUXSEL, Digital Observation Pin control RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MTESTMUXSEL_MTESTMUXSEL ,Controls for the 64-1 mux for asynchronous data to the Digital Observation Pin.  - 6'h0 --> Drive 0 from this chiplet (allows flat 'OR' of pass-through information)  - 6'h01:1f --> Select local data from AC/DBYTE/MASTER macro  - 6'h20 --> Reserved (Drive 0 from macro into mux; Drive 0 from PUB synth logic path into mux)  - 6'h21:3f --> Select local data from PUB AC/DBYTE/MASTER synthesized logic Note: See PUB documentation for how, or if, the Digital Observation Pin is mapped to a physical bump in this configuration. RESET:0x0"
          
group.long  0x36++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MTESTPGMINFO, Digital Observation Pin program info for debug RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MTESTPGMINFO_MTESTPGMINFO ,The value of this csr may be driven onto the Digital Observation Pin. It has no other hardware effect. RESET:0x0"
          
group.long  0x38++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DYNPWRDNUP, Note : This CSR is written by PHY Initialization Engine (PIE) and the data in here will be overwritten. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DYNPWRDNUP_DYNPOWERDOWN ,This field is programmable as follows: - 1: analog circuitry (voltage dacs, bias gen) is turned off. - 0: normal operation. RESET:0x0"
          
group.long  0x3a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PMIENABLE, This register is dynamically written by PHY Initialization Engine during frequency changes and should not be written by the user. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PMIENABLE_PMIENABLE ,This register is dynamically written by PHY Initialization Engine during frequency changes and should not be written by the user. RESET:0x0"
          
group.long  0x3c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYTID, PHY Technology ID Register RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYTID_PHYTID ,This register is a placeholder to store technology-specific information RESET:0x0"
          
group.long  0x40++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTMRL_P0, HWT MaxReadLatency. RESET:0x6"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTMRL_P0_HWTMRL_P0 ,This MASTER copy of MRL is used by the PHY training firmware only. RESET:0x6"
          
group.long  0x42++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIPHYUPD, This Register is used to determine the DFI Update request interval and the maximum update response time.  Note: DFIPHYUPDCNT and DFIPHYUPDRESP must be chosen such that DFIPHYUPDCNT > DFIPHYUPDRESP RESET:0xff07"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIPHYUPD_DFIPHYUPDCNT ,This controls the interval between the end of a phyupdate transaction and a subsequent request.  - 4'b0000 - Disable timer-based Phy Update when DFIPHYUPDMODE==1'b0  - 4'b0001 - 16K MEMCLKs minus nMEMCLKs_phyupd_resp  - 4'b0011 - 32K MEMCLKs minus nMEMCLKs_phyupd_resp  - 4'b0111 - 64K MEMCLKs minus nMEMCLKs_phyupd_resp  - 4'b1111 - 128K MEMCLKs minus nMEMCLKs_phyupd_resp Any code not enumerated above is RSVD and should not be set. RESET:0x7"
          
         hexmask.long 0x00 4.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIPHYUPD_DFIPHYUPDRESP ,Enforces the t_phyupd_resp time, the maximum time that is allowed to controller to respond to the request for a PHY update. A dfi_error will be signaled if there is no acknowledgement of the update request within nMEMCLKs_phyupd_resp.  - 3'b000: nMEMCLKs_phyupd_resp= 1024 MEMCLKs, default value  - 3'b001: nMEMCLKs_phyupd_resp= 2048 MEMCLKs  - 3'b010: nMEMCLKs_phyupd_resp= 4096 MEMCLKs  - 3'b011: nMEMCLKs_phyupd_resp= 8192 MEMCLKs, [not allowed in LPDDR3, LPDDR4 modes] Note: The above are nominal values. The actual values are reduced by (2 + (DWC_DDRPHY_PIPE_DFI_MISC * MEMCLK/DfiCtlClk)) * 2  Note: Any code not enumerated above is RSVD and should not be set.  Note: This signal interacts with dfi_phymstr_req. See Section Collisions Between PHY Update and DFI LP of the PUB Databook. RESET:0x0"
          
         bitfld.long 0x00 7. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIPHYUPD_DFIPHYUPDMODE ,This field is programmable as follows: - 1'b0: [Recommended/Default] deterministic timer-based Phy Update Requests; enables multi-channel/multi-phy lockstep operation. - 1'b1: Reserved RESET:0x0"
          
         hexmask.long 0x00 8.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIPHYUPD_DFIPHYUPDTHRESHOLD ,Reserved RESET:0xf"
          
         hexmask.long 0x00 12.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIPHYUPD_DFIPHYUPDINTTHRESHOLD ,Reserved RESET:0xf"
          
group.long  0x44++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PDAMRSWRITEMODE, Controls the write DQ generation for Per-Dram-Addressing of MRS RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PDAMRSWRITEMODE_PDAMRSWRITEMODE ,Controls the write DQ generation per the timing requirements on the DQ signals used for Per-Dram-Addressing mode of MRS commands. When asserted, the DQ are driven for an additional UI before the logical burst and for an additional UI after the logical burst. The early UI has the value of first logical UI, and the late UI has the value of the last logical UI. The timing of the logical burst is unchanged; no modification to csr TxDqDly is required or performed. Strongly recommended to be cleared after completing the MRS that clears MR3 A4 and for mission-mode writes, else required bubbles will be larger and the power consumed will be greater. See JEDEC MR3 A4, Per DRAM Addresssability. RESET:0x0"
          
group.long  0x46++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIGEARDOWNCTL, Controls whether dfi_geardown_en will cause CS and CKE timing to change. RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIGEARDOWNCTL_DFIGEARDOWNCTL ,DFIGEARDOWNCTL[0] controls whether dfi_geardown_en will cause chip-select (CS) timing to change.  - 0 - CS timing will not be dynamically modified wtih dfi_geardown_en  - 1 - CS will be delayed by an additional 1UI dynamically when dfi_geardown_en==1  Note, this CSR must be set to zero if the PHY is not in DDR4 Mode. DFIGEARDOWNCTL[1] controls whether dfi_geardown_en will cause clock-enable (CKE) timing to change.  - 0 - CKE timing will not be dynamically modified with dfi_geardown_en  - 1 - CKE will be delayed by an additional 1UI dynamically when dfi_geardown_en==1  Note, this CSR must be set to zero if the PHY is not in DDR4 Mode RESET:0x0"
          
group.long  0x48++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DQSPREAMBLECONTROL_P0, For improved robustness in operating with DRAM timing drift, this register provides controls for the width of the write DQS preamble and postamble, and controls for the anticipated width of DQS preamble for reads. RESET:0x8"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DQSPREAMBLECONTROL_P0_TWOTCKRXDQSPRE ,Widens the RxDqsEn window to allow larger drift in the incoming read DQS to take advantage of the larger/wider preamble generated by the DRAMSs when the D4 DRAMS are configured with DDR4 MR4 A11 Read Preamble=1 for causing a 2nCK read preamble. For LPDDR4, set to 1 for static read preamble, set to 0 for toggling read preamble.  Note the nominal trained-to-center point will be earlier relative to the first strobing edge of DQS than when not in this mode. RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DQSPREAMBLECONTROL_P0_TWOTCKTXDQSPRE ,For LPDDR4, all write operations are 2nCK such that this control must be set to 1. RESET:0x0"
          
         hexmask.long 0x00 2.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DQSPREAMBLECONTROL_P0_POSITIONDFEINIT ,For DDR4 phy only when receive DFE is enabled.  - PositionDfeInit[2] is reserved  - PositionDfeInit[1]=1 causes DfeInit to be asserted at the nominal time  - PositionDfeInit[0] is reserved PositionDfeInit=3'b010 is the nominal, recommended value for leading edge used by receiver, other values are reserved. RESET:0x2"
          
         bitfld.long 0x00 5. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DQSPREAMBLECONTROL_P0_LP4TGLTWOTCKTXDQSPRE ,Used in LPDDR4 mode to modify the early preamble when Register TwoTckTxDqsPre=1 - 0: level first-memclk preamble - 1: toggling first-memclk preamble RESET:0x0"
          
         bitfld.long 0x00 6. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DQSPREAMBLECONTROL_P0_LP4POSTAMBLEEXT ,In LPDDR4 mode must be set to extend the write postamble. - 0: half-memclk postamble, as in D4 - 1: one-and-one-half-memclk postamble; see LPDDR4 Spec MR3, OP[1] WR PST, vendor-specific function. RESET:0x0"
          
         bitfld.long 0x00 7. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DQSPREAMBLECONTROL_P0_LP4STTCPREBRIDGERXEN ,Used in LPDDR4 static-preamble mode to bridge the RxEn between two reads to the same timing group when the bubble is 1 memclk. LPDDR4 static-preamble mode is set in the DRAMs with MR1, OP[3]=0. RESET:0x0"
          
         bitfld.long 0x00 8. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DQSPREAMBLECONTROL_P0_WDQSEXTENSION ,When set, DQS_T and DQS_C will be driven differentially to 0 and 1, respectively, before and after a write burst, except during a memory read transaction. See DesignWare Cores LPDDR4 MultiPHY: WDQS Extension Application Note. Use of WDQSEXTENSION requires POdtTailWidth=3 and POdtStartDelay=00 RESET:0x0"
          
group.long  0x4a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MASTERX4CONFIG, DBYTE module controls to select X4 Dram device mode RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MASTERX4CONFIG_X4TG ,Set to 1 if this Timing Group/Rank is x4 (as opposed to x8) memory.  - XXX[1|0] : TxReqDest/RxReqDest 0 X4/X8.  - XX[1|0]X : TxReqDest/RxReqDest 1 X4/X8.  - X[1|0]XX : TxReqDest/RxReqDest 2 X4/X8.  - [1|0]XXX : TxReqDest/RxReqDest 3 X4/X8.  This CSR must be written before dfi_init_start is asserted. RESET:0x0"
          
group.long  0x4c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_WRLEVBITS, Write level feedback DQ observability selection RESET:0x98"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_WRLEVBITS_WRLEVFORDQSL ,Indicates which DQ bit is used for Write Levelization. - 0000 - use DQ0 -  .. - 0111 - use DQ7 - 1000 - use |DQ[3:0] - 1001 - use |DQ[7:4] - 1010 - use |DQ[7:0] RESET:0x8"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_WRLEVBITS_WRLEVFORDQSU ,Indicates which DQ bit is used for Write Levelization. - 0000 - use DQ0 -  .. - 0111 - use DQ7 - 1000 - use |DQ[3:0] - 1001 - use |DQ[7:4] - 1010 - use |DQ[7:0] RESET:0x9"
          
group.long  0x4e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ENABLECSMULTICAST, In DDR4 Mode , this controls whether CS_N[3:2] should be multicast on CID[1:0] RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ENABLECSMULTICAST_ENABLECSMULTICAST ,In DDR4 Mode , this controls whether CS_N[3:2] should be multicast on CID[1:0] - 0 - Do not override pins corresponding to cid[1:0] (dfi_cid[1:0] will connect to the pads) - 1 - Override pins corresponding to cid[1:0] with dfi_cs[3:2]. (cs[3:2] will be multicast on cs[3:2] and cid[1:0]) RESET:0x0"
          
group.long  0x50++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTLPCSMULTICAST, Reserved. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTLPCSMULTICAST_HWTLPCSMULTICAST ,Reserved. RESET:0x0"
          
group.long  0x58++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACX4ANIBDIS, Disable for unused ACX Nibbles RESET:0x0"
         hexmask.long 0x00 0.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACX4ANIBDIS_ACX4ANIBDIS ,When a bit is set, the corresponding ACX nibble is disabled (specifically, the I/O OE is disabled, as is the Dfi-side FIFO clock RESET:0x0"
          
group.long  0x5a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DMIPINPRESENT_P0, This Register is used to instruct the PHY whether to enable the Read-DBI function on Lane8 of each DBYTE. Only the LPDDR4 and DDR4 Protocols support the Read-DBI feature. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DMIPINPRESENT_P0_RDDBIENABLED ,This bit must be set to 1'b1 if Read-DBI is enabled in a connected DDR4 or LPDDR4 device. If set, the following DRAM MR should also be set [DDR4.MR5.A12=1 or LPDDR4.MR3.OP[7]=1] RESET:0x0"
          
group.long  0x5c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ARDPTRINITVAL_P0, Address/Command FIFO ReadPointer Initial Value RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ARDPTRINITVAL_P0_ARDPTRINITVAL_P0 ,This is the initial Pointer Offset for the free-running FIFOs in the DBYTE and ACX4 hardips. The units of this register are in UI. The pointer separation should be chosen to compensate for all sources of skew and drift of the PHY DFICLK and PCLK networks. See 'ARdPtrInitVal Impacts From Construction Skews' of the PUB databook. This CSR must be programmed in Step C of the PHY Initialization sequence RESET:0x0"
          
