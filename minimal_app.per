    line.long 0x00 "DISP_DPHY_DPHY_PLL_CTRL, Register for controlling the D-PHY internal PLL RESET:0x0"
         bitfld.long 0x00 0. " DISP_DPHY_DPHY_PLL_CTRL_PLL_SHADOW_CONTROL ,Selection of PLL configuration mechanism. 0: SoC control and shadow registers  1: D-PHY control RESET:0x0"
          
