         hexmask.long 0x00 2.--31. 1. " DECTSPI_MST_RDMA_STARTADDR_DB_VALUE ,None RESET:0x0"
          
group.long  0xc++0x3
    line.long 0x00 "DECTSPI_MST_RDMA_MAXSIZE, the size in bytes of the buffer allocated for DMA operations RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DECTSPI_MST_RDMA_MAXSIZE_VALUE ,None RESET:0x0"
          
group.long  0x10++0x3
    line.long 0x00 "DECTSPI_MST_RDMA_SIZE1, SIZE1 interrupt triggers in case size1 byte have been read from the buffer / can be used for double buffering RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DECTSPI_MST_RDMA_SIZE1_VALUE ,None RESET:0x0"
          
rgroup.long 0x14++0x3
    line.long 0x00 "DECTSPI_MST_RDMA_CURR_ADDR, the current address of the DMA read pointer RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DECTSPI_MST_RDMA_CURR_ADDR_VALUE ,None RESET:0x0"
          
group.long  0x18++0x3
    line.long 0x00 "DECTSPI_MST_RDMA_IRQ_STATUS, interrupt status bits reflect the occurrence of an event / whether these bits generate an interrupt is contolled via irq_status_enable RESET:0x0"
         bitfld.long 0x00 0. " DECTSPI_MST_RDMA_IRQ_STATUS_MAXSIZE ,Buffer is filled to MAXSIZE RESET:0x0"
          
         bitfld.long 0x00 1. " DECTSPI_MST_RDMA_IRQ_STATUS_SIZE1 ,Buffer is filled to size1 RESET:0x0"
          
         bitfld.long 0x00 2. " DECTSPI_MST_RDMA_IRQ_STATUS_BERR ,Bus error: system bus returns an error response. Use curr_addr as a hint where the bus error occurred RESET:0x0"
          
         bitfld.long 0x00 3. " DECTSPI_MST_RDMA_IRQ_STATUS_UNFL ,Underflow: data towards AXI-4S is consumed faster than the DMA is able to read data from the bus system in time. NOTE: This can also be detected from the interface axi wrappers (e.g. spi_axi4s_wrap) RESET:0x0"
          
group.long  0x1c++0x3
    line.long 0x00 "DECTSPI_MST_RDMA_IRQ_STATUS_ENABLE, Enables the selected events to generate interrupts on the interrupt line RESET:0x0"
         bitfld.long 0x00 0. " DECTSPI_MST_RDMA_IRQ_STATUS_ENABLE_MAXSIZE ,Enable interrupt maxsize RESET:0x0"
          
         bitfld.long 0x00 1. " DECTSPI_MST_RDMA_IRQ_STATUS_ENABLE_SIZE1 ,Enable interrupt size1 RESET:0x0"
          
         bitfld.long 0x00 2. " DECTSPI_MST_RDMA_IRQ_STATUS_ENABLE_BERR ,Enable interrupt berr RESET:0x0"
          
