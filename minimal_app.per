tree "LPDDR4_PUB__DWC_DDRPHYA_APBONLY0"
base e:0x421a0000
width 80.
group.long  0x0++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_MICROCONTMUXSEL, PMU Config Mux Select RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_MICROCONTMUXSEL_MICROCONTMUXSEL ,This register controls access to the PHY configuration registers. - 1 : MicroController/PHY Init Engine has control of csr bus. - 0 : Access to CSR bus available via APB interface, according to the APB Interface Access Rules described in the PUB databook RESET:0x0"
          
rgroup.long 0x8++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_UCTSHADOWREGS, This is used for the mailbox protocol between the firmware and the system. See section 3.4.1 of the training firmware AppNote for details on the protocol. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_UCTSHADOWREGS_UCTWRITEPROTSHADOW ,When set to 0, the PMU has a message for the user RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_UCTSHADOWREGS_UCTDATWRITEPROTSHADOW ,Reserved for future use. RESET:0x0"
          
group.long  0x60++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_DCTWRITEONLY, Reserved for future use. RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_DCTWRITEONLY_DCTWRITEONLY ,Reserved for future use. RESET:0x0"
          
group.long  0x62++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_DCTWRITEPROT, DCT downstream mailbox protocol CSR. RESET:0x1"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_DCTWRITEPROT_DCTWRITEPROT ,By setting this register to 0, the user acknowledges the receipt of the message. RESET:0x1"
          
rgroup.long 0x64++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_UCTWRITEONLYSHADOW, Read-only view of the csr UctDatWriteOnly RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_UCTWRITEONLYSHADOW_UCTWRITEONLYSHADOW ,Used to pass the message ID for major messages. Also used to pass the lower 16 bits for streaming messages. RESET:0x0"
          
rgroup.long 0x68++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_UCTDATWRITEONLYSHADOW, Read-only view of the csr UctDatWriteOnly RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_UCTDATWRITEONLYSHADOW_UCTDATWRITEONLYSHADOW ,Used to pass the upper 16 bits for streaming messages. Not used in passing major messages. RESET:0x0"
          
group.long  0x6a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_NEVERGATECSRCLOCK, Reserved for PHY training firmware use. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_NEVERGATECSRCLOCK_NEVERGATECSRCLOCK ,Reserved for PHY training firmware use. RESET:0x0"
          
group.long  0x6e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_DFICFGRDDATAVALIDTICKS, Number of DfiClk ticks required for valid csr Rd Data. RESET:0x6"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_DFICFGRDDATAVALIDTICKS_DFICFGRDDATAVALIDTICKS ,Roundtrip delay of a register read access. This value must not be changed from its reset value. RESET:0x6"
          
group.long  0x132++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_MICRORESET, Controls reset and clock shutdown on the local microcontroller. RESET:0x1"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_MICRORESET_STALLTOMICRO ,This field is programmable as follows:  - Set this bit to stall the microcontroller by hardware.  - Clear this bit to allow the microcontroller to continue executing from its current   program counter location. Typically, this bit is used at power up to hold the program counter at the boot vector while BIOS loads the microcontroller program code. While stalled, the microcontroller clocks are gated off for power reduction. RESET:0x1"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_MICRORESET_TESTWAKEUP ,Reserved. Must always be set to 0. RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_MICRORESET_RSVDMICRO ,RSVD RESET:0x0"
          
         bitfld.long 0x00 3. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_MICRORESET_RESETTOMICRO ,This field is programmable as follows:  - Set this bit to apply synchronous reset to the microcontroller.  - Clear this bit to release reset to the microcontroller. Note: This reset initializes the program counter to begin execution from the boot vector. This reset also clears the interrupt sticky bits. RESET:0x0"
          
group.long  0x1ce++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_SEQUENCEROVERRIDE, Reserved for PHY training firmware use. RESET:0x80"
         hexmask.long 0x00 0.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_SEQUENCEROVERRIDE_RFU_SEQUENCEROVERRIDE ,None RESET:0x80"
          
rgroup.long 0x1f4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_DFIINITCOMPLETESHADOW, dfi_init_complete - Controller Read-only Shadow RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_APBONLY0_DFIINITCOMPLETESHADOW_DFIINITCOMPLETESHADOW ,This csr presents a read-only view (a shadow) of the Register DfiInitComplete which is used by the sequencer to control the state of dfi_init_complete. The value in this Register is not affected by the BlockSeq0BAck field of the SequencerOverride register. While the Register MicroContMuxSel is set, access to this Shadow register will not steal config bus bandwidth from the micro controller. That is polling won't have a performance penalty. RESET:0x0"
          
tree.end

tree "LPDDR4_PUB__DWC_DDRPHYA_ANIB0_P1"
base e:0x42200000
width 80.
group.long  0x100++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P1_ATXDLY_P1, Address/Command Delay, per pstate. RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P1_ATXDLY_P1_ATXDLY_P1 ,Trained for LPDDR3/4 to generate timed address and command signals to the DRAMs, per ACX4. For DDR3/DDR4, it is recommended that address and command ACX4 have it ATxDly=0x00 The four signals generated by an ACX4 will have common timing.  - ATxDly[6] is the coarse delay, ie one unit of delay is 1 UI.  - ATxDly[5] is reserved.  - ATxDly[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32. The target ACX4 used for memory clock generation, must have its ATxDly configured to 0x00. RESET:0x0"
          
tree.end

tree "LPDDR4_PUB__DWC_DDRPHYA_ANIB1_P1"
