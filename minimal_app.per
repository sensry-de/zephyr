         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DB9LCDLCALPHDETOUT_DB9LCDLCALPHDETOUT ,Reserved for PHY training firmware use. RESET:0x0"
          
group.long  0x74++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DBYTEDLLMODECNTRL, DLL Mode control Register in DBYTE modules RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DBYTEDLLMODECNTRL_DLLRXPREAMBLEMODE ,Must be set to 1 if read DQS preamble contains a toggle, for example DDR4 or LPDDR4 read toggling preamble mode. In LPDDR4, the PHY Initialization Engine will always set this bit field to 0x1 for correct operation of the retraining algorithm. RESET:0x0"
          
group.long  0x76++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DBYTERXENTRAIN, Reserved for PHY training firmware use. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DBYTERXENTRAIN_RFU_DBYTERXENTRAIN ,None RESET:0x0"
          
rgroup.long 0x7e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ANLCDLCALPHDETOUT, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ANLCDLCALPHDETOUT_ANLCDLCALPHDETOUT ,Reserved for PHY training firmware use. RESET:0x0"
          
group.long  0x8a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALOFFSETS, A safety register that can be used to correct systematic offsets from each calibration stage. It is not recommended to change these values from the default zero value. RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALOFFSETS_CALCMPR5OFFSET ,This value adjusts the offset-compensated DAC code for the cmpana circuit at VRef == 0.5 * VDDQ. RESET:0x0"
          
         hexmask.long 0x00 6.--9. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALOFFSETS_CALDRVPDTHOFFSET ,This value adjusts the driver pull-down calibration code RESET:0x0"
          
         hexmask.long 0x00 10.--13. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALOFFSETS_CALDRVPUTHOFFSET ,This value adjusts the driver pull-up calibration code RESET:0x0"
          
group.long  0x8e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SARINITVALS, This register specifies the initial value for the compensation engine. It is not recommended to change the default value. RESET:0x127"
         hexmask.long 0x00 0.--2. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SARINITVALS_SARINITOFFSET05 ,Specify the SAR starting value for OFFSET05 calibration. This is an 8 bit wide target. RESET:0x7"
          
         hexmask.long 0x00 3.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SARINITVALS_SARINITNINT ,Specify the SAR starting value for NINT calibration. This is a 5 bit wide target. RESET:0x4"
          
         hexmask.long 0x00 6.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_SARINITVALS_SARINITPEXT ,Specify the SAR starting value for PEXT calibration. This is a 5 bit wide target. RESET:0x4"
          
group.long  0x92++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALPEXTOVR, Impedance Calibration PExt Override control RESET:0x0"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALPEXTOVR_CALPEXTOVR ,If the CSR CalPExtDis is set then the value provided here by software will be used instead of the automatically generated value which is visible via CSR CalPExt. This CSR may only be written when the calibrator is not running. RESET:0x0"
          
group.long  0x94++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPR5OVR, Impedance Calibration Cmpr 50 control RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPR5OVR_CALCMPR5OVR ,If the CSR CalCmpr5Dis is set then the value provided here by software will be used instead of the automatically generated value which is visible via CSR CalCmpr5. This CSR may only be written when the calibrator is not running. RESET:0x0"
          
group.long  0x96++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALNINTOVR, Impedance Calibration NInt Override control RESET:0x0"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALNINTOVR_CALNINTOVR ,If the CSR CalNIntDis is set then the value provided here by software will be used instead of the automatically generated value which is visible via CSR CalNInt. This CSR may only be written when the calibrator is not running. RESET:0x0"
          
group.long  0xa0++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALDRVSTR0, For a given calibration target these CSRs specify the drive strength(s) to be used. There is no encoding.  Note: The strength selected should match the external resistor value used for calibration. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALDRVSTR0_CALDRVSTRPD50 ,This field is programmable as follows: - 3..15 = Reserved for future. - 2 - 40.0R - 1 - 120.0R - 0 - 240.0R (Default) RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALDRVSTR0_CALDRVSTRPU50 ,This field is programmable as follows: - 3..15 = Reserved for future. - 2 - 40.0R - 1 - 120.0R - 0 - 240.0R (Default) RESET:0x0"
          
group.long  0xaa++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PROCODTCTL, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PROCODTCTL_RFU_PROCODTCTL ,None RESET:0x0"
          
group.long  0xac++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PROCODTTIMECTL_P0, Controls timing of ProcOdt for DQ and DQS termination during reads. The enabling and disabling of ProcOdt can be shifted with a granularity of 1UI.  If WDQSEXTENSION is enabled, this register should be set to 0x03. Otherwise, use the recommended settings based on MEMCLK frequency and TwoTckRxDqsPre. This will ensure that ProcOdt is enabled before the DQS preamble begins and is not disabled until after the DQS postamble ends.  Recommended configuration if Register TwoTckRxDqsPre==1:  - 0000MHz < memclk-freq <= 0933 ; Register POdtStartDelay= 2 ; Register POdtTailWidth=2  - 0933MHz < memclk-freq <= 1200 ; Register POdtStartDelay= 0 ; Register POdtTailWidth=2  - 1200MHz < memclk-freq <= NA ; Register POdtStartDelay= 0 ; Register POdtTailWidth=3  Recommended configuration if TwoTckRxDqsPre==0:  - 0000MHz < memclk-freq <= 933 ; Register POdtStartDelay= 2 ; Register POdtTailWidth=2  - 0933MHz < memclk-freq <= 1200 ; Register POdtStartDelay= 1 ; Register POdtTailWidth=2  - 1200MHz < memclk-freq <= NA ; Register POdtStartDelay= 1 ; Register POdtTailWidth=3 See related CSR TxOdtDrvStren. RESET:0x1f"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PROCODTTIMECTL_P0_PODTTAILWIDTH ,controls the length of the tail of ProcOdt, units of UI - POdtTailWidth controls the time from closing the window to receive DQS to ProcODT deassertion, and can be set with values ranging from 0 to 3. - The aforementioned timing is defined as (3 + POdtTailWidth + POdtTailWidthExt - csrTwiTckDqsPre) UIs. - It is recommended to use this csr as the main timing configuration unit, with default value of 3. Note that this might not be the optimal value, since it is technology dependent. Refer to the PHY Databook for optimal settings. RESET:0x3"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PROCODTTIMECTL_P0_PODTSTARTDELAY ,controls the start of ProcOdt, units of UI  - 3 delay start 2 UI, maximum delay of start of ProcOdt  - 2 delay start 1 UI,  - 1 delay start 0 UI, default  - 0 early by 1 UI, The time from ProcODT assertion to opening the window to receive DQS is than (10 - POdtStartDelay) UI. It may be up to 4 pclk smaller if small 	  coarse delays are used (used only at the lowest clock frequencies) RESET:0x3"
          
         hexmask.long 0x00 4.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PROCODTTIMECTL_P0_PODTTAILWIDTHEXT ,controls the length of the tail of ProcOdt, units of UI - POdtTailWidthExt controls the time from closing the window to receive DQS to ProcODT deassertion, and can be set with values ranging from 0 to 3. - The aforementioned timing is defines as (3 + POdtTailWidth + POdtTailWidthExt - csrTwiTckDqsPre) UIs. - It is recommended to use this csr as an extension to POdtTailWidth, and has a default value of 1. Note that this might not be the optimal value, since it is technology dependent. Refer to the PHY Databook for optimal settings. RESET:0x1"
          
group.long  0xb6++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMALERTCONTROL, Controls for the receiver for MemAlert (D4 Parity or WCRC Error) or, alternately, for ERR_n (D3 registered DIMM). RESET:0x4000"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMALERTCONTROL_MALERTVREFLEVEL ,Sets the vref level of internal VREF DAC assuming the following Mission mode settings:  [TestExtVrefRange,TestMajorMode] = [0011 or 0000)  The VREF level chosen by the receiver follows the equation::  VREF = VDDQ*(0.51 + MALERTVrefLevel[6:0]*0.00345)  The min/max values possible are:  - VREF_min = VDDQ*(0.51)  - VREF_max = VDDQ*(0.948) RESET:0x0"
          
         bitfld.long 0x00 7. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMALERTCONTROL_MALERTVREFEXTEN ,When set for test/debug, selects external Vref source. This should not be set in mission mode. RESET:0x0"
          
         hexmask.long 0x00 8.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMALERTCONTROL_MALERTPUSTREN ,Controls the Pull-up termination on MALERT  - bit[8] - controls a 240 Ohm Pull-up leg  - bit[9] - controls a 240 Ohm Pull-up leg  - bit[10] - controls a 120 Ohm Pull-up leg  - bit[11] - controls a 120 Ohm Pull-up leg This field is programmable as follows:  - 0000 - No Pull-up Strength  - 0001 - 240 Ohm Pull-up Strength  - 0010 - 240 Ohm Pull-up Strength  - 0011 - 120 Ohm Pull-up Strength  - 0100 - 120 Ohm Pull-up Strength  - 0101 - 80 Ohm Pull-up Strength  - 0110 - 80 Ohm Pull-up Strength  - 0111 - 60 Ohm Pull-up Strength  - 1000 - 120 Ohm Pull-up Strength  - 1001 - 80 Ohm Pull-up Strength  - 1010 - 80 Ohm Pull-up Strength  - 1011 - 60 Ohm Pull-up Strength  - 1100 - 60 Ohm Pull-up Strength  - 1101 - 48 Ohm Pull-up Strength  - 1110 - 48 Ohm Pull-up Strength  - 1111 - 40 Ohm Pull-up Strength RESET:0x0"
          
         bitfld.long 0x00 12. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMALERTCONTROL_MALERTPUEN ,When set, enables the Pull-up termination on MALERT RESET:0x0"
          
         bitfld.long 0x00 13. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMALERTCONTROL_MALERTRXEN ,This field is programmable as follows: - 1 - Enables receiver and received data is forwarded to dfi_alert_n. - 0 - Disable the receiver and send MALERTDisableVal to dfi_alert_n RESET:0x0"
          
         bitfld.long 0x00 14. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMALERTCONTROL_MALERTDISABLEVAL ,When MALERTRxEn is not set, this CSR state is used to drive dfi_alert_n. RESET:0x1"
          
         bitfld.long 0x00 15. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMALERTCONTROL_MALERTFORCEERROR ,When MALERTForceError is set, this CSR state is used to force parity error to memory. RESET:0x0"
          
group.long  0xb8++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMALERTCONTROL2, Controls for the MemAlert output (dfi_alert_n) The DFI interface defines that the signal dfi_alert_n as a synchronous output on DFICLK. For some memory systems, this signal is synchronized again elsewhere in the SOC, so the synchronizer in the PHY is useless (and simply adds to the latency of observing an ALERT transition. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMALERTCONTROL2_MALERTSYNCBYPASS ,This field is programmed as follows: - MALERTSyncBypass==[0], the phy will drive dfi_alert_n with a synchronized value of the ALERT_N receiver. - MALERTSyncBypass==[1], the phy will drive dfi_alert_n with the asynchronous value of the ALERT_N receiver. RESET:0x0"
          
group.long  0xc0++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMRESETL, Control the MemResetL output of the PHY. Intended to be used to protect/force the BP_MemReset_L output. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMRESETL_MEMRESETLVALUE ,Control the MemResetL output of the PHY. The state of this field is transfered to the PHY BP_MemReset_L output when ProtectMemReset is set. BP_MemReset_L cannot reset LPDDR3. RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MEMRESETL_PROTECTMEMRESET ,Control the MemResetL output of the PHY. The state of the MemResetL field is transfered to the PHY BP_MemReset_L output when ProtectMemReset is set. RESET:0x0"
          
group.long  0xdc++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PUBMODE, Selects between HWT and DCT as the source of memory transactions. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PUBMODE_HWTMEMSRC ,When this is set to a 1, the mux that switches between DCT and HWT for the source of memory transactions is switched to HWT.  - Setting this bit relinquishes control to the HWT.  - Clearing this bit relinquishes control to the DCT. The transition can only be made when the. FIFOs are all in PtrInit (i.e. all PtrInit signals are high). RESET:0x0"
          
rgroup.long 0xde++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MISCPHYSTATUS, This Read Only CSR represent misc status of the PHY RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MISCPHYSTATUS_DCTSANE ,Returns the status of the custom circuit which protects the MemResetL output of the PHY on initial power-on or reset. This circuit resets to 0 meaning that hardware has control of the MemResetL output. If set to 1, memory RESET is being controlled by Registers MemResetLVaue and ProtectMemReset or dfi_reset_n. RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MISCPHYSTATUS_PORMEMRESET ,Returns the active-high value used by the custom circuit which drives the memory RESET signal. To comply with JEDEC specifications for memory reset, this signal powers on 1'b1. This signal is reset during the PHY Initialization sequence. RESET:0x0"
          
group.long  0xe0++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CORELOOPBACKSEL, Controls whether the loopback path bypasses the final PAD node. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CORELOOPBACKSEL_CORELOOPBACKSEL ,This register is controlled by the PHY test firmware This register enables Core-Side loopback operation of the PHY.  - When set, the PHY PAD node will be bypassed, and pre-pad node will be selected for sampling by the PHY RX.  - Setting this register enables full-speed loopback operation of the PHY regardless of the loading of the pad.  - This register must be set to 1'b0 for mission mode operation (or pad-side loopback). RESET:0x0"
          
group.long  0xe2++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLTRAINPARAM, DLL Training Parameters RESET:0x2"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLTRAINPARAM_EXTENDPHDTIME ,Used by the PHY firmware locking the LCDL delay cells. The number of extra DfiClk periods (= 4*UI) for the DLL phase-detector outputs to become not-metastable RESET:0x2"
          
group.long  0xe4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTLPCSENA, Programmed by PHY training firmware to support LPDDR3/LPDDR4 DRAM drift compensation. RESET:0x3"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTLPCSENA_HWTLPCSENA ,Programmed by PHY training firmware to support LPDDR3/LPDDR4 DRAM drift compensation. RESET:0x3"
          
group.long  0xe6++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTLPCSENB, Programmed by PHY training firmware to support LPDDR3/LPDDR4 DRAM drift compensation. RESET:0x3"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTLPCSENB_HWTLPCSENB ,Programmed by PHY training firmware to support LPDDR3/LPDDR4 DRAM drift compensation. RESET:0x3"
          
group.long  0xe8++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTLPCSENBYPASS, CSn Disable Bypass for LPDDR3/4 RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTLPCSENBYPASS_HWTLPCSENBYPASS ,When set, these bits disable LpCsEn function for LPDDR3/4 RESET:0x0"
          
group.long  0xea++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFICAMODE, This CSR controls the PHY signal-to-bump-mapping mode.  - The default state is all bits 0.  - Setting bits fields to 1 changes the arch mode and are required to be 1-hot. While all fields of this csr are present in all products, some will not always be relevant as a particular dram type may not be supported. Irrelevant bits must be set to 0, always.  Programmed by dwc_ddrphy_phyinit_C_initPhyConfig() according to PHY configuration and DRAM type. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFICAMODE_DFILP3CAMODE ,Controls the output data-rate of the AC module Command/Address pins Enable LPDDR3 Mode  - 0: LPDDR3 Dual Data Rate address mode disabled  - 1: LPDDR3 Dual Data Rate address mode enabled RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFICAMODE_DFID4CAMODE ,Enable DDR4 Mode - 0: D4 mode disabled - 1: D4 mode enabled RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFICAMODE_DFILP4CAMODE ,Enable LP4 Mode - 0: LP4 mode disabled - 1: LP4 mode enabled RESET:0x0"
          
         bitfld.long 0x00 3. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFICAMODE_DFID4ALTCAMODE ,Enable DDR4-Alt Mode (only available in certain configurations) - 0: D4-Altmode disabled - 1: D4-Altmode enabled RESET:0x0"
          
group.long  0xec++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCACTL, Reserved for PHY training firmware use. RESET:0x1"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCACTL_RFU_HWTCACTL ,None RESET:0x1"
          
group.long  0xee++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCAMODE, Programmed by PHY training firmware to support LPDDR3/LPDDR4 DRAM drift compensation. RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCAMODE_RFU_HWTCAMODE ,None RESET:0x0"
          
group.long  0xf0++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLCONTROL, This CSR is written by PHY Initialization Engine (PIE) and the data in here will be overwritten. RESET:0x3"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLCONTROL_DLLRESETRELOCK ,Used to reset the DDL/LCDL lock state machine. Deasserting starts locking sequence. This must be done anytime the DLLs are to be relocked (e.g. frequency change). RESET:0x1"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLCONTROL_DLLRESETSLAVE ,Reserved. RESET:0x1"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLCONTROL_DLLRESETRSVD ,RSVD for future use RESET:0x0"
          
group.long  0xf2++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PULSEDLLUPDATEPHASE, This register is used only for test and for training. It is not used in PIE frequency change or power-state change. The CfgWE for this register causes a UpdatePhase, aka ClkPhase, for the DLL associated with the subfield enables.  - Writing a 1 to one of the PulseXDllUpdatePhase will cause a pulse, ie it will assert ClkPhase=1 then clear ClkPhase=0.  - There is no need to write a 0 after writing a 1 to one of the PulseXDllUpdatePhase.  - A written 1 will read back a 1, but that does not mean that ClkPhase to the corresponding DLL is being held high.  - Writing this CSR must be in a traffic bubble.  - Writing all-0s to this register is a nop for the DLLs. It will clear any readback values if they were set.  - This function requires Register AlwaysEnCfgClk=1. Example to update the active Phases of the DBYTE module DLLs (nop for AC module DLLs):  - io_write16(c0 | tMASTER | csr_CalAndPllConfig_ADDR, csr_AlwaysEnCfgClk_MASK);  - io_write16(cbrd | tANIB | csr_PulseDllUpdatePhase_ADDR, csr_PulseDbyteDllUpdatePhase_MASK);  - io_write16(cbrd | tANIB | csr_PulseDllUpdatePhase_ADDR, 0x0); RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PULSEDLLUPDATEPHASE_PULSEDBYTEDLLUPDATEPHASE ,Causes a LongBubble to the DBYTE modules, which causes a update of the DBYTE module DLLs (tx,rxen,rxclk). RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PULSEDLLUPDATEPHASE_PULSEACKDLLUPDATEPHASE ,Causes an AC module CK (memck) DLL phase update. This should be written with 1 only when the memory CKE=0 or memory RST=0, or when there is no memory, as in tester mode. RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PULSEDLLUPDATEPHASE_PULSEACADLLUPDATEPHASE ,Causes an AC module CA (command/address/cke/odt) DLL phase update. RESET:0x0"
          
         hexmask.long 0x00 3.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PULSEDLLUPDATEPHASE_UPDATEPHASEDESTRESERVED ,reserved, not used RESET:0x0"
          
         bitfld.long 0x00 6. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PULSEDLLUPDATEPHASE_TRAINUPDATEPHASEONLONGBUBBLE ,Causes LongBubble to update the dbyte & anib LDCL Phase. May be used for training, but not to be used for mission mode. RESET:0x0"
          
         bitfld.long 0x00 7. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PULSEDLLUPDATEPHASE_ALWAYSUPDATELCDLPHASE ,Causes each new operation to reload the LcdlPhase; will increase bubbles. RESET:0x0"
          
group.long  0xf4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCONTROLOVR0, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--12. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCONTROLOVR0_RFU_HWTCONTROLOVR0 ,None RESET:0x0"
          
group.long  0xf6++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCONTROLOVR1, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--12. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCONTROLOVR1_RFU_HWTCONTROLOVR1 ,None RESET:0x0"
          
group.long  0xf8++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLGAINCTL_P0, Controls for the DllGain sequencing for locking and maintaining lock of the LCDL delay cells. - The DllGain sequencer will start locking with the DllGainIV. - As the end of locking approaches, the DllGain will be incremented in stages until, at the end of locking, the DllGain is the terminal values DllGainTV. - 2^(5-DllGain) is fractional change in the DAC code MstPhase1UI[8:0] of Dll per pclk. - Firmware uses values for DllGainIV, DllGainTV, and LcdlSeed0 that are optimized for minimum locking time. These controls are not to be configured by the user. RESET:0xa1"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLGAINCTL_P0_DLLGAINIV ,Initial value of DllGain. RESET:0x1"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLGAINCTL_P0_DLLGAINTV ,Terminal value of DllGain, ie the value in effect when locking is done and the value used for maintaining lock, ie tracking pclk variation. DllGainTV must be greater than or equal to DllGainIV. The maximum value is 10. RESET:0xa"
          
         hexmask.long 0x00 8.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLGAINCTL_P0_DLLSEEDSEL ,Reserved, must be configured to be 0. RESET:0x0"
          
group.long  0xfa++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLLOCKPARAM_P0, Reserved for PHY training firmware use. RESET:0x17c1"
         hexmask.long 0x00 0.--12. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DLLLOCKPARAM_P0_RFU_DLLLOCKPARAM_P0 ,None RESET:0x17c1"
          
group.long  0xfc++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCONTROLVAL0, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--12. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCONTROLVAL0_RFU_HWTCONTROLVAL0 ,None RESET:0x0"
          
group.long  0xfe++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCONTROLVAL1, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--12. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTCONTROLVAL1_RFU_HWTCONTROLVAL1 ,None RESET:0x0"
          
group.long  0x102++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACSMGLBLSTART, Reserved for PHY training firmware use. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACSMGLBLSTART_ACSMGLBLSTART ,Reserved for PHY training firmware use. RESET:0x0"
          
group.long  0x104++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACSMGLBLSGLSTPCTRL, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACSMGLBLSGLSTPCTRL_RFU_ACSMGLBLSGLSTPCTRL ,None RESET:0x0"
          
group.long  0x108++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_LCDLCALPHASE, Reserved for PHY test firmware use. RESET:0x0"
         hexmask.long 0x00 0.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_LCDLCALPHASE_LCDLCALPHASE ,Reserved for PHY test firmware use. RESET:0x0"
          
group.long  0x10a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_LCDLCALCTRL, Reserved for PHY test firmware use. RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_LCDLCALCTRL_RFU_LCDLCALCTRL ,None RESET:0x0"
          
group.long  0x110++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALRATE, This CSR controls the impedance calibration engine in the PHY. RESET:0x9"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALRATE_CALINTERVAL ,This CSR specifies the interval between successive calibrations, in mS. csrValue : Interval (mS)  - 0 : 0 (continuous)  - 1 : 0.010  - 2 : 0.10  - 3 : 1  - 4 : 2  - 5 : 3  - 6 : 4  - 7 : 8  - 8 : 10  - 9 : 20  - 10-15 : Reserved. This field should only be changed while the calibrator is idle. ie before csr CalRun is set. The calibration intervals are valid only at DFICLK frequency >=24MHz. If the DFICLK frequency is less than 24MHz, the interval may be up to 2.4x larger than the value programmed in the register. RESET:0x9"
          
         bitfld.long 0x00 4. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALRATE_CALRUN ,This field is programmed as follows:  - 1: A calibration sequence will be triggered by the 0->1 transition of this bit, as determined by CSR CalOnce.  - 0: Calibrator will not run. If already active then it will complete the current sequence before quiescing. The default value of this field is 0 because the calibrator needs to know the correct operating mode before it starts up. This csr won't do anything while CalZap is asserted. RESET:0x0"
          
         bitfld.long 0x00 5. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALRATE_CALONCE ,The setting of this CSR changes the behavior of CSR CalRun.  - 1: The 0->1 transition of CSR CalRun causes a single iteration of the calibration sequence to occur. Once the calibration is complete, the calibration engine will remain IDLE until another CalRun Trigger.  - 0: Calibration will proceed at the rate determined by Register CalInterval. This field should only be changed while the calibrator is idle. ie before csr CalRun is set. RESET:0x0"
          
         bitfld.long 0x00 6. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALRATE_DISABLEBACKGROUNDZQUPDATES ,Reserved for debug only. When this bit is set, ZQ compensation code updates will occur only during a DFI sideband [PHYUPDATE,CTRLUPDATE,PHYMSTR] handshake. This debug feature must be disabled if DFI1 is active. RESET:0x0"
          
group.long  0x112++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALZAP, Impedance Calibration Zap/Reset RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALZAP_CALZAP ,This CSR is written by PHY Initialization Engine (PIE) and the data in here will be overwritten.  Setting this csr resets the calibrator to its idle state. Must be cleared in order for the calibration engine to run again. RESET:0x0"
          
group.long  0x116++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PSTATE, PSTATE Selection RESET:0xc"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PSTATE_PSTATE ,This CSR is written by PHY Initialization Engine (PIE) and the data in here will be overwritten. The current PState inferred by the PIE from handshake requests on DFI status interface.  - 0000 - PState P0  - 0001 - PState P1  - 0010 - PState P2  - 0011 - PState P3  - 0100 - Reserved  - 0101 - Reserved  - 0110 - Reserved  - 0111 - Reserved  - 1000 - Reserved  - 1001 - Reserved  - 1010 - Reserved  - 1011 - Reserved  - 1100 - LP2  - 1101 - Reserved  - 1110 - Reserved  - 1111 - LP3 The lower two bits of this CSR are used to select the PHY's current Pstate for all Pstateable registers.  Note: It is a don't care what value is selected in either LP2 or LP3 because no transactions will be taking place when in those states. RESET:0xc"
          
group.long  0x118++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALPREDRIVEROVERRIDE, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALPREDRIVEROVERRIDE_RFU_CALPREDRIVEROVERRIDE ,None RESET:0x0"
          
group.long  0x11a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLOUTGATECONTROL, Note : This CSR is written by PHY Initialization Engine (PIE) and the data in here will be overwritten. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLOUTGATECONTROL_PCLKGATEEN ,Reserved. RESET:0x0"
          
          
group.long  0x11e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_UCMEMRESETCONTROL, This register is dynamically written by PHY Initialization Engine during frequency changes and should not be written by the user. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_UCMEMRESETCONTROL_RFU_UCMEMRESETCONTROL ,None RESET:0x0"
          
group.long  0x120++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PORCONTROL, Power On Reset Control. Register is written PIE during PHY operation. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PORCONTROL_PLLDLLLOCKDONE ,Set by the PIE to 1 during execution, Cleared on PHY Reset or on power cycle. When Set, releases control of PHY I/O's from power on defaults.  Note: This is a legacy register name and no longer represents when PHY internal PLL or DLL is locked. RESET:0x0"
          
rgroup.long 0x12e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALBUSY, Impedance Calibration Busy Status RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALBUSY_CALBUSY ,Read 1 if the calibrator is actively calibrating. Any changes to calibrator-related CSRs may only be made if the calibrator is disabled (via CSR CalRun) and this CSR reads 0. RESET:0x0"
          
group.long  0x130++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALMISC2, Second set of miscellaneous impedance calibrator controls. RESET:0x4"
         hexmask.long 0x00 0.--2. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALMISC2_CALNUMVOTES ,This CSR controls the number of consecutive comparator output bits over which majority voting is done. It effectively works as a sampling window, since each sample serves as a single vote. The result of the voting is fed into the Successive Approximation Register (SAR). The voting is initiated after the time configured via csrs CalSlowCmpana has elapsed. CSR Value : number of Votes  - 0 : 1  - 1 : 9  - 2 : 17  - 3 : 33  - 4 : 65 (defaults)  - 5 : 129  - 6 : 193  - 7 : 255 RESET:0x4"
          
          
          
         bitfld.long 0x00 12. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALMISC2_CALCMPTRRESTRIM ,Reserved for future use. RESET:0x0"
          
         bitfld.long 0x00 13. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALMISC2_CALCANCELROUNDERRDIS ,The PEXT calibration result and NINT calibration results naturally include a rounding error which manifests as a change of impedance at the pad. Where both of these errors are in the same direction the. PEXT calibration result will be adjusted by 1 to offset. NINT error. Setting this csr to 1 prevents this adjustment. RESET:0x0"
          
         bitfld.long 0x00 14. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALMISC2_CALSLOWCMPANA ,When set, this CSR doubles the time allowed for the analog comparator cell to settle before sampling begins. RESET:0x0"
          
          
group.long  0x134++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALMISC, Table of impedance calibration CSR relatedness:  Target: OFFSET05  - Aka: CalCmpr5  - Working state: resCalCmpr5  - R_W viewing CSR: CalCmpr5  - Override CSR: CalCmpr5Ovr  - Offset CSR: CalCmpr5Offset  - Destination CSR: -- Target: NINT  - Aka: CalDrvPd5  - Working state: resCalNInt  - R_W viewing CSR: CalNInt  - Override CSR: CalNIntOvr  - Offset CSR: [CalDrvPdOffset, CalDrvPdThOffset]  - Destination CSR: -- Target: PEXT  - Aka: CalDrvPu5  - Working state: resCalPExt  - R_W viewing CSR: CalPExt  - Override CSR: CalPExtOvr  - Offset CSR: [CalDrvPuOffset, CalDrvPuThOffset]  - Destination CSR: -- Miscellaneous calibration control knobs. These values may only be changed when the calibrator is not running. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALMISC_CALCMPR5DIS ,Setting this CSR prevents the calibration engine from using the result from the CalCmpr5 stage of calibration. Software must supply a replacement value via CSR CalCmpr5Ovr. RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALMISC_CALNINTDIS ,Setting this CSR prevents the calibration engine from overwriting the CSRs TxCalBinN and TxCalThN with an automatically generated value, in which case a value must be supplied by software. RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALMISC_CALPEXTDIS ,Setting this CSR prevents the calibration engine from overwriting the CSRs TxCalBinP and TxCalThP with an automatically generated value, in which case a value must be supplied by software. RESET:0x0"
          
group.long  0x136++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALVREFS, VREF code for Comparator offset compensation. RESET:0x2"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALVREFS_CALVREFS ,This CSR drives the Cmpdig_CalRef pin of the cmpana cell at various stages of calibration. Following are the encoding values  - 2'b00 - Reserved  - 2'b01 - Reserved  - 2'b10 - 50% Vref (Default)  - 2'b11 - Reserved RESET:0x2"
          
rgroup.long 0x138++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPR5, Impedance Calibration Cmpr control RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPR5_CALCMPR5 ,Returns the offset-compensated DAC code for the cmpana circuit at VRef == 0.5 * VDDQ. RESET:0x0"
          
rgroup.long 0x13a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALNINT, Observation of calibration engine pull-down calibration code. RESET:0x0"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALNINT_CALNINTTHB ,The value here is the number of thermometer bits which are set. RESET:0x0"
          
rgroup.long 0x13c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALPEXT, Observation of calibration engine pull-up calibration code. RESET:0x0"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALPEXT_CALPEXTTHB ,The value here is the number of thermometer bits which are set. RESET:0x0"
          
group.long  0x150++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPINVERT, A safety bit for each calibration target, which controls the inversion (or not) of the comparator output before it is sampled. A 1 in the CSR causes the comparator output to be inverted. RESET:0x3"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPINVERT_CMPINVERTCALDAC50 ,Impedance Calibration Cmp Invert control RESET:0x1"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPINVERT_CMPINVERTCALDRVPD50 ,Impedance Calibration Cmp Invert control RESET:0x1"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPINVERT_CMPINVERTCALDRVPU50 ,Impedance Calibration Cmp Invert control RESET:0x0"
          
         bitfld.long 0x00 3. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPINVERT_CMPINVERTCALODTPD ,Impedance Calibration Cmp Invert control RESET:0x0"
          
         bitfld.long 0x00 4. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPINVERT_CMPINVERTCALODTPU ,Impedance Calibration Cmp Invert control RESET:0x0"
          
group.long  0x15c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPANACNTRL, This register control the cmpana custom circuit analog control. It is not recommended to change their values from the reset values. RESET:0x112"
         hexmask.long 0x00 0.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPANACNTRL_CMPRGAINCURRADJ ,Impedance Calibration Cmpana control RESET:0x12"
          
         bitfld.long 0x00 8. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPANACNTRL_CMPRGAINRESADJ ,Impedance Calibration Cmpana control RESET:0x1"
          
         bitfld.long 0x00 9. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CALCMPANACNTRL_CMPRBIASBYPASSEN ,Impedance Calibration Cmpana control RESET:0x0"
          
group.long  0x160++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIRDDATACSDESTMAP_P0, This CSR must be default values in LPDDR3 and LPDDR4 modes. Maps dfi_rddata_cs_n (read chip-select asserted low) to destination dimm timing group. RESET:0xe4"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIRDDATACSDESTMAP_P0_DFIRDDESTM0 ,Maps dfi_rddata_cs_n_p0[0] to dest DfiRdDestm0 timing.  For example, if 0 dfi_rddata_cs_n_p0[0] will use Register Rx[En,Clk]DlyTg0 timing. RESET:0x0"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIRDDATACSDESTMAP_P0_DFIRDDESTM1 ,Maps dfi_rddata_cs_n_p0[1] to dest DfiRdDestm1 timing.  For example, if 1 dfi_rddata_cs_n[_p01] will use Register Rx[En,Clk]DlyTg1 timing. RESET:0x1"
          
         hexmask.long 0x00 4.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIRDDATACSDESTMAP_P0_DFIRDDESTM2 ,Maps dfi_rddata_cs_n_p0[2] to dest DfiRdDestm2 timing.  For example, if 2 dfi_rddata_cs_n_p0[2] will use Register Rx[En,Clk]DlyTg2 timing. RESET:0x2"
          
         hexmask.long 0x00 6.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIRDDATACSDESTMAP_P0_DFIRDDESTM3 ,Maps dfi_rddata_cs_n_p0[3] to dest DfiRdDestm3 timing.  For example, if 3 dfi_rddata_cs_n_p0[3] will use Register Rx[En,Clk]DlyTg3 timing. RESET:0x3"
          
group.long  0x164++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_VREFINGLOBAL_P0, This Register controls the PHY global VREF generator, and the PHY analog pad BP_VREF. The mission mode function of the PHY VREF generator is to generate VrefDQ for the PHY RX function. This register is written and configured by the PHY training firmware for mission mode function. RESET:0x200"
         hexmask.long 0x00 0.--2. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_VREFINGLOBAL_P0_GLOBALVREFINSEL ,GlobalVrefInSel[1:0] controls the mode of the PHY VREF DAC and the BP_VREF pin  - 2'b00 - PHY Vref DAC Range0 -- BP_VREF = Hi-Z  - 2'b01 - Reserved Encoding  - 2'b10 - PHY Vref DAC Range0 -- BP_VREF connected to PLL Analog Bus  - 2'b11 - PHY Vref DAC Range0 -- BP_VREF connected to PHY Vref DAC GlobalVrefInSel[2] controls the DAC range for internal Vref generation RESET:0x0"
          
         hexmask.long 0x00 3.--9. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_VREFINGLOBAL_P0_GLOBALVREFINDAC ,DAC code for internal Vref generation. The DAC has two ranges; the range is set by GlobalVrefInSel[2]  - RANGE0 : [GlobalVrefInSel[2] = 0]  -- DAC Output Voltage = GlobalVrefInDAC == 6'h00 ? Hi-Z : 0.345*VDDQ + (0.005*GlobalVrefInDAC)*VDDQ  - RANGE1 : [GlobalVrefInSel[2] = 1]  -- DAC Output Voltage = GlobalVrefInDAC == 6'h00 ? Hi-Z : (0.005*(GlobalVrefInDAC-1))*VDDQ RESET:0x40"
          
         hexmask.long 0x00 10.--13. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_VREFINGLOBAL_P0_GLOBALVREFINTRIM ,RSVD RESET:0x0"
          
         bitfld.long 0x00 14. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_VREFINGLOBAL_P0_GLOBALVREFINMODE ,RSVD RESET:0x0"
          
group.long  0x168++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIWRDATACSDESTMAP_P0, This CSR must be default values in LPDDR3 and LPDDR4 modes Maps dfi_wrdata_cs_n (write chip-select asserted low) to destination dimm timing group. The full dfi interface has 72 values of dfi_wrdata_cs_n, with 8 per byte. Byte db (0..8) uses values dfi_wrdata_cs_n[(db*8 + 7):(db*8 + 0)] and this register, which is per byte, to determine the timing-control registers to use for the asserted chip-select. For simplicity, the subfield description does not include the byte offset for dfi_wrdata_cs_n.  Note: The example values below are the default/reset values. If this register is written to all zeroes, then all writes will use Register Tx[Dq,Dqs]Dlyd0 timing. RESET:0xe4"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIWRDATACSDESTMAP_P0_DFIWRDESTM0 ,Maps dfi_wrdata_cs_n_p0[0] to dest DfiWrDestm0 timing  For example, if 0 dfi_wrdata_cs_n_p0[0] will use Register Tx[Dq,Dqs]DlyTg0 timing. RESET:0x0"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIWRDATACSDESTMAP_P0_DFIWRDESTM1 ,Maps dfi_wrdata_cs_n_p0[1] to dest DfiWrDestm1 timing  For example, if 1 dfi_wrdata_cs_n_p0[0] will use Register Tx[Dq,Dqs]DlyTg1 timing. RESET:0x1"
          
         hexmask.long 0x00 4.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIWRDATACSDESTMAP_P0_DFIWRDESTM2 ,Maps dfi_wrdata_cs_n_p0[2] to dest DfiWrDestm2 timing  For example, if 2 dfi_wrdata_cs_n_p0[0] will use Register Tx[Dq,Dqs]DlyTg2 timing. RESET:0x2"
          
         hexmask.long 0x00 6.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIWRDATACSDESTMAP_P0_DFIWRDESTM3 ,Maps dfi_wrdata_cs_n_p0[3] to dest DfiWrDestm3 timing (use Register Tx[Dq,Dqs]DlyTg3)  For example, if 3 dfi_wrdata_cs_n_p0[0] will use Register Tx[Dq,Dqs]DlyTg3 timing. RESET:0x3"
          
rgroup.long 0x16a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MASUPDGOODCTR, Counts successful PHY Master Interface Updates (PPTs) RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MASUPDGOODCTR_MASUPDGOODCTR ,This register increments whenever the Memory Controller acknowledges a PHY Master Interface request ,i.e. a request for the PHY to take over the DFI for Periodic Phase Training (PPT).  (As per section 11 of the Preliminary DFI 4.0 Specification Rev. 2) In a 2-channel system, both MC channels must ack. The counter saturates at max value 65535. RESET:0x0"
          
rgroup.long 0x16c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYUPD0GOODCTR, Counts successful PHY-initiated DFI0 Interface Updates RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYUPD0GOODCTR_PHYUPD0GOODCTR ,This register increments whenever the Memory Controller acknowledges a PHY-initiated DFI0 interface update request. The counter saturates at max value 65535. RESET:0x0"
          
rgroup.long 0x16e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYUPD1GOODCTR, Counts successful PHY-initiated DFI1 Interface Updates RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYUPD1GOODCTR_PHYUPD1GOODCTR ,This register increments whenever the Memory Controller acknowledges a PHY-initiated DFI1 interface update request. The counter saturates at max value 65535. RESET:0x0"
          
rgroup.long 0x170++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CTLUPD0GOODCTR, Counts successful Memory Controller DFI0 Interface Updates RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CTLUPD0GOODCTR_CTLUPD0GOODCTR ,This register increments whenever the PHY acknowledges a Memory Controller-initiated DFI0 interface update request. The counter saturates at max value 65535. RESET:0x0"
          
rgroup.long 0x172++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CTLUPD1GOODCTR, Counts successful Memory Controller DFI1 Interface Updates RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_CTLUPD1GOODCTR_CTLUPD1GOODCTR ,This register increments whenever the PHY acknowledges a. Memory Controller-initiated DFI1 interface update request. The counter saturates at max value 65535. RESET:0x0"
          
rgroup.long 0x174++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MASUPDFAILCTR, Counts unsuccessful PHY Master Interface Updates RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MASUPDFAILCTR_MASUPDFAILCTR ,This register increments whenever the PHY asserts a PHY Master. Interface request, but the Memory Controller doesn't acknowledge the request within the allowed interval. (As per section 11 of the Preliminary DFI 4.0 Specification Rev. 2) The counter saturates at max value 65535. In a 2-channel system, a failure occurs if either MC channels fails to ack. RESET:0x0"
          
rgroup.long 0x176++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYUPD0FAILCTR, Counts unsuccessful PHY-initiated DFI0 Interface Updates RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYUPD0FAILCTR_PHYUPD0FAILCTR ,This register increments whenever the PHY asserts a DFI0. Interface update request, but the Memory Controller doesn't acknowledge the request within the allowed interval. (As per section 11 of the Preliminary DFI 4.0 Specification Rev. 2) The counter saturates at max value 65535. RESET:0x0"
          
rgroup.long 0x178++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYUPD1FAILCTR, Counts unsuccessful PHY-initiated DFI1 Interface Updates RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYUPD1FAILCTR_PHYUPD1FAILCTR ,This register increments whenever the PHY asserts a DFI1. Interface update request, but the Memory Controller doesn't acknowledge the request within the allowed interval. (As per section 11 of the Preliminary DFI 4.0 Specification Rev. 2) The counter saturates at max value 65535. RESET:0x0"
          
group.long  0x17a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYPERFCTRENABLE, Each bit corresponds to one performance counter. Set the bit to enable the counter. Clearing the bit stops and clears the counter. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYPERFCTRENABLE_MASUPDGOODCTL ,Enables MasUpdGoodCtr RESET:0x0"
          
