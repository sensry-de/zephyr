         hexmask.long 0x00 8.--15. 1. " DCU_DSW_GLOBAL_VERSION_MAJOR_VERSION ,Major version RESET:0x1"
          
         hexmask.long 0x00 16.--31. 1. " DCU_DSW_GLOBAL_VERSION_IDENTIFICATION ,Identification RESET:0xde57"
          
group.long  0x4++0x3
    line.long 0x00 "DCU_DSW_GLOBAL_MODE, Operating mode RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " DCU_DSW_GLOBAL_MODE_OPERATING_MODE ,Operating mode RESET:0x0"
          
group.long  0x8++0x3
    line.long 0x00 "DCU_DSW_GLOBAL_FB_ADDRESS, Framebuffer address RESET:0x0"
