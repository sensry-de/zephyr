    line.long 0x00 "ETHERNET_TSN_SW_MDIO_CFG, MDIO Configuration register RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " ETHERNET_TSN_SW_MDIO_CFG_MDC_CLKDIV ,Clock Divider to configure MDC clock frequency. Refer to 10.1 Clock Divider for more details. RESET:0x0"
          
         bitfld.long 0x00 8. " ETHERNET_TSN_SW_MDIO_CFG_ENABLE ,Enable the MDIO controller. If the controller is enabled then MDC will be toggled.  ENABLE can only be read as 1 if a valid MDC_CLKDIV value is set. RESET:0x0"
          
         bitfld.long 0x00 15. " ETHERNET_TSN_SW_MDIO_CFG_NPRE ,No Preamble With NPRE=1 the preamble generation is suppressed and frames are initiated with Start of Frame pattern directly. Suitable in case that all connected PHYs accept management frames without a preamble pattern. Recommended to be used if only one PHY is connected. RESET:0x0"
          
group.long  0x20024++0x3
    line.long 0x00 "ETHERNET_TSN_SW_MDIO_CTRL, MDIO Control register RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_TSN_SW_MDIO_CTRL_READY ,READY=1 indicates a finished transfer and also shows that the controller is ready for a new transfer. READY=1 is only possible if ENABLE=1. If READY=1 is signaled after a read transfer, then RD_DATA is valid until a new transfer is started. RESET:0x0"
          
         bitfld.long 0x00 8. " ETHERNET_TSN_SW_MDIO_CTRL_INIT ,INIT=1 results in a MDIO write/read transfer if READY=1. If READY=0 while a transfer is already pending or if ENABLE=0 then settings INIT=1 has no effect and the current transaction is withdrawn. RESET:0x0"
          
         hexmask.long 0x00 16.--20. 1. " ETHERNET_TSN_SW_MDIO_CTRL_REGAD ,MODE=0 Management Frame Register Address. MODE=1 Management Frame Device (MMD) Address RESET:0x0"
          
         bitfld.long 0x00 21. " ETHERNET_TSN_SW_MDIO_CTRL_MODE ,Switch the MDIO frame format between clause 22 and clause 45 devices. 0 – clause 22 (typical for 10/100/1000 PHYs) 1 – clause 45 RESET:0x0"
          
         hexmask.long 0x00 24.--28. 1. " ETHERNET_TSN_SW_MDIO_CTRL_PHYAD ,Management Frame PHY Address. RESET:0x0"
          
         hexmask.long 0x00 30.--31. 1. " ETHERNET_TSN_SW_MDIO_CTRL_OP ,Opcode to determine transfer type If the frame format is based on Clause 22 MDIO (MODE=0) 01 – Write Access 10 – Read Access If the frame format is based on Clause 45 MDIO (MODE=1) 00 – Address Write Access on the address register 01 – Write Access at the address register location (MMD register bank) 11 – Read Access at the address register location (MMD register bank) 10 – Read Access at the address register location (MMD register bank) and increment address register after read. RESET:0x0"
          
