tree "LPDDR4_PUB__DWC_DDRPHYA_ANIB0_P0"
base e:0x42000000
width 80.
group.long  0x34++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_MTESTMUXSEL, Digital Observation Pin control RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_MTESTMUXSEL_MTESTMUXSEL ,Controls for the 64-1 mux for asynchronous data to the Digital Observation Pin.  - 6'h0 --> Drive 0 from this chiplet (allows flat 'OR' of pass-through information)  - 6'h01:1f --> Select local data from AC/DBYTE/MASTER macro  - 6'h20 --> Reserved (Drive 0 from macro into mux; Drive 0 from PUB synth logic path into mux)  - 6'h21:3f --> Select local data from PUB AC/DBYTE/MASTER synthesized logic Note: See PUB documentation for how, or if, the Digital Observation Pin is mapped to a physical bump in this configuration. RESET:0x0"
          
group.long  0x4e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_AFORCEDRVCONT, Force Address/Command Driven (Lanes A3-A0) RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_AFORCEDRVCONT_AFORCEDRVCONT ,Force continuous drive, per-lane, of the ACX4 instance controlled by this register. Setting this register will cause the PHY to drive the target lane when dfi_init_complete==1  - Bit [0] = controls lane 0 of the target ACX4 block  - Bit [1] = controls lane 1 of the target ACX4 block  - Bit [2] = controls lane 2 of the target ACX4 block  - Bit [3] = controls lane 3 of the target ACX4 block RESET:0x0"
          
group.long  0x50++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_AFORCETRICONT, Force Address/Command Tristate (Lanes A3-A0) RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_AFORCETRICONT_AFORCETRICONT ,Force tristate control, per-lane, of the ACX4 instance controlled by this register. Setting this register will cause the PHY to tristate the target lane when dfi_init_complete==1  - Bit [0] = controls lane 0 of the target ACX4 block  - Bit [1] = controls lane 1 of the target ACX4 block  - Bit [2] = controls lane 2 of the target ACX4 block  - Bit [3] = controls lane 3 of the target ACX4 block RESET:0x0"
          
group.long  0x86++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATXIMPEDANCE, Tx impedance of Address driver cells. RESET:0x3ff"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATXIMPEDANCE_ADRVSTRENP ,The 5-bit bus is used to select the target pull-up output impedance.  Refer to Technology specific PHY DATABOOK for supported options. Connects to the DrvStren pins of the driver thus: Csr_DrvStren120P[5:0] = [csrADrvStrenP[4:0],1'b1]  - 00000 = 120.0 Ohm  - 00001 = 60.0 Ohm  - 00011 = 40.0 Ohm  - 00111 = 30.0 Ohm  - 01111 = 24.0 Ohm  - 11111 = 20.0 Ohm RESET:0x1f"
          
         hexmask.long 0x00 5.--9. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATXIMPEDANCE_ADRVSTRENN ,This 5-bit bus is used to select the target pull-down output impedance. Refer to Technology specific PHY DATABOOK for supported options. Connects to the DrvStren pins of the driver thus: Csr_DrvStren120N[5:0] = [csrADrvStrenN[4:0],1'b1]  - 00000 = 120.0 Ohm  - 00001 = 60.0 Ohm  - 00011 = 40.0 Ohm  - 00111 = 30.0 Ohm  - 01111 = 24.0 Ohm  - 11111 = 20.0 Ohm RESET:0x1f"
          
rgroup.long 0xa6++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATESTPRBSERR, Address Loopback PRBS Error status for an entire ACX4 block RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATESTPRBSERR_ATESTPRBSERR ,Overall error indicator for each prbs bump checker. - Bit[0] = Lane0 Error Status [1 = errors found, 0 = no errors] - Bit[1] = Lane1 Error Status - Bit[2] = Lane2 Error Status - Bit[3] = Lane3 Error Status RESET:0x0"
          
group.long  0xaa++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATXSLEWRATE, controls slew rates of address/command/memclk drivers. Tx predriver cal trims driver timing to account for clock duty cycle variation. RESET:0x7ff"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATXSLEWRATE_ATXPREP ,This is the 4-bit binary trim for the driver pull-up slew rate. 4'b0000 has a slower slew rate than 4'b1111 RESET:0xf"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATXSLEWRATE_ATXPREN ,4 bit binary trim for the driver pull-down slew rate. 4'b0000 has a slower slew rate than 4'b1111 RESET:0xf"
          
         hexmask.long 0x00 8.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATXSLEWRATE_ATXPREDRVMODE ,Controls predrivers to adjust timing of turn-on and turn-off of pull-up and pull-down segments. - Recommended settings if the ANIB drives CK pins: -- DDR3 = 3'b000 -- DDR4 = 3'b000 -- LPDDR3 = 3'b000 -- LPDDR4 = 3'b001 - Recommended settings if the ANIB does not drive CK pins: -- DDR3 = 3'b011 -- DDR4 = 3'b011 -- LPDDR3 = 3'b011 -- LPDDR4 = 3'b001 RESET:0x7"
          
rgroup.long 0xac++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATESTPRBSERRCNT, Address Loopback Test Result register RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATESTPRBSERRCNT_ATESTPRBSERRCNT ,Overall error indicator for each prbs bump checker. - Bit [3:0] = Lane0 Error Count - Bit [7:4] = Lane1 Error Count - Bit [11:8] = Lane2 Error Count - Bit [15:12] = Lane3 Error Count RESET:0x0"
          
group.long  0x100++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATXDLY_P0, Address/Command Delay, per pstate. RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_ANIB0_P0_ATXDLY_P0_ATXDLY_P0 ,Trained for LPDDR3/4 to generate timed address and command signals to the DRAMs, per ACX4. For DDR3/DDR4, it is recommended that address and command ACX4 have it ATxDly=0x00 The four signals generated by an ACX4 will have common timing.  - ATxDly[6] is the coarse delay, ie one unit of delay is 1 UI.  - ATxDly[5] is reserved.  - ATxDly[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32. The target ACX4 used for memory clock generation, must have its ATxDly configured to 0x00. RESET:0x0"
          
tree.end
    

