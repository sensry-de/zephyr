         bitfld.long 0x00 17. " DISP_DPHY_DISP_DPHY_INIT_CFG_SW_RESET_DSI_SYS_N ,SW trigger for reset_dsi_sys_n of DPHY, active low RESET:0x0"
          
         bitfld.long 0x00 18. " DISP_DPHY_DISP_DPHY_INIT_CFG_SW_RESET_DSI_PIXEL_N ,SW trigger for reset_dsi_pixel of DPHY, active low RESET:0x0"
          
         bitfld.long 0x00 19. " DISP_DPHY_DISP_DPHY_INIT_CFG_SW_RESET_DCU_N ,SW trigger for reset_dcu of DPHY, active low RESET:0x0"
          
group.long  0x8++0x3
    line.long 0x00 "DISP_DPHY_DISP_DPHY_TX_TEST, DPHY TX test and control interface signals DPHY RESET:0x0"
         bitfld.long 0x00 0. " DISP_DPHY_DISP_DPHY_TX_TEST_T_CLK ,Strobe signal to clock the testdin bus contents into the PHY RESET:0x0"
          
         bitfld.long 0x00 1. " DISP_DPHY_DISP_DPHY_TX_TEST_T_EN ,Vendor-Specific Interface Operation Type Selector. 1 -> address write operation on the falling edge of testclk. 0 -> data write operation on the rising edge of testclk RESET:0x0"
          
         bitfld.long 0x00 2. " DISP_DPHY_DISP_DPHY_TX_TEST_T_CLR ,Interface clear signal that performs vendor-specific interface initialization RESET:0x0"
          
         hexmask.long 0x00 3.--10. 1. " DISP_DPHY_DISP_DPHY_TX_TEST_T_DIN ,Vendor-specific input 8-bit data bus for internal register programming and test functionalities access RESET:0x0"
          
         hexmask.long 0x00 11.--18. 1. " DISP_DPHY_DISP_DPHY_TX_TEST_T_DOUT ,Vendor-Specific 8-bit data bus for read-back and internal probing functionalities RESET:0x0"
          
group.long  0xc++0x3
    line.long 0x00 "DISP_DPHY_DISP_DPHY_RX_TEST, DPHY RX test and control interface signals DPHY RESET:0x0"
         bitfld.long 0x00 0. " DISP_DPHY_DISP_DPHY_RX_TEST_T_CLK ,Strobe signal to clock the testdin bus contents into the PHY RESET:0x0"
          
         bitfld.long 0x00 1. " DISP_DPHY_DISP_DPHY_RX_TEST_T_EN ,Vendor-Specific Interface Operation Type Selector. 1 -> address write operation on the falling edge of testclk. 0 -> data write operation on the rising edge of testclk RESET:0x0"
          
         bitfld.long 0x00 2. " DISP_DPHY_DISP_DPHY_RX_TEST_T_CLR ,Interface clear signal that performs vendor-specific interface initialization RESET:0x0"
          
