         bitfld.long 0x00 3. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYPERFCTRENABLE_CTLUPD0GOODCTL ,Enables CtlUpd0GoodCtr RESET:0x0"
          
         bitfld.long 0x00 4. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYPERFCTRENABLE_CTLUPD1GOODCTL ,Enables CtlUpd1GoodCtr RESET:0x0"
          
         bitfld.long 0x00 5. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYPERFCTRENABLE_MASUPDFAILCTL ,Enables MasUpdFailCtr RESET:0x0"
          
         bitfld.long 0x00 6. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYPERFCTRENABLE_PHYUPD0FAILCTL ,Enables PhyUpd0FailCtr RESET:0x0"
          
         bitfld.long 0x00 7. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYPERFCTRENABLE_PHYUPD1FAILCTL ,Enables PhyUpd1FailCtr RESET:0x0"
          
group.long  0x17c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIWRRDDATACSCONFIG, By default, dfi_wrdata_cs and dfi_rddata_cs are interpreted as active low signals. For LPDDR4, the polarity of dfi_wrdata_cs and dfi_rddata_cs can be inverted. All other protocols shall use the default values. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIWRRDDATACSCONFIG_DFIWRDATACSPOLARITY ,Specifify the dfi_wrdata_cs polarity 1'b0 - Active low 1'b1 - Active high RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIWRRDDATACSCONFIG_DFIRDDATACSPOLARITY ,Specifify the dfi_rddata_cs polarity 1'b0 - Active low 1'b1 - Active high RESET:0x0"
          
group.long  0x186++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLPWRDN, PLL Power Down RESET:0x1"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLPWRDN_PLLPWRDN ,This CSR is written by PHY Initialization Engine (PIE) and the data in here will be overwritten. Places the PLL in Power Down when asserted. RESET:0x1"
          
group.long  0x188++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLRESET, PLL Reset RESET:0x1"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLRESET_PLLRESET ,Reserved RESET:0x1"
          
group.long  0x18a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL2_P0, This csr is to be programmed by bios or other means to set PLL charge-pump settings in various PStates. See Technology specific PHY Databook for control setting programming. RESET:0x19"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL2_P0_PLLFREQSEL ,Adjusts the loop parameters to compensate for different VCO bias points, and input/output clock division ratios. RESET:0x19"
          
group.long  0x18c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0, Note : This CSR is written by PHY Initialization Engine (PIE) and the data in here will be overwritten. RESET:0x2008"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLSTANDBY ,Connects directly to standby pin of PLL. Puts PLL into standbymode. RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLBYPSEL ,Reserved. RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLX2MODE ,connects to x2_mode pins of PLL. pllout_x4x2 output frequency selection. - 0: PLOUT_X4X2 output = 4*pllin_x1 frequency - 1: PLOUT_X4X2 output = 2*pllin_x1 frequency RESET:0x0"
          
         bitfld.long 0x00 3. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLOUTBYPEN ,Controls the antiglitch mux on the pllout_x1x2x4 path - 1: pllout_x1x2x4 = byp_pllin_x1 - 0: pllout_x1x2x4 = VCO (SCD) (selected by x2_mode) RESET:0x1"
          
         bitfld.long 0x00 4. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLPRESET ,Put PLL in preset mode. RESET:0x0"
          
         bitfld.long 0x00 5. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLBYPASSMODE ,PLL Bypass clock mux control. If set, BypassPclk input will be used as byp_pll1x_in clock for PLL. Default 0. RESET:0x0"
          
         bitfld.long 0x00 6. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLSELDFIFREQRATIO ,reserved. RESET:0x0"
          
         bitfld.long 0x00 7. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLSYNCBUSFLUSH ,Used to flush the syncbus logic of the PLL during PHY initialization or LP3 Exit sequence. Should Only be toggled when synbus is not used and Register PllOutBypEn is asserted. RESET:0x0"
          
         bitfld.long 0x00 8. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLSYNCBUSBYP ,When asserted bypasses the Pll SyncPulse and uses a synchronizer of the same latency. RESET:0x0"
          
         hexmask.long 0x00 9.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLRESERVED10X9 ,for future use. RESET:0x0"
          
         bitfld.long 0x00 11. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLGEARSHIFT ,Puts PLL in fast re-locking mode - 0: default, normal mode - 1: fast relock gear RESET:0x0"
          
         bitfld.long 0x00 12. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLLOCKCNTSEL ,Lock detect counter selection. - 0: Normal lock detector behavior phase lock - 1: Test mode (Shorten lock cycle count 16->8) RESET:0x0"
          
         hexmask.long 0x00 13.--14. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLLOCKPHSEL ,Lock detect phase selection. - 0: Test mode reduced lock window - 1: Default operation phase lock - 2: Test mode (mismatch check) - 3: Test mode (+80ps window) RESET:0x1"
          
         bitfld.long 0x00 15. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL0_PLLSPARECTRL0 ,Spare bits for PLL control. RESET:0x0"
          
group.long  0x18e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL1_P0, This csr is to be programmed by bios or other means to set PLL charge-pump settings in various PStates. See Technology specific PHY Databook for control setting programming. RESET:0x20"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL1_P0_PLLCPINTCTRL ,connects directly to cp_int_cntrl<4:0> in PLL. Charge pump integrating current control. RESET:0x0"
          
         hexmask.long 0x00 5.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL1_P0_PLLCPPROPCTRL ,connects directly to cp_prop_cntrl<3:0> of PLL. Charge pump proportional current control. RESET:0x1"
          
group.long  0x190++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLTST, Control Register for PLL Test RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLTST_PLLANATSTEN ,Connects directly to pll_ana_test_en of PLL. Analog test port enable. - 0 = analog test port disabled (hi-Z) - 1 = analog test port enabled RESET:0x0"
          
         hexmask.long 0x00 1.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLTST_PLLANATSTSEL ,Connects directly to pll_ana_test_sel<3:0> of PLL. Control bits are decoded to enable various analog test signals to be brought out via analog test pin (pll_analog_test). Table below provides decode detail.  PllAnaTstSel : Pll Analog Pin Function : Description   - 0000: Hi-Z: This code should be set when the PLL is in normal use or when the digital test port is being used for accurate timing measurements  - 0001: core: Override vmarg_ext with analog pin  - 0010: core: Override regulator input with analog pin  - 0011: core: Observe gd voltage on analog test pin  - 0100: core: Observe vp voltage on analog test pin  - 0101: core: Observe vph voltage on analog test pin  - 0110: core: Observe vreg_cp voltage on analog test pin  - 0111: core: Observe v2i current (~10uA) on analog test pin  - 1000: core: Observe vreg_v2i voltage on analog test pin  - 1001: core: Observe vbp voltage from current source on analog pin  - 1010: core: Observe vbn voltage from current source on analog tpin  - 1011: core: NC  - 1100: core: NC  - 1101: VSS : 0v probe ir drop test  - 1110: VP : Core supply probe SCD IR drop test  - 1111: VPH : Core Supply probe Refdiv IR drop test RESET:0x0"
          
         hexmask.long 0x00 5.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLTST_PLLDIGTSTSEL ,Connects directly to pll_dig_test_sel<2:0> of PLL. Digital test mux select. Control bits are decoded to enable various digital test signals to be brought out via digital test pin, see decoder table for detail.  - PllDigTstOut[1] is observable on BP_ALERT and Digital Observation Pin via MtestMuxSel logic.  - PllDigTstOut[0] is observable on Digital Observation Pin via MtestMuxSel logic only (if enabled in this configuration).  - During mission mode PllDigTstSel should be set to 3'h0.  - Byp = PllBypassMode CSR value  - Sel = PllDigTstSel CSR value Byp | Sel | PllDigTstOut[1] | PllDigTstOut[0] | Description  - 0 | 000 | 0 | 0 | This code should be set during normal use to minimize clock jitter  - 0 | 001 | fbk_clk_ldet | pllin_x1 | Buffered version of fbk_clk at PFD input  - 0 | 010 | ref_clk_ldet | pllin_x1 | Buffered version of ref_clk at PFD input  - 0 | 011 | pllin_x1 | pllin_x1 | For calibrating delay skew between two test outputs - input reference clock  - 0 | 100 | clk_fbk | pllin_x1 | Buffered version of pllout_x1  - 0 | 101 | pllout_amux_x1x2x4 | pllin_x1 | Syncbus clock output (Fout<Fmax_dto only)  - 0 | 110 | en_count | pll_lock | Lock detector state test  - 0 | 111 | standby_eff | eoc | Calibration state test  - 1 | 000 | 0 | 0 | This code should be set during normal use to minimize clock jitter  - 1 | 001 | fbk_clk_ldet | pllin_x1 | Buffered version of fbk_clk at PFD input if PLL in mission/byp 1 modes  - 1 | 010 | ref_clk_ldet | pllin_x1 | Buffered version of ref_clk at PFD input -if PLL in mission/byp 1 modes  - 1 | 011 | pllin_x1 | pllin_x1 | For calibrating delay skew between two test outputs - input reference clock  - 1 | 100 | clk_fbk | pllin_x1 | Buffered version of pllout_x1 if PLL in mission/byp 1 modes  - 1 | 101 | pllout_amux_x1x2x4 | pllin_x1 | Syncbus clock output (Fout<Fmax_dto only)  - 1 | 110 | en_count | pll_lock | Lock detector test if PLL in mission/byp 1 modes  - 1 | 111 | standby_eff | eoc | Calibration state test if PLL in mission/byp 1 modes Note: Fmax_dto=400MHz RESET:0x0"
          
rgroup.long 0x192++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLLOCKSTATUS, PLL's pll_lock pin output RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLLOCKSTATUS_PLLLOCKSTATUS ,Directly connected to the pll_Lock output. When asserted Pll macro has asserted the Lock status. To avoid metastability issues, this register should perform a majority-vote after reading this register several times. RESET:0x0"
          
