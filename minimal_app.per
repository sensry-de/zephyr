tree "TIMER_PWM1"
base e:0x4100b000
width 80.
group.long  0x0++0x3
    line.long 0x00 "TIMER_PWM1_CTRL, Timer Control Register RESET:0x0"
         bitfld.long 0x00 0. " TIMER_PWM1_CTRL_SINGLESHOT ,singleshot mode RESET:0x0"
          
         bitfld.long 0x00 1. " TIMER_PWM1_CTRL_CYCLIC ,cyclic mode RESET:0x0"
          
         bitfld.long 0x00 2. " TIMER_PWM1_CTRL_STOP ,stop mode RESET:0x0"
          
         bitfld.long 0x00 3. " TIMER_PWM1_CTRL_FREEZE ,freezes the timer. Counter will stop counting but will retain its value RESET:0x0"
          
         bitfld.long 0x00 4. " TIMER_PWM1_CTRL_FREEZE_IN_DIS ,when set, ignores the freeze_in signal RESET:0x0"
          
         bitfld.long 0x00 5. " TIMER_PWM1_CTRL_PWM ,enable pulse width modulation. timer mode is not affected RESET:0x0"
          
         bitfld.long 0x00 6. " TIMER_PWM1_CTRL_PDM ,enable pulse density modulation -> timer mode is disabled RESET:0x0"
          
rgroup.long 0x4++0x3
    line.long 0x00 "TIMER_PWM1_STATUS, Status Register RESET:0x0"
         bitfld.long 0x00 0. " TIMER_PWM1_STATUS_RUNNING ,indicates if timer is running (1) or stopped (0) RESET:0x0"
          
group.long  0x8++0x3
    line.long 0x00 "TIMER_PWM1_PRESCALE, Prescale Value Register RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " TIMER_PWM1_PRESCALE_VALUE ,Prescales the clock to counter (CLK_COUNT) w.r.t input clock of timer(CLK_TIM). FREQ_CLK_COUNT = FREQ_CLK_TIM / PRESCALE. NOTE: stop the timer before modifying this field RESET:0x0"
          
group.long  0xc++0x3
    line.long 0x00 "TIMER_PWM1_TARGET, Target Value Register RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " TIMER_PWM1_TARGET_VALUE ,Target value, this write trigger has the highest priority compared to the other registers RESET:0x0"
          
group.long  0x10++0x3
    line.long 0x00 "TIMER_PWM1_DELTA, Defines the duration of the high phase in PWM mode or the pulse density in PDM mode RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " TIMER_PWM1_DELTA_VALUE ,PWM mode: if count < delta, pm_out = 1, else 0 // PDM mode: this is the value for the dithering algorithm RESET:0x0"
          
rgroup.long 0x14++0x3
    line.long 0x00 "TIMER_PWM1_COUNT, Captured Timer Value RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " TIMER_PWM1_COUNT_VALUE ,Captured timer value. This value is valid only if TIMER_READ is enabled in HW. The value is valid after capture.req _> capture_ack register handshake RESET:0x0"
          
group.long  0x18++0x3
    line.long 0x00 "TIMER_PWM1_COUNT_SET, Set Counter Value RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " TIMER_PWM1_COUNT_SET_VALUE ,Set counter value, this write trigger has the highest priority compared to the other registers RESET:0x0"
          
group.long  0x1c++0x3
    line.long 0x00 "TIMER_PWM1_IRQ_STATUS_ENABLE, Status Interrupt Enable Register RESET:0x0"
         bitfld.long 0x00 0. " TIMER_PWM1_IRQ_STATUS_ENABLE_ALARM ,Count reached target value RESET:0x0"
          
         bitfld.long 0x00 1. " TIMER_PWM1_IRQ_STATUS_ENABLE_OVFL ,Count reached target value while alarm is set to one. i.e. The previous alarm was not handled RESET:0x0"
          
group.long  0x20++0x3
    line.long 0x00 "TIMER_PWM1_IRQ_STATUS, Status Interrupt Register RESET:0x0"
         bitfld.long 0x00 0. " TIMER_PWM1_IRQ_STATUS_ALARM ,Count reached target value RESET:0x0"
          
         bitfld.long 0x00 1. " TIMER_PWM1_IRQ_STATUS_OVFL ,Count reached target value while alarm is set to one. i.e. The previous alarm was not handled RESET:0x0"
          
wgroup.long 0x24++0x3
    line.long 0x00 "TIMER_PWM1_IRQ_STATUS_SET, Set irq_status register bits. Used to the emulate interrupt event (for SW debug or dev). RESET:0x0"
         bitfld.long 0x00 0. " TIMER_PWM1_IRQ_STATUS_SET_ALARM ,Set alarm irq RESET:0x0"
          
         bitfld.long 0x00 1. " TIMER_PWM1_IRQ_STATUS_SET_OVFL ,Set ovfl irq RESET:0x0"
          
tree.end

