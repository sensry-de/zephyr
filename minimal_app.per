         hexmask.long 0x00 12.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIFREQXLAT7_DFIFREQXLATVAL31 ,The sequencer start vector used when dfi_freq value is 31. RESET:0x0"
          
group.long  0x1f0++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXRDPTRINIT, TxRdPtrInit control register RESET:0x1"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_TXRDPTRINIT_TXRDPTRINIT ,This register directly controls TxRdPtrInit, and is meant to be written by the PState sequencer as part of the power state switching sequence. It should be written to a 1 once the transition to LP2 is complete and:  - 32 cycles before the de-asserting of init_complete. Likewise it should    be written to 0 once the transition to an active PState is complete and  - 32 cycles before the assertion of init_complete. It should reset to a 1  on both warm and cold reset. RESET:0x1"
          
group.long  0x1f2++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIINITCOMPLETE, DFI Init Complete control RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIINITCOMPLETE_DFIINITCOMPLETE ,This register directly controls DfiInitComplete, and is meant to be written by the PState sequencer as part of the power state switching sequence.  - It should be written to a 0 once the transition to LP2 is complete.  - Likewise it should be written to 1 once the transition to an active and PState is complete.  - It should reset to a 0 on both warm and cold reset. RESET:0x0"
          
group.long  0x1f4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIFREQRATIO_P0, DFI Frequency Ratio RESET:0x1"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_DFIFREQRATIO_P0_DFIFREQRATIO_P0 ,Specifies the ratio DfiCtlClk:MemClk.  - 00 = 1:1 mode  - 01 = 1:2 mode  - 1x = 1:4 mode When DWC_DDRPHY_FIXED_DFICTLCLK_RATIO is defined, this register is ignored and 1:2 mode is selected. RESET:0x1"
          
group.long  0x1f6++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_RXFIFOCHECKS, Enable more frequent consistency checks of the RX FIFOs RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_RXFIFOCHECKS_DOFREQUENTRXFIFOCHECKS ,- When 0, read data FIFO pointer consistency checks are performed only during sideband transactions(i.e., phyupd, ctrlupd, lp_data, phymstr) or when dfi_init_start is asserted. This option relies upon intentional quiescing of the DFI interface in order for the check to be performed. - When 1, read data FIFO consistency checks are performed as when this bit is 0, and also  at the beginning of each break in read data traffic from the DRAM. This options provides the lowest  latency in reporting of a discrepancy in the read data FIFO pointer values. RESET:0x0"
          
group.long  0x1fe++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MTESTDTOCTRL, If set, allows the MTestCombo observability signal to be routed out core-side through the dwc_ddrphy_dto pin RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MTESTDTOCTRL_MTESTDTOEN ,This field is programmed as follows: - MTESTdtoEn==[0], dwc_ddrphy_dto will be squelched (0) - MTESTdtoEn==[1], dwc_ddrphy_dto will reflect the observability signal multiplexed on MTestCombo RESET:0x0"
          
group.long  0x200++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MAPCAA0TODFI, Maps PHY CAA lane 0 from dfi0_address of the index of the register contents. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MAPCAA0TODFI_MAPCAA0TODFI ,For LPDDR3 and LPDDR4 applications, these CSRs map a dfi0_address to CAA 0.  Unused for DDR3 and unused for DDR4 applications. Each register in the set of MapCAAtoDfi must have a unique value within the set.  For example, if PHY CAA0 is mapped from dfi0_address[2], then Register MapCAA0toDfi should be 2.  - LPDDR4 ACX3,ACX6,ACX10,ACX12 registers MapCAA[0..5]toDfi are used  -- values 0-5 are valid,  -- values 6-15 are reserved  -- registers MapCAA[6..9]toDfi are reserved  - LPDDR3 ACX3: not supported  - LPDDR3 ACX6,ACX10,ACX12: registers MapCAA[0..9]toDfi are used  -- values 0-9 are valid,  -- values 10-15 are reserved  - LPDDR3 ACX6,ACX10,ACX12: registers MapCAA[0..9]toDfi are used  -- values 0-9 are valid,  -- values 10-15 are reserved RESET:0x0"
          
group.long  0x202++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MAPCAA1TODFI, Maps PHY CAA lane 1 from dfi0_address of the index of the register contents. RESET:0x1"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MAPCAA1TODFI_MAPCAA1TODFI ,For LPDDR3 and LPDDR4 applications, these CSRs map a dfi0_address to CAA 1.  Unused for DDR3 and unused for DDR4 applications. Each register in the set of MapCAAtoDfi must have a unique value within the set.  For example, if PHY CAA1 is mapped from dfi0_address[2], then Register MapCAA1toDfi should be 2.  - LPDDR4 ACX3,ACX6,ACX10,ACX12 registers MapCAA[0..5]toDfi are used  -- values 0-5 are valid,  -- values 6-15 are reserved  -- registers MapCAA[6..9]toDfi are reserved  - LPDDR3 ACX3: not supported  - LPDDR3 ACX6,ACX10,ACX12: registers MapCAA[0..9]toDfi are used  -- values 0-9 are valid,  -- values 10-15 are reserved  - LPDDR3 ACX6,ACX10,ACX12: registers MapCAA[0..9]toDfi are used  -- values 0-9 are valid,  -- values 10-15 are reserved RESET:0x1"
          
