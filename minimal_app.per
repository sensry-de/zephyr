         hexmask.long 0x00 0.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P1_TXDQDLYTG3_R8_P1_TXDQDLYTG3_R8_P1 ,Write DQ Delay (Timing Group 3). Trained to center the delay between the write DQ to the write DQS.  - Tx DQ Delay ( 9 bits, includes 3b coarse and 6b fine delays); (For Timing Group 3)  - TxDqDlyTg3[8:6] is the coarse delay, ie one unit of delay is 1 UI.  - TxDqDlyTg3[4:0] is the fine (fractional UI) delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - TxDqDlyTg3[5] is reserved.  - Register Block Offset Address 0x0C3 controls the lane0 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x1C3 controls the lane1 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x2C3 controls the lane2 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x3C3 controls the lane3 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x4C3 controls the lane4 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x5C3 controls the lane5 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x6C3 controls the lane6 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x7C3 controls the lane7 write DQ timing. (For Timing Group 3)  - Register Block Offset Address 0x8C3 controls the lane[DMDBI] write DQ timing. (For Timing Group 3) Note: These Registers are replicated per pstate.  Note: Timing Group 3 = RANK3. RESET:0x10"
          
tree.end

tree "LPDDR4_PUB__DWC_DDRPHYA_DBYTE1_P1"
base e:0x42222000
width 80.
group.long  0x6++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_USEDQSENREPLICA_P1, Reserved for PHY training firmware use. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_USEDQSENREPLICA_P1_USEDQSENREPLICA_P1 ,Reserved for PHY training firmware use. RESET:0x0"
          
group.long  0x40++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_DFIMRL_P1, DFI MaxReadLatency RESET:0x6"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_DFIMRL_P1_DFIMRL_P1 ,This Max Read Latency CSR is to be trained to ensure the rx-data fifo is not read until after all dbytes have their read data valid. This is the value, in units of two mem clocks, between dfi_rddata_en and dfi_rddata_valid A unit change in the LSB is a change in MRL of two mem clocks. RESET:0x6"
          
group.long  0x82++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXIMPEDANCECTRL0_B0_P1, - Tx DQ driver impedance when equalization is enabled per nibble. - Register Block Offset Address 0x041 controls the lower DQ nibble - Register Block Offset Address 0x141 controls the upper DQ nibble RESET:0xfff"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXIMPEDANCECTRL0_B0_P1_DRVSTRENDQP ,Refer to Technology specific PHY DATABOOK for supported options. The 6-bit bus is used to select the target pull-down output impedance. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStren120P[2:0], Csr_DrvStren240P[1:0],Csr_DrvStren480P[0:0]] = [csrDrvStrenDqP]  - 000000 - HiZ.  - 000001 - 480.0  - 000010 - 240.0  - 000011 - 160.0  - 001000 - 120.0  - 001001 - 96.0  - 001010 - 80.0  - 001011 - 68.6  - 011000 - 60.0  - 011001 - 53.3  - 011010 - 48.0  - 011011 - 43.6  - 111000 - 40.0  - 111001 - 36.9  - 111010 - 34.3  - 111011 - 32.0  - 111110 - 30.0  - 111111 - 28.2 RESET:0x3f"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXIMPEDANCECTRL0_B0_P1_DRVSTRENDQN ,Refer to Technology specific PHY DATABOOK for supported options. This 6-bit bus is used to select the target pull-down output impedance. Connects to the DrvStren pins of the driver thus:  [Csr_DrvStren120N[2:0],Csr_DrvStren240N[1:0],Csr_DrvStren480N[0:0]] = [csrDrvStrenDqN]  Note:See table of csr DrvStrenDqP for list of possible impedances. RESET:0x3f"
          
group.long  0x86++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_DQDQSRCVCNTRL_B0_P1, Connected to the rxdqs and rxdq Mode selects and trim controls, per nibble.  - Register Block Offset Address 0x043 controls the lower DQ nibble  - Register Block Offset Address 0x143 controls the upper DQ nibble This DFE feature may be used with MajorModeDbyte=011 only. RESET:0x5b0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_DQDQSRCVCNTRL_B0_P1_SELANALOGVREF ,Setting this signal high will force the local per-bit VREF generator to pass the global VREFA to the samplers. RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_DQDQSRCVCNTRL_B0_P1_EXTVREFRANGE ,Extends the range available in the local per-bit VREF generator. RESET:0x0"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_DQDQSRCVCNTRL_B0_P1_DFECTRL ,This field is programmable as follows  - 00 - DFE off  - 01 - DFE on  - 10 - Train DFE0 Amplifier  - 11 - Train DFE1 Amplifier These settings are determined by PHY Training FW and should not be overridden. RESET:0x0"
          
         hexmask.long 0x00 4.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_DQDQSRCVCNTRL_B0_P1_MAJORMODEDBYTE ,Selects the major mode of operation for the receiver. These settings are determined by PHY Configuration based on DRAM protocol  - 000 - Input signal is terminated/referenced to VDDQ/2 (or unterminated)  - 001 - reserved  - 010 - Input signal is terminated/referenced to VSSQ  - 011 - Input signal is terminated/referenced to VDDQ  - 100 - reserved  - 101 - reserved  - 110 - reserved  - 111 - reserved RESET:0x3"
          
         hexmask.long 0x00 7.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_DQDQSRCVCNTRL_B0_P1_GAINCURRADJ ,Adjust gain current of RX amplifier stage. It is recommended to use default values for this CSR. RESET:0xb"
          
          
group.long  0x90++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXEQUALIZATIONMODE_P1, Tx DQ driver equalization is a technique for improving the write-data eye at the DRAMs. The driver can drive with full strength (configured with DrvStrenFSHiDqP and DrvStrenFSLoDqN0 or with weak strength (configured with DrvStrenEQHiDqP and DrvStrenEQLoDqN) depending on the dq value sequence.  - TxEqMode = 00 Off; drive with full strength only  - TxEqMode = 01 Mode0 drive with full strength.or weak strength depending on  present logical value and the previous logical value.  - TxEqMode = 10 Mode1 drive with full strength.or weak strength depending on  present logical value and the next logical value. Mode1 is a lower power mode.  - TxEqMode = 11 reserved RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXEQUALIZATIONMODE_P1_TXEQMODE ,Tx dq driver equalization mode controls. FFE, de-emphasis DDR43 PHY ONLY RESET:0x0"
          
group.long  0x92++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXIMPEDANCECTRL1_B0_P1, Tx impedance of DQ driver cells when equalization is disabled. - Register Block Offset Address 0x049 controls the lower DQ nibble - Register Block Offset Address 0x149 controls the upper DQ nibble RESET:0xfff"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXIMPEDANCECTRL1_B0_P1_DRVSTRENFSDQP ,Refer to Technology specific PHY DATABOOK for supported options This 6-bit bus is used to select the target pull-up output impedance. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStrenFS120P[2:0], Csr_DrvStrenFS240P[1:0], Csr_DrvStrenFS480P[0]] = [csrFSDrvStrenDq]  - 000000 - HiZ.  - 000001 - 480.0  - 000010 - 240.0  - 000011 - 160.0  - 001000 - 120.0  - 001001 - 96.0  - 001010 - 80.0  - 001011 - 68.6  - 011000 - 60.0  - 011001 - 53.3  - 011010 - 48.0  - 011011 - 43.6  - 111000 - 40.0  - 111001 - 36.9  - 111010 - 34.3  - 111011 - 32.0  - 111110 - 30.0  - 111111 - 28.2 RESET:0x3f"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXIMPEDANCECTRL1_B0_P1_DRVSTRENFSDQN ,Refer to Technology specific PHY DATABOOK for supported options. This 6-bit bus is used to select the target pull-down output impedance. Connects to the DrvStren pins of the driver thus:  [Csr_DrvStrenFS120N[2:0], Csr_DrvStrenFS240N[1:0], Csr_DrvStrenFS480N[0:0]] = [csrDrvStrenDqN]  Note: See table of csr DrvStrenFSDqP for list of possible impedances. RESET:0x3f"
          
group.long  0x96++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXIMPEDANCECTRL2_B0_P1, Tx DQ driver opposition impedance when equalization is enabled. - Register Block Offset Address 0x04b controls the lower DQ nibble - Register Block Offset Address 0x14b controls the upper DQ nibble RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXIMPEDANCECTRL2_B0_P1_DRVSTRENEQHIDQP ,Refer to Technology specific PHY DATABOOK for supported options This 6-bit bus is used to select the target pull-up output impedance used in equalization. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStrenEQHi120P[2:0], Csr_DrvStrenEQHi240P[1:0], Csr_DrvStrenEQHi480P[0]] = [csrDrvStrenEQHiDq] RESET:0x0"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXIMPEDANCECTRL2_B0_P1_DRVSTRENEQLODQN ,Refer to Technology specific PHY DATABOOK for supported options This 6-bit bus is used to select the target pull-down output impedance used in equalization. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStrenEQLo120N[2:0], Csr_DrvStrenEQLo240N[1:0], Csr_DrvStrenEQLo480P[0]] = [csrDrvStrenEQLoDq] RESET:0x0"
          
group.long  0x98++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_DQDQSRCVCNTRL2_P1, Control for an aggressive power-saving feature to powerdown dq and dqs receiver cells dynamically. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_DQDQSRCVCNTRL2_P1_ENRXAGRESSIVEPDR ,reserved RESET:0x0"
          
group.long  0x9a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXODTDRVSTREN_B0_P1, Selects desired impedance value for Host ODT. Must be set by user before PHY initialization. Setting for each protocol: DDR3:  - OdtStrenP - non-zero value  - OdtStrenN - same as OdtStrenP LPDDR3:  - OdtStrenP - non-zero value  - OdtStrenN - high-impedance DDR4:  - OdtStrenP - non-zero value  - OdtStrenN - high-impedance LPDDR4:  - OdtStrenP - high-impedance  - OdtStrenN - non-zero value  - Register Block Offset Address 0x04d controls the lower DQ nibble  - Register Block Offset Address 0x14d controls the upper DQ nibble RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXODTDRVSTREN_B0_P1_ODTSTRENP ,Selects the ODT pull-up impedance.  Refer to Technology specific PHY DATABOOK for supported options  - [ODTStren120P[2:0], ODTStren240P[1:0],ODTStren480P[0:0]]  - 000_00_0 = High Impedance  - 000_00_1 = 480 ohms  - 000_01_0 = 240 ohms  - 000_01_1 = 160 ohms  - 001_00_0 = 120 ohms  - 001_00_1 = 96.0 ohms  - 001_01_0 = 80.0 ohms  - 001_01_1 = 68.6 ohms  - 011_00_0 = 60.0 ohms  - 011_00_1 = 53.3 ohms  - 011_01_0 = 48.0 ohms  - 011_01_1 = 43.6 ohms  - 111_00_0 = 40.0 ohms  - 111_00_1 = 36.9 ohms  - 111_01_0 = 34.3 ohms  - 111_01_1 = 32.0 ohms  - 111_11_0 = 30.0 ohms  - 111_11_1 = 28.2 ohms RESET:0x0"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXODTDRVSTREN_B0_P1_ODTSTRENN ,Selects the ODT pull-down impedance.  Refer to Technology specific PHY DATABOOK for supported options  - [ODTStren120N[2:0], ODTStren240N[1:0],ODTStren480N[0:0]]  - 000_00_0 = High Impedance  - 000_00_1 = 480 ohms  - 000_01_0 = 240 ohms  - 000_01_1 = 160 ohms  - 001_00_0 = 120 ohms  - 001_00_1 = 96.0 ohms  - 001_01_0 = 80.0 ohms  - 001_01_1 = 68.6 ohms  - 011_00_0 = 60.0 ohms  - 011_00_1 = 53.3 ohms  - 011_01_0 = 48.0 ohms  - 011_01_1 = 43.6 ohms  - 111_00_0 = 40.0 ohms  - 111_00_1 = 36.9 ohms  - 111_01_0 = 34.3 ohms  - 111_01_1 = 32.0 ohms  - 111_11_0 = 30.0 ohms  - 111_11_1 = 28.2 ohms RESET:0x0"
          
group.long  0xbe++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXSLEWRATE_B0_P1, Controls slew rates of the DQ/DQS drivers per nibble. - Tx predriver cal trims driver timing to account for clock duty cycle variation. - Register Block Offset Address 0x05f is the TxSlewRate for the lower nibble. - Register Block Offset Address 0x15f is the TxSlewRate for the upper nibble. RESET:0x7ff"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXSLEWRATE_B0_P1_TXPREP ,This is the 4-bit binary trim for the driver pull-up slew rate. 4'b0000 has a slower slew rate than 4'b1111 RESET:0xf"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXSLEWRATE_B0_P1_TXPREN ,4 bit binary trim for the driver pull-down slew rate. 4'b0000 has a slower slew rate than 4'b1111 RESET:0xf"
          
         hexmask.long 0x00 8.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_TXSLEWRATE_B0_P1_TXPREDRVMODE ,Controls predrivers to adjust timing of turn-on and turn-off of pull-up and pull-down segments. Recommended settings:  - DDR3 = 3'b011.  - DDR4 = 3'b010.  - LPDDR3 = 3'b010.  - LPDDR4 = 3'b001 RESET:0x7"
          
group.long  0x100++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXENDLYTG0_U0_P1, Trained Receive Enable Delay. (For Timing Group 0) RESET:0x100"
         hexmask.long 0x00 0.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXENDLYTG0_U0_P1_RXENDLYTG0_U0_P1 ,Trained Receive Enable Delay. (For Timing Group 0) Trained to set the delay from the memory-read command to the signal enabling the read DQS to generate read-data strobes. The trained read DQS enable asserts during the read DQS preamble and deasserts at the end of the read burst.  - RxEnDlyTg0[10:6] is the coarse delay, ie one unit of delay is 1 UI.  - RxEnDlyTg0[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - RxEnDlyTg0[5] is reserved.  - Register Block Offset Address 0x080 controls the lower DQ nibble DqsEn. (For Timing Group 0)  - Register Block Offset Address 0x180 controls the upper DQ nibble DqsEn. (For Timing Group 0) Note: These Registers are replicated per pstate.  Note: Timing Group 0 = RANK0. RESET:0x100"
          
group.long  0x102++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXENDLYTG1_U0_P1, Trained Receive Enable Delay. (For Timing Group 1) RESET:0x100"
         hexmask.long 0x00 0.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXENDLYTG1_U0_P1_RXENDLYTG1_U0_P1 ,Trained Receive Enable Delay. (For Timing Group 1) Trained to set the delay from the memory-read command to the signal enabling the read DQS to generate read-data strobes. The trained read DQS enable asserts during the read DQS preamble and deasserts at the end of the read burst.  - RxEnDlyTg1[10:6] is the coarse delay, ie one unit of delay is 1 UI.  - RxEnDlyTg1[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - RxEnDlyTg1[5] is reserved.  - Register Block Offset Address 0x081 controls the lower DQ nibble DqsEn. (For Timing Group 1)  - Register Block Offset Address 0x181 controls the upper DQ nibble DqsEn. (For Timing Group 1) Note: These Registers are replicated per pstate.  Note: Timing Group 1 = RANK1. RESET:0x100"
          
group.long  0x104++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXENDLYTG2_U0_P1, Trained Receive Enable Delay. (For Timing Group 2) RESET:0x100"
         hexmask.long 0x00 0.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXENDLYTG2_U0_P1_RXENDLYTG2_U0_P1 ,Trained Receive Enable Delay. (For Timing Group 2) Trained to set the delay from the memory-read command to the signal enabling the read DQS to generate read-data strobes. The trained read DQS enable asserts during the read DQS preamble and deasserts at the end of the read burst.  - RxEnDlyTg2[10:6] is the coarse delay, ie one unit of delay is 1 UI.  - RxEnDlyTg2[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - RxEnDlyTg2[5] is reserved.  - Register Block Offset Address 0x082 controls the lower DQ nibble DqsEn. (For Timing Group 2)  - Register Block Offset Address 0x182 controls the upper DQ nibble DqsEn. (For Timing Group 2) Note: These Registers are replicated per pstate.  Note: Timing Group 2 = RANK2. RESET:0x100"
          
group.long  0x106++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXENDLYTG3_U0_P1, Trained Receive Enable Delay. (For Timing Group 3) RESET:0x100"
         hexmask.long 0x00 0.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXENDLYTG3_U0_P1_RXENDLYTG3_U0_P1 ,Trained Receive Enable Delay. (For Timing Group 3) Trained to set the delay from the memory-read command to the signal enabling the read DQS to generate read-data strobes. The trained read DQS enable asserts during the read DQS preamble and deasserts at the end of the read burst.  - RxEnDlyTg3[10:6] is the coarse delay, ie one unit of delay is 1 UI.  - RxEnDlyTg3[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - RxEnDlyTg3[5] is reserved.  - Register Block Offset Address 0x083 controls the lower DQ nibble DqsEn. (For Timing Group 3)  - Register Block Offset Address 0x183 controls the upper DQ nibble DqsEn. (For Timing Group 3) Note: These Registers are replicated per pstate.  Note: Timing Group 3 = RANK3. RESET:0x100"
          
group.long  0x118++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXCLKDLYTG0_U0_P1, Trained Read DQS to RxClk Delay (Timing Group DEST=0). RESET:0x10"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXCLKDLYTG0_U0_P1_RXCLKDLYTG0_U0_P1 ,Trained Read DQS to RxClk Delay (Timing Group DEST=0). Trained to generate read DQ receive clock from the received read DQS.  - RxClk Delay (6 bits, fine delay only); (For Timing Group 0)  - RxClkDlyTg0[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - RxClkDlyTg0[5] is reserved. There is no coarse delay field, ie the max configurable delay is 31/32 UI.  - Register Block Offset Address 0x08c controls the lower DQ nibble RxClk timing. (For Timing Group 0)  - Register Block Offset Address 0x18c controls the upper DQ nibble RxClk timing. (For Timing Group 0) Note: These Registers are replicated per pstate.  Note: Timing Group 0 = RANK0. RESET:0x10"
          
group.long  0x11a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXCLKDLYTG1_U0_P1, Trained Read DQS to RxClk Delay (Timing Group DEST=1). RESET:0x10"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXCLKDLYTG1_U0_P1_RXCLKDLYTG1_U0_P1 ,Trained Read DQS to RxClk Delay (Timing Group DEST=1). Trained to generate read DQ receive clock from the received read DQS.  - RxClk Delay (6 bits, fine delay only); (For Timing Group 1)  - RxClkDlyTg1[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - RxClkDlyTg1[5] is reserved. There is no coarse delay field, ie the max configurable delay is 31/32 UI.  - Register Block Offset Address 0x08d controls the lower DQ nibble RxClk timing. (For Timing Group 1)  - Register Block Offset Address 0x18d controls the upper DQ nibble RxClk timing. (For Timing Group 1) Note: These Registers are replicated per pstate.  Note: Timing Group 1 = RANK1. RESET:0x10"
          
group.long  0x11c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXCLKDLYTG2_U0_P1, Trained Read DQS to RxClk Delay (Timing Group DEST=2). RESET:0x10"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXCLKDLYTG2_U0_P1_RXCLKDLYTG2_U0_P1 ,Trained Read DQS to RxClk Delay (Timing Group DEST=2). Trained to generate read DQ receive clock from the received read DQS.  - RxClk Delay (6 bits, fine delay only); (For Timing Group 2)  - RxClkDlyTg2[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - RxClkDlyTg2[5] is reserved. There is no coarse delay field, ie the max configurable delay is 31/32 UI.  - Register Block Offset Address 0x08e controls the lower DQ nibble RxClk timing. (For Timing Group 2)  - Register Block Offset Address 0x18e controls the upper DQ nibble RxClk timing. (For Timing Group 2) Note: These Registers are replicated per pstate.  Note: Timing Group 2 = RANK2. RESET:0x10"
          
group.long  0x11e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXCLKDLYTG3_U0_P1, Trained Read DQS to RxClk Delay (Timing Group DEST=3). RESET:0x10"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P1_RXCLKDLYTG3_U0_P1_RXCLKDLYTG3_U0_P1 ,Trained Read DQS to RxClk Delay (Timing Group DEST=3). Trained to generate read DQ receive clock from the received read DQS.  - RxClk Delay (6 bits, fine delay only); (For Timing Group 3)  - RxClkDlyTg3[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - RxClkDlyTg3[5] is reserved. There is no coarse delay field, ie the max configurable delay is 31/32 UI.  - Register Block Offset Address 0x08f controls the lower DQ nibble RxClk timing. (For Timing Group 3)  - Register Block Offset Address 0x18f controls the upper DQ nibble RxClk timing. (For Timing Group 3) Note: These Registers are replicated per pstate.  Note: Timing Group 3 = RANK3. RESET:0x10"
          
