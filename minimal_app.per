tree "LPDDR4_PUB__DWC_DDRPHYA_MASTER0_P2"
base e:0x42440000
width 80.
group.long  0x10++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_CALUCLKINFO_P2, Informs the impedance calibration engine about frequency of DfiClk RESET:0x320"
         hexmask.long 0x00 0.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_CALUCLKINFO_P2_CALUCLKTICKSPER1US ,Must be programmed to the number of DfiClks in 1us (rounded up), with minimum value of 24. - if (DfiClk < 24MHz) CalUclkInfo = 24 - else CalUclkInfo = (number of DfiClks in 1us) RESET:0x320"
          
group.long  0x16++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_SEQ0BDLY0_P2, PHY Initialization Engine (PIE) Delay Register 0 RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_SEQ0BDLY0_P2_SEQ0BDLY0_P2 ,PHY Initialization Engine (PIE) Delay Register 0. This register is available for selection by the NOP and WAIT instructions in the PIE for the delay value. Programmed by dwc_ddrphy_phyinit_I_loadPIEImage() to support frequency changes.  Programming Seq0BDLY[3,2,1,0] Registers:  - These registers are used to control various delays during PLL, DLL initialization.  - These registers should be programmed with the corresponding number of MEMCLK cycles representing a fixed amount of delay irrespective of DfiClk Frequency.  - When calculating the number of cycles to be programmed for each PState, it should be noted that the sequencer multiplies programmed values by a factor of 8 and values are round down to the closest integer.  Register | Required Delay | Programmed Value   - Seq0BDLY0 | 0.5us | ( 0.5us / MEMCLK period) / 8)  - Seq0BDLY1 | 1.0us | ( 1.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | (10.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | 64/4 if (MEMCLK Freq <= 400MHz)  - Seq0BDLY3 | - | 132/4 if (400MHz Freq < MEMCLK Freq <= 533MHz)  - Seq0BDLY3 | - | 176/4 if (MEMCLK Freq > 533MHz) RESET:0x0"
          
group.long  0x18++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_SEQ0BDLY1_P2, PHY Initialization Engine (PIE) Delay Register 1 RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_SEQ0BDLY1_P2_SEQ0BDLY1_P2 ,PHY Initialization Engine (PIE) Delay Register 1. This register is available for selection by the NOP and WAIT instructions in the PIE for the delay value. Programmed by dwc_ddrphy_phyinit_I_loadPIEImage() to support frequency changes.  Programming Seq0BDLY[3,2,1,0] Registers:  - These registers are used to control various delays during PLL, DLL initialization.  - These registers should be programmed with the corresponding number of MEMCLK cycles representing a fixed amount of delay irrespective of DfiClk Frequency.  - When calculating the number of cycles to be programmed for each PState, it should be noted that the sequencer multiplies programmed values by a factor of 8 and values are round down to the closest integer.  Register | Required Delay | Programmed Value   - Seq0BDLY0 | 0.5us | ( 0.5us / MEMCLK period) / 8)  - Seq0BDLY1 | 1.0us | ( 1.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | (10.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | 64/4 if (MEMCLK Freq <= 400MHz)  - Seq0BDLY3 | - | 132/4 if (400MHz Freq < MEMCLK Freq <= 533MHz)  - Seq0BDLY3 | - | 176/4 if (MEMCLK Freq > 533MHz) RESET:0x0"
          
group.long  0x1a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_SEQ0BDLY2_P2, PHY Initialization Engine (PIE) Delay Register 2 RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_SEQ0BDLY2_P2_SEQ0BDLY2_P2 ,PHY Initialization Engine (PIE) Delay Register 2. This register is available for selection by the NOP and WAIT instructions in the PIE for the delay value. Programmed by dwc_ddrphy_phyinit_I_loadPIEImage() to support frequency changes.  Programming Seq0BDLY[3,2,1,0] Registers:  - These registers are used to control various delays during PLL, DLL initialization.  - These registers should be programmed with the corresponding number of MEMCLK cycles representing a fixed amount of delay irrespective of DfiClk Frequency.  - When calculating the number of cycles to be programmed for each PState, it should be noted that the sequencer multiplies programmed values by a factor of 8 and values are round down to the closest integer.  Register | Required Delay | Programmed Value   - Seq0BDLY0 | 0.5us | ( 0.5us / MEMCLK period) / 8)  - Seq0BDLY1 | 1.0us | ( 1.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | (10.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | 64/4 if (MEMCLK Freq <= 400MHz)  - Seq0BDLY3 | - | 132/4 if (400MHz Freq < MEMCLK Freq <= 533MHz)  - Seq0BDLY3 | - | 176/4 if (MEMCLK Freq > 533MHz) RESET:0x0"
          
group.long  0x1c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_SEQ0BDLY3_P2, PHY Initialization Engine (PIE) Delay Register 3 RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_SEQ0BDLY3_P2_SEQ0BDLY3_P2 ,PHY Initialization Engine (PIE) Delay Register 3. This register is available for selection by the NOP and WAIT instructions in the PIE for the delay value. Programmed by dwc_ddrphy_phyinit_I_loadPIEImage() to support frequency changes.  Programming Seq0BDLY[3,2,1,0] Registers:  - These registers are used to control various delays during PLL, DLL initialization.  - These registers should be programmed with the corresponding number of MEMCLK cycles representing a fixed amount of delay irrespective of DfiClk Frequency.  - When calculating the number of cycles to be programmed for each PState, it should be noted that the sequencer multiplies programmed values by a factor of 8 and values are round down to the closest integer.  Register | Required Delay | Programmed Value   - Seq0BDLY0 | 0.5us | ( 0.5us / MEMCLK period) / 8)  - Seq0BDLY1 | 1.0us | ( 1.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | (10.0us / MEMCLK period) / 8)  - Seq0BDLY2 | 10.0us | 64/4 if (MEMCLK Freq <= 400MHz)  - Seq0BDLY3 | - | 132/4 if (400MHz Freq < MEMCLK Freq <= 533MHz)  - Seq0BDLY3 | - | 176/4 if (MEMCLK Freq > 533MHz) RESET:0x0"
          
group.long  0x20++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PPTTRAINSETUP_P2, For LPDDR3/4 some tracking is required periodically using the DFI PHY MASTER interface. This register control the interval. Setting the register to 0 completely disables the PHY Master Interface. Programmed by dwc_ddrphy_phyinit_I_loadPIEImage() to support LPDDR3/LPDDR4 DRAM drift compensation. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PPTTRAINSETUP_P2_PHYMSTRTRAININTERVAL ,Bits 3:0 of this register specifies the time between the end of one training and the start of the next. Note that, to account for the delay to receive the acknowledge from the MC, the dfi_phymstr_req signal is asserted in advance so that the effective update (after acknowledge from the MC) occurs inside the interval defined by PhyMstrTrainInterval.  - 4'b0000 Disable PHY Master Interface  - 4'b0001 PHY MASTER Request Interval = 524288 MEMCLKs  - 4'b0010 PHY MASTER Request Interval = 1048576 MEMCLKs  - 4'b0011 PHY MASTER Request Interval = 2097152 MEMCLKs  - 4'b0100 PHY MASTER Request Interval = 4194304 MEMCLKs  - 4'b0101 PHY MASTER Request Interval = 8388608 MEMCLKs  - 4'b0110 PHY MASTER Request Interval = 16777216 MEMCLKs  - 4'b0111 PHY MASTER Request Interval = 33554432 MEMCLKs  - 4'b1000 PHY MASTER Request Interval = 67108864 MEMCLKs  - 4'b1001 PHY MASTER Request Interval = 134217728 MEMCLKs  - 4'b1010 PHY MASTER Request Interval = 268435456 MEMCLKs  - 4'b1011 - 4'b1111 PHY MASTER Request Interval = undefined RESET:0x0"
          
         hexmask.long 0x00 4.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PPTTRAINSETUP_P2_PHYMSTRMAXREQTOACK ,The value in bits 6:4 of this register specify the max time from tdfi_phymstr_req asserted to tdfi_phymstr_ack asserted. If the request is not acknowledged by this time, dfi_error will be asserted.  - 3'b000 Disable PHY Master Interface  - 3'b001 set tPHYMSTR_resp. = 512 MEMCLKs  - 3'b010 set tPHYMSTR_resp. = 1024 MEMCLKs  - 3'b011 set tPHYMSTR_resp. = 2048 MEMCLKs  - 3'b100 set tPHYMSTR_resp. = 4096 MEMCLKs  - 3'b101 set tPHYMSTR_resp. = 8192 MEMCLKs  - 3'b110 set tPHYMSTR_resp. = 32768 MEMCLKs  - 3'b111 set tPHYMSTR_resp. = undefined  Note: The above are nominal values. The actual values are reduced by (2 + (DWC_DDRPHY_PIPE_DFI_MISC * MEMCLK/DfiCtlClk)) * 2  Note: This signal interacts with dfi_phyupd_req. See Section Collisions Between PHY Update and DFI LP of the PUB Databook. RESET:0x0"
          
group.long  0x22++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PPTTRAINSETUP2_P2, Programmed by PHY training firmware to support LPDDR3/LPDDR4 DRAM drift compensation. RESET:0x2"
         hexmask.long 0x00 0.--2. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PPTTRAINSETUP2_P2_RFU_PPTTRAINSETUP2_P2 ,None RESET:0x2"
          
group.long  0x32++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_TRISTATEMODECA_P2, This register is used to control the PHY Dynamic Address/Command Tristate Feature, and the stopped MEMCLK state. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_TRISTATEMODECA_P2_DISDYNADRTRI ,When DisDynAdrTri=1, Dynamic Tristating is disabled. Dynamic Tristating is on by default. Dynamic Tristating should be disabled (DisDynAdrTri=1) for these modes:  - DR3/2T if the controller cannot follow the 2T PHY tristate protocol.  - DDR4/2T/2N if the controller cannot follow the 2T PHY tristate protocol.  - LPDDR4 When DisDynAdrTri=0 (default),  - In DDR4 mode, The following SDRAM pins can be dynamically tristated: A,BA,BG,ACT_n  - In LPDDR3 mode, The following SDRAM pins can be dynamically tristated: CA[*]  - In 1T mode, the PHY will tristate the relevant pins when all ranks are DESelected  - In 2T mode (or geardown), the PHY will tristate the relevant pins when:  -- DDR3 -- All ranks DESelected (all CS_L==1) AND [RAS_n,CAS_n,WE_n,BA0] = [1,1,1,0]  -- DDR4 -- All ranks DESelected (all CS_L==1) AND [RAS_n,CAS_n,WE_n,BA0,ACT_n] = [1,1,1,0,1]  - When in this mode, the controller should avoid sending the above patterns with any rank selected. [e.g. NOPs sent by the controller should have BA0 set to a non-zero value] RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_TRISTATEMODECA_P2_DDR2TMODE ,Must be set to 1 for Dynamic Tristate to work when CA bus is 2T or Geardown mode. This CSR bit has no effect when DisDynAdrTri==1 RESET:0x0"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_TRISTATEMODECA_P2_CKDISVAL ,The PHY provides 4 memory clocks, n=0..3.  - When the toggling of memory clock CK_t[n] is disabled with dfi_clk_disable[n]=1, the memory clock CK_t[n] is driven with Register CkDisVal[1].  - When the toggling of memory clock CK_c[n] is disabled with dfi_clk_disable[n]=1, the memory clock CK_c[n] is driven with ~(Register CkDisVal[0]) (ie inverted).  Note that the non-toggling differential memory clock [CK_t[n],CK_c[n]] may be driven with any combination, LL,LH,HL,HH; the default [CK_t[n],CK_c[n]]=LH. RESET:0x0"
          
group.long  0x40++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_HWTMRL_P2, HWT MaxReadLatency. RESET:0x6"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_HWTMRL_P2_HWTMRL_P2 ,This MASTER copy of MRL is used by the PHY training firmware only. RESET:0x6"
          
group.long  0x48++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DQSPREAMBLECONTROL_P2, For improved robustness in operating with DRAM timing drift, this register provides controls for the width of the write DQS preamble and postamble, and controls for the anticipated width of DQS preamble for reads. RESET:0x8"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DQSPREAMBLECONTROL_P2_TWOTCKRXDQSPRE ,Widens the RxDqsEn window to allow larger drift in the incoming read DQS to take advantage of the larger/wider preamble generated by the DRAMSs when the D4 DRAMS are configured with DDR4 MR4 A11 Read Preamble=1 for causing a 2nCK read preamble. For LPDDR4, set to 1 for static read preamble, set to 0 for toggling read preamble.  Note the nominal trained-to-center point will be earlier relative to the first strobing edge of DQS than when not in this mode. RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DQSPREAMBLECONTROL_P2_TWOTCKTXDQSPRE ,For LPDDR4, all write operations are 2nCK such that this control must be set to 1. RESET:0x0"
          
         hexmask.long 0x00 2.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DQSPREAMBLECONTROL_P2_POSITIONDFEINIT ,For DDR4 phy only when receive DFE is enabled.  - PositionDfeInit[2] is reserved  - PositionDfeInit[1]=1 causes DfeInit to be asserted at the nominal time  - PositionDfeInit[0] is reserved PositionDfeInit=3'b010 is the nominal, recommended value for leading edge used by receiver, other values are reserved. RESET:0x2"
          
         bitfld.long 0x00 5. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DQSPREAMBLECONTROL_P2_LP4TGLTWOTCKTXDQSPRE ,Used in LPDDR4 mode to modify the early preamble when Register TwoTckTxDqsPre=1 - 0: level first-memclk preamble - 1: toggling first-memclk preamble RESET:0x0"
          
         bitfld.long 0x00 6. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DQSPREAMBLECONTROL_P2_LP4POSTAMBLEEXT ,In LPDDR4 mode must be set to extend the write postamble. - 0: half-memclk postamble, as in D4 - 1: one-and-one-half-memclk postamble; see LPDDR4 Spec MR3, OP[1] WR PST, vendor-specific function. RESET:0x0"
          
         bitfld.long 0x00 7. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DQSPREAMBLECONTROL_P2_LP4STTCPREBRIDGERXEN ,Used in LPDDR4 static-preamble mode to bridge the RxEn between two reads to the same timing group when the bubble is 1 memclk. LPDDR4 static-preamble mode is set in the DRAMs with MR1, OP[3]=0. RESET:0x0"
          
         bitfld.long 0x00 8. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DQSPREAMBLECONTROL_P2_WDQSEXTENSION ,When set, DQS_T and DQS_C will be driven differentially to 0 and 1, respectively, before and after a write burst, except during a memory read transaction. See DesignWare Cores LPDDR4 MultiPHY: WDQS Extension Application Note. Use of WDQSEXTENSION requires POdtTailWidth=3 and POdtStartDelay=00 RESET:0x0"
          
group.long  0x5a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DMIPINPRESENT_P2, This Register is used to instruct the PHY whether to enable the Read-DBI function on Lane8 of each DBYTE. Only the LPDDR4 and DDR4 Protocols support the Read-DBI feature. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DMIPINPRESENT_P2_RDDBIENABLED ,This bit must be set to 1'b1 if Read-DBI is enabled in a connected DDR4 or LPDDR4 device. If set, the following DRAM MR should also be set [DDR4.MR5.A12=1 or LPDDR4.MR3.OP[7]=1] RESET:0x0"
          
group.long  0x5c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_ARDPTRINITVAL_P2, Address/Command FIFO ReadPointer Initial Value RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_ARDPTRINITVAL_P2_ARDPTRINITVAL_P2 ,This is the initial Pointer Offset for the free-running FIFOs in the DBYTE and ACX4 hardips. The units of this register are in UI. The pointer separation should be chosen to compensate for all sources of skew and drift of the PHY DFICLK and PCLK networks. See 'ARdPtrInitVal Impacts From Construction Skews' of the PUB databook. This CSR must be programmed in Step C of the PHY Initialization sequence RESET:0x0"
          
group.long  0xac++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PROCODTTIMECTL_P2, Controls timing of ProcOdt for DQ and DQS termination during reads. The enabling and disabling of ProcOdt can be shifted with a granularity of 1UI.  If WDQSEXTENSION is enabled, this register should be set to 0x03. Otherwise, use the recommended settings based on MEMCLK frequency and TwoTckRxDqsPre. This will ensure that ProcOdt is enabled before the DQS preamble begins and is not disabled until after the DQS postamble ends.  Recommended configuration if Register TwoTckRxDqsPre==1:  - 0000MHz < memclk-freq <= 0933 ; Register POdtStartDelay= 2 ; Register POdtTailWidth=2  - 0933MHz < memclk-freq <= 1200 ; Register POdtStartDelay= 0 ; Register POdtTailWidth=2  - 1200MHz < memclk-freq <= NA ; Register POdtStartDelay= 0 ; Register POdtTailWidth=3  Recommended configuration if TwoTckRxDqsPre==0:  - 0000MHz < memclk-freq <= 933 ; Register POdtStartDelay= 2 ; Register POdtTailWidth=2  - 0933MHz < memclk-freq <= 1200 ; Register POdtStartDelay= 1 ; Register POdtTailWidth=2  - 1200MHz < memclk-freq <= NA ; Register POdtStartDelay= 1 ; Register POdtTailWidth=3 See related CSR TxOdtDrvStren. RESET:0x1f"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PROCODTTIMECTL_P2_PODTTAILWIDTH ,controls the length of the tail of ProcOdt, units of UI - POdtTailWidth controls the time from closing the window to receive DQS to ProcODT deassertion, and can be set with values ranging from 0 to 3. - The aforementioned timing is defined as (3 + POdtTailWidth + POdtTailWidthExt - csrTwiTckDqsPre) UIs. - It is recommended to use this csr as the main timing configuration unit, with default value of 3. Note that this might not be the optimal value, since it is technology dependent. Refer to the PHY Databook for optimal settings. RESET:0x3"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PROCODTTIMECTL_P2_PODTSTARTDELAY ,controls the start of ProcOdt, units of UI  - 3 delay start 2 UI, maximum delay of start of ProcOdt  - 2 delay start 1 UI,  - 1 delay start 0 UI, default  - 0 early by 1 UI, The time from ProcODT assertion to opening the window to receive DQS is than (10 - POdtStartDelay) UI. It may be up to 4 pclk smaller if small 	  coarse delays are used (used only at the lowest clock frequencies) RESET:0x3"
          
         hexmask.long 0x00 4.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PROCODTTIMECTL_P2_PODTTAILWIDTHEXT ,controls the length of the tail of ProcOdt, units of UI - POdtTailWidthExt controls the time from closing the window to receive DQS to ProcODT deassertion, and can be set with values ranging from 0 to 3. - The aforementioned timing is defines as (3 + POdtTailWidth + POdtTailWidthExt - csrTwiTckDqsPre) UIs. - It is recommended to use this csr as an extension to POdtTailWidth, and has a default value of 1. Note that this might not be the optimal value, since it is technology dependent. Refer to the PHY Databook for optimal settings. RESET:0x1"
          
group.long  0xf8++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DLLGAINCTL_P2, Controls for the DllGain sequencing for locking and maintaining lock of the LCDL delay cells. - The DllGain sequencer will start locking with the DllGainIV. - As the end of locking approaches, the DllGain will be incremented in stages until, at the end of locking, the DllGain is the terminal values DllGainTV. - 2^(5-DllGain) is fractional change in the DAC code MstPhase1UI[8:0] of Dll per pclk. - Firmware uses values for DllGainIV, DllGainTV, and LcdlSeed0 that are optimized for minimum locking time. These controls are not to be configured by the user. RESET:0xa1"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DLLGAINCTL_P2_DLLGAINIV ,Initial value of DllGain. RESET:0x1"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DLLGAINCTL_P2_DLLGAINTV ,Terminal value of DllGain, ie the value in effect when locking is done and the value used for maintaining lock, ie tracking pclk variation. DllGainTV must be greater than or equal to DllGainIV. The maximum value is 10. RESET:0xa"
          
         hexmask.long 0x00 8.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DLLGAINCTL_P2_DLLSEEDSEL ,Reserved, must be configured to be 0. RESET:0x0"
          
group.long  0xfa++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DLLLOCKPARAM_P2, Reserved for PHY training firmware use. RESET:0x17c1"
         hexmask.long 0x00 0.--12. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DLLLOCKPARAM_P2_RFU_DLLLOCKPARAM_P2 ,None RESET:0x17c1"
          
group.long  0x160++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIRDDATACSDESTMAP_P2, This CSR must be default values in LPDDR3 and LPDDR4 modes. Maps dfi_rddata_cs_n (read chip-select asserted low) to destination dimm timing group. RESET:0xe4"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIRDDATACSDESTMAP_P2_DFIRDDESTM0 ,Maps dfi_rddata_cs_n_p0[0] to dest DfiRdDestm0 timing.  For example, if 0 dfi_rddata_cs_n_p0[0] will use Register Rx[En,Clk]DlyTg0 timing. RESET:0x0"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIRDDATACSDESTMAP_P2_DFIRDDESTM1 ,Maps dfi_rddata_cs_n_p0[1] to dest DfiRdDestm1 timing.  For example, if 1 dfi_rddata_cs_n[_p01] will use Register Rx[En,Clk]DlyTg1 timing. RESET:0x1"
          
         hexmask.long 0x00 4.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIRDDATACSDESTMAP_P2_DFIRDDESTM2 ,Maps dfi_rddata_cs_n_p0[2] to dest DfiRdDestm2 timing.  For example, if 2 dfi_rddata_cs_n_p0[2] will use Register Rx[En,Clk]DlyTg2 timing. RESET:0x2"
          
         hexmask.long 0x00 6.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIRDDATACSDESTMAP_P2_DFIRDDESTM3 ,Maps dfi_rddata_cs_n_p0[3] to dest DfiRdDestm3 timing.  For example, if 3 dfi_rddata_cs_n_p0[3] will use Register Rx[En,Clk]DlyTg3 timing. RESET:0x3"
          
group.long  0x164++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_VREFINGLOBAL_P2, This Register controls the PHY global VREF generator, and the PHY analog pad BP_VREF. The mission mode function of the PHY VREF generator is to generate VrefDQ for the PHY RX function. This register is written and configured by the PHY training firmware for mission mode function. RESET:0x200"
         hexmask.long 0x00 0.--2. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_VREFINGLOBAL_P2_GLOBALVREFINSEL ,GlobalVrefInSel[1:0] controls the mode of the PHY VREF DAC and the BP_VREF pin  - 2'b00 - PHY Vref DAC Range0 -- BP_VREF = Hi-Z  - 2'b01 - Reserved Encoding  - 2'b10 - PHY Vref DAC Range0 -- BP_VREF connected to PLL Analog Bus  - 2'b11 - PHY Vref DAC Range0 -- BP_VREF connected to PHY Vref DAC GlobalVrefInSel[2] controls the DAC range for internal Vref generation RESET:0x0"
          
         hexmask.long 0x00 3.--9. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_VREFINGLOBAL_P2_GLOBALVREFINDAC ,DAC code for internal Vref generation. The DAC has two ranges; the range is set by GlobalVrefInSel[2]  - RANGE0 : [GlobalVrefInSel[2] = 0]  -- DAC Output Voltage = GlobalVrefInDAC == 6'h00 ? Hi-Z : 0.345*VDDQ + (0.005*GlobalVrefInDAC)*VDDQ  - RANGE1 : [GlobalVrefInSel[2] = 1]  -- DAC Output Voltage = GlobalVrefInDAC == 6'h00 ? Hi-Z : (0.005*(GlobalVrefInDAC-1))*VDDQ RESET:0x40"
          
         hexmask.long 0x00 10.--13. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_VREFINGLOBAL_P2_GLOBALVREFINTRIM ,RSVD RESET:0x0"
          
         bitfld.long 0x00 14. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_VREFINGLOBAL_P2_GLOBALVREFINMODE ,RSVD RESET:0x0"
          
group.long  0x168++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIWRDATACSDESTMAP_P2, This CSR must be default values in LPDDR3 and LPDDR4 modes Maps dfi_wrdata_cs_n (write chip-select asserted low) to destination dimm timing group. The full dfi interface has 72 values of dfi_wrdata_cs_n, with 8 per byte. Byte db (0..8) uses values dfi_wrdata_cs_n[(db*8 + 7):(db*8 + 0)] and this register, which is per byte, to determine the timing-control registers to use for the asserted chip-select. For simplicity, the subfield description does not include the byte offset for dfi_wrdata_cs_n.  Note: The example values below are the default/reset values. If this register is written to all zeroes, then all writes will use Register Tx[Dq,Dqs]Dlyd0 timing. RESET:0xe4"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIWRDATACSDESTMAP_P2_DFIWRDESTM0 ,Maps dfi_wrdata_cs_n_p0[0] to dest DfiWrDestm0 timing  For example, if 0 dfi_wrdata_cs_n_p0[0] will use Register Tx[Dq,Dqs]DlyTg0 timing. RESET:0x0"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIWRDATACSDESTMAP_P2_DFIWRDESTM1 ,Maps dfi_wrdata_cs_n_p0[1] to dest DfiWrDestm1 timing  For example, if 1 dfi_wrdata_cs_n_p0[0] will use Register Tx[Dq,Dqs]DlyTg1 timing. RESET:0x1"
          
         hexmask.long 0x00 4.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIWRDATACSDESTMAP_P2_DFIWRDESTM2 ,Maps dfi_wrdata_cs_n_p0[2] to dest DfiWrDestm2 timing  For example, if 2 dfi_wrdata_cs_n_p0[0] will use Register Tx[Dq,Dqs]DlyTg2 timing. RESET:0x2"
          
         hexmask.long 0x00 6.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIWRDATACSDESTMAP_P2_DFIWRDESTM3 ,Maps dfi_wrdata_cs_n_p0[3] to dest DfiWrDestm3 timing (use Register Tx[Dq,Dqs]DlyTg3)  For example, if 3 dfi_wrdata_cs_n_p0[0] will use Register Tx[Dq,Dqs]DlyTg3 timing. RESET:0x3"
          
group.long  0x18a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PLLCTRL2_P2, This csr is to be programmed by bios or other means to set PLL charge-pump settings in various PStates. See Technology specific PHY Databook for control setting programming. RESET:0x19"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PLLCTRL2_P2_PLLFREQSEL ,Adjusts the loop parameters to compensate for different VCO bias points, and input/output clock division ratios. RESET:0x19"
          
group.long  0x18e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PLLCTRL1_P2, This csr is to be programmed by bios or other means to set PLL charge-pump settings in various PStates. See Technology specific PHY Databook for control setting programming. RESET:0x20"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PLLCTRL1_P2_PLLCPINTCTRL ,connects directly to cp_int_cntrl<4:0> in PLL. Charge pump integrating current control. RESET:0x0"
          
         hexmask.long 0x00 5.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PLLCTRL1_P2_PLLCPPROPCTRL ,connects directly to cp_prop_cntrl<3:0> of PLL. Charge pump proportional current control. RESET:0x1"
          
group.long  0x194++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PLLTESTMODE_P2, Additional controls for PLL CP/VCO modes of operation RESET:0x124"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PLLTESTMODE_P2_PLLTESTMODE_P2 ,It is required to use default values for this CSR unless directed otherwise by Synopsys. Directly connected to testmode[15:0] pin of PLL RESET:0x124"
          
group.long  0x198++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PLLCTRL4_P2, This csr is to be programmed by bios or other means to set PLL charge-pump settings in various PStates. Refer to Technology specific PHY Databook for control setting programming. RESET:0x17f"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PLLCTRL4_P2_PLLCPINTGSCTRL ,connects directly to cp_int_gs_cntrl<4:0> in PLL. Charge pump integrating current control for fast relock and gearshift. RESET:0x1f"
          
         hexmask.long 0x00 5.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_PLLCTRL4_P2_PLLCPPROPGSCTRL ,connects directly to cp_prop_gs_cntrl<3:0> of PLL. Charge pump proportional current control for fast relock and gearshift. RESET:0xb"
          
group.long  0x1f4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIFREQRATIO_P2, DFI Frequency Ratio RESET:0x1"
         hexmask.long 0x00 0.--1. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P2_DFIFREQRATIO_P2_DFIFREQRATIO_P2 ,Specifies the ratio DfiCtlClk:MemClk.  - 00 = 1:1 mode  - 01 = 1:2 mode  - 1x = 1:4 mode When DWC_DDRPHY_FIXED_DFICTLCLK_RATIO is defined, this register is ignored and 1:2 mode is selected. RESET:0x1"
          
tree.end

