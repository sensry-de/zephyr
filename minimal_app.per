group.long  0x34++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_MTESTMUXSEL, Digital Observation Pin control RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_MTESTMUXSEL_MTESTMUXSEL ,Controls for the 64-1 mux for asynchronous data to the Digital Observation Pin.  - 6'h0 --> Drive 0 from this chiplet (allows flat 'OR' of pass-through information)  - 6'h01:1f --> Select local data from AC/DBYTE/MASTER macro  - 6'h20 --> Reserved (Drive 0 from macro into mux; Drive 0 from PUB synth logic path into mux)  - 6'h21:3f --> Select local data from PUB AC/DBYTE/MASTER synthesized logic Note: See PUB documentation for how, or if, the Digital Observation Pin is mapped to a physical bump in this configuration. RESET:0x0"
          
group.long  0x3e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_DTSMTRAINMODECTRL, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_DTSMTRAINMODECTRL_RFU_DTSMTRAINMODECTRL ,None RESET:0x0"
          
group.long  0x40++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_DFIMRL_P0, DFI MaxReadLatency RESET:0x6"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_DFIMRL_P0_DFIMRL_P0 ,This Max Read Latency CSR is to be trained to ensure the rx-data fifo is not read until after all dbytes have their read data valid. This is the value, in units of two mem clocks, between dfi_rddata_en and dfi_rddata_valid A unit change in the LSB is a change in MRL of two mem clocks. RESET:0x6"
          
group.long  0x48++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_ASYNCDBYTEMODE, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_ASYNCDBYTEMODE_ASYNCDBYTEMODE ,Reserved for PHY training firmware use. RESET:0x0"
          
group.long  0x4c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_ASYNCDBYTETXEN, Reserved for PHY training firmware use. RESET:0x0"
