tree "EMMC_QSPI_REG__TOP"
base e:0x40300000
width 80.
group.long  0x0++0x3
    line.long 0x00 "EMMC_QSPI_REG_TOP_CTRL, EMMC-QSPI mode controls + Miscellaneous controls of EMMC controller RESET:0x3e"
         bitfld.long 0x00 0. " EMMC_QSPI_REG_TOP_CTRL_QSPI_MODE_EN ,QSPI mode enable; enables QSPI host to control EMMC test interface AND enables pad ctrl from test interface. Connected to both phy_intf_sel and test_pad_mode signals on EMMC controller. 0: EMMC mode, 1: QSPI mode RESET:0x0"
          
         bitfld.long 0x00 1. " EMMC_QSPI_REG_TOP_CTRL_CARD_CLK_STABLE ,Indicates to controller that the supplied card clock is stable RESET:0x1"
          
         bitfld.long 0x00 2. " EMMC_QSPI_REG_TOP_CTRL_INT_BCLK_STABLE ,Indicates to controller that the supplied base clock is stable RESET:0x1"
          
         bitfld.long 0x00 3. " EMMC_QSPI_REG_TOP_CTRL_INT_ACLK_STABLE ,Indicates to controller that the supplied AXI clock is stable RESET:0x1"
          
         bitfld.long 0x00 4. " EMMC_QSPI_REG_TOP_CTRL_INT_TMCLK_STABLE ,Indicates to controller that the supplied timer clock is stable RESET:0x1"
          
         bitfld.long 0x00 5. " EMMC_QSPI_REG_TOP_CTRL_HOST_REG_VOL_STABLE ,Indicates to controller that the host regulator voltage is stable RESET:0x1"
          
         bitfld.long 0x00 6. " EMMC_QSPI_REG_TOP_CTRL_CARD_DETECT_N ,SD card detect. Must tie LOW in eMMC mode RESET:0x0"
          
         bitfld.long 0x00 7. " EMMC_QSPI_REG_TOP_CTRL_CARD_WRITE_PROT ,SD card write protect. Must tie LOW in eMMC mode RESET:0x0"
          
         bitfld.long 0x00 8. " EMMC_QSPI_REG_TOP_CTRL_RESET_EMMC_TX_N ,SW trigger for reset_emmc_tx_n RESET:0x0"
          
         bitfld.long 0x00 9. " EMMC_QSPI_REG_TOP_CTRL_RESET_EMMC_TIMER_N ,SW trigger for reset_emmc_timer_n RESET:0x0"
          
         bitfld.long 0x00 10. " EMMC_QSPI_REG_TOP_CTRL_RESET_EMMC_N ,SW trigger for reset_emmc_n RESET:0x0"
          
tree.end

