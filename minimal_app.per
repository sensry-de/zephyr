wgroup.long 0x20++0x3
    line.long 0x00 "DECTSPI_MST_RDMA_IRQ_STATUS_SET, Set irq_status register bits. Used to the emulate interrupt event (for SW debug or dev) RESET:0x0"
         bitfld.long 0x00 0. " DECTSPI_MST_RDMA_IRQ_STATUS_SET_MAXSIZE ,Set interrupt maxsize RESET:0x0"
          
