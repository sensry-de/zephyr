         bitfld.long 0x00 0. " DUALTIMER2_ADDRESSBLOCK0_TIMER1RIS_RAWTIMERINTERRUPT ,Timer 1 Raw interrupt status from the counter RESET:0x0" "TIMER1RIS_DISABLED-0,TIMER1RIS_ENABLED-1"
          
          
