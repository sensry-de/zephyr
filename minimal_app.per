    line.long 0x00 "WATCHDOG_ADDRESSBLOCK0_WDOGMIS, Watchdog Interrupt status register indicates the masked interrupt status from the counter. This value is the logical AND of the Raw interrupt status with the Interrupt enable bit from the Control register, and is the same value that is passed to the interrupt output pin. RESET:0x0"
         bitfld.long 0x00 0. " WATCHDOG_ADDRESSBLOCK0_WDOGMIS_WATCHDOGINTERRUPT ,Enabled interrupt status from the counter RESET:0x0" "WDOGMIS_DISABLED-0,WDOGMIS_ENABLED-1"
          
          
group.long  0xc00++0x3
    line.long 0x00 "WATCHDOG_ADDRESSBLOCK0_WDOGLOCK, Watchdog Lock register disables write accesses to all other registers to prevent rogue software from disabling the watchdog functionality. A read from this register returns only the bottom bit. RESET:0x0"
         bitfld.long 0x00 0. " WATCHDOG_ADDRESSBLOCK0_WDOGLOCK_REGISTERWRITEENABLESTATUS ,Register write enable status (default 0, write access is enabled, not locked) RESET:0x0" "WRITE_ENABLED-0,WRITE_LOCKED-1"
          
         hexmask.long 0x00 1.--31. 1. " WATCHDOG_ADDRESSBLOCK0_WDOGLOCK_ENABLEREGISTERWRITES ,Enable write access to all other registers by writing value '0x1ACCE551'. Disable write access by writing any other value. RESET:0x0"
          
group.long  0xf00++0x3
    line.long 0x00 "WATCHDOG_ADDRESSBLOCK0_WDOGITCR, Watchdog Integration test control register enables integration test mode. When in this mode the test output register directly controls the masked interrupt output WDOGINT and reset output WDOGRES. RESET:0x0"
         bitfld.long 0x00 0. " WATCHDOG_ADDRESSBLOCK0_WDOGITCR_INTEGRATIONTESTMODEENABLE ,Integration test mode enable (default 0, disable). When set HIGH, places the watchdog into integration test mode. RESET:0x0" "TESTMODE_DISABLE-0,TESTMODE_ENABLE-1"
          
          
group.long  0xf04++0x3
    line.long 0x00 "WATCHDOG_ADDRESSBLOCK0_WDOGITOP, Watchdog Integration test output set register values directly drive the enabled interrupt output and reset output when in Integration test mode. RESET:0x0"
         bitfld.long 0x00 0. " WATCHDOG_ADDRESSBLOCK0_WDOGITOP_INTEGRATIONTESTWGODRESVALUE ,Value output on WDOGRES when in Integration test mode RESET:0x0"
          
