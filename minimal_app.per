         hexmask.long 0x00 13.--20. 1. " ADPLL2G_ADPLL2G_CTRL_1_FT ,ADPLL fine-tune value for open-loop mode and for automatic coarse tune RESET:0x80"
          
         hexmask.long 0x00 21.--26. 1. " ADPLL2G_ADPLL2G_CTRL_1_CT ,Coarse tune value for open loop (CT>=4!) and in the case AUTO_CT = 0 RESET:0x8"
          
