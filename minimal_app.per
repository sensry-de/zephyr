tree "SGMII_WRAP_REG__ADPLL_REGS"
base e:0x40073040
width 80.
group.long  0x0++0x3
    line.long 0x00 "SGMII_WRAP_REG_ADPLL_REGS_CTRL_0, Control register 0 / reset settings for 10MHz input, 60MHz output RESET:0x212bde"
         bitfld.long 0x00 0. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_EN_ADPLL ,Enable the PLL RESET:0x0" "DISABLED-0,ENABLED-1"
          
         bitfld.long 0x00 1. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_MAINDIV_N1 ,N1 of ADPLL main loop divider RESET:0x1" "ONE-0,TWO-1"
          
         bitfld.long 0x00 2.--3. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_MAINDIV_N2 ,N2 of ADPLL main loop divider RESET:0x3" "TWO-0,THREE-1,FOUR-2,FIVE-3"
          
         bitfld.long 0x00 4.--5. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_MAINDIV_N3 ,N3 of ADPLL main loop divider RESET:0x1" "TWO-0,THREE-1,FOUR-2,FIVE-3"
          
         bitfld.long 0x00 6.--7. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_MAINDIV_N4 ,N4 of ADPLL main loop divider RESET:0x3" "ONE-0,TWO-1,THREE-2,FOUR-3"
          
         bitfld.long 0x00 8.--9. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_OUTDIV_SEL ,ADPLL output divider RESET:0x3" "NODIV-0,DIV2-1,DIV4-2,DIV8-3"
          
         bitfld.long 0x00 10. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_OPEN_LOOP ,Enable open loop (PLL starts without loop regulation) RESET:0x0" "DISABLED-0,ENABLED-1"
          
         bitfld.long 0x00 11.--12. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_DIVCORE_SEL ,Frequency divider setting for core output clock RESET:0x1" "NODIV-0,DIV3-1,DIV5-2,DIV10-3"
          
         bitfld.long 0x00 13. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_AUTO_CT ,Enable for automatic coarse tune RESET:0x1" "DISABLED-0,ENABLED-1"
          
         bitfld.long 0x00 14. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_PFD_SEL ,enable/disable synchronizer for PFD RESET:0x0" "DISABLED-0,ENABLED-1"
          
         bitfld.long 0x00 15. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_LOCK_WINDOW_SEL ,Lock Detection Window selection RESET:0x0" "LONG-0,SHORT-1"
          
         bitfld.long 0x00 16. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_DIVCORE_MUX_SEL ,selects the divider chain for clk_core. Only COREDIV or OUTDIV + COREDIV RESET:0x1" "COREDIV-0,COREDIV_OUTDIV-1"
          
         bitfld.long 0x00 17. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_EN_FAST_LOCK ,Enable internal fast lock-in for fine tune value using binary search RESET:0x0" "DISABLED-0,ENABLED-1"
          
         bitfld.long 0x00 18. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_ENFORCE_LOCK ,Overwrite locked-bit (Note: locked status can still read on adpll_status_o) RESET:0x0" "UNENFORCED-0,ENFORCED-1"
          
         bitfld.long 0x00 19. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_SET_OP_LOCK ,Force locked bit to 1 in OP mode. This mode bypasses the lock detection RESET:0x0" "UNENFORCED-0,FORCED1-1"
          
         bitfld.long 0x00 20. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_DISABLE_LOCK ,Force locked bit to 0 (Note: locked status can still read on adpll_status_o) RESET:0x0" "UNENFORCED-0,FORCED0-1"
          
         bitfld.long 0x00 21. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_REF_BYPASS ,enable/disable reference clock bypass to ADPLL core clock output RESET:0x1" "DISABLED-0,ENABLED-1"
          
         bitfld.long 0x00 22. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_BIST_MODE ,Set BIST mode or normal PLL usage mode RESET:0x0" "NORMAL-0,BIST-1"
          
         bitfld.long 0x00 23. " SGMII_WRAP_REG_ADPLL_REGS_CTRL_0_CT_COMPENSATION ,Enable automatic increase/decrease of coarsetune value in case of finetune overflow/underflow RESET:0x0" "DISABLED-0,ENABLED-1"
          
