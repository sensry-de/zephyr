         bitfld.long 0x00 0. " DCU_DSW_GLOBAL_IRQ_STATUS_BUSY_IRQ ,Frame done interrupt read status/write clear RESET:0x0"
          
         bitfld.long 0x00 1. " DCU_DSW_GLOBAL_IRQ_STATUS_BUSY_BUSY ,Busy indication of the DSW. Read only. RESET:0x0"
          
rgroup.long 0x1c++0x3
    line.long 0x00 "DCU_DSW_GLOBAL_COUNT_BUS_WORDS, Counter for current bus words RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DCU_DSW_GLOBAL_COUNT_BUS_WORDS_CNT_READ ,Count read buswords RESET:0x0"
          
rgroup.long 0x20++0x3
    line.long 0x00 "DCU_DSW_GLOBAL_COUNT_STREAM_WORDS, Counter for current stream words RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DCU_DSW_GLOBAL_COUNT_STREAM_WORDS_CNT_STREAM_WORDS ,Counter for current stream words RESET:0x0"
          
rgroup.long 0x24++0x3
    line.long 0x00 "DCU_DSW_GLOBAL_COUNT_FIFO_ERROR, Counter for FIFO errors RESET:0x0"
