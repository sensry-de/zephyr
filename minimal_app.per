tree "ETHERNET_TSN_SW"
base e:0x40200000
width 80.
group.long  0x4++0x3
    line.long 0x00 "ETHERNET_TSN_SW_LU_MAIN_CTRL, LU_MAIN control register (CENTRAL/LOOKUP/LU_MAIN) RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_TSN_SW_LU_MAIN_CTRL_BYP_EN ,MAC Lookup bypass. When enabled, all frames are forwarded with the information of the BYPASS register. RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_TSN_SW_LU_MAIN_CTRL_STC_EN ,Send unknown SRC-MAC Frames to CPU-Port. (0 for disable, 1 for enable) RESET:0x0"
          
group.long  0x8++0x3
    line.long 0x00 "ETHERNET_TSN_SW_LU_MAIN_HITMEM, LU_MAIN hit memory register (CENTRAL/LOOKUP/LU_MAIN) RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_TSN_SW_LU_MAIN_HITMEM_CLR ,Clears the hit memory. The asserted bit is cleared automatically after the clear is forwarded to the hit memory. The clearing will take some additional time. RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_TSN_SW_LU_MAIN_HITMEM_DM_EN ,Select Hitmem MAC type: (0) Source MAC Address (1) Destination MAC address. RESET:0x0"
          
group.long  0x10++0x3
    line.long 0x00 "ETHERNET_TSN_SW_LU_MAIN_BYPASS, LU_MAIN bypass register (CENTRAL/LOOKUP/LU_MAIN) RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " ETHERNET_TSN_SW_LU_MAIN_BYPASS_DEST ,Target destination port of frame. Mark port via bit-selection. Multiple ports can be selected. LSB is CPU Port (Port0). Bypass is only for testing without CAM and does not support DESTE field. RESET:0x0"
          
rgroup.long 0x100++0x3
    line.long 0x00 "ETHERNET_TSN_SW_CAM_APB2AXIS_STS, CAM APB2AXIS Status Register RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_TSN_SW_CAM_APB2AXIS_STS_RDY ,Ready = '1' signalizes that new data can be written to DATA registers RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_TSN_SW_CAM_APB2AXIS_STS_BUSY ,Busy signalizes that the controller is writing data and/or data is pending. The controller can be ready to take more data also when it is busy. RESET:0x0"
          
rgroup.long 0x110++0x3
    line.long 0x00 "ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_CNT, CAM APB2AXIS Request Count Register RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_CNT_WRCNT ,Number of streams in queue. CNT is always <= PARAM.DEPTH. RESET:0x0"
          
rgroup.long 0x114++0x3
    line.long 0x00 "ETHERNET_TSN_SW_CAM_APB2AXIS_FILLSTS, CAM APB2AXIS FILL STATUS Register RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_TSN_SW_CAM_APB2AXIS_FILLSTS_EMPTY ,FD FIFO failure. Internal controller lost synchronization. RESET:0x0"
          
         bitfld.long 0x00 4. " ETHERNET_TSN_SW_CAM_APB2AXIS_FILLSTS_FULL ,Frame was dropped because the internal descriptor FIFO is full. Full by too many frames. RESET:0x0"
          
group.long  0x118++0x3
    line.long 0x00 "ETHERNET_TSN_SW_CAM_APB2AXIS_RESET, CAM APB2AXIS RESET Register RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_TSN_SW_CAM_APB2AXIS_RESET_RESET ,Resets controller and clears all pending stream data. Bit is automatically reset to 0. RESET:0x0"
          
rgroup.long 0x11c++0x3
    line.long 0x00 "ETHERNET_TSN_SW_CAM_APB2AXIS_PARAM, CAM APB2AXIS Parameter Register RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " ETHERNET_TSN_SW_CAM_APB2AXIS_PARAM_WORDLEN_BYTE ,Number of configured 32-bit-words for this controller. RESET:0x0"
          
         hexmask.long 0x00 8.--15. 1. " ETHERNET_TSN_SW_CAM_APB2AXIS_PARAM_DEPTH ,Number of configured buffer depth. If number is bigger than one then an internal FIFO is included. RESET:0x0"
          
group.long  0x120++0x3
    line.long 0x00 "ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_DATA_0, CAM APB2AXIS Request Data 0 Register RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_DATA_0_CH ,CAM APB2AXIS channel selection. Always 0 for writing to DEST_MAC table. RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_DATA_0_TYPE ,Select between set, clear or clear all: 00 – unused 01 – Set one DEST_MAC entry 10 – Clear one DEST_MAC entry 11 – Clear multiple entries (advanced user only) RESET:0x0"
          
         hexmask.long 0x00 16.--31. 1. " ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_DATA_0_ENTRY_NUM ,Entry number in ALMEM. The ALMEM[ENTRY_NUM] holding the routing information for the DESTMAC and VID. Value greater than the maximum entry number is not allowed. RESET:0x0"
          
group.long  0x124++0x3
    line.long 0x00 "ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_DATA_1, CAM APB2AXIS Request Data 1 Register RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_DATA_1_DESTMAC ,Holding the first four bytes of the destination MAC for the DEST_MAC table. RESET:0x0"
          
group.long  0x128++0x3
    line.long 0x00 "ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_DATA_2, CAM APB2AXIS Request Data 2 Register RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_DATA_2_DEST_MAC_47_32 ,Holding the last two bytes of the destination MAC. RESET:0x0"
          
         hexmask.long 0x00 16.--27. 1. " ETHERNET_TSN_SW_CAM_APB2AXIS_REQ_DATA_2_VID ,VLAN-ID value (12 bit) for the VLAN_ID table. Use the default VLAN-ID (VID=1), if setup an entry for non-VLAN traffic. RESET:0x0"
          
rgroup.long 0x200++0x3
    line.long 0x00 "ETHERNET_TSN_SW_ALMEM_APB2AXIS_STS, ALMEM APB2AXIS Status Register RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_STS_RDY ,Ready = '1' signalizes that new data can be written to DATA registers. RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_STS_BUSY ,Busy signalizes that the controller is writing data and/or data is pending. The controller can be ready to take more data also when it is busy. RESET:0x0"
          
rgroup.long 0x210++0x3
    line.long 0x00 "ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_CNT, ALMEM APB2AXIS Request Count Register RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_CNT_WRCNT ,Number of streams in queue. CNT is always <= PARAM.DEPTH. RESET:0x0"
          
rgroup.long 0x214++0x3
    line.long 0x00 "ETHERNET_TSN_SW_ALMEM_APB2AXIS_FILLSTS, ALMEM APB2AXIS FILL STATUS Register RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_FILLSTS_EMPTY ,FD FIFO failure. Internal controller lost synchronization. RESET:0x0"
          
         bitfld.long 0x00 4. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_FILLSTS_FULL ,Frame was dropped because the internal descriptor FIFO is full. Full by too many frames. RESET:0x0"
          
group.long  0x218++0x3
    line.long 0x00 "ETHERNET_TSN_SW_ALMEM_APB2AXIS_RESET, ALMEM APB2AXIS RESET Register RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_RESET_RESET ,Resets controller and clears all pending stream data. Bit is automatically reset to 0. RESET:0x0"
          
rgroup.long 0x21c++0x3
    line.long 0x00 "ETHERNET_TSN_SW_ALMEM_APB2AXIS_PARAM, ALMEM APB2AXIS Parameter Register RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_PARAM_WORDLEN_BYTE ,Number of configured 32-bit-words for this controller. RESET:0x0"
          
         hexmask.long 0x00 8.--15. 1. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_PARAM_DEPTH ,Number of configured buffer depth. If number is bigger than one then an internal FIFO is included. RESET:0x0"
          
group.long  0x220++0x3
    line.long 0x00 "ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_0, ALMEM APB2AXIS Request Data 0 Register RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_0_DEST ,Select the destination ports of forwarded frame. It is coded in onehot/select way, where 0 is always route to null. For 5 ports DEST[4:0] is sufficient. 00000 – to null (frame to clear) 00001 – to port 0 (CPU Port) 00010 – to port 1 00110 – to port 1&2 10000 – to port 4 RESET:0x0"
          
         hexmask.long 0x00 16.--18. 1. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_0_QUEUE ,Select the Priority Queue for TSN TX, only used if QSEL=11 RESET:0x0"
          
         bitfld.long 0x00 19. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_0_DROP ,1 if frame should be dropped. RESET:0x0"
          
         hexmask.long 0x00 20.--21. 1. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_0_QSEL ,Define the traffic queue selection: 00 – use PCP field of VLAN, untagged frames use PCP of PVID 01 – use PCP field with global remapping list 10 – reserved. (like ‘11’) 11 – use value QUEUE of Action List RESET:0x0"
          
         hexmask.long 0x00 22.--24. 1. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_0_UTAG ,TSN-EP user sideband information. RESET:0x0"
          
group.long  0x224++0x3
    line.long 0x00 "ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_1, ALMEM APB2AXIS Request Data 1 Register RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_1_ENTRY_NUM ,Define the entry number for reading or writing. RESET:0x0"
          
         hexmask.long 0x00 16.--24. 1. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_1_DESTE ,Extended Destination Register for forwarding ports from 16 to 24. RESET:0x0"
          
         bitfld.long 0x00 30. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_1_RESP ,If set then the command request will always return a response. A read response is also sent if register is not set. A write response can be useful to wait for the end of the last command in a write burst. RESET:0x0"
          
         bitfld.long 0x00 31. " ETHERNET_TSN_SW_ALMEM_APB2AXIS_REQ_DATA_1_WR_RD ,1 if writing to the ALMEM entry, 0 if reading from ALMEM entry. RESET:0x0"
          
