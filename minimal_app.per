group.long  0x1c6++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_LCDLDBGCNTL, Controls for use in observing and testing the LCDLs. RESET:0x0"
         hexmask.long 0x00 0.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_LCDLDBGCNTL_LCDLFINEOVRVAL ,Value forced as the initial value while LcdlTstEnable=1 and LcdlFineOvr. After the deassertion of LcdlFineOvr, the locking state-machine will attempt locking. RESET:0x0"
          
         bitfld.long 0x00 9. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_LCDLDBGCNTL_LCDLFINEOVR ,Forces the value of the present LCDL 1UI estimate code to be LcdlFineOvrVal for all LCDLs. RESET:0x0"
          
         bitfld.long 0x00 10. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_LCDLDBGCNTL_LCDLFINESNAP ,Latch enable for reading the present LCDL 1UI estimate code in LcdlFineSnapVal and the present phase-detector value in LcdlPhdSnapVal RESET:0x0"
          
         bitfld.long 0x00 11. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_LCDLDBGCNTL_LCDLTSTENABLE ,Enables the debug/test operations and status Ovr,Snap,StickyLock,StickyUnlock, and LiveLock. RESET:0x0"
          
         hexmask.long 0x00 12.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_LCDLDBGCNTL_LCDLSTATUSSEL ,Selects the LCDL status, from among the status for the 16 LCDLs in the DBYTE, for reading via Register DxLcdlStatus and an LCDL from among the LCDLs in the ANIB for reading via Register AcLcdlStatus. LcdlStatusSel source for DxLcdlStatus source for AcLcdlStatus  - 15 lcdl_rxclk1t reserved  - 14 lcdl_rxclk1c reserved  - 13 lcdl_rxclk0t reserved  - 12 lcdl_rxclk0c reserved  - 11 lcdl_rxen1 anib11-tx  - 10 lcdl_rxen0 anib10-tx  - 9 lcdl_txln9 (dqs-lower) anib9-tx  - 8 lcdl_txln8 (dm/dqs-upper) anib8-tx  - 7 lcdl_txln7 (dq7) anib7-tx  - 6 lcdl_txln6 (dq6) anib6-tx  - 5 lcdl_txln5 (dq5) anib5-tx  - 4 lcdl_txln4 (dq4) anib4-tx  - 3 lcdl_txln3 (dq3) anib3-tx  - 2 lcdl_txln2 (dq2) anib2-tx  - 1 lcdl_txln1 (dq1) anib1-tx  - 0 lcdl_txln0 (dq0) anib0-tx RESET:0x0"
          
rgroup.long 0x1c8++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACLCDLSTATUS, Status of anib macro LCDL selected by Register LcdlStatusSel  Note that there is just one copy of this register, with the information from the implemented ANIBs multiplexed per csr LcdlStatus Sel RESET:0x0"
         hexmask.long 0x00 0.--9. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACLCDLSTATUS_ACLCDLFINESNAPVAL ,Value of the LCDL 1UI estimate code, latched by pulse on csrLcdlFineSnap while csr LcdlTstEnable=1. Index 9 is reserved for growth. RESET:0x0"
          
         bitfld.long 0x00 10. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACLCDLSTATUS_ACLCDLPHDSNAPVAL ,Value of the LCDL phase-detector output, latched by pulse on LcdlFineSnap while csr LcdlTstEnable=1. RESET:0x0"
          
         bitfld.long 0x00 11. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACLCDLSTATUS_ACLCDLSTICKYLOCK ,latched value of whether the LCDL ever achieved lock after the assertion of LcdlTstEnable. RESET:0x0"
          
         bitfld.long 0x00 12. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACLCDLSTATUS_ACLCDLSTICKYUNLOCK ,latched value of whether the LCDL ever lost lock after the assertion of LcdlTstEnable. RESET:0x0"
          
         bitfld.long 0x00 13. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_ACLCDLSTATUS_ACLCDLLIVELOCK ,present value of whether the LCDL is locked, valid when LcdlTstEnable=1. RESET:0x0"
          
