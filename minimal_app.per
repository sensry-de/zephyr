         hexmask.long 0x00 11.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         bitfld.long 0x00 16. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_STAT_DONE ,Done Status Flag. This flag will be set to HIGH when the DMA command reaches the state defined by the DONETYPE settings. When DONEPAUSEEN is set the DMA command operation is paused when this flag is asserted. Write '1' to this bit to clear it. Automatically cleared when the ENABLECMD is set. RESET:0x0"
          
         bitfld.long 0x00 17. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_STAT_ERR ,Error Status Flag. This flag will be set to HIGH if the DMA encounters an error during its operation. The details about the error event can be found in the ERRINFO register. Write '1' to this bit to clear it. When cleared, it also clears the ERRINFO register. Automatically cleared when the ENABLECMD is set. RESET:0x0"
          
         bitfld.long 0x00 18. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_STAT_DISABLED ,Disabled Status Flag. This flag will be set to HIGH if the DMA channel is successfully disabled using the DISABLECMD command. Write '1' to this bit to clear it. Automatically cleared when the ENABLECMD is set. RESET:0x0"
          
         bitfld.long 0x00 19. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_STAT_STOPPED ,Stopped Status Flag. This flag will be set to HIGH if the DMA channel successfully reached the stopped state. The stop request can come from many internal or external sources. Write '1' to this bit to clear it. Automatically cleared when the ENABLECMD is set. RESET:0x0"
          
         bitfld.long 0x00 20. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_STAT_PAUSED ,Paused Status Flag. This flag will be set to HIGH if the DMA channel successfully paused the operation of the command. The pause request can come from many internal or external sources. When the request to pause is not asserted anymore the bit will be cleared automatically and the command operation can continue. RESET:0x0"
          
         bitfld.long 0x00 21. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_STAT_RESUMEWAIT ,Waiting for resume from software Flag. This flag indicates that the DMA channel successfully paused the operation of the command and needs SW acknowledgment to resume the operation. Will be set to HIGH if STAT_PAUSED is asserted and the PAUSECMD bit set in the command register or when the STAT_DONE is asserted and the DONEPAUSEEN bit is set. Cleared when the RESUMECMD bit is set in the command register. RESET:0x0"
          
         hexmask.long 0x00 22.--23. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_RAZWI_2 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         bitfld.long 0x00 24. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_STAT_SRCTRIGINWAIT ,Channel is waiting for Source Trigger Status. This bit is set to HIGH when DMA channel starts waiting for source input trigger request. Automatically cleared when the source trigger request is received either from HW or SW source. RESET:0x0"
          
         bitfld.long 0x00 25. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_STAT_DESTRIGINWAIT ,Channel is waiting for Destination Trigger Status. This bit is set to HIGH when DMA channel starts waiting for destination input trigger request. Automatically cleared when the destination trigger request is received either from HW or SW source. RESET:0x0"
          
         bitfld.long 0x00 26. " DMA350_APB4SLVADDRESSBLOCK_DMACH1_CH_STATUS_STAT_TRIGOUTACKWAIT ,Channel is waiting for output Trigger Acknowledgement Status. This bit is set to HIGH when DMA channel starts waiting for output trigger acknowledgement. Automatically cleared when the output trigger acknowledgement is received either from HW or SW source. RESET:0x0"
          
