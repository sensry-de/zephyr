group.long  0x260++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_VREFDAC1_R1, VrefDAC1 control for DQ Receiver (used only when DFE is enabled in DDR4) RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_VREFDAC1_R1_VREFDAC1_R1 ,VrefDAC1 controls the alternate VREF setting for DFE (used only when DFE is enabled in DDR4) DAC control for rxdq cell internal VREF, trained by Firmware. The VREF generators have different ranges, depending on the Mission Mode settings for  - [DqDqsRcvCntrl::MajorModeDbyte,DqDqsRcvCntrl::ExtVrefRange]  - [011,0] :: VREF = VDDQ*(0.510 + VrefDAC1[6:0]*0.00345)  - [011,1] :: VREF = VDDQ*(0.453 + VrefDAC1[6:0]*0.00385)  - [non-enumerated encodings are reserved]  - Register Block Offset Address 0x030 is the VrefDAC1 for lane0.  - Register Block Offset Address 0x130 is the VrefDAC1 for lane1.  - Register Block Offset Address 0x230 is the VrefDAC1 for lane2.  - Register Block Offset Address 0x330 is the VrefDAC1 for lane3.  - Register Block Offset Address 0x430 is the VrefDAC1 for lane4.  - Register Block Offset Address 0x530 is the VrefDAC1 for lane5.  - Register Block Offset Address 0x630 is the VrefDAC1 for lane6.  - Register Block Offset Address 0x730 is the VrefDAC1 for lane7.  - Register Block Offset Address 0x830 is the VrefDAC1 for lane[DBI]. RESET:0x0"
          
group.long  0x264++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TRAININGCNTR_R1, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TRAININGCNTR_R1_RFU_TRAININGCNTR_R1 ,None RESET:0x0"
          
group.long  0x280++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_VREFDAC0_R1, VrefDAC0 control for DQ Receiver RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_VREFDAC0_R1_VREFDAC0_R1 ,PHY RX VREF DAC control for rxdq cell internal VREF, (used only when 2D training is enabled in LPDDR4,DDR4 DAC control for rxdq cell internal VREF, trained by Firmware. The VREF generators have different ranges, depending on the Mission Mode settings for  - [DqDqsRcvCntrl::MajorModeDbyte,DqDqsRcvCntrl::ExtVrefRange]  - [000,0] :: VREF = VDDQ*(0.287 + VrefDAC0[6:0]*0.00330)  - [000,1] :: VREF = VDDQ*(0.250 + VrefDAC0[6:0]*0.00385)  - [011,0] :: VREF = VDDQ*(0.510 + VrefDAC0[6:0]*0.00345)  - [011,1] :: VREF = VDDQ*(0.453 + VrefDAC0[6:0]*0.00385)  - [010,0] :: VREF = VDDQ*(0.047 + VrefDAC0[6:0]*0.00367)  - [non-enumerated encodings are reserved]  - Register Block Offset Address 0x040 is the VrefDAC0 for lane0.  - Register Block Offset Address 0x140 is the VrefDAC0 for lane1.  - Register Block Offset Address 0x240 is the VrefDAC0 for lane2.  - Register Block Offset Address 0x340 is the VrefDAC0 for lane3.  - Register Block Offset Address 0x440 is the VrefDAC0 for lane4.  - Register Block Offset Address 0x540 is the VrefDAC0 for lane5.  - Register Block Offset Address 0x640 is the VrefDAC0 for lane6.  - Register Block Offset Address 0x740 is the VrefDAC0 for lane7.  - Register Block Offset Address 0x840 is the VrefDAC0 for lane[DBI]. RESET:0x0"
          
group.long  0x282++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXIMPEDANCECTRL0_B1_P0, - Tx DQ driver impedance when equalization is enabled per nibble. - Register Block Offset Address 0x041 controls the lower DQ nibble - Register Block Offset Address 0x141 controls the upper DQ nibble RESET:0xfff"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXIMPEDANCECTRL0_B1_P0_DRVSTRENDQP ,Refer to Technology specific PHY DATABOOK for supported options. The 6-bit bus is used to select the target pull-down output impedance. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStren120P[2:0], Csr_DrvStren240P[1:0],Csr_DrvStren480P[0:0]] = [csrDrvStrenDqP]  - 000000 - HiZ.  - 000001 - 480.0  - 000010 - 240.0  - 000011 - 160.0  - 001000 - 120.0  - 001001 - 96.0  - 001010 - 80.0  - 001011 - 68.6  - 011000 - 60.0  - 011001 - 53.3  - 011010 - 48.0  - 011011 - 43.6  - 111000 - 40.0  - 111001 - 36.9  - 111010 - 34.3  - 111011 - 32.0  - 111110 - 30.0  - 111111 - 28.2 RESET:0x3f"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXIMPEDANCECTRL0_B1_P0_DRVSTRENDQN ,Refer to Technology specific PHY DATABOOK for supported options. This 6-bit bus is used to select the target pull-down output impedance. Connects to the DrvStren pins of the driver thus:  [Csr_DrvStren120N[2:0],Csr_DrvStren240N[1:0],Csr_DrvStren480N[0:0]] = [csrDrvStrenDqN]  Note:See table of csr DrvStrenDqP for list of possible impedances. RESET:0x3f"
          
group.long  0x286++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_DQDQSRCVCNTRL_B1_P0, Connected to the rxdqs and rxdq Mode selects and trim controls, per nibble.  - Register Block Offset Address 0x043 controls the lower DQ nibble  - Register Block Offset Address 0x143 controls the upper DQ nibble This DFE feature may be used with MajorModeDbyte=011 only. RESET:0x5b0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_DQDQSRCVCNTRL_B1_P0_SELANALOGVREF ,Setting this signal high will force the local per-bit VREF generator to pass the global VREFA to the samplers. RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_DQDQSRCVCNTRL_B1_P0_EXTVREFRANGE ,Extends the range available in the local per-bit VREF generator. RESET:0x0"
          
         hexmask.long 0x00 2.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_DQDQSRCVCNTRL_B1_P0_DFECTRL ,This field is programmable as follows  - 00 - DFE off  - 01 - DFE on  - 10 - Train DFE0 Amplifier  - 11 - Train DFE1 Amplifier These settings are determined by PHY Training FW and should not be overridden. RESET:0x0"
          
         hexmask.long 0x00 4.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_DQDQSRCVCNTRL_B1_P0_MAJORMODEDBYTE ,Selects the major mode of operation for the receiver. These settings are determined by PHY Configuration based on DRAM protocol  - 000 - Input signal is terminated/referenced to VDDQ/2 (or unterminated)  - 001 - reserved  - 010 - Input signal is terminated/referenced to VSSQ  - 011 - Input signal is terminated/referenced to VDDQ  - 100 - reserved  - 101 - reserved  - 110 - reserved  - 111 - reserved RESET:0x3"
          
         hexmask.long 0x00 7.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_DQDQSRCVCNTRL_B1_P0_GAINCURRADJ ,Adjust gain current of RX amplifier stage. It is recommended to use default values for this CSR. RESET:0xb"
          
          
group.long  0x292++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXIMPEDANCECTRL1_B1_P0, Tx impedance of DQ driver cells when equalization is disabled. - Register Block Offset Address 0x049 controls the lower DQ nibble - Register Block Offset Address 0x149 controls the upper DQ nibble RESET:0xfff"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXIMPEDANCECTRL1_B1_P0_DRVSTRENFSDQP ,Refer to Technology specific PHY DATABOOK for supported options This 6-bit bus is used to select the target pull-up output impedance. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStrenFS120P[2:0], Csr_DrvStrenFS240P[1:0], Csr_DrvStrenFS480P[0]] = [csrFSDrvStrenDq]  - 000000 - HiZ.  - 000001 - 480.0  - 000010 - 240.0  - 000011 - 160.0  - 001000 - 120.0  - 001001 - 96.0  - 001010 - 80.0  - 001011 - 68.6  - 011000 - 60.0  - 011001 - 53.3  - 011010 - 48.0  - 011011 - 43.6  - 111000 - 40.0  - 111001 - 36.9  - 111010 - 34.3  - 111011 - 32.0  - 111110 - 30.0  - 111111 - 28.2 RESET:0x3f"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXIMPEDANCECTRL1_B1_P0_DRVSTRENFSDQN ,Refer to Technology specific PHY DATABOOK for supported options. This 6-bit bus is used to select the target pull-down output impedance. Connects to the DrvStren pins of the driver thus:  [Csr_DrvStrenFS120N[2:0], Csr_DrvStrenFS240N[1:0], Csr_DrvStrenFS480N[0:0]] = [csrDrvStrenDqN]  Note: See table of csr DrvStrenFSDqP for list of possible impedances. RESET:0x3f"
          
group.long  0x296++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXIMPEDANCECTRL2_B1_P0, Tx DQ driver opposition impedance when equalization is enabled. - Register Block Offset Address 0x04b controls the lower DQ nibble - Register Block Offset Address 0x14b controls the upper DQ nibble RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXIMPEDANCECTRL2_B1_P0_DRVSTRENEQHIDQP ,Refer to Technology specific PHY DATABOOK for supported options This 6-bit bus is used to select the target pull-up output impedance used in equalization. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStrenEQHi120P[2:0], Csr_DrvStrenEQHi240P[1:0], Csr_DrvStrenEQHi480P[0]] = [csrDrvStrenEQHiDq] RESET:0x0"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXIMPEDANCECTRL2_B1_P0_DRVSTRENEQLODQN ,Refer to Technology specific PHY DATABOOK for supported options This 6-bit bus is used to select the target pull-down output impedance used in equalization. Connects to the DrvStren pins of the driver thus:  - [Csr_DrvStrenEQLo120N[2:0], Csr_DrvStrenEQLo240N[1:0], Csr_DrvStrenEQLo480P[0]] = [csrDrvStrenEQLoDq] RESET:0x0"
          
group.long  0x29a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXODTDRVSTREN_B1_P0, Selects desired impedance value for Host ODT. Must be set by user before PHY initialization. Setting for each protocol: DDR3:  - OdtStrenP - non-zero value  - OdtStrenN - same as OdtStrenP LPDDR3:  - OdtStrenP - non-zero value  - OdtStrenN - high-impedance DDR4:  - OdtStrenP - non-zero value  - OdtStrenN - high-impedance LPDDR4:  - OdtStrenP - high-impedance  - OdtStrenN - non-zero value  - Register Block Offset Address 0x04d controls the lower DQ nibble  - Register Block Offset Address 0x14d controls the upper DQ nibble RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXODTDRVSTREN_B1_P0_ODTSTRENP ,Selects the ODT pull-up impedance.  Refer to Technology specific PHY DATABOOK for supported options  - [ODTStren120P[2:0], ODTStren240P[1:0],ODTStren480P[0:0]]  - 000_00_0 = High Impedance  - 000_00_1 = 480 ohms  - 000_01_0 = 240 ohms  - 000_01_1 = 160 ohms  - 001_00_0 = 120 ohms  - 001_00_1 = 96.0 ohms  - 001_01_0 = 80.0 ohms  - 001_01_1 = 68.6 ohms  - 011_00_0 = 60.0 ohms  - 011_00_1 = 53.3 ohms  - 011_01_0 = 48.0 ohms  - 011_01_1 = 43.6 ohms  - 111_00_0 = 40.0 ohms  - 111_00_1 = 36.9 ohms  - 111_01_0 = 34.3 ohms  - 111_01_1 = 32.0 ohms  - 111_11_0 = 30.0 ohms  - 111_11_1 = 28.2 ohms RESET:0x0"
          
         hexmask.long 0x00 6.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXODTDRVSTREN_B1_P0_ODTSTRENN ,Selects the ODT pull-down impedance.  Refer to Technology specific PHY DATABOOK for supported options  - [ODTStren120N[2:0], ODTStren240N[1:0],ODTStren480N[0:0]]  - 000_00_0 = High Impedance  - 000_00_1 = 480 ohms  - 000_01_0 = 240 ohms  - 000_01_1 = 160 ohms  - 001_00_0 = 120 ohms  - 001_00_1 = 96.0 ohms  - 001_01_0 = 80.0 ohms  - 001_01_1 = 68.6 ohms  - 011_00_0 = 60.0 ohms  - 011_00_1 = 53.3 ohms  - 011_01_0 = 48.0 ohms  - 011_01_1 = 43.6 ohms  - 111_00_0 = 40.0 ohms  - 111_00_1 = 36.9 ohms  - 111_01_0 = 34.3 ohms  - 111_01_1 = 32.0 ohms  - 111_11_0 = 30.0 ohms  - 111_11_1 = 28.2 ohms RESET:0x0"
          
group.long  0x2be++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXSLEWRATE_B1_P0, Controls slew rates of the DQ/DQS drivers per nibble. - Tx predriver cal trims driver timing to account for clock duty cycle variation. - Register Block Offset Address 0x05f is the TxSlewRate for the lower nibble. - Register Block Offset Address 0x15f is the TxSlewRate for the upper nibble. RESET:0x7ff"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXSLEWRATE_B1_P0_TXPREP ,This is the 4-bit binary trim for the driver pull-up slew rate. 4'b0000 has a slower slew rate than 4'b1111 RESET:0xf"
          
         hexmask.long 0x00 4.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXSLEWRATE_B1_P0_TXPREN ,4 bit binary trim for the driver pull-down slew rate. 4'b0000 has a slower slew rate than 4'b1111 RESET:0xf"
          
         hexmask.long 0x00 8.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TXSLEWRATE_B1_P0_TXPREDRVMODE ,Controls predrivers to adjust timing of turn-on and turn-off of pull-up and pull-down segments. Recommended settings:  - DDR3 = 3'b011.  - DDR4 = 3'b010.  - LPDDR3 = 3'b010.  - LPDDR4 = 3'b001 RESET:0x7"
          
group.long  0x2c4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TRAININGINCDECDTSMEN_R1, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_TRAININGINCDECDTSMEN_R1_TRAININGINCDECDTSMEN_R1 ,Reserved for PHY training firmware use. RESET:0x0"
          
group.long  0x2d0++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXPBDLYTG0_R1, Read DQ per-bit BDL delay (Timing Group 0). RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXPBDLYTG0_R1_RXPBDLYTG0_R1 ,Read DQ per-bit BDL delay (Timing Group 0). Trained to deskew the read DQ data that will be sampled by the incoming per-nibble read DQS, to improve the composite eye.  Bits 5-0 convey the BDL delay value. Bit 6 is Reserved.  The unit of change is a LSB in the control of the delay circuit, and is not denoninated in units of UI.  - Register Block Offset Address 0x068 controls the lane0 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x168 controls the lane1 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x268 controls the lane2 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x368 controls the lane3 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x468 controls the lane4 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x568 controls the lane5 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x668 controls the lane6 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x768 controls the lane7 read deskew timing. (For Timing Group 0)  - Register Block Offset Address 0x868 controls the lane[DBI] read deskew timing. (For Timing Group 0)  Note: This register is not per-pstate. The same deskew (for channel-routing differences) is used for all pstates.  Note: Timing Group 0 = RANK0. RESET:0x0"
          
group.long  0x2d2++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXPBDLYTG1_R1, Read DQ per-bit BDL delay (Timing Group 1). RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXPBDLYTG1_R1_RXPBDLYTG1_R1 ,Read DQ per-bit BDL delay (Timing Group 1). Trained to deskew the read DQ data that will be sampled by the incoming per-nibble read DQS, to improve the composite eye.  Bits 5-0 convey the BDL delay value. Bit 6 is Reserved.  The unit of change is a LSB in the control of the delay circuit, and is not denoninated in units of UI.  - Register Block Offset Address 0x069 controls the lane0 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x169 controls the lane1 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x269 controls the lane2 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x369 controls the lane3 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x469 controls the lane4 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x569 controls the lane5 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x669 controls the lane6 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x769 controls the lane7 read deskew timing. (For Timing Group 1)  - Register Block Offset Address 0x869 controls the lane[DBI] read deskew timing. (For Timing Group 1)  Note: This register is not per-pstate. The same deskew (for channel-routing differences) is used for all pstates.  Note: Timing Group 1 = RANK1. RESET:0x0"
          
group.long  0x2d4++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXPBDLYTG2_R1, Read DQ per-bit BDL delay (Timing Group 2). RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXPBDLYTG2_R1_RXPBDLYTG2_R1 ,Read DQ per-bit BDL delay (Timing Group 2). Trained to deskew the read DQ data that will be sampled by the incoming per-nibble read DQS, to improve the composite eye.  Bits 5-0 convey the BDL delay value. Bit 6 is Reserved.  The unit of change is a LSB in the control of the delay circuit, and is not denoninated in units of UI.  - Register Block Offset Address 0x06a controls the lane0 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x16a controls the lane1 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x26a controls the lane2 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x36a controls the lane3 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x46a controls the lane4 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x56a controls the lane5 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x66a controls the lane6 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x76a controls the lane7 read deskew timing. (For Timing Group 2)  - Register Block Offset Address 0x86a controls the lane[DBI] read deskew timing. (For Timing Group 2)  Note: This register is not per-pstate. The same deskew (for channel-routing differences) is used for all pstates.  Note: Timing Group 2 = RANK2. RESET:0x0"
          
group.long  0x2d6++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXPBDLYTG3_R1, Read DQ per-bit BDL delay (Timing Group 3). RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXPBDLYTG3_R1_RXPBDLYTG3_R1 ,Read DQ per-bit BDL delay (Timing Group 3). Trained to deskew the read DQ data that will be sampled by the incoming per-nibble read DQS, to improve the composite eye.  Bits 5-0 convey the BDL delay value. Bit 6 is Reserved.  The unit of change is a LSB in the control of the delay circuit, and is not denoninated in units of UI.  - Register Block Offset Address 0x06b controls the lane0 read deskew timing. (For Timing Group 3)  - Register Block Offset Address 0x16b controls the lane1 read deskew timing. (For Timing Group 3)  - Register Block Offset Address 0x26b controls the lane2 read deskew timing. (For Timing Group 3)  - Register Block Offset Address 0x36b controls the lane3 read deskew timing. (For Timing Group 3)  - Register Block Offset Address 0x46b controls the lane4 read deskew timing. (For Timing Group 3)  - Register Block Offset Address 0x56b controls the lane5 read deskew timing. (For Timing Group 3)  - Register Block Offset Address 0x66b controls the lane6 read deskew timing. (For Timing Group 3)  - Register Block Offset Address 0x76b controls the lane7 read deskew timing. (For Timing Group 3)  - Register Block Offset Address 0x86b controls the lane[DBI] read deskew timing. (For Timing Group 3)  Note: This register is not per-pstate. The same deskew (for channel-routing differences) is used for all pstates.  Note: Timing Group 3 = RANK3. RESET:0x0"
          
group.long  0x300++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXENDLYTG0_U1_P0, Trained Receive Enable Delay. (For Timing Group 0) RESET:0x100"
         hexmask.long 0x00 0.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXENDLYTG0_U1_P0_RXENDLYTG0_U1_P0 ,Trained Receive Enable Delay. (For Timing Group 0) Trained to set the delay from the memory-read command to the signal enabling the read DQS to generate read-data strobes. The trained read DQS enable asserts during the read DQS preamble and deasserts at the end of the read burst.  - RxEnDlyTg0[10:6] is the coarse delay, ie one unit of delay is 1 UI.  - RxEnDlyTg0[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - RxEnDlyTg0[5] is reserved.  - Register Block Offset Address 0x080 controls the lower DQ nibble DqsEn. (For Timing Group 0)  - Register Block Offset Address 0x180 controls the upper DQ nibble DqsEn. (For Timing Group 0) Note: These Registers are replicated per pstate.  Note: Timing Group 0 = RANK0. RESET:0x100"
          
group.long  0x302++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXENDLYTG1_U1_P0, Trained Receive Enable Delay. (For Timing Group 1) RESET:0x100"
         hexmask.long 0x00 0.--10. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_RXENDLYTG1_U1_P0_RXENDLYTG1_U1_P0 ,Trained Receive Enable Delay. (For Timing Group 1) Trained to set the delay from the memory-read command to the signal enabling the read DQS to generate read-data strobes. The trained read DQS enable asserts during the read DQS preamble and deasserts at the end of the read burst.  - RxEnDlyTg1[10:6] is the coarse delay, ie one unit of delay is 1 UI.  - RxEnDlyTg1[4:0] is the fine delay, ie one unit of delay is one-thirtysecond of a UI = UI/32.  - RxEnDlyTg1[5] is reserved.  - Register Block Offset Address 0x081 controls the lower DQ nibble DqsEn. (For Timing Group 1)  - Register Block Offset Address 0x181 controls the upper DQ nibble DqsEn. (For Timing Group 1) Note: These Registers are replicated per pstate.  Note: Timing Group 1 = RANK1. RESET:0x100"
          
