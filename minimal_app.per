    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL3, It is recommended to use default values for this CSR. Otherwise, it can be programmed by bios or other means. RESET:0x1f0"
         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL3_PLLSPARE ,Spare bits for future PLL control modes RESET:0x0"
          
         hexmask.long 0x00 4.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL3_PLLMAXRANGE ,connects directly to maxrange of PLL. Setting for Saturation control of PLL. RESET:0x1f"
          
         hexmask.long 0x00 9.--13. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL3_PLLDACVALIN ,connects directly to dacval_in<4:0> of PLL. Calibration DAC input current setting, can be forced at rising edge of preset if force_cal =1 RESET:0x0"
          
         bitfld.long 0x00 14. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL3_PLLFORCECAL ,connects directly to force_cal of PLL. Forces Calibration code dacval_in<4:0> to be used at preset mode if force_cal=1 if force_cal=0 previous stored value will be used RESET:0x0"
          
         bitfld.long 0x00 15. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL3_PLLENCAL ,Calibration will run at standby rising edge if en_cal=1 if en_cal=0 calibration will not run RESET:0x0"
          
group.long  0x198++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL4_P0, This csr is to be programmed by bios or other means to set PLL charge-pump settings in various PStates. Refer to Technology specific PHY Databook for control setting programming. RESET:0x17f"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL4_P0_PLLCPINTGSCTRL ,connects directly to cp_int_gs_cntrl<4:0> in PLL. Charge pump integrating current control for fast relock and gearshift. RESET:0x1f"
          
         hexmask.long 0x00 5.--8. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PLLCTRL4_P0_PLLCPPROPGSCTRL ,connects directly to cp_prop_gs_cntrl<3:0> of PLL. Charge pump proportional current control for fast relock and gearshift. RESET:0xb"
          
