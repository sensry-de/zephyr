         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_MAPCAB9TODFI_MAPCAB9TODFI ,For LPDDR3 and LPDDR4 applications, these CSRs map a dfi1_address to CAB 9.  - Unused for DDR3 and unused for DDR4 applications.  - Unused for the 3-ANIB configuration. Each register in the set of MapCABtoDfi must have a unique value within the set.  For example, if PHY CAB9 is mapped from dfi1_address[2], then Register MapCAB9toDfi should be 2.  - LPDDR4 ACX3 registers MapCAB[0..9]toDfi are reserved, second channel not supported.  - LPDDR4 ACX6,ACX10,ACX12 registers MapCAB[0..5]toDfi are used, values 0-5 are valid,  - values 6-15 are reserved  - registers MapCAB[6..9]toDfi are reserved  - LPDDR3 ACX3 not supported.  - LPDDR3 ACX6 registers MapCAB[0..9] are unused, second channel not supported.  - LPDDR3 ACX10,ACX12 registers MapCAB[0..9]toDfi are used, values 0-9 are valid,  - values 10-15 are reserved RESET:0x9"
          
group.long  0x236++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTENABLE, Enables various interrupts to appear in the PhyInterruptStatus CSR. Only interrupts which are enabled by writing a 1 to the appropriate location in this CSR will be observable in the PhyInterruptStatus CSR. If a 0 is written in a particular location the corresponding interrupt will not be visible in the PhyInterruptStatus CSR. See the description of PhyInterruptStatus for more information on specific interrupts. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTENABLE_PHYTRNGCMPLTEN ,Enable for the PHY Training Complete interrupt. - 0 : Interrupt not enabled - 1 : Interrupt enabled RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTENABLE_PHYINITCMPLTEN ,Enable for the PHY Initialization Complete interrupt. - 0 : Interrupt not enabled - 1 : Interrupt enabled RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTENABLE_PHYTRNGFAILEN ,Enable for the PHY Training Failure interrupt. - 0 : Interrupt not enabled - 1 : Interrupt enabled RESET:0x0"
          
         hexmask.long 0x00 3.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTENABLE_PHYFWRESERVEDEN ,Reserved RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTENABLE_PHYVTDRIFTALARMEN ,Reserved RESET:0x0"
          
         bitfld.long 0x00 10. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTENABLE_PHYRXFIFOCHECKEN ,Enable for the RxFifo Pointers Check Interrupt - 0 : Interrupt not enabled - 1 : Interrupt enabled RESET:0x0"
          
         hexmask.long 0x00 11.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTENABLE_PHYHWRESERVEDEN ,Reserved RESET:0x0"
          
group.long  0x238++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTFWCONTROL, A 0 to 1 transition for any of the interrupts will set the corresponding bit  location in the PhyInterruptStatus CSR if the corresponding bit location in the PhyInterruptEnable CSR is set to 1. See the description of PhyInterruptStatus for more information on specific interrupts. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTFWCONTROL_PHYTRNGCMPLTFW ,PHY Training Complete Firmware interrupt. Written only by PHY Firmware. - 0 : Interrupt not asserted - 1 : Interrupt asserted RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTFWCONTROL_PHYINITCMPLTFW ,Reserved RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTFWCONTROL_PHYTRNGFAILFW ,PHY Training Failure Firmware interrupt. Written only by PHY Firmware. - 0 : Interrupt not asserted - 1 : Interrupt asserted RESET:0x0"
          
         hexmask.long 0x00 3.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTFWCONTROL_PHYFWRESERVEDFW ,Implemented, reserved for future use. - 0 : Interrupt not asserted - 1 : Interrupt asserted - Reserved RESET:0x0"
          
group.long  0x23a++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTMASK, This register is used to mask various interrupts to prevent them from affecting the output pin dwc_ddrphy_int_n. Only interrupts which are not masked by clearing to 0 the corresponding location in this CSR will be able to affect the dwc_ddrphy_int_n output when asserted in the PhyInterruptStatus CSR.  If a 1 is written in a particular location that interrupt will still be visible in the PhyInterruptStatus CSR but that interrupt will not affect the output pin dwc_ddrphy_int_n. See the description of PhyInterruptStatus for more information on specific interrupts. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTMASK_PHYTRNGCMPLTMSK ,Mask for the PHY Training Complete interrupt. - 0 : Interrupt not masked - 1 : Interrupt masked RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTMASK_PHYINITCMPLTMSK ,Mask for the PHY Initialization Complete interrupt. - 0 : Interrupt not masked - 1 : Interrupt masked RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTMASK_PHYTRNGFAILMSK ,Mask for the PHY Training Failure interrupt. - 0 : Interrupt not masked - 1 : Interrupt masked RESET:0x0"
          
         hexmask.long 0x00 3.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTMASK_PHYFWRESERVEDMSK ,Reserved RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTMASK_PHYVTDRIFTALARMMSK ,Reserved RESET:0x0"
          
         bitfld.long 0x00 10. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTMASK_PHYRXFIFOCHECKMSK ,Mask for the RxFifo Pointers Check Interrupt - 0 : Interrupt not masked - 1 : Interrupt masked RESET:0x0"
          
         hexmask.long 0x00 11.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTMASK_PHYHWRESERVEDMSK ,Reserved RESET:0x0"
          
group.long  0x23c++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTCLEAR, This register clears various interrupts and will negate the output pin dwc_ddrphy_int_n if the cleared interrupt was the cause of the assertion of the output pin dwc_ddrphy_int_n.  A 0 to 1 transition on a bit will clear the corresponding interrupt, and cause the hardware to immediately clear the bit. See the description of PhyInterruptStatus for more information on specific interrupts. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTCLEAR_PHYTRNGCMPLTCLR ,Clear for the PHY Training Complete interrupt. - 0 : Interrupt not affected - 1 : Interrupt cleared RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTCLEAR_PHYINITCMPLTCLR ,Clear for the PHY Initialization Complete interrupt. - 0 : Interrupt not affected - 1 : Interrupt cleared RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTCLEAR_PHYTRNGFAILCLR ,Clear for the PHY Training Failure interrupt. - 0 : Interrupt not affected - 1 : Interrupt cleared RESET:0x0"
          
         hexmask.long 0x00 3.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTCLEAR_PHYFWRESERVEDCLR ,Reserved RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTCLEAR_PHYVTDRIFTALARMCLR ,Reserved RESET:0x0"
          
         bitfld.long 0x00 10. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTCLEAR_PHYRXFIFOCHECKCLR ,Clear for the RxFifo Pointers Check Interrupt - 0 : Interrupt not affected - 1 : Interrupt cleared RESET:0x0"
          
         hexmask.long 0x00 11.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTCLEAR_PHYHWRESERVEDCLR ,Reserved RESET:0x0"
          
rgroup.long 0x23e++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTSTATUS, This register displays the current status of various PHY interrupts. This is a read only CSR. The PHY is the only entity which can write to it.  In order for a bit to become set in the PhyInterruptStatus CSR the corresponding bit must be set in the PhyInterruptEnable CSR.  If an interrupt is set in the PhyInterruptStatus CSR and the corresponding bit in the PhyInterruptMask CSR is cleared the dwc_ddrphy_int_n output signal will be asserted. Once the dwc_ddrphy_int_n output signal is asserted it can only be negated when all unmasked interrupts in the PhyInterruptStatus CSR have been cleared by writing the corresponding bit in the PhyInterruptClear CSR to 1. RESET:0x0"
         bitfld.long 0x00 0. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTSTATUS_PHYTRNGCMPLT ,PHY Training Complete interrupt. Assertion of this interrupt indicates that the PHY has successfully trained the memory interface at all indicated frequencies and is ready for the PHY Initialization Engine to be loaded.  - 0 : Interrupt not enabled and asserted  - 1 : Interrupt enabled and asserted RESET:0x0"
          
         bitfld.long 0x00 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTSTATUS_PHYINITCMPLT ,PHY Initialization Complete interrupt. Written by the user. Assertion of this interrupt is meant to indicate that the PHY Initialization Engine has been fully loaded and dfi_init_complete has been asserted.  - 0 : Interrupt not enabled and asserted  - 1 : Interrupt enabled and asserted RESET:0x0"
          
         bitfld.long 0x00 2. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTSTATUS_PHYTRNGFAIL ,PHY Training Failure interrupt. Assertion of this interrupt indicates there was an issue during training which did not allow the PHY to successfully complete training.  - 0 : Interrupt not enabled and asserted  - 1 : Interrupt enabled and asserted RESET:0x0"
          
         hexmask.long 0x00 3.--7. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTSTATUS_PHYFWRESERVED ,Reserved RESET:0x0"
          
         hexmask.long 0x00 8.--9. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTSTATUS_VTDRIFTALARM ,Reserved RESET:0x0"
          
         bitfld.long 0x00 10. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTSTATUS_PHYRXFIFOCHECK ,A mechanism in the PHY checks the Read Fifo pointers for consistency at times they are idle. If a check fails, this interrupt is asserted, and detailed status is found in the RxFifoCheckStatus register.  - 0 : Interrupt not enabled and asserted  - 1 : Interrupt enabled and asserted RESET:0x0"
          
         hexmask.long 0x00 11.--15. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_PHYINTERRUPTSTATUS_PHYHWRESERVED ,Reserved RESET:0x0"
          
group.long  0x240++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTSWIZZLEHWTADDRESS0, Signal swizzle selection for HWT swizzle RESET:0x0"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_MASTER0_P0_HWTSWIZZLEHWTADDRESS0_HWTSWIZZLEHWTADDRESS0 ,This set of registers is used in DDR3/DDR4 mode where a user has re-mapped the DFI inputs to the PHY. This register does not affect the mapping of those signals, or remap the tristate properties of the bumps. However, when the user remaps the DFI signals, the HWT inputs must be mapped in a similar fashion using this register.  Each remappable hwt bit has a register associated with it. When the register value is zero, the bit is not re-mapped. When the register value is non-zero, the signal associated with the number in the table below is mapped to the signal associated with the register. So, for example, if the value for the register associated with hwt_act_n (HwtSwizzleHwtActN) is set to 27, then hwt_parity_in will be mapped to hwt_act_n.  Note: These registers should always be 0 for LPDDR3 and LPDDR4.  Some registers are used only for DDR3 or DDR4. These are noted in the descriptions.  - 0: No-remapping  - 1: hwt_address[0]  - 2: hwt_address[1]  - 3: hwt_address[2]  - 4: hwt_address[3]  - 5: hwt_address[4]  - 6: hwt_address[5]  - 7: hwt_address[6]  - 8: hwt_address[7]  - 9: hwt_address[8]  - 10: hwt_address[9]  - 11: hwt_address[10]  - 12: hwt_address[11]  - 13: hwt_address[12]  - 14: hwt_address[13]  - 15: hwt_address[14]  (DDR3 Only)  - 16: hwt_address[15]  (DDR3 Only)  - 17: hwt_address[17]  (DDR4 Only)  - 18: hwt_act_n  (DDR4 Only)  - 19: hwt_bank[0]  - 20: hwt_bank[1]  - 21: hwt_bank[2]  (DDR3 Only)  - 22: hwt_bg[0]  (DDR4 Only)  - 23: hwt_bg[1]  (DDR4 Only)  - 24: hwt_cas_n  - 25: hwt_ras_n  - 26: hwt_we_n  - 27: hwt_parity_in RESET:0x0"
          
