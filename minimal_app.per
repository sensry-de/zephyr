         hexmask.long 0x00 0.--3. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DTSMTRAINMODECTRL_RFU_DTSMTRAINMODECTRL ,None RESET:0x0"
          
group.long  0x40++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DFIMRL_P0, DFI MaxReadLatency RESET:0x6"
         hexmask.long 0x00 0.--4. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE0_P0_DFIMRL_P0_DFIMRL_P0 ,This Max Read Latency CSR is to be trained to ensure the rx-data fifo is not read until after all dbytes have their read data valid. This is the value, in units of two mem clocks, between dfi_rddata_en and dfi_rddata_valid A unit change in the LSB is a change in MRL of two mem clocks. RESET:0x6"
          
