    line.long 0x00 "DCU_DSW_GLOBAL_FB_DIMENSIONS, Framebuffer dimensions RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " DCU_DSW_GLOBAL_FB_DIMENSIONS_X_DIM ,x-dimension in pixels RESET:0x0"
          
