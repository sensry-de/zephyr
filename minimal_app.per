         hexmask.long 0x00 0.--31. 1. " TIMER_RTC_TARGET_VALUE ,Target value, this write trigger has the highest priority compared to the other registers RESET:0x0"
          
rgroup.long 0x10++0x3
    line.long 0x00 "TIMER_RTC_COUNT, Captured Timer Value RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " TIMER_RTC_COUNT_VALUE ,Captured timer value. This value is valid only if TIMER_READ is enabled in HW. The value is valid after capture.req _> capture_ack register handshake RESET:0x0"
          
group.long  0x14++0x3
    line.long 0x00 "TIMER_RTC_COUNT_SET, Set Counter Value RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " TIMER_RTC_COUNT_SET_VALUE ,Set counter value, this write trigger has the highest priority compared to the other registers RESET:0x0"
          
group.long  0x18++0x3
    line.long 0x00 "TIMER_RTC_IRQ_STATUS_EN, Status Interrupt Enable Register RESET:0x0"
         bitfld.long 0x00 0. " TIMER_RTC_IRQ_STATUS_EN_ALARM ,Count reached zero RESET:0x0"
          
         bitfld.long 0x00 1. " TIMER_RTC_IRQ_STATUS_EN_OVFL ,Count reached zero while alarm is set to one. i.e. The previous alarm was not handled RESET:0x0"
          
group.long  0x1c++0x3
    line.long 0x00 "TIMER_RTC_IRQ_STATUS, Status Interrupt Register RESET:0x0"
         bitfld.long 0x00 0. " TIMER_RTC_IRQ_STATUS_ALARM ,Count reached zero RESET:0x0"
          
         bitfld.long 0x00 1. " TIMER_RTC_IRQ_STATUS_OVFL ,Count reached zero while alarm is set to one. i.e. The previous alarm was not handled RESET:0x0"
          
wgroup.long 0x20++0x3
    line.long 0x00 "TIMER_RTC_IRQ_STATUS_SET, Set irq_status register bits. Used to the emulate interrupt event (for SW debug or dev). RESET:0x0"
         bitfld.long 0x00 0. " TIMER_RTC_IRQ_STATUS_SET_ALARM ,Set alarm irq RESET:0x0"
          
         bitfld.long 0x00 1. " TIMER_RTC_IRQ_STATUS_SET_OVFL ,Set ovfl irq RESET:0x0"
          
tree.end
    

tree "LPDDR4_PUB"
base e:0x42000000
width 80.
