group.long  0x50++0x3
    line.long 0x00 "LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_ASYNCDBYTETXDATA, Reserved for PHY training firmware use. RESET:0x0"
         hexmask.long 0x00 0.--11. 1. " LPDDR4_PUB_DWC_DDRPHYA_DBYTE1_P0_ASYNCDBYTETXDATA_ASYNCDBYTETXDATA ,Reserved for PHY training firmware use. RESET:0x0"
          
