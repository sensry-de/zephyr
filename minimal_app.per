         bitfld.long 0x00 17.--19. " PMU_RI_PMU_CTRL_STATUS_MODE ,ri_pmu_ctr mode status RESET:0x0" "OFF-0,SLEEP-1,RBB_RETENTION-2,IDLE-3,ACTIVE_LP-4,ACTIVE_HP-5"
          
         bitfld.long 0x00 20. " PMU_RI_PMU_CTRL_STATUS_AWAITING_WAKEUP ,Set '1'  FSM is waiting for wakeup signal i.e. is currently IDLE, RBB_RETENTION or SLEEP. RESET:0x0"
          
         bitfld.long 0x00 21. " PMU_RI_PMU_CTRL_STATUS_BOOT_DONE ,Set '1'  when FSM boots for the first time following reset/rbb_retention/sleep RESET:0x0"
          
         bitfld.long 0x00 31. " PMU_RI_PMU_CTRL_STATUS_BUSY ,indicates when the FSM is busy (active-high) RESET:0x0"
          
group.long  0x2a8++0x3
    line.long 0x00 "PMU_RI_PMU_CTRL_CFG, None RESET:0x4e20f"
         hexmask.long 0x00 0.--5. 1. " PMU_RI_PMU_CTRL_CFG_ISOLATION_CNT ,Isolation counter (TODO add description). RESET:0xf"
          
         hexmask.long 0x00 6.--19. 1. " PMU_RI_PMU_CTRL_CFG_SWITCH_CLK_CNT ,Delay between selecting slow clock and disabling the fast clock. RESET:0x1388"
          
         bitfld.long 0x00 20. " PMU_RI_PMU_CTRL_CFG_NO_ABB_LOCK ,Set '1' to always ignore the ABB locked flagfor purposes of ABB delay counter. RESET:0x0"
          
         bitfld.long 0x00 21. " PMU_RI_PMU_CTRL_CFG_NO_32K ,Sets whether to use 32 kHz clock during SLEEP/RBB_RETENTION. Default:0 = Use 32 kHz. RESET:0x0"
          
         bitfld.long 0x00 22. " PMU_RI_PMU_CTRL_CFG_NO_LDO ,Sets whether to use ULP LDO during SLEEP/RBB_RETENTION. Default:0 = Use LDO. RESET:0x0"
          
