tree "ETHERNET_REG__WDMA"
base e:0x400f8080
width 80.
group.long  0x0++0x3
    line.long 0x00 "ETHERNET_REG_WDMA_CTRL, Contains software control fields RESET:0x2"
         bitfld.long 0x00 0. " ETHERNET_REG_WDMA_CTRL_ENABLE ,Global enable for the WDMA RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_REG_WDMA_CTRL_CYCLIC ,Enable cyclic operation. If enabled and the DMA address has reached (startaddr + maxsize), the next write will wrap to startaddr RESET:0x1"
          
         bitfld.long 0x00 2. " ETHERNET_REG_WDMA_CTRL_ADDR_DECREMENT ,When = 1, address is decremented in the AXI master RESET:0x0"
          
         bitfld.long 0x00 3. " ETHERNET_REG_WDMA_CTRL_CONT_MODE ,Enables continuous mode if set to 1, transmission is finalized, if HW signals last access RESET:0x0"
          
         bitfld.long 0x00 4. " ETHERNET_REG_WDMA_CTRL_DOUBLE_BUF ,Enables double buffering mode, once maxsize is reached, it starts again from startaddr_db RESET:0x0"
          
         hexmask.long 0x00 5.--12. 1. " ETHERNET_REG_WDMA_CTRL_BURST_LEN ,AXI burst length RESET:0x0"
          
group.long  0x4++0x3
    line.long 0x00 "ETHERNET_REG_WDMA_STARTADDR, the start address of the DMA buffer. The last two bits are zero for word alignment RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " ETHERNET_REG_WDMA_STARTADDR_WORD_ALIGNMENT ,None RESET:0x0"
          
         hexmask.long 0x00 2.--31. 1. " ETHERNET_REG_WDMA_STARTADDR_VALUE ,None RESET:0x0"
          
group.long  0x8++0x3
    line.long 0x00 "ETHERNET_REG_WDMA_STARTADDR_DB, the second start address of the DMA in double buffering mode. The last two bits are zero for word alignment RESET:0x0"
         hexmask.long 0x00 0.--1. 1. " ETHERNET_REG_WDMA_STARTADDR_DB_WORD_ALIGNMENT ,None RESET:0x0"
          
         hexmask.long 0x00 2.--31. 1. " ETHERNET_REG_WDMA_STARTADDR_DB_VALUE ,None RESET:0x0"
          
group.long  0xc++0x3
    line.long 0x00 "ETHERNET_REG_WDMA_MAXSIZE, the size in bytes of the buffer allocated for DMA operations RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " ETHERNET_REG_WDMA_MAXSIZE_VALUE ,None RESET:0x0"
          
group.long  0x10++0x3
    line.long 0x00 "ETHERNET_REG_WDMA_SIZE1, SIZE1 interrupt triggers in case buffer is filled with size1 byte / can be used for double buffering RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " ETHERNET_REG_WDMA_SIZE1_VALUE ,None RESET:0x0"
          
rgroup.long 0x14++0x3
    line.long 0x00 "ETHERNET_REG_WDMA_CURR_ADDR, the current address of the DMA write pointer RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " ETHERNET_REG_WDMA_CURR_ADDR_VALUE ,None RESET:0x0"
          
group.long  0x18++0x3
    line.long 0x00 "ETHERNET_REG_WDMA_IRQ_STATUS, interrupt status bits / whether these bits generate an interrupt is contolled via irq_status_enable RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_REG_WDMA_IRQ_STATUS_MAXSIZE ,Buffer is filled to MAXSIZE RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_REG_WDMA_IRQ_STATUS_SIZE1 ,Buffer is filled to size1 RESET:0x0"
          
         bitfld.long 0x00 2. " ETHERNET_REG_WDMA_IRQ_STATUS_BERR ,Bus error: system bus returns an error response. Use curr_addr as a hint where the bus error occurred RESET:0x0"
          
         bitfld.long 0x00 3. " ETHERNET_REG_WDMA_IRQ_STATUS_OVFL ,Overflow: data from AXI-4S is coming too fast to be written to the bus system in time. NOTE: This can also be detected from the interface axi wrappers (e.g. spi_axi4s_wrap) RESET:0x0"
          
group.long  0x1c++0x3
    line.long 0x00 "ETHERNET_REG_WDMA_IRQ_STATUS_ENABLE, Enables the selected events to generate interrupts on the interrupt line RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_REG_WDMA_IRQ_STATUS_ENABLE_MAXSIZE ,Enable interrupt maxsize RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_REG_WDMA_IRQ_STATUS_ENABLE_SIZE1 ,Enable interrupt size1 RESET:0x0"
          
         bitfld.long 0x00 2. " ETHERNET_REG_WDMA_IRQ_STATUS_ENABLE_BERR ,Enable interrupt berr RESET:0x0"
          
         bitfld.long 0x00 3. " ETHERNET_REG_WDMA_IRQ_STATUS_ENABLE_OVFL ,Enable interrupt ovfl RESET:0x0"
          
wgroup.long 0x20++0x3
    line.long 0x00 "ETHERNET_REG_WDMA_IRQ_STATUS_SET, Set irq_status register bits. Used to force an interrupt event (used for Software debugging or integration testing) RESET:0x0"
         bitfld.long 0x00 0. " ETHERNET_REG_WDMA_IRQ_STATUS_SET_MAXSIZE ,Set interrupt maxsize for one cycle RESET:0x0"
          
         bitfld.long 0x00 1. " ETHERNET_REG_WDMA_IRQ_STATUS_SET_SIZE1 ,Set interrupt size1 for one cycle RESET:0x0"
          
         bitfld.long 0x00 2. " ETHERNET_REG_WDMA_IRQ_STATUS_SET_BERR ,Set interrupt berr for one cycle RESET:0x0"
          
         bitfld.long 0x00 3. " ETHERNET_REG_WDMA_IRQ_STATUS_SET_OVFL ,Set interrupt ovfl for one cycle RESET:0x0"
          
tree.end

