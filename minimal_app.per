rgroup.long 0xe6++0x3
    line.long 0x00 "EMMC_REG_BLOCK_P_EMBEDDED_CNTRL, This register points to the location of UHS-II embedded control registers. RESET:0xf6c"
         hexmask.long 0x00 0.--11. 1. " EMMC_REG_BLOCK_P_EMBEDDED_CNTRL_REG_OFFSET_ADDR ,Offset Address of Embedded Control register. RESET:0xf6c"
          
          
rgroup.long 0xe8++0x3
    line.long 0x00 "EMMC_REG_BLOCK_P_VENDOR_SPECIFIC_AREA, This register used as a pointer for the Vendor Specific Area 1. RESET:0x500"
         hexmask.long 0x00 0.--11. 1. " EMMC_REG_BLOCK_P_VENDOR_SPECIFIC_AREA_REG_OFFSET_ADDR ,Base offset Address for Vendor-Specific registers. RESET:0x500"
          
          
rgroup.long 0xea++0x3
    line.long 0x00 "EMMC_REG_BLOCK_P_VENDOR2_SPECIFIC_AREA, This register is used as a pointer for the Vendor Specific Area 2. RESET:0x180"
         hexmask.long 0x00 0.--15. 1. " EMMC_REG_BLOCK_P_VENDOR2_SPECIFIC_AREA_REG_OFFSET_ADDR ,Base offset Address for Command Queuing registers. RESET:0x180"
          
rgroup.long 0xfc++0x3
    line.long 0x00 "EMMC_REG_BLOCK_SLOT_INTR_STATUS_R, This register indicates the Interrupt status of each slot. RESET:0x0"
         hexmask.long 0x00 0.--7. 1. " EMMC_REG_BLOCK_SLOT_INTR_STATUS_R_INTR_SLOT ,Interrupt signal for each Slot  These status bits indicate the logical OR of Interrupt signal and Wakeup signal for each slot. A maximum of 8 slots can be defined. If one interrupt signal is associated with multiple slots, the Host Driver can identify the interrupt that is generated by reading these bits. By a power on reset or by setting Software Reset For All bit, the interrupt signals are de-asserted and this status reads 00h.  - Bit 00: Slot 1  - Bit 01: Slot 2  - Bit 02: Slot 3  - ..........  - ..........  - Bit 07: Slot 8   Note: MSHC Host Controller support single card slot. This register shall always return 0. RESET:0x0"
          
          
rgroup.long 0xfe++0x3
    line.long 0x00 "EMMC_REG_BLOCK_HOST_CNTRL_VERS_R, This register is used to indicate the Host Controller Version number. RESET:0xe05"
         bitfld.long 0x00 0.--7. " EMMC_REG_BLOCK_HOST_CNTRL_VERS_R_SPEC_VERSION_NUM ,Specification Version Number  These bits indicate the Host controller specification version. The upper and lower 4-bits indicate the version. Values 0x06-0xFF are reserved. RESET:0x5" "VER_1_00-0,VER_2_00-1,VER_3_00-2,VER_4_00-3,VER_4_10-4,VER_4_20-5"
          
         hexmask.long 0x00 8.--15. 1. " EMMC_REG_BLOCK_HOST_CNTRL_VERS_R_VENDOR_VERSION_NUM ,Vendor Version Number  This field is reserved for the vendor version number. Host Driver must not use this status. RESET:0xe"
          
tree.end
    

tree "EMMC_REG__VENDOR2_BLOCK"
base e:0x40065180
width 80.
rgroup.long 0x0++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQVER, This register provides information about the version of the eMMC Command Queueing standard, which is implemented by the CQE in BCD format. RESET:0x510"
         hexmask.long 0x00 0.--3. 1. " EMMC_REG_VENDOR2_BLOCK_CQVER_EMMC_VER_SUFFIX ,This bit indicates the eMMC version suffix (2nd digit right of decimal point) in BCD format. RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " EMMC_REG_VENDOR2_BLOCK_CQVER_EMMC_VER_MINOR ,This bit indicates the eMMC minor version (1st digit right of decimal point) in BCD format. RESET:0x1"
          
         hexmask.long 0x00 8.--11. 1. " EMMC_REG_VENDOR2_BLOCK_CQVER_EMMC_VER_MAJOR ,This bit indicates the eMMC major version (1st digit left of decimal point) in BCD format. RESET:0x5"
          
         hexmask.long 0x00 12.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQVER_EMMMC_VER_RSVD ,These bits of the CQVER register are reserved. They always return 0. RESET:0x0"
          
rgroup.long 0x4++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQCAP, This register indicates the capabilities of the command queuing engine. RESET:0x3020"
         hexmask.long 0x00 0.--9. 1. " EMMC_REG_VENDOR2_BLOCK_CQCAP_ITCFVAL ,Internal Timer Clock Frequency Value (ITCFVAL) This field scales the frequency of the timer clock provided by ITCFMUL. The Final clock frequency of actual timer clock is calculated as ITCFVAL* ITCFMUL. RESET:0x20"
          
         hexmask.long 0x00 10.--11. 1. " EMMC_REG_VENDOR2_BLOCK_CQCAP_CQCCAP_RSVD1 ,These bits of the CQCAP register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 12.--15. " EMMC_REG_VENDOR2_BLOCK_CQCAP_ITCFMUL ,Internal Timer Clock Frequency Multiplier (ITCFMUL) This field indicates the frequency of the clock used for interrupt coalescing timer and for determining the SQS polling period. See ITCFVAL definition for details. Values 0x5 to 0xF are reserved. RESET:0x3" "CLK_100KHZ-2,CLK_10KHZ-1,CLK_10MHZ-4,CLK_1KHZ-0,CLK_1MHZ-3"
          
         hexmask.long 0x00 16.--27. 1. " EMMC_REG_VENDOR2_BLOCK_CQCAP_CQCCAP_RSVD2 ,These bits [27:16] of the CQCAP register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 28. " EMMC_REG_VENDOR2_BLOCK_CQCAP_CRYPTO_SUPPORT ,Crypto Support  This bit indicates whether the Host Controller supports cryptographic operations. RESET:0x0" "FALSE-0,TRUE-1"
          
         hexmask.long 0x00 29.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQCAP_CQCCAP_RSVD3 ,These bits [31:29] of the CQCAP register are reserved. They always return 0. RESET:0x0"
          
group.long  0x8++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQCFG, This register controls CQE behavior affecting the general operation of command queuing engine. RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_VENDOR2_BLOCK_CQCFG_CQ_EN ,Enable command queuing engine (CQE). When CQE is disable, the software controls the eMMC bus using the registers between the addresses 0x000 to 0x1FF. Before the software writes to this bit, the software verifies that the eMMC host controller is in idle state and there are no ongoing commands or data transfers. When software wants to exit command queuing mode, it clears all previous tasks (if any) before setting this bit to 0. RESET:0x0" "CQE_DISABLE-0,CQE_ENABLE-1"
          
         hexmask.long 0x00 2.--7. 1. " EMMC_REG_VENDOR2_BLOCK_CQCFG_CQCCFG_RSVD1 ,These bits (CQCCFG_RSVD1) of the CQCFG register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 8. " EMMC_REG_VENDOR2_BLOCK_CQCFG_TASK_DESC_SIZE ,Bit Value Description  This bit indicates the size of task descriptor used in host memory. This bit can only be configured when Command Queuing Enable bit is 0 (command queuing is disabled). RESET:0x0" "TASK_DESC_128B-1,TASK_DESC_64B-0"
          
         hexmask.long 0x00 9.--11. 1. " EMMC_REG_VENDOR2_BLOCK_CQCFG_CQCCFG_RSVD2 ,These bits (CQCCFG_RSVD2) of the CQCFG register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 12. " EMMC_REG_VENDOR2_BLOCK_CQCFG_DCMD_EN ,This bit indicates to the hardware whether the Task Descriptor in slot #31 of the TDL is a data transfer descriptor or a direct-command descriptor. CQE uses this bit when a task is issued in slot #31, to determine how to decode the Task Descriptor. RESET:0x0" "SLOT31_DCMD_DISABLE-0,SLOT31_DCMD_ENABLE-1"
          
         hexmask.long 0x00 13.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQCFG_CQCCFG_RSVD3 ,These bits (CQCCFG_RSVD3) of the CQCFG register are reserved. They always return 0. RESET:0x0"
          
group.long  0xc++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQCTL, This register controls CQE behavior affecting the general operation of command queuing module or simultaneous operation of multiple tasks. RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_VENDOR2_BLOCK_CQCTL_HALT ,Halt request and resume RESET:0x0" "HALT_CQE-1,RESUME_CQE-0"
          
         hexmask.long 0x00 1.--7. 1. " EMMC_REG_VENDOR2_BLOCK_CQCTL_CQCTL_RSVD1 ,These bits (CQCTL_RSVD1) of the CQCTL register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 8. " EMMC_REG_VENDOR2_BLOCK_CQCTL_CLR_ALL_TASKS ,Clear all tasks  This bit can only be written when the controller is halted. This bit does not clear tasks in the device. The software has to use the CMDQ_TASK_MGMT command to clear device's queue. RESET:0x0" "CLEAR_ALL_TASKS-1,NO_EFFECT-0"
          
         hexmask.long 0x00 9.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQCTL_CQCTL_RSVD2 ,These bits (CQCTL_RSVD2) of the CQCTL register are reserved. They always return 0. RESET:0x0"
          
group.long  0x10++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQIS, This register indicates pending interrupts that require service. Each bit in this register is asserted in response to a specific event, only if the respective bit is set in the CQISE register. RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_VENDOR2_BLOCK_CQIS_HAC ,Halt complete interrupt This status bit is asserted (only if CQISE.HAC_STE=1) when halt bit in the CQCTL register transitions from 0 to 1 indicating that the host controller has completed its current ongoing task and has entered halt state. A value of 1 clears this status bit. RESET:0x0" "NOTSET-0,SET-1"
          
         bitfld.long 0x00 1. " EMMC_REG_VENDOR2_BLOCK_CQIS_TCC ,Task complete interrupt This status bit is asserted (if CQISE.TCC_STE=1) when at least one of the following conditions are met:  - A task is completed and the INT bit is set in its Task Descriptor  - Interrupt caused by Interrupt Coalescing logic due to timeout  - Interrupt Coalescing logic reached the configured threshold A value of 1 clears this status bit RESET:0x0" "NOTSET-0,SET-1"
          
         bitfld.long 0x00 2. " EMMC_REG_VENDOR2_BLOCK_CQIS_RED ,Response error detected interrupt This status bit is asserted (if CQISE.RED_STE=1) when a response is received with an error bit set in the device status field. Configure the CQRMEM register to identify device status bit fields that may trigger an interrupt and that are masked. A value of 1 clears this status bit. RESET:0x0" "NOTSET-0,SET-1"
          
         bitfld.long 0x00 3. " EMMC_REG_VENDOR2_BLOCK_CQIS_TCL ,Task cleared interrupt This status bit is asserted (if CQISE.TCL_STE=1) when a task clear operation is completed by CQE. The completed task clear operation is either an individual task clear (by writing CQTCLR) or clearing of all tasks (by writing CQCTL). A value of 1 clears this status bit. RESET:0x0" "NOTSET-0,SET-1"
          
         hexmask.long 0x00 6.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQIS_CQIS_RSVD1 ,These bits of the CQIS register are reserved. They always return 0. RESET:0x0"
          
group.long  0x14++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQISE, This register enables and disables the reporting of the corresponding interrupt to host software in the CQIS register. When a bit is set (1) and the corresponding interrupt condition is active, then the bit in CQIS is asserted. Interrupt sources that are disabled (when '0') are not indicated in the CQIS register. This register is bit-index matched to the CQIS register. RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_VENDOR2_BLOCK_CQISE_HAC_STE ,Halt complete interrupt status enable RESET:0x0" "INT_STS_DISABLE-0,INT_STS_ENABLE-1"
          
         bitfld.long 0x00 1. " EMMC_REG_VENDOR2_BLOCK_CQISE_TCC_STE ,Task complete interrupt status enable RESET:0x0" "INT_STS_DISABLE-0,INT_STS_ENABLE-1"
          
         bitfld.long 0x00 2. " EMMC_REG_VENDOR2_BLOCK_CQISE_RED_STE ,Response error detected interrupt status enable RESET:0x0" "INT_STS_DISABLE-0,INT_STS_ENABLE-1"
          
         bitfld.long 0x00 3. " EMMC_REG_VENDOR2_BLOCK_CQISE_TCL_STE ,Task cleared interrupt status enable RESET:0x0" "INT_STS_DISABLE-0,INT_STS_ENABLE-1"
          
         hexmask.long 0x00 6.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQISE_CQISTE_RSVD1 ,These bits of the CQISE register are reserved. They always return 0. RESET:0x0"
          
group.long  0x18++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQISGE, This register enables and disables the generation of interrupts to host software. When a bit is set and the corresponding bit in CQIS is set, then an interrupt is generated. Interrupt sources that are disabled are still indicated in the CQIS register. This register is bit-index matched to the CQIS register. RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_VENDOR2_BLOCK_CQISGE_HAC_SGE ,Halt complete interrupt signal enable RESET:0x0" "INT_SIG_DISABLE-0,INT_SIG_ENABLE-1"
          
         bitfld.long 0x00 1. " EMMC_REG_VENDOR2_BLOCK_CQISGE_TCC_SGE ,Task complete interrupt signal enable RESET:0x0" "INT_SIG_DISABLE-0,INT_SIG_ENABLE-1"
          
         bitfld.long 0x00 2. " EMMC_REG_VENDOR2_BLOCK_CQISGE_RED_SGE ,Response error detected interrupt signal enable RESET:0x0" "INT_SIG_DISABLE-0,INT_SIG_ENABLE-1"
          
         bitfld.long 0x00 3. " EMMC_REG_VENDOR2_BLOCK_CQISGE_TCL_SGE ,Task cleared interrupt signal enable RESET:0x0" "INT_SIG_DISABLE-0,INT_SIG_ENABLE-1"
          
         hexmask.long 0x00 6.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQISGE_CQISGE_RSVD1 ,These bits of the CQISGE register are reserved. They always return 0. RESET:0x0"
          
group.long  0x1c++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQIC, This register controls and configures interrupt coalescing feature. RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " EMMC_REG_VENDOR2_BLOCK_CQIC_TOUT_VAL ,Interrupt Coalescing Timeout Value Software uses this field to configure the maximum time allowed between the completion of a task on the bus and the generation of an interrupt. Timer Operation: The timer is reset by software during the interrupt service routine. It starts running when the first data transfer task with INT=0 is completed, after the timer was reset. When the timer reaches the value configured in ICTOVAL field, it generates an interrupt and stops. The timer's unit is equal to 1024 clock periods of the clock whose frequency is specified in the Internal Timer Clock Frequency field CQCAP register.  - 0x0: Timer is disabled. Timeout-based interrupt is not generated  - 0x1: Timeout on 01x1024 cycles of timer clock frequency  - 0x2: Timeout on 02x1024 cycles of timer clock frequency  - ........  - 0x7f: Timeout on 127x1024 cycles of timer clock frequency In order to write to this field, the TOUT_VAL_WEN bit must be set at the same write operation. RESET:0x0"
          
         bitfld.long 0x00 7. " EMMC_REG_VENDOR2_BLOCK_CQIC_TOUT_VAL_WEN ,When software writes 1 to this bit, the value TOUT_VAL is updated with the contents written on the same cycle. RESET:0x0" "WEN_CLR-0,WEN_SET-1"
          
         hexmask.long 0x00 8.--12. 1. " EMMC_REG_VENDOR2_BLOCK_CQIC_INTC_TH ,Interrupt Coalescing Counter Threshold filed Software uses this field to configure the number of task completions (only tasks with INT=0 in the Task Descriptor), which are required in order to generate an interrupt. Counter Operation: As data transfer tasks with INT=0 complete, they are counted by CQE. The counter is reset by software during the interrupt service routine. The counter stops counting when it reaches the value configured in INTC_TH, and generates interrupt.  - 0x0: Interrupt coalescing feature disabled  - 0x1: Interrupt coalescing interrupt generated after 1 task when INT=0 completes  - 0x2: Interrupt coalescing interrupt generated after 2 tasks when INT=0 completes  - ........  - 0x1f: Interrupt coalescing interrupt generated after 31 tasks when INT=0 completes To write to this field, the INTC_TH_WEN bit must be set during the same write operation. RESET:0x0"
          
         hexmask.long 0x00 13.--14. 1. " EMMC_REG_VENDOR2_BLOCK_CQIC_CQIC_RSVD1 ,These bits (CQIC_RSVD1) of the CQIC register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 15. " EMMC_REG_VENDOR2_BLOCK_CQIC_INTC_TH_WEN ,Interrupt Coalescing Counter Threshold Write Enable When software writes 1 to this bit, the value INTC_TH is updated with the contents written on the same cycle. RESET:0x0" "WEN_CLR-0,WEN_SET-1"
          
         bitfld.long 0x00 16. " EMMC_REG_VENDOR2_BLOCK_CQIC_INTC_RST ,Counter and Timer Reset When host driver writes 1, the interrupt coalescing timer and counter are reset. RESET:0x0" "ASSERT_INTC_RESET-1,NO_EFFECT-0"
          
         hexmask.long 0x00 17.--19. 1. " EMMC_REG_VENDOR2_BLOCK_CQIC_CQIC_RSVD2 ,These bits (CQIC_RSVD2) of the CQIC register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 20. " EMMC_REG_VENDOR2_BLOCK_CQIC_INTC_STAT ,Interrupt Coalescing Status Bit This bit indicates to the software whether any tasks (with INT=0) have completed and counted towards interrupt coalescing (that is, this is set if and only if INTC counter > 0). RESET:0x0" "INTC_ATLEAST1_COMP-1,INTC_NO_TASK_COMP-0"
          
         hexmask.long 0x00 21.--30. 1. " EMMC_REG_VENDOR2_BLOCK_CQIC_CQIC_RSVD3 ,These bits (CQIC_RSVD3) of the CQIC register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 31. " EMMC_REG_VENDOR2_BLOCK_CQIC_INTC_EN ,Interrupt Coalescing Enable Bit RESET:0x0" "DISABLE_INT_COALESCING-0,ENABLE_INT_COALESCING-1"
          
group.long  0x20++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQTDLBA, This register is used for configuring the lower 32 bits of the byte address of the head of the Task Descriptor List in the host memory. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQTDLBA_TDLBA ,This register stores the LSB bits (31:0) of the byte address of the head of the Task Descriptor List in system memory. The size of the task descriptor list is 32 * (Task Descriptor size + Transfer Descriptor size) as configured by the host driver.  This address is set on 1 KB boundary. The lower 10 bits of this register are set to 0 by the software and are ignored by CQE. RESET:0x0"
          
group.long  0x24++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQTDLBAU, This register is used for configuring the upper 32 bits of the byte address of the head of the Task Descriptor List in the host memory. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQTDLBAU_TDLBAU ,This register stores the MSB bits (63:32) of the byte address of the head of the Task Descriptor List in system memory. The size of the task descriptor list is 32 * (Task Descriptor size + Transfer Descriptor size) as configured by Host driver. This address is set on 1 KB boundary. The lower 10 bits of this register are set to 0 by the software and are ignored by CQE. This register is reserved when using 32-bit addressing mode. RESET:0x0"
          
group.long  0x28++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQTDBR, Using this register, software triggers CQE to process a new task. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQTDBR_DBR ,The software configures TDLBA and TDLBAU, and enable CQE in CQCFG before using this register. Writing 1 to bit n of this register triggers CQE to start processing the task encoded in slot n of the TDL. Writing 0 by the software does not have any impact on the hardware, and does not change the value of the register bit. CQE always processes tasks according to the order submitted to the list by CQTDBR write transactions. CQE processes Data Transfer tasks by reading the Task Descriptor and sending QUEUED_TASK_PARAMS (CMD44) and QUEUED_TASK_ADDRESS (CMD45) commands to the device. CQE processes DCMD tasks (in slot #31, when enabled) by reading the Task Descriptor, and generating the command encoded by its index and argument. The corresponding bit is cleared to 0 by CQE in one of the following events:  - A task execution is completed (with success or error).  - The task is cleared using CQTCLR register.  - All tasks are cleared using CQCTL register.  - CQE is disabled using CQCFG register. Software may initiate multiple tasks at the same time (batch submission) by writing 1 to multiple bits of this register in the same transaction. In the case of batch submission, CQE processes the tasks in order of the task index, starting with the lowest index. If one or more tasks in the batch are marked with QBR, the ordering of execution is based on said processing order. RESET:0x0"
          
group.long  0x2c++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQTCN, This register is used by CQE to notify software about completed tasks. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQTCN_TCN ,Task Completion Notification Each of the 32 bits are bit mapped to the 32 tasks.  - Bit-N(1): Task-N has completed execution (with success or errors)  - Bit-N(0): Task-N has not completed, could be pending or not submitted. On task completion, software may read this register to know tasks that have completed. After reading this register, software may clear the relevant bit fields by writing 1 to the corresponding bits. RESET:0x0"
          
rgroup.long 0x30++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQDQS, This register stores the most recent value of the device's queue status. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQDQS_DQS ,Device Queue Status Each of the 32 bits are bit mapped to the 32 tasks.  - Bit-N(1): Device has marked task N as ready for execution  - Bit-N(0): Task-N is not ready for execution. This task could be pending in device or not submitted. Host controller updates this register with response of the Device Queue Status command. RESET:0x0"
          
rgroup.long 0x34++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQDPT, This register maintains the list of tasks that are queued into device and are awaiting execution completion. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQDPT_DPT ,Device-Pending Tasks Each of the 32 bits are bit mapped to the 32 tasks.  - Bit-N(1): Task-N has been successfully queued into the device and is awaiting execution  - Bit-N(0): Task-N is not yet queued. Bit n of this register is set if and only if QUEUED_TASK_PARAMS (CMD44) and QUEUED_TASK_ADDRESS (CMD45) were sent for this specific task and if this task has not been executed. The controller sets this bit after receiving a successful response for CMD45. CQE clears this bit after the task has completed execution. Software reads this register in the task-discard procedure to determine if the task is queued in the device. RESET:0x0"
          
group.long  0x38++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQTCLR, This register is used for removing an outstanding task in the CQE. The register must be used only when CQE is in Halt state. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQTCLR_TCLR ,Writing 1 to bit n of this register orders CQE to clear a task that the software has previously issued. This bit can only be written when CQE is in Halt state as indicated in CQCFG register Halt bit. When software writes 1 to a bit in this register, CQE updates the value to 1, and starts clearing the data structures related to the task. CQE clears the bit fields (sets a value of 0) in CQTCLR and in CQTDBR once the clear operation is complete. Software must poll on the CQTCLR until it is cleared to verify that a clear operation was done. RESET:0x0"
          
group.long  0x40++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQSSC1, This register is used for removing an outstanding task in the CQE. The register controls when SEND_QUEUE_STATUS commands are sent. RESET:0x11000"
         hexmask.long 0x00 0.--15. 1. " EMMC_REG_VENDOR2_BLOCK_CQSSC1_SQSCMD_IDLE_TMR ,This field configures the polling period to be used when using periodic SEND_QUEUE_STATUS (CMD13) polling. Periodic polling is used when tasks are pending in the device, but no data transfer is in progress. When a SEND_QUEUE_STATUS response indicates that no task is ready for execution, CQE counts the configured time until it issues the next SEND_QUEUE_STATUS. Timer units are clock periods of the clock whose frequency is specified in the Internal Timer Clock Frequency field CQCAP register. The minimum value is 0001h (1 clock period) and the maximum value is FFFFh (65535 clock periods). For example, a CQCAP field value of 0 indicates a 19.2 MHz clock frequency (period = 52.08 ns). If the setting in CQSSC1.CIT is 1000h, the calculated polling period is 4096*52.08 ns= 213.33 ns.  Should be programmed only when CQCFG.CQ_EN is '0'. RESET:0x1000"
          
         hexmask.long 0x00 16.--19. 1. " EMMC_REG_VENDOR2_BLOCK_CQSSC1_SQSCMD_BLK_CNT ,This field indicates when SQS CMD is sent while data transfer is in progress. A value of 'n' indicates that CQE sends status command on the CMD line, during the transfer of data block BLOCK_CNT-n, on the data lines, where BLOCK_CNT is the number of blocks in the current transaction.  - 0x0: SEND_QUEUE_STATUS (CMD13) command is not sent during the transaction. Instead, it is sent only when the data lines are idle.  - 0x1: SEND_QUEUE_STATUS command is to be sent during the last block of the transaction.  - 0x2: SEND_QUEUE_STATUS command when last 2 blocks are pending.  - 0x3: SEND_QUEUE_STATUS command when last 3 blocks are pending.  - ........  - 0xf: SEND_QUEUE_STATUS command when last 15 blocks are pending.   Should be programmed only when CQCFG.CQ_EN is '0' RESET:0x1"
          
         hexmask.long 0x00 20.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQSSC1_RSVD_20_31 ,These bits of the CQSSC1 register are reserved. They always return 0. RESET:0x0"
          
group.long  0x44++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQSSC2, The register is used for configuring the RCA field in SEND_QUEUE_STATUS command argument. RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " EMMC_REG_VENDOR2_BLOCK_CQSSC2_SQSCMD_RCA ,This field provides CQE with the contents of the 16-bit RCA field in SEND_QUEUE_STATUS (CMD13) command argument. CQE copies this field to bits 31:16 of the argument when transmitting SEND_ QUEUE_STATUS (CMD13) command. RESET:0x0"
          
         hexmask.long 0x00 16.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQSSC2_RSVD_16_31 ,These bits of the CQSSC2 register are reserved. They always return 0. RESET:0x0"
          
rgroup.long 0x48++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQCRDCT, This register stores the response of last executed DCMD. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQCRDCT_DCMD_RESP ,This register contains the response of the command generated by the last direct command (DCMD) task that was sent. Contents of this register are valid only after bit 31 of CQTDBR register is cleared by the controller. RESET:0x0"
          
group.long  0x50++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQRMEM, This register controls the generation of response error detect (RED) interrupt. Only the bits enabled here can contribute to RED. RESET:0xfdf9a080"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQRMEM_RESP_ERR_MASK ,The bits of this field are bit mapped to the device response. This bit is used as an interrupt mask on the device status filed that is received in R1/R1b responses.  - 1: When a R1/R1b response is received, with a bit i in the device status set, a RED interrupt is generated.  - 0: When a R1/R1b response is received, bit i in the device status is ignored. The reset value of this register is set to trigger an interrupt on all 'Error' type bits in the device status.  Note: Responses to CMD13 (SQS) encode the QSR so that they are ignored by this logic. RESET:0xfdf9a080"
          
rgroup.long 0x54++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQTERRI, This register is updated by CQE when an error occurs on data or command related to a task activity. When such an error is detected by CQE or indicated by the eMMC controller, CQE stores the following in the CQTERRI register: task IDs and indices of commands that were executed on the command line and data lines when the error occurred. Software must use this information in the error recovery procedure. RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " EMMC_REG_VENDOR2_BLOCK_CQTERRI_RESP_ERR_CMD_INDX ,This field captures the index of the command that was executed on the command line when the error occurred. RESET:0x0"
          
         hexmask.long 0x00 6.--7. 1. " EMMC_REG_VENDOR2_BLOCK_CQTERRI_RSVD_6_7 ,These bits (RSVD_6_7) of the CQTERRI register are reserved. They always return 0. RESET:0x0"
          
         hexmask.long 0x00 8.--12. 1. " EMMC_REG_VENDOR2_BLOCK_CQTERRI_RESP_ERR_TASKID ,This field captures the ID of the task which was executed on the command line when the error occurred. RESET:0x0"
          
         hexmask.long 0x00 13.--14. 1. " EMMC_REG_VENDOR2_BLOCK_CQTERRI_RSVD_13_14 ,These bits (RSVD_13_14) of the CQTERRI register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 15. " EMMC_REG_VENDOR2_BLOCK_CQTERRI_RESP_ERR_FIELDS_VALID ,This bit is updated when an error is detected while a command transaction was in progress. RESET:0x0" "NOT_SET-0,SET-1"
          
         hexmask.long 0x00 16.--21. 1. " EMMC_REG_VENDOR2_BLOCK_CQTERRI_TRANS_ERR_CMD_INDX ,This field captures the index of the command that was executed and whose data transfer has errors. RESET:0x0"
          
         hexmask.long 0x00 22.--23. 1. " EMMC_REG_VENDOR2_BLOCK_CQTERRI_RSVD_23_22 ,These bits (RSVD_23_22) of the CQTERRI register are reserved. They always return 0. RESET:0x0"
          
         hexmask.long 0x00 24.--28. 1. " EMMC_REG_VENDOR2_BLOCK_CQTERRI_TRANS_ERR_TASKID ,This field captures the ID of the task that was executed and whose data transfer has errors. RESET:0x0"
          
         hexmask.long 0x00 29.--30. 1. " EMMC_REG_VENDOR2_BLOCK_CQTERRI_RSVD_30_29 ,These bits (RSVD_30_29) of the CQTERRI register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 31. " EMMC_REG_VENDOR2_BLOCK_CQTERRI_TRANS_ERR_FIELDS_VALID ,This bit is updated when an error is detected while a data transfer transaction was in progress. RESET:0x0" "NOT_SET-0,SET-1"
          
rgroup.long 0x58++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQCRI, This register stores the index of the last received command response. RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " EMMC_REG_VENDOR2_BLOCK_CQCRI_CMD_RESP_INDX ,Last Command Response index This field stores the index of the last received command response. Controller updates the value every time a command response is received. RESET:0x0"
          
         hexmask.long 0x00 6.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQCRI_RSVD_31_6 ,These bits of the CQCRI register are reserved. They always return 0. RESET:0x0"
          
rgroup.long 0x5c++0x3
    line.long 0x00 "EMMC_REG_VENDOR2_BLOCK_CQCRA, This register stores the argument of the last received command response. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR2_BLOCK_CQCRA_CMD_RESP_ARG ,Last Command Response argument This field stores the argument of the last received command response. Controller updates the value every time a command response is received. RESET:0x0"
          
tree.end
    

tree "EMMC_REG__PHY_BLOCK"
base e:0x40065300
width 80.
group.long  0x0++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_PHY_CNFG, SD/eMMC PHY general configuration register RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_PHY_BLOCK_PHY_CNFG_PHY_RSTN ,Active-Low reset control for PHY, write '0' to reset PHY, Write '1' to deassert reset. RESET:0x0"
          
         bitfld.long 0x00 1. " EMMC_REG_PHY_BLOCK_PHY_CNFG_PHY_PWRGOOD ,Phy's Power Good status is captured here. Ensure this is '1' before stating transactions. RESET:0x0"
          
         hexmask.long 0x00 16.--19. 1. " EMMC_REG_PHY_BLOCK_PHY_CNFG_PAD_SP ,PMOS TX drive strength control. Common config for all for SD/eMMC Pads. RESET:0x0"
          
         hexmask.long 0x00 20.--23. 1. " EMMC_REG_PHY_BLOCK_PHY_CNFG_PAD_SN ,NMOS TX drive strength control. Common config for all for SD/eMMC Pads. RESET:0x0"
          
group.long  0x4++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_CMDPAD_CNFG, SD/eMMC PHY's Command/Response PAD settings are controlled here RESET:0x440"
         hexmask.long 0x00 0.--2. 1. " EMMC_REG_PHY_BLOCK_CMDPAD_CNFG_RXSEL ,Reciver type select for PAD. Controls the RXSEL value of SD/eMMC PHY CMD PAD RESET:0x0"
          
         bitfld.long 0x00 3.--4. " EMMC_REG_PHY_BLOCK_CMDPAD_CNFG_WEAKPULL_EN ,Pull-up/Pul-down enable control for CMD PAD RESET:0x0" "DISABLED-0,ILLEGAL-3,PULLDOWN-2,PULLUP-1"
          
         hexmask.long 0x00 5.--8. 1. " EMMC_REG_PHY_BLOCK_CMDPAD_CNFG_TXSLEW_CTRL_P ,Slew control for P-Type CMD Pad's TX RESET:0x2"
          
         hexmask.long 0x00 9.--12. 1. " EMMC_REG_PHY_BLOCK_CMDPAD_CNFG_TXSLEW_CTRL_N ,Slew control for N-Type CMD Pad's TX RESET:0x2"
          
group.long  0x6++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DATPAD_CNFG, SD/eMMC PHY's Data PAD settings are controlled here. common settings for all data pads RESET:0x440"
         hexmask.long 0x00 0.--2. 1. " EMMC_REG_PHY_BLOCK_DATPAD_CNFG_RXSEL ,Reciver type select for PAD. Controls the RXSEL value of SD/eMMC PHY DATA PADs RESET:0x0"
          
         bitfld.long 0x00 3.--4. " EMMC_REG_PHY_BLOCK_DATPAD_CNFG_WEAKPULL_EN ,Pull-up/Pull-down enable control for DATA PADs RESET:0x0" "DISABLED-0,ILLEGAL-3,PULLDOWN-2,PULLUP-1"
          
         hexmask.long 0x00 5.--8. 1. " EMMC_REG_PHY_BLOCK_DATPAD_CNFG_TXSLEW_CTRL_P ,Slew control for P-Type DATA Pad's TX RESET:0x2"
          
         hexmask.long 0x00 9.--12. 1. " EMMC_REG_PHY_BLOCK_DATPAD_CNFG_TXSLEW_CTRL_N ,Slew control for N-Type DATA Pad's TX RESET:0x2"
          
group.long  0x8++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_CLKPAD_CNFG, SD/eMMC PHY's CLK PAD settings are controlled here. RESET:0x440"
         hexmask.long 0x00 0.--2. 1. " EMMC_REG_PHY_BLOCK_CLKPAD_CNFG_RXSEL ,Reciver type select for PAD. Controls the RXSEL value of SD/eMMC PHY CLK PAD RESET:0x0"
          
         bitfld.long 0x00 3.--4. " EMMC_REG_PHY_BLOCK_CLKPAD_CNFG_WEAKPULL_EN ,Pull-up/Pul-down enable control for CLK PAD RESET:0x0" "DISABLED-0,ILLEGAL-3,PULLDOWN-2,PULLUP-1"
          
         hexmask.long 0x00 5.--8. 1. " EMMC_REG_PHY_BLOCK_CLKPAD_CNFG_TXSLEW_CTRL_P ,Slew control for P-Type CLK Pad's TX RESET:0x2"
          
         hexmask.long 0x00 9.--12. 1. " EMMC_REG_PHY_BLOCK_CLKPAD_CNFG_TXSLEW_CTRL_N ,Slew control for N-Type CLK Pad's TX RESET:0x2"
          
group.long  0xa++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_STBPAD_CNFG, SD/eMMC PHY's Strobe PAD settings are controlled here. RESET:0x440"
         hexmask.long 0x00 0.--2. 1. " EMMC_REG_PHY_BLOCK_STBPAD_CNFG_RXSEL ,Reciver type select for PAD. Controls the RXSEL value of SD/eMMC PHY STROBE PAD RESET:0x0"
          
         bitfld.long 0x00 3.--4. " EMMC_REG_PHY_BLOCK_STBPAD_CNFG_WEAKPULL_EN ,Pull-up/Pul-down enable control for STROBE PAD RESET:0x0" "DISABLED-0,ILLEGAL-3,PULLDOWN-2,PULLUP-1"
          
         hexmask.long 0x00 5.--8. 1. " EMMC_REG_PHY_BLOCK_STBPAD_CNFG_TXSLEW_CTRL_P ,Slew control for P-Type Strobe Pad's TX RESET:0x2"
          
         hexmask.long 0x00 9.--12. 1. " EMMC_REG_PHY_BLOCK_STBPAD_CNFG_TXSLEW_CTRL_N ,Slew control for N-Type Strobe Pad's TX RESET:0x2"
          
group.long  0xc++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_RSTNPAD_CNFG, SD/eMMC PHY's RSTN PAD settings are controlled here. RESET:0x440"
         hexmask.long 0x00 0.--2. 1. " EMMC_REG_PHY_BLOCK_RSTNPAD_CNFG_RXSEL ,Reciver type select for PAD. Controls the RXSEL value of SD/eMMC PHY RST_N PAD(s) RESET:0x0"
          
         bitfld.long 0x00 3.--4. " EMMC_REG_PHY_BLOCK_RSTNPAD_CNFG_WEAKPULL_EN ,Pull-up/Pul-down enable control for RST_N PAD(s) RESET:0x0" "DISABLED-0,ILLEGAL-3,PULLDOWN-2,PULLUP-1"
          
         hexmask.long 0x00 5.--8. 1. " EMMC_REG_PHY_BLOCK_RSTNPAD_CNFG_TXSLEW_CTRL_P ,Slew control for P-Type RST_N Pad's TX RESET:0x2"
          
         hexmask.long 0x00 9.--12. 1. " EMMC_REG_PHY_BLOCK_RSTNPAD_CNFG_TXSLEW_CTRL_N ,Slew control for N-Type RST_N Pad's TX RESET:0x2"
          
group.long  0xe++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_PADTEST_CNFG, PAD TEST Path and direction control RESET:0x4"
         bitfld.long 0x00 0. " EMMC_REG_PHY_BLOCK_PADTEST_CNFG_TESTMODE_EN ,enables test mode interface for all PADS. Functional interface is disabled. RESET:0x0" "PAD_FUNCMODE-0,PAD_TESTMODE-1"
          
         bitfld.long 0x00 1. " EMMC_REG_PHY_BLOCK_PADTEST_CNFG_TEST_DLY_LINE_EN ,Test enable for delay line testing This signal enables the testing of delay lines with the test clock. RESET:0x0" "TEST_DLY_LINE_DIS-0,TEST_DLY_LINE_EN-1"
          
         bitfld.long 0x00 2. " EMMC_REG_PHY_BLOCK_PADTEST_CNFG_TEST_CLK_EN ,. While updating delay codes during testmode, this signal is used to gate the test clock. Functional interface is disabled. RESET:0x1" "TEST_CLK_ENABLED-1,TEST_CLK_GATED-0"
          
         hexmask.long 0x00 4.--15. 1. " EMMC_REG_PHY_BLOCK_PADTEST_CNFG_TEST_OE ,test interface OE control. Drive's PHY's itest_oe inputs. RESET:0x0"
          
group.long  0x10++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_PADTEST_OUT, PAD TEST Path Data out, Drives itest_a input of SD/eMMC PHY RESET:0x0"
         hexmask.long 0x00 0.--11. 1. " EMMC_REG_PHY_BLOCK_PADTEST_OUT_TESTDATA_OUT ,Data written here is reflected on corresponding itest_a. Indivitual bits are mapped to corresponding itest_a inputs of the PHY RESET:0x0"
          
rgroup.long 0x12++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_PADTEST_IN, PAD TEST Path Data in, reflects value of otest_y output of SD/eMMC PHY RESET:0x0"
         hexmask.long 0x00 0.--11. 1. " EMMC_REG_PHY_BLOCK_PADTEST_IN_TESTDATA_IN ,individual bits here capture data avaliable on corresponding otest_y output. should be used for DC test and low freq data patterns. RESET:0x0"
          
group.long  0x18++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_PRBS_CNFG, Register to configure PRBS engine RESET:0xffff"
         hexmask.long 0x00 0.--15. 1. " EMMC_REG_PHY_BLOCK_PRBS_CNFG_INIT_SEED ,Value programmed here is used as SEED for PRBS engine RESET:0xffff"
          
group.long  0x1a++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_PHYLPBK_CNFG, Register to setup loopback mode RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_PHY_BLOCK_PHYLPBK_CNFG_PHYLPBK_EN ,PHY Local loop back mode is enable RESET:0x0" "PHYLPBK_MODE_DIS-0,PHYLPBK_MODE_EN-1"
          
         bitfld.long 0x00 1. " EMMC_REG_PHY_BLOCK_PHYLPBK_CNFG_OUT_EN_PHYLPBK_MODE ,CMD/DATA output enable in PHY loopback mode RESET:0x0" "OUTPUT_DIS-0,OUTPUT_EN-1"
          
group.long  0x1c++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_COMMDL_CNFG, Config register to settings common to all DelayLines used in PHY RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_PHY_BLOCK_COMMDL_CNFG_DLSTEP_SEL ,DelayLine's per step delay selection, Drives PHY's idl_step input RESET:0x0"
          
         bitfld.long 0x00 1. " EMMC_REG_PHY_BLOCK_COMMDL_CNFG_DLOUT_EN ,When '1' DL outputs can be sampled on PADs. Drives idlout_en for all PADs RESET:0x0" "DL_OUTDIS-0,DL_OUTEN-1"
          
group.long  0x1d++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_SDCLKDL_CNFG, Settings for SD/eMMC CLK DelayLine. RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_PHY_BLOCK_SDCLKDL_CNFG_EXTDLY_EN ,Drives SD/eMMC CLK DelayLine's extdlyen input RESET:0x0" "DEF_MODE-0,EXTDL_MODE-1"
          
         bitfld.long 0x00 1. " EMMC_REG_PHY_BLOCK_SDCLKDL_CNFG_BYPASS_EN ,Drives SD/eMMC CLK DelayLine's bypassen input RESET:0x0" "BYPASSMODE-1,DLMODE-0"
          
         hexmask.long 0x00 2.--3. 1. " EMMC_REG_PHY_BLOCK_SDCLKDL_CNFG_INPSEL_CNFG ,Drives SD/eMMC CLK DelayLine's config input. Value here selects the input source to DelayLine RESET:0x0"
          
         bitfld.long 0x00 4. " EMMC_REG_PHY_BLOCK_SDCLKDL_CNFG_UPDATE_DC ,Prepares DealyLine for code update when '1'. Its recommended that this bit is 1 when SDCLKDL_DC is being written. Ensure this is '0' when not updating code. Note: Turn-off card clock using CLK_CTRL_R.SD_CLK_EN before programing this field. RESET:0x0" "BYPASSMODE-1,DLMODE-0"
          
group.long  0x1e++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_SDCLKDL_DC, SD/eMMC CLK DelayLine Delay Code value RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " EMMC_REG_PHY_BLOCK_SDCLKDL_DC_CCKDL_DC ,Drives SD/eMMC CLK DelayLine's Delay Code input. Value here Selects the number of active stages in the card clock delay line. Note: Turn-off card clock using CLK_CTRL_R.SD_CLK_EN before programing this field. RESET:0x0"
          
group.long  0x20++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_SMPLDL_CNFG, SD/eMMC cclk_rx DelayLine configuration settings RESET:0xc"
         bitfld.long 0x00 0. " EMMC_REG_PHY_BLOCK_SMPLDL_CNFG_EXTDLY_EN ,Drives CCLK_RX DelayLine's extdlyen input RESET:0x0" "DEF_MODE-0,EXTDL_MODE-1"
          
         bitfld.long 0x00 1. " EMMC_REG_PHY_BLOCK_SMPLDL_CNFG_BYPASS_EN ,Drives CCLK_RX DelayLine's bypassen input RESET:0x0" "BYPASSMODE-1,DLMODE-0"
          
         hexmask.long 0x00 2.--3. 1. " EMMC_REG_PHY_BLOCK_SMPLDL_CNFG_INPSEL_CNFG ,Drives CCLK_RX DelayLine's config input. Value here selects the input source to DelayLine RESET:0x3"
          
         bitfld.long 0x00 4. " EMMC_REG_PHY_BLOCK_SMPLDL_CNFG_INPSEL_OVERRIDE ,PHY's Sampling delay line config is controlled by controller using sample_cclk_sel, this signal overides sample_cclk_sel such that INPSEL_CFG field directly control's PHY's config input.  - 0x0 : Controller logic drive Sampling delay line config.  - 0x1 : SMPLDL_CNFG.INPSEL_CNFG drives sampling delay line config. RESET:0x0"
          
group.long  0x21++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_ATDL_CNFG, SD/eMMC drift_cclk_rx DelayLine configuration settings RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_PHY_BLOCK_ATDL_CNFG_EXTDLY_EN ,Drives drift_cclk_rx DelayLine's extdlyen input RESET:0x0" "DEF_MODE-0,EXTDL_MODE-1"
          
         bitfld.long 0x00 1. " EMMC_REG_PHY_BLOCK_ATDL_CNFG_BYPASS_EN ,Drives drift_cclk_rx DelayLine's bypassen input RESET:0x0" "BYPASSMODE-1,DLMODE-0"
          
         hexmask.long 0x00 2.--3. 1. " EMMC_REG_PHY_BLOCK_ATDL_CNFG_INPSEL_CNFG ,Drives drift_cclk_rx DelayLine's config input. Value here selects the input source to DelayLine RESET:0x0"
          
group.long  0x24++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DLL_CTRL, SD/eMMC PHY's DLL Control settings register RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_PHY_BLOCK_DLL_CTRL_DLL_EN ,Enable's DLL when '1' RESET:0x0" "DLLDISABLE-0,DLLENABLE-1"
          
         bitfld.long 0x00 1. " EMMC_REG_PHY_BLOCK_DLL_CTRL_OFFST_EN ,Enables offset mode of PHY when DLL is enabled. when DLL is disabled this allows direct control of delay generated by DLL's Subordinate RESET:0x0" "OFFSTDIS-0,OFFSTEN-1"
          
         bitfld.long 0x00 2. " EMMC_REG_PHY_BLOCK_DLL_CTRL_SLV_SWDC_UPDATE ,Corresponding output drives PHY's DLL Subordinate's dc update input. This is used to turn-off Subordinate Delay line's output when changing its delay code using DLL_OFFST register RESET:0x0" "DL_OUT_OFF-1,DL_OUT_ON-0"
          
group.long  0x25++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DLL_CNFG1, SD/eMMC PHY DLL configuration register 1 RESET:0x0"
         hexmask.long 0x00 0.--2. 1. " EMMC_REG_PHY_BLOCK_DLL_CNFG1_WAITCYCLE ,Sets the value of DLL's wait cycle input RESET:0x0"
          
         hexmask.long 0x00 4.--5. 1. " EMMC_REG_PHY_BLOCK_DLL_CNFG1_SLVDLY ,Sets the value of DLL subordinate's update delay input islv_update_dly RESET:0x0"
          
group.long  0x26++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DLL_CNFG2, SD/eMMC PHY DLL configuration register 2 RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " EMMC_REG_PHY_BLOCK_DLL_CNFG2_JUMPSTEP ,Sets the value of DLL's jump step input RESET:0x0"
          
group.long  0x28++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DLLDL_CNFG, SD/eMMC PHY DLL MST & Subordinate DL configuration settings RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_PHY_BLOCK_DLLDL_CNFG_MST_EXTDLYEN ,Enable Extended delay mode for manager RESET:0x0"
          
         hexmask.long 0x00 1.--2. 1. " EMMC_REG_PHY_BLOCK_DLLDL_CNFG_MST_INPSEL ,Clock source select for Manager DL RESET:0x0"
          
         bitfld.long 0x00 3. " EMMC_REG_PHY_BLOCK_DLLDL_CNFG_MST_BYPASS ,Bypass enable control for Manager DL RESET:0x0"
          
         bitfld.long 0x00 4. " EMMC_REG_PHY_BLOCK_DLLDL_CNFG_SLV_EXTDLYEN ,Enable Extended delay mode for Subordinate RESET:0x0"
          
         hexmask.long 0x00 5.--6. 1. " EMMC_REG_PHY_BLOCK_DLLDL_CNFG_SLV_INPSEL ,Clock source select for Subordinate DL RESET:0x0"
          
         bitfld.long 0x00 7. " EMMC_REG_PHY_BLOCK_DLLDL_CNFG_SLV_BYPASS ,Bypass enable control for Subordinate DL RESET:0x0"
          
group.long  0x29++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DLL_OFFST, SD/eMMC PHY DLL Offset value settings RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " EMMC_REG_PHY_BLOCK_DLL_OFFST_OFFST ,Sets the value of DLL's offset input RESET:0x0"
          
group.long  0x2a++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DLLMST_TSTDC, SD/eMMC PHY DLL Manager testing Delay code register RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " EMMC_REG_PHY_BLOCK_DLLMST_TSTDC_MSTTST_DC ,Sets the value of DLL's Manager test code input when DLL is disabled. RESET:0x0"
          
group.long  0x2c++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DLLLBT_CNFG, SD/eMMC PHY DLL Low Bandwidth Timer configuration register RESET:0x0"
         hexmask.long 0x00 0.--15. 1. " EMMC_REG_PHY_BLOCK_DLLLBT_CNFG_LBT_LOADVAL ,Sets the value of DLL's olbt_loadval input. Controls the lbt timer's timeout value at which DLL runs a revalidation cycle. RESET:0x0"
          
rgroup.long 0x2e++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DLL_STATUS, SD/eMMC PHY DLL Status register RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_PHY_BLOCK_DLL_STATUS_LOCK_STS ,Captures the value of DLL's lock status information RESET:0x0" "DLL_IS_LOCKED-1,DLL_NOT_LOCKED-0"
          
         bitfld.long 0x00 1. " EMMC_REG_PHY_BLOCK_DLL_STATUS_ERROR_STS ,Captures the value of DLL's lock error status information. Value is valid only when LOCK_STS is set. -  IF LOCK_STS =1 and ERR_STS = 0 then DLL is locked and no errors are generated -  IF LOCK_STS =1 and ERR_STS = 1 then DLL is locked to default and has errors. Transactions at this phase can fail RESET:0x0" "DLL_ERROR-1,DLL_LOCK_OKAY-0"
          
rgroup.long 0x30++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DLLDBG_MLKDC, SD/eMMC PHY DLL's Manager lock code status RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " EMMC_REG_PHY_BLOCK_DLLDBG_MLKDC_MSTLKDC ,Captures the value Delay Code to which DLL's Manager has locked RESET:0x0"
          
rgroup.long 0x32++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_DLLDBG_SLKDC, SD/eMMC PHY DLL's Subordinate lock code status RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " EMMC_REG_PHY_BLOCK_DLLDBG_SLKDC_SLVLKDC ,Captures the value Delay Code to which DLL's Subordinate has locked RESET:0x0"
          
group.long  0x34++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_TST_PHY1_DL0, Settings for PHY1 Delay line 0 during testmode RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " EMMC_REG_PHY_BLOCK_TST_PHY1_DL0_PHY1_DL0_DC ,Delay code for PHY1 Delay Line0 Drives Delay Line0  delay code input for PHY1. Value here selects the number of active stages in the Delay line 0 of PHY1. These bits are used only for testmode purposes. The value of these bits are reflected on the signal test_phy1_dl0_dc. RESET:0x0"
          
         bitfld.long 0x00 7. " EMMC_REG_PHY_BLOCK_TST_PHY1_DL0_PHY1_DL0_UPDATE_DC ,Delay code Update for PHY1 Delay Line0 Prepares Delay Line0 of PHY1 for code update when '1'. Its recommended that this bit is 1 when PHY1_DL0_DC is being written. Ensure this is 0 when not updating the code. This bit is used only for testmode purposes. The value of this bit is reflected on the signal test_phy1_dl0_dc_update. RESET:0x0" "TST_DLMODE-0,TST_UPDATEMODE-1"
          
group.long  0x35++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_TST_PHY2_DL0, Settings for PHY2 Delay line 0 during testmode RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " EMMC_REG_PHY_BLOCK_TST_PHY2_DL0_PHY2_DL0_DC ,Delay code for PHY2 Delay Line0 Drives Delay Line0  delay code input for PHY2. Value here selects the number of active stages in the Delay line 0 of PHY2. These bits are used only for testmode purposes. The value of these bits are reflected on the signal test_phy2_dl0_dc. RESET:0x0"
          
         bitfld.long 0x00 7. " EMMC_REG_PHY_BLOCK_TST_PHY2_DL0_PHY2_DL0_UPDATE_DC ,Delay code Update for PHY2 Delay Line0 Prepares Delay Line0 of PHY2 for code update when '1'. Its recommended that this bit is 1 when PHY2_DL0_DC is being written. Ensure this is 0 when not updating the code. This bit is used only for testmode purposes. The value of this bit is reflected on the signal test_phy2_dl0_dc_update. RESET:0x0" "TST_DLMODE-0,TST_UPDATEMODE-1"
          
group.long  0x36++0x3
    line.long 0x00 "EMMC_REG_PHY_BLOCK_TST_PHY2_DL1, Settings for PHY2 Delay line 1 during testmode RESET:0x0"
         hexmask.long 0x00 0.--6. 1. " EMMC_REG_PHY_BLOCK_TST_PHY2_DL1_PHY2_DL1_DC ,Delay code for PHY2 Delay Line1 Drives Delay Line1  delay code input for PHY2. Value here selects the number of active stages in the Delay line 1 of PHY2. These bits are used only for testmode purposes. The value of these bits are reflected on the signal test_phy2_dl1_dc. RESET:0x0"
          
         bitfld.long 0x00 7. " EMMC_REG_PHY_BLOCK_TST_PHY2_DL1_PHY2_DL1_UPDATE_DC ,Delay code Update for PHY2 Delay Line1 Prepares Delay Line1 of PHY2 for code update when '1'. Its recommended that this bit is 1 when PHY2_DL1_DC is being written. Ensure this is 0 when not updating the code. This bit is used only for testmode purposes. The value of this bit is reflected on the signal test_phy2_dl1_dc_update. RESET:0x0" "TST_DLMODE-0,TST_UPDATEMODE-1"
          
tree.end
    

tree "EMMC_REG__VENDOR1_BLOCK"
base e:0x40065500
width 80.
rgroup.long 0x0++0x3
    line.long 0x00 "EMMC_REG_VENDOR1_BLOCK_MSHC_VER_ID_R, This register reflects the current release number of DWC_mshc/DWC_mshc_lite. RESET:0x30323030"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR1_BLOCK_MSHC_VER_ID_R_MSHC_VER_ID ,Current release number  This field indicates the Synopsys DesignWare Cores DWC_mshc/DWC_mshc_lite current release number that is read by an application.  An application reading this register in conjunction with the MSHC_VER_TYPE_R register, gathers details of the current release. RESET:0x30323030"
          
rgroup.long 0x4++0x3
    line.long 0x00 "EMMC_REG_VENDOR1_BLOCK_MSHC_VER_TYPE_R, This register reflects the current release type of DWC_mshc/DWC_mshc_lite. RESET:0x67612a2a"
         hexmask.long 0x00 0.--31. 1. " EMMC_REG_VENDOR1_BLOCK_MSHC_VER_TYPE_R_MSHC_VER_TYPE ,Current release type  This field indicates the Synopsys DesignWare Cores DWC_mshc/DWC_mshc_lite current release type that is read by an application.  An application reading this register in conjunction with the MSHC_VER_ID_R register, gathers details of the current release. RESET:0x67612a2a"
          
group.long  0x8++0x3
    line.long 0x00 "EMMC_REG_VENDOR1_BLOCK_MSHC_CTRL_R, This register is used to control the operation of MSHC Host Controller. RESET:0x1"
         bitfld.long 0x00 0. " EMMC_REG_VENDOR1_BLOCK_MSHC_CTRL_R_CMD_CONFLICT_CHECK ,Command conflict check  This bit enables command conflict check.  Note: DWC_mshc controller monitors the CMD line whenever a command is issued and checks whether the value driven on sd_cmd_out matches the value on sd_cmd_in at next subsequent edge of cclk_tx to determine command conflict error. This bit is cleared only if the feed back delay (including IO Pad delay) is more than (t_card_clk_period - t_setup), where t_setup is the setup time of a flop in DWC_mshc. The I/O pad delay is consistent across CMD and DATA lines, and it is within the value: (2*t_card_clk_period - t_setup) RESET:0x1" "CMD_CONFLICT_CHK_LAT1-1,DISABLE_CMD_CONFLICT_CHK-0"
          
         bitfld.long 0x00 1. " EMMC_REG_VENDOR1_BLOCK_MSHC_CTRL_R_NEGEDGE_DATAOUT_EN ,Negedge Data Out  This bit enables the data to be sent out on negedge of cclk_tx. This is valid only for speed mode HS400. RESET:0x0" "DISABLED-0,ENABLED-1"
          
         hexmask.long 0x00 2.--3. 1. " EMMC_REG_VENDOR1_BLOCK_MSHC_CTRL_R_RSVD1 ,These bits (RSVD1) of the MSHC_CTRL_R register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 4. " EMMC_REG_VENDOR1_BLOCK_MSHC_CTRL_R_SW_CG_DIS ,Internal clock gating disable control  This bit must be used to disable IP's internal clock gating when required. when disabled clocks are not gated. Clocks to the core (except hclk) must be stopped when programming this bit. RESET:0x0" "DISABLE-1,ENABLE-0"
          
         bitfld.long 0x00 5. " EMMC_REG_VENDOR1_BLOCK_MSHC_CTRL_R_SLV_ERR_RESP_NONEXIS_REG ,When 0 this bit gives subordinate error response for non existent register access. Currently this is a read-ony bit with default value 0. RESET:0x0"
          
group.long  0x10++0x3
    line.long 0x00 "EMMC_REG_VENDOR1_BLOCK_MBIU_CTRL_R, This register is used to select the valid burst types that the AHB Manager bus interface can generate. When more than one bit is set the manager selects the burst it prefers among those that are enabled in this register. RESET:0xf"
         bitfld.long 0x00 0. " EMMC_REG_VENDOR1_BLOCK_MBIU_CTRL_R_UNDEFL_INCR_EN ,Undefined INCR Burst Controls generation of undefined length INCR transfer on Manager interface. RESET:0x1" "FALSE-0,TRUE-1"
          
         bitfld.long 0x00 1. " EMMC_REG_VENDOR1_BLOCK_MBIU_CTRL_R_BURST_INCR4_EN ,INCR4 Burst Controls generation of INCR4 transfers on Manager interface. RESET:0x1" "FALSE-0,TRUE-1"
          
         bitfld.long 0x00 2. " EMMC_REG_VENDOR1_BLOCK_MBIU_CTRL_R_BURST_INCR8_EN ,INCR8 Burst Controls generation of INCR8 transfers on Manager interface. RESET:0x1" "FALSE-0,TRUE-1"
          
         bitfld.long 0x00 3. " EMMC_REG_VENDOR1_BLOCK_MBIU_CTRL_R_BURST_INCR16_EN ,INCR16 Burst Controls generation of INCR16 transfers on Manager interface. RESET:0x1" "FALSE-0,TRUE-1"
          
         hexmask.long 0x00 4.--7. 1. " EMMC_REG_VENDOR1_BLOCK_MBIU_CTRL_R_RSVD ,Reserved field RESET:0x0"
          
group.long  0x2c++0x3
    line.long 0x00 "EMMC_REG_VENDOR1_BLOCK_EMMC_CTRL_R, This register is used to control the eMMC operation. RESET:0xc"
         bitfld.long 0x00 0. " EMMC_REG_VENDOR1_BLOCK_EMMC_CTRL_R_CARD_IS_EMMC ,eMMC Card present  This bit indicates the type of card connected. An application program this bit based on the card connected to MSHC. RESET:0x0" "EMMC_CARD-1,NON_EMMC_CARD-0"
          
         bitfld.long 0x00 1. " EMMC_REG_VENDOR1_BLOCK_EMMC_CTRL_R_DISABLE_DATA_CRC_CHK ,Disable Data CRC Check  This bit controls masking of CRC16 error for Card Write in eMMC mode. This is useful in bus testing (CMD19) for an eMMC device. In bus testing, an eMMC card does not send CRC status for a block, which may generate CRC error. This CRC error can be masked using this bit during bus testing. RESET:0x0" "DISABLE-1,ENABLE-0"
          
         bitfld.long 0x00 2. " EMMC_REG_VENDOR1_BLOCK_EMMC_CTRL_R_EMMC_RST_N ,EMMC Device Reset signal control.  This register field controls the sd_rst_n output of DWC_mshc RESET:0x1" "RST_ASSERT-0,RST_DEASSERT-1"
          
         bitfld.long 0x00 3. " EMMC_REG_VENDOR1_BLOCK_EMMC_CTRL_R_EMMC_RST_N_OE ,Output Enable control for EMMC Device Reset signal PAD control.  This field drived sd_rst_n_oe output of DWC_mshc RESET:0x1" "DISABLE-0,ENABLE-1"
          
         bitfld.long 0x00 8. " EMMC_REG_VENDOR1_BLOCK_EMMC_CTRL_R_ENH_STROBE_ENABLE ,Enhanced Strobe Enable  This bit instructs DWC_mshc to sample the CMD line using data strobe for HS400 mode. RESET:0x0" "ENH_STB_FOR_CMD-1,NO_STB_FOR_CMD-0"
          
         bitfld.long 0x00 9. " EMMC_REG_VENDOR1_BLOCK_EMMC_CTRL_R_CQE_ALGO_SEL ,Scheduler algorithm selected for execution  This bit selects the Algorithm used for selecting one of the many ready tasks for execution. RESET:0x0" "FCFS_ONLY-1,PRI_REORDER_PLUS_FCFS-0"
          
         bitfld.long 0x00 10. " EMMC_REG_VENDOR1_BLOCK_EMMC_CTRL_R_CQE_PREFETCH_DISABLE ,Enable or Disable CQE's PREFETCH feature  This field allows Software to disable CQE's data prefetch feature when set to 1. RESET:0x0" "PREFETCH_DISABLE-1,PREFETCH_ENABLE-0"
          
         hexmask.long 0x00 11.--15. 1. " EMMC_REG_VENDOR1_BLOCK_EMMC_CTRL_R_RSVD ,These bits (RSVD) of the EMMC_CTRL_R register are reserved. They always return 0. RESET:0x0"
          
group.long  0x2e++0x3
    line.long 0x00 "EMMC_REG_VENDOR1_BLOCK_BOOT_CTRL_R, This register is used to control the eMMC Boot operation. RESET:0x0"
         bitfld.long 0x00 0. " EMMC_REG_VENDOR1_BLOCK_BOOT_CTRL_R_MAN_BOOT_EN ,Mandatory Boot Enable  This bit is used to initiate the mandatory boot operation. The application sets this bit along with VALIDATE_BOOT bit. Writing 0 is ignored. The DWC_mshc clears this bit after the boot transfer is completed or terminated. RESET:0x0" "MAN_BOOT_DIS-0,MAN_BOOT_EN-1"
          
         hexmask.long 0x00 1.--6. 1. " EMMC_REG_VENDOR1_BLOCK_BOOT_CTRL_R_RSVD_6_1 ,These bits (RSVD _6_1) of the BOOT_CTRL_R register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 7. " EMMC_REG_VENDOR1_BLOCK_BOOT_CTRL_R_VALIDATE_BOOT ,Validate Mandatory Boot Enable bit  This bit is used to validate the MAN_BOOT_EN bit. RESET:0x0" "FALSE-0,TRUE-1"
          
         bitfld.long 0x00 8. " EMMC_REG_VENDOR1_BLOCK_BOOT_CTRL_R_BOOT_ACK_ENABLE ,Boot Acknowledge Enable  When this bit set, DWC_mshc checks for boot acknowledge start pattern of 0-1-0 during boot operation. This bit is applicable for both mandatory and alternate boot mode. RESET:0x0" "FALSE-0,TRUE-1"
          
         hexmask.long 0x00 9.--11. 1. " EMMC_REG_VENDOR1_BLOCK_BOOT_CTRL_R_RSVD_11_9 ,These bits (RSVD_11_9) of the BOOT_CTRL_R register are reserved. They always return 0. RESET:0x0"
          
         hexmask.long 0x00 12.--15. 1. " EMMC_REG_VENDOR1_BLOCK_BOOT_CTRL_R_BOOT_TOUT_CNT ,Boot Ack Timeout Counter Value.  This value determines the interval by which boot ack timeout (50 ms) is detected when boot ack is expected during boot operation.  - 0xF : Reserved  - 0xE : TMCLK x 2^27  - ..   - ............  - 0x1 : TMCLK x 2^14  - 0x0 : TMCLK x 2^13 RESET:0x0"
          
group.long  0x40++0x3
    line.long 0x00 "EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R, This register controls some aspects of tuning and auto-tuning features. Do not program this register when HOST_CTRL2_R.SAMPLE_CLK_SEL is '1' RESET:0x1f000005"
         bitfld.long 0x00 0. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_AT_EN ,Setting this bit enables Auto tuning engine. This bit is enabled by default when core is configured with mode3 retuning support. Clear this bit to 0 when core is configured to have Mode3 re-tuning but SW wishes to disable mode3 re-tuning.  This field should be programmed only when CLK_CTRL_R.SD_CLK_EN is 0. RESET:0x1" "AT_DISABLE-0,AT_ENABLE-1"
          
         bitfld.long 0x00 1. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_CI_SEL ,Selects the interval when the corrected center phase select code can be driven on tuning_cclk_sel output. RESET:0x0" "WHEN_IN_BLK_GAP-0,WHEN_IN_IDLE-1"
          
         bitfld.long 0x00 2. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_SWIN_TH_EN ,Sampling window Threshold enable  Selects the tuning mode  Field should be programmed only when SAMPLE_CLK_SEL is '0' RESET:0x1" "LARGEST_WIN_MODE-0,THRESHOLD_MODE-1"
          
         bitfld.long 0x00 3. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_RPT_TUNE_ERR ,Framing errors are not generated when executing tuning. This debug bit allows users to report these errors. RESET:0x0" "DEBUG_ERRORS-1,ERRORS_DISABLED-0"
          
         bitfld.long 0x00 4. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_SW_TUNE_EN ,This fields enables software-managed tuning flow. RESET:0x0" "SW_TUNING_DISABLE-0,SW_TUNING_ENABLE-1"
          
         hexmask.long 0x00 5.--7. 1. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_RSDV2 ,These bits (RSVD2) of the AT_CTRL_R register are reserved. They always return 0. RESET:0x0"
          
         hexmask.long 0x00 8.--11. 1. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_WIN_EDGE_SEL ,This field sets the phase for Left and Right edges for drift monitoring. [Left edge offset + Right edge offset] must not be less than total taps of delayLine. - 0x0: User selection disabled. Tuning calculated edges are used. - 0x1: Right edge Phase is center + 2 stages, Left edge Phase is center - 2 stages. - 0x2: Right edge Phase is center + 3 stages, Left edge Phase is center - 3 stages. - ... - 0xF: Right edge Phase is center + 16 stages, Left edge Phase is center - 16 stages. RESET:0x0"
          
         hexmask.long 0x00 12.--15. 1. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_RSDV3 ,These bits (RSVD3) of the AT_CTRL_R register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 16. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_TUNE_CLK_STOP_EN ,Clock stopping control for Tuning and auto-tuning circuit.  When enabled, clock gate control output of DWC_mshc (clk2card_on) is pulled low before changing phase select codes on tuning_cclk_sel and autotuning_cclk_sel. This effectively stops the Device/Card clock, cclk_rx and also drift_cclk_rx. Changing phase code when clocks are stopped ensures glitch free phase switching. Set this bit to 0 if the PHY or delayline can guarantee glitch free switching. RESET:0x0" "DISABLE_CLK_STOPPING-0,ENABLE_CLK_STOPPING-1"
          
         bitfld.long 0x00 17.--18. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_PRE_CHANGE_DLY ,Maximum Latency specification between cclk_tx and cclk_rx. RESET:0x0" "LATENCY_LT_1-0,LATENCY_LT_2-1,LATENCY_LT_3-2,LATENCY_LT_4-3"
          
         bitfld.long 0x00 19.--20. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_POST_CHANGE_DLY ,Time taken for phase switching and stable clock output.  Specifies the maximum time (in terms of cclk cycles) that the delay line can take to switch its output phase after a change in tuning_cclk_sel or autotuning_cclk_sel. Set a value of 0x3 for glitch free clock switching when the PHY Type is SNPS SD/eMMC phy. RESET:0x0" "LATENCY_LT_1-0,LATENCY_LT_2-1,LATENCY_LT_3-2,LATENCY_LT_4-3"
          
         hexmask.long 0x00 24.--30. 1. " EMMC_REG_VENDOR1_BLOCK_AT_CTRL_R_SWIN_TH_VAL ,Sampling window threshold value setting  The maximum value that can be set here depends on the length of delayline used for tuning. A delayLine with 128 taps can use values from 0x0 to 0x7F.  This field is valid only when SWIN_TH_EN is '1'. Should be programmed only when SAMPLE_CLK_SEL is '0'      - 0x0 : Threshold values is 0x1, windows of length 1 tap and above can be selected as sampling window.      - 0x1 : Threshold values is 0x2, windows of length 2 taps and above can be selected as sampling window.      - 0x2 : Threshold values is 0x1, windows of length 3 taps and above can be selected as sampling window.      - ........      - 0x7F : Threshold values is 0x1, windows of length 127 taps and above can be selected as sampling window. RESET:0x1f"
          
group.long  0x44++0x3
    line.long 0x00 "EMMC_REG_VENDOR1_BLOCK_AT_STAT_R, Register to read the Center, Left and Right codes used by tuning and auto-tuning engines. Center code field is also used for software managed tuning. RESET:0x80000006"
         hexmask.long 0x00 0.--7. 1. " EMMC_REG_VENDOR1_BLOCK_AT_STAT_R_CENTER_PH_CODE ,Centered Phase code. Reading this field returns the current value on tuning_cclk_sel output. Setting AT_CTRL_R.SW_TUNE_EN enables software to write to this field and its contents are reflected on tuning_cclk_sel. RESET:0x6"
          
         hexmask.long 0x00 8.--15. 1. " EMMC_REG_VENDOR1_BLOCK_AT_STAT_R_R_EDGE_PH_CODE ,Right Edge Phase code. Reading this field returns the phase code value used by Auto-tuning engine to sample data on Right edge of sampling window. RESET:0x0"
          
         hexmask.long 0x00 16.--23. 1. " EMMC_REG_VENDOR1_BLOCK_AT_STAT_R_L_EDGE_PH_CODE ,Left Edge Phase code. Reading this field returns the phase code value used by Auto-tuning engine to sample data on Left edge of sampling window. RESET:0x0"
          
         hexmask.long 0x00 24.--30. 1. " EMMC_REG_VENDOR1_BLOCK_AT_STAT_R_RSDV1 ,These bits of the AT_STAT_R register are reserved. They always return 0. RESET:0x0"
          
         bitfld.long 0x00 31. " EMMC_REG_VENDOR1_BLOCK_AT_STAT_R_DL2_BUSY ,Delay Line 2 busy indication. If this bit is set then it indicates that the cclk_rx delay line is in the process of delay code updation. RESET:0x1"
          
tree.end
    

tree "EMMC_REG__EMBEDDED_CONTROL_BLOCK"
base e:0x40065f6c
width 80.
group.long  0x0++0x3
    line.long 0x00 "EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R, This register controls the embedded device. When the Host Controller is connected to a removable device, this register is not used. RESET:0x0"
         hexmask.long 0x00 0.--2. 1. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_NUM_CLK_PIN ,Number of Clock Pins (SD Mode)  This field indicates support of clock pins to select one of devices for shared bus system. Up to 7 clock pins can be supported.  - 0x0 : Shared bus is not supported  - 0x1 : 1 SDCLK is supported  - 0x2 - 2 SDCLK is supported  -  .    .  -  .    .  -  .    .  - 0x7 : 7 SDCLK is supported RESET:0x0"
          
         bitfld.long 0x00 3. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_RSVD_3 ,This bit (RSVD_3) of the EMBEDDED_CTRL_R register is reserved. It always returns 0. RESET:0x0"
          
         hexmask.long 0x00 4.--5. 1. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_NUM_INT_PIN ,Number of Interrupt Input Pins  This field indicates support of interrupt input pins for an embedded system. RESET:0x0"
          
         hexmask.long 0x00 6.--7. 1. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_RSVD_7_6 ,These bits (RSVD_7_6) of the EMBEDDED_CTRL_R register are reserved. They always return 0. RESET:0x0"
          
         hexmask.long 0x00 8.--14. 1. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_BUS_WIDTH_PRESET ,Bus Width Preset (SD Mode)  Each bit of this field specifies the bus width for each embedded device. The shared bus supports mixing of 4-bit and 8-bit bus width devices.  - D08 : Bus Width Preset for Device 1  - D09 : Bus Width Preset for Device 2  - D10 : Bus Width Preset for Device 3  - D11 : Bus Width Preset for Device 4  - D12 : Bus Width Preset for Device 5  - D13 : Bus Width Preset for Device 6  - D14 : Bus Width Preset for Device 7  Function of each bit is defined as follows:  - 0 : 4-bit bus width mode  - 1 : 8-bit bus width mode RESET:0x0"
          
         bitfld.long 0x00 15. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_RSVD_15 ,This bit (RSVD_15) of the EMBEDDED_CTRL_R register is reserved. It always returns 0. RESET:0x0"
          
         hexmask.long 0x00 16.--18. 1. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_CLK_PIN_SEL ,Clock Pin Select (SD Mode)  This bit is selected by one of clock pin outputs.  - 0x0 : Clock pins are disabled  - 0x1 : CLK[1] is selected  - 0x2 : CLK[2] is selected  -  .      .  -  .      .  -  .      .  - 0x7 : CLK[7] is selected RESET:0x0"
          
         bitfld.long 0x00 19. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_RSVD_19 ,This bit (RSVD_19) of the EMBEDDED_CTRL_R register is reserved. It always returns 0. RESET:0x0"
          
         hexmask.long 0x00 20.--22. 1. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_INT_PIN_SEL ,Interrupt Pin Select  These bits enable the interrupt pin inputs.  - 000 : Interrupts (INT_A,INT_B,INT_C) are disabled  - xx1 : INT_A is enabled  - x1x : INT_B is enabled  - 1xx : INT_C is enabled RESET:0x0"
          
         bitfld.long 0x00 23. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_RSVD_23 ,This bit (RSVD_23) of the EMBEDDED_CTRL_R register is reserved. It always returns 0. RESET:0x0"
          
         hexmask.long 0x00 24.--30. 1. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_BACK_END_PWR_CTRL ,Back-End Power Control (SD Mode)  Each bit of this field controls back-end power supply for an embedded device.  - 0 : Back-End Power is off  - 1 : Back-End Power is supplied  D24 : Back-End Power for Device 1  D25 : Back-End Power for Device 2  D26 : Back-End Power for Device 3  D27 : Back-End Power for Device 4  D28 : Back-End Power for Device 5  D29 : Back-End Power for Device 6  D30 : Back-End Power for Device 7 RESET:0x0"
          
         bitfld.long 0x00 31. " EMMC_REG_EMBEDDED_CONTROL_BLOCK_EMBEDDED_CTRL_R_RSVD_31 ,This bit (RSVD_31) of the EMBEDDED_CTRL_R register is reserved. It always returns 0. RESET:0x0"
          
tree.end

