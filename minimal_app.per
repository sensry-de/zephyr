group.long  0xc++0x3
    line.long 0x00 "ADPLL2G_ADPLL2G_STATUS_CAPTURE, None RESET:0x0"
         bitfld.long 0x00 0. " ADPLL2G_ADPLL2G_STATUS_CAPTURE_CAPTURE ,Triggers capture of status* registers; This bit is cleared by HW when status is ready RESET:0x0"
          
rgroup.long 0x10++0x3
    line.long 0x00 "ADPLL2G_ADPLL2G_STATUS, None RESET:0x0"
         bitfld.long 0x00 0. " ADPLL2G_ADPLL2G_STATUS_PLL_LOCKED ,locked bit RESET:0x0"
          
