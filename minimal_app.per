group.long  0x10++0x3
    line.long 0x00 "ABB_ABB_0_CONFIG_CTRL_1, ctrl_1 register. Note: mode field is set for open-loop mode, other reset values are for low-performance mode with ABB = 50 MHz (unsued in open-loop mode). RESET:0x80f002"
         bitfld.long 0x00 0.--1. " ABB_ABB_0_CONFIG_CTRL_1_MODE ,Operation mode of RI_ABB controller: 00 = auto (default) 01 = single PVT monitor readout (for test) 10 = open loop PWM charge pump drive (for test) 11 = zero bias charge pump mode, both VNW and VPW pins are actively tied to VSS RESET:0x2" "MODE_AUTO-0,MODE_SINGLE_PVT-1,MODE_OPENLOOP_PWN_CP-2,MODE_ZERO_BIAS_CP-3"
          
         bitfld.long 0x00 2.--3. " ABB_ABB_0_CONFIG_CTRL_1_TESTMODE ,Test mode of RI_ABB controller: 00 = normal operation (default) 01 = PVT monitor test, testclock switched to internal ripple counter (see TIMER_CONFIG_VAL) 10 = ripple counter bist mode 11 = reserved RESET:0x0" "TESTMODE_NORMAL-0,TESTMODE_PVT_MON_TEST-1,TESTMODE_RIPPLE_CNT-2"
          
         bitfld.long 0x00 4.--5. " ABB_ABB_0_CONFIG_CTRL_1_STATUS_OUTPUT_SELECT ,Define the status output which can capture at status registers: 00 = ringo count value and calibration done flag set at ri_abb_status_o 01 = locked status information, preliminary feature debugging only 10 = filter status information, preliminary feature debugging only 11 = ring oscillator information, preliminary feature debugging only RESET:0x0" "RINGO_CNT_CAL-0,LOCKED_STATUS-1,FILTER_STATUS-2,RING_OSC-3"
          
          
         bitfld.long 0x00 8.--9. " ABB_ABB_0_CONFIG_CTRL_1_CHARGE_PUMP_SELECT_EN ,Enable additional charge pump slices thereby defining the drive strength of the body bias charge pump. The available settings depend on the drive strength option: When DS_X010:   Field value is not applicable, because one slice is always active. When DS_X030:   00 : no additional slice enabled   01 : second slice enabled   10 : third slice enabled   11 : second and third slice enabled RESET:0x0" "NONE-0,SECOND-1,THIRD-2,SECOND_THIRD-3"
          
         bitfld.long 0x00 10.--11. " ABB_ABB_0_CONFIG_CTRL_1_CHARGE_PUMP_SELECT_EN_LOCK ,Defines charge pump stages enabled during lock-in (before lock is detected). The available settings depend on the drive strength option: When DS_X010: Field value is not applicable, because one slice is always active. When DS_X030: 00 : no additional slice enabled 01 : second slice enabled 10 : third slice enabled 11 : second and third slice enabledOverride the Enable signal from the PMU RESET:0x0" "NONE-0,SECOND-1,THIRD-2,SECOND_THIRD-3"
          
         hexmask.long 0x00 12.--15. 1. " ABB_ABB_0_CONFIG_CTRL_1_PVTMON_CYCLES ,Configures the internal monitor. Please refer to ri_abb_gf22fdx_ref_value_specification or contact Racyics. RESET:0xf"
          
         hexmask.long 0x00 16.--31. 1. " ABB_ABB_0_CONFIG_CTRL_1_TIMER_CONFIG_VAL ,Defines the length of a closed loop control cycle. Note: Value also used for testmode; please refer to ri_abb_gf22fdx_datasheet or contact Racyics. RESET:0x80"
          
