tree "DMA350__APB4SLVADDRESSBLOCK"
base e:0x40062000
width 80.
rgroup.long 0x200++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_NSEC_CHINTRSTATUS0, Non-Secure Channel Interrupt Status Register 0  This register shows the overall interrupt status of every Non-secure channel from Channel 0 to Channel 31. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CHINTRSTATUS0_CHINTRSTATUS0 ,Collated Non-Secure Channel Interrupt flags for channel 0 to channel 31. Limited by NUM_CHANNELS, all unimplemented bits are reserved. RESET:0x0"
          
group.long  0x208++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUS, Non-Secure Status Register  This register provides information about the overall status of the Non-secure channels. RESET:0x0"
         bitfld.long 0x00 0. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUS_INTR_ANYCHINTR ,Combined Non-Secure Channel Interrupt Flag. Set to '1' when any Non-secure channel has an interrupt request in CHINTRSTATUS0 and NSECCTRL.INTREN_ANYCHINTR = 1. Cleared automatically when the source of the channel interrupt is cleared. RESET:0x0"
          
         bitfld.long 0x00 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUS_INTR_ALLCHIDLE ,All Non-Secure Channel Idle Interrupt Status. Set to '1' when NSECCTRL.STAT_ALLCHIDLE is asserted and NSECCTRL.INTREN_ALLCHIDLE = 1. Cleared automatically when STAT_ALLCHIDLE is cleared. RESET:0x0"
          
         bitfld.long 0x00 2. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUS_INTR_ALLCHSTOPPED ,All Non-Secure Channel Stopped Interrupt Status. Set to '1' when NSECCTRL.STAT_ALLCHSTOPPED is asserted and NSECCTRL.INTREN_ALLCHSTOPPED = 1. Cleared automatically when STAT_ALLCHSTOPPED is cleared. RESET:0x0"
          
         bitfld.long 0x00 3. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUS_INTR_ALLCHPAUSED ,All Non-Secure Channel Paused Interrupt Status. Set to '1' when NSECCTRL.STAT_ALLCHPAUSED is asserted and NSECCTRL.INTREN_ALLCHPAUSED = 1. Cleared automatically when STAT_ALLCHPAUSED is cleared. RESET:0x0"
          
         hexmask.long 0x00 4.--16. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUS_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         bitfld.long 0x00 17. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUS_STAT_ALLCHIDLE ,All Non-Secure Channel Idle Status. Set to '1' whenever all Non-secure DMA channel is in idle state after at least one channel was running. Cleared by writing '1' to this bit. RESET:0x0"
          
         bitfld.long 0x00 18. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUS_STAT_ALLCHSTOPPED ,All Non-Secure Channel Stopped Status. Set to '1' whenever all Non-secure DMA channels are in stopped or inactive state and the ALLCHSTOP request is active. Not set when channels reach the stopped state for other reasons. All Non-secure channels are forced to an immediate stopped state until ALLCHSTOP request is asserted even if they were enabled after the request. Cleared by writing '1' to this bit. The ALLCHSTOP request is also cleared when this bit is cleared. RESET:0x0"
          
         bitfld.long 0x00 19. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUS_STAT_ALLCHPAUSED ,All Non-Secure Channel Paused Status. Set to '1' whenever all Non-secure DMA channel is in paused or inactive state and the ALLCHPAUSE request is active. Not set when channels reach the paused state for other reasons. All Non-secure channels are forced to an immediate pause until ALLCHPAUSE request is asserted even if they were enabled after the request. Cleared by writing '1' to this bit which results in all Non-secure channels to resume their operation. The ALLCHPAUSE request is also cleared when this bit is cleared. RESET:0x0"
          
         hexmask.long 0x00 20.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUS_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x20c++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL, Non-Secure Control Register  This registers can be used to adjust the interrupt generation and general behavior of the Non-secure channels. RESET:0x0"
         bitfld.long 0x00 0. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_INTREN_ANYCHINTR ,Combined Non-Secure Channel Interrupt Enable RESET:0x0"
          
         bitfld.long 0x00 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_INTREN_ALLCHIDLE ,All Non-Secure Channel Idle Interrupt Enable RESET:0x0"
          
         bitfld.long 0x00 2. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_INTREN_ALLCHSTOPPED ,All Non-Secure Channels Stopped Interrupt Enable RESET:0x0"
          
         bitfld.long 0x00 3. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_INTREN_ALLCHPAUSED ,All Non-Secure Channel Paused Interrupt Enable RESET:0x0"
          
         hexmask.long 0x00 4.--7. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         bitfld.long 0x00 8. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_ALLCHSTOP ,Non-Secure All Channel Stop Request. When set to '1', all Non-secure channels get a stop request. Stays asserted until the STAT_ALLCHSTOPPED status flag is set. Cleared automatically when the STAT_ALLCHSTOPPED status flag is cleared. RESET:0x0"
          
         bitfld.long 0x00 9. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_ALLCHPAUSE ,Non-Secure All Channel Pause Request. When set to '1', all Non-secure channels get a pause request. Stays asserted until the channels are paused and the STAT_ALLCHPAUSED status flag is set. Cleared automatically when the STAT_ALLCHPAUSED status flag is cleared. RESET:0x0"
          
         hexmask.long 0x00 10.--26. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         bitfld.long 0x00 27. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_DBGHALTNSRO ,Debug Halt Enable Non-Secure Read Only. When set to '1', the NSEC_CTRL.DBGHALTEN register becomes read-only. When set to '0', NSEC_CTRL.DBGHALTEN has read-write access. This register is read-only for the non-secure SW. RESET:0x0"
          
         bitfld.long 0x00 28. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_DBGHALTEN ,Debug Halt Enabled. When set to '0', the DMA ignores the halt request from an external debugger. Clearing this bit while halt is ongoing results in continuing the operation. When set to '1', the debugger request to halt the DMA is allowed. This field is common for non-secure and secure side of the DMA, but access to this register is limited by the DBGHALTNSRO register field. RESET:0x0"
          
         bitfld.long 0x00 29. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_IDLERETEN ,Idle Channel Retention Enable. Allows retention for non-secure channels that are enabled and waiting for an event in IDLE state. - 0: disabled - 1: enabled RESET:0x0"
          
         hexmask.long 0x00 30.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CTRL_DISMINPWR ,Minimum Power state of the DMAC when at least one non-secure channel is present. - 00: OFF - 01: Retention - 10: ON - Others: Reserved RESET:0x0"
          
group.long  0x214++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_NSEC_CHPTR, Non-Secure Channel Pointer  This register is used to select one channel that needs to be configured through the following registers that have NSEC_CH prefix. RESET:0x0"
         hexmask.long 0x00 0.--5. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CHPTR_CHPTR ,Non-Secure Channel Pointer. Selects which channel settings can be adjusted by the following registers. RESET:0x0"
          
         hexmask.long 0x00 6.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CHPTR_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x218++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_NSEC_CHCFG, Non-Secure Channel Configuration Register  This register provides configuration fields for channel attributes. RESET:0x0"
         hexmask.long 0x00 0.--16. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CHCFG_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         bitfld.long 0x00 17. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CHCFG_CHPRIV ,Non-Secure Channel Privilege Enable. NSECCHPTR selects the channel. When set to '1' it allows the channel to send transfers marked as Privileged only. The configuration registers of the selected channel are also given privileged only access rights. When set to '0' the channel is only allowed to send unprivileged transfers and the channel registers can be accessed by both privileged and unprivileged register accesses. RESET:0x0"
          
         hexmask.long 0x00 18.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_CHCFG_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x2f0++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUSPTR, Non-Secure Unit Status Pointer Register  This register can set a pointer to an internal status register that can show the global state of the Non-secure channels. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUSPTR_NSECSTATUSPTR ,Non-Secure DMA Unit status pointer used to select which status value to view using STATUSVALUE register. Pointer values are: - 0: Channel Enabled Status for channel numbers [31 : 0]. - 1: Reserved - 2: Channel Stopped Status for channel numbers [31 : 0]. - 3: Reserved - 4: Channel Paused Status for channel numbers [31 : 0]. - Others: Reserved. RESET:0x0"
          
         hexmask.long 0x00 4.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUSPTR_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
rgroup.long 0x2f4++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUSVAL, Non-Secure Unit Status Value Register  This register shows the current value of a status register on Non-secure channels selected by the pointer in NSEC_STATUSPTR. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_STATUSVAL_NSECSTATUSVAL ,Non-Secure DMA Unit status value. Can be used for reading internal status values of the DMA Unit for debug purposes. Values shown here are dependent on STATUSPTR. Note that inputs are masked by security mapping before being presented here. This means that only status values mapped to Non-secure world are visible as non-Zero values. All unimplemented bits are RAZWI. RESET:0x0"
          
group.long  0x2f8++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_NSEC_SIGNALPTR, Non-Secure Unit Signal Pointer  This register can set a pointer to an internal register that shows the state of the Non-secure interfaces attached to the DMAC. RESET:0x0"
         hexmask.long 0x00 0.--3. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_SIGNALPTR_NSECSIGNALPTR ,Non-Secure DMA Unit signal pointer used to select which inputs or outputs to view using SIGNALVAL register. Pointer values, x,  are: - 0 to 7: Trigger Input Requests [31+32*x : 32*x] - 8 to 9: Trigger output Acknowledges [31+32*(x-8) :  32*(x-8)] - 10 to 11: GPO output value [31+32*(x-10) : 32*(x-10)], only present when HAS_GPOSEL is set - Others: Reserved RESET:0x0"
          
         hexmask.long 0x00 4.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_SIGNALPTR_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
group.long  0x2fc++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_NSEC_SIGNALVAL, Non-Secure Unit Signal Value Register  This register shows the current value of the Non-secure interfaces selected by the pointer in NSEC_SIGNALPTR. RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_NSEC_SIGNALVAL_NSECSIGNALVAL ,Non-Secure DMA Unit signal status. Can be used for reading signal values of triggers and GPOs for debug. Values shown here are dependent on SIGNALPTR. Note that inputs are masked by security mapping before being presented here. This means that only signals mapped to Non-secure world are visible as non-zero values. Writing to this register has the following effect:  - Writing '1' to a Non-secure Trigger Input Request that are not selected by any DMA channel will cause a deny response for it. This can attempt to clear an unwanted trigger input.  - Writing '1' to any Trigger Output Acknowledges status, GPO status and all Trigger Input Request already selected by any DMA channel is ignored. All unimplemented bits are RAZWI. RESET:0x0"
          
rgroup.long 0xfb0++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMA_BUILDCFG0, DMA Build Configuration Register 0  This register is used to provide information about the configuration parameters of the DMAC. RESET:0x49c10"
         hexmask.long 0x00 0.--2. 1. " DMA350_APB4SLVADDRESSBLOCK_DMA_BUILDCFG0_FRAMETYPE ,Register Frame Type.  - 000: Combined Frame,  - 001: Security Configuration Frame,  - 010: Secure Control Frame, or if TrustZone not implemented, Control Frame.  - 011: Non-Secure Control Frame,  - 100: DMA Channel Frame. Note that each frame replicates the Information fields. RESET:0x0"
          
         bitfld.long 0x00 3. " DMA350_APB4SLVADDRESSBLOCK_DMA_BUILDCFG0_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         hexmask.long 0x00 4.--9. 1. " DMA350_APB4SLVADDRESSBLOCK_DMA_BUILDCFG0_NUM_CHANNELS ,Number of Channels + 1 supported by the DMAC RESET:0x1"
          
         hexmask.long 0x00 10.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMA_BUILDCFG0_ADDR_WIDTH ,Address Width in bits = ADDR_WIDTH + 1 RESET:0x27"
          
         hexmask.long 0x00 16.--18. 1. " DMA350_APB4SLVADDRESSBLOCK_DMA_BUILDCFG0_DATA_WIDTH ,Data Width. - 000: 8-bit - 001: 16-bit - 010: 32-bit - 011: 64-bit - 100: 128-bit - 101: 256-bit - 110: 512-bit - 111: 1024-bit RESET:0x4"
          
         bitfld.long 0x00 19. " DMA350_APB4SLVADDRESSBLOCK_DMA_BUILDCFG0_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         hexmask.long 0x00 20.--24. 1. " DMA350_APB4SLVADDRESSBLOCK_DMA_BUILDCFG0_CHID_WIDTH ,Channel ID Width. '0' means CHID is not present. RESET:0x0"
          
         hexmask.long 0x00 25.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMA_BUILDCFG0_RAZWI_2 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
