    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG0, Channel Build Configuration and Capability Register 0  This register contains the configuration parameters can capabilities of the DMA channel. RESET:0x3d27000f"
         hexmask.long 0x00 0.--7. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG0_DATA_BUFF_SIZE ,Data Buffer Size in entries - 1. Total Size = ((DATA_BUFF_SIZE + 1) * DATA_WIDTH /8) bytes. RESET:0xf"
          
         hexmask.long 0x00 8.--15. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG0_CMD_BUFF_SIZE ,Command Buffer Size in command words - 1. Total Size = (CMD_BUFF_SIZE + 1) * 4 bytes. RESET:0x0"
          
         hexmask.long 0x00 16.--21. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG0_ADDR_WIDTH ,Address Width in bits = ADDR_WIDTH + 1 RESET:0x27"
          
         hexmask.long 0x00 22.--24. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG0_DATA_WIDTH ,Data Width. - 000: 8-bit - 001: 16-bit - 010: 32-bit - 011: 64-bit - 100: 128-bit - 101: 256-bit - 110: 512-bit - 111: 1024-bit RESET:0x4"
          
         bitfld.long 0x00 25. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG0_RAZWI_0 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
         hexmask.long 0x00 26.--29. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG0_INC_WIDTH ,Width of the increment register = INC_WIDTH + 1. When set to 0, then only 0 and 1 can be set as an increment. When larger values are used, then negative increments can be set using 2's complement: INC_WIDTH = 0: 0..1 INC_WIDTH = 1: -2..1 INC_WIDTH = 2: -4..3 INC_WIDTH = 3: -8..7 … INC_WIDTH = 15: -32768..32767 RESET:0xf"
          
         hexmask.long 0x00 30.--31. 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG0_RAZWI_1 ,Read-As-Zero, Writes Ignored. RESET:0x0"
          
rgroup.long 0x10fc++0x3
    line.long 0x00 "DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG1, Channel Build Configuration and Capability Register 1  This register contains the configuration parameters can capabilities of the DMA channel. RESET:0x79f"
         bitfld.long 0x00 0. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG1_HAS_XSIZEHI ,Has 32-bit XSIZE counters. RESET:0x1"
          
         bitfld.long 0x00 1. " DMA350_APB4SLVADDRESSBLOCK_DMACH0_CH_BUILDCFG1_HAS_WRAP ,Has wrap capability. RESET:0x1"
          
