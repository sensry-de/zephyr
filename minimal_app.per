    line.long 0x00 "GPIO_INTTYPE, Interrupt type status RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTTYPE_INTTYPE ,0 : Level detection 1: Edge detection RESET:0x0"
          
group.long  0x2c++0x3
    line.long 0x00 "GPIO_INTTYPESET, Interrupt type set RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTTYPESET_INTTYPESET ,0 : No Effect 1: Set interrupt type bit for edge detection RESET:0x0"
          
group.long  0x30++0x3
    line.long 0x00 "GPIO_INTTYPECLR, Interrupt type clear RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTTYPECLR_INTTYPECLR ,0 : No Effect 1: Clear interrupt type bit for edge detection RESET:0x0"
          
rgroup.long 0x34++0x3
    line.long 0x00 "GPIO_INTPOLHIGH, Interrupt polarity high status RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTPOLHIGH_INTPOLHIGH ,0 : Triggering on HIGH level or rising edge disabled. If corresponding intpollow bit is also set to 0, the IRQ logic will not trigger on any level or edges. This case corresponds a masking of the intstatus register. 1 : Triggering on HIGH level or rising edge enabled. If corresponding intpollow bit is also set to 1,    the IRQ logic will trigger on both edges (rising, falling),    if edge triggering is selected in inttype register.         Note that setting both intpolhigh and intpollow bit to 1 is not sensible            in case that level triggering is selected in inttype register.            Triggering on both levels (LOW, HIGH) would cause a permanent met interrupt condition. RESET:0x0"
          
group.long  0x38++0x3
    line.long 0x00 "GPIO_INTPOLHIGHSET, Interrupt polarity high set RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTPOLHIGHSET_INTPOLHIGHSET ,0 : No Effect 1: Set interrupt polarity high bit to enable triggering on HIGH level or rising edge RESET:0x0"
          
group.long  0x3c++0x3
    line.long 0x00 "GPIO_INTPOLHIGHCLR, Interrupt polarity high clear RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTPOLHIGHCLR_INTPOLHIGHCLR ,0 : No Effect 1: Clear interrupt polarity high bit to enable triggering on HIGH level or rising edge RESET:0x0"
          
rgroup.long 0x40++0x3
    line.long 0x00 "GPIO_INTPOLLOW, Interrupt polarity low status RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTPOLLOW_INTPOLLOW ,0 : Triggering on LOW level or falling edge disabled. If corresponding intpollow bit is also set to 0, the IRQ logic will not trigger on any level or edges. This case corresponds a masking of the intstatus register. 1 : Triggering on LOW level or falling edge enabled. If corresponding intpollow bit is also set to 1,    the IRQ logic will trigger on both edges (rising, falling),    if edge triggering is selected in inttype register.         Note that setting both intpolhigh and intpollow bit to 1 is not sensible            in case that level triggering is selected in inttype register.            Triggering on both levels (LOW, HIGH) would cause a permanent met interrupt condition. RESET:0x0"
          
group.long  0x44++0x3
    line.long 0x00 "GPIO_INTPOLLOWSET, Interrupt polarity low set RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTPOLLOWSET_INTPOLLOWSET ,0 : No Effect 1: Set interrupt polarity high bit to enable triggering on LOW level or falling edge RESET:0x0"
          
group.long  0x48++0x3
    line.long 0x00 "GPIO_INTPOLLOWCLR, Interrupt polarity low clear RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTPOLLOWCLR_INTPOLLOWCLR ,0 : No Effect 1: Clear interrupt polarity high bit to enable triggering on LOW level or falling edge RESET:0x0"
          
rgroup.long 0x4c++0x3
    line.long 0x00 "GPIO_INTSTATUS, Interrupt status RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTSTATUS_INTSTATUS ,0 : No Interrupt request 1: An interrupt condition was met according to config in inttype, intpolhigh and intpollow RESET:0x0"
          
group.long  0x50++0x3
    line.long 0x00 "GPIO_INTCLEAR, Interrupt status clear RESET:0x0"
         hexmask.long 0x00 0.--31. 1. " GPIO_INTCLEAR_INTCLEAR ,0 : No Effect 1: Clear interrupt request in intstatus RESET:0x0"
          
tree.end

