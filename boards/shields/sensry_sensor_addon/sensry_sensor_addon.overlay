/ {
	sensry-leds {
		compatible = "gpio-leds";

		shield_led: shield-led {
			gpios = <&i2s_gpio_controller 0 GPIO_ACTIVE_HIGH>;
			label = "Shield LED";
		};
	};
};

&nordic_expansion_i2c {
	i2s_gpio_controller: gpio@21 {
		compatible = "nxp,pca9554";
		reg = <0x21>;
		no-auto-reset;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
	};

	light_sensor: opt3002@44 {
		compatible = "ti,opt3001";
		reg = <0x44>;
		label = "light_sensor";
	};

	external_rtc: rtc@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
	};

	environmental_sensor: bme680@76 {
		compatible = "bosch,bme680";
		reg = <0x76>;
		label = "environmental_sensor";
	};
};

sensry_spi: &nordic_expansion_spi_p2 {
	cs-gpios = <&nordic_expansion_header 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
		   <&nordic_expansion_header 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

	imu: imu@0 {
		compatible = "bosch,bmi270";
		reg = <0>;
		spi-max-frequency = <8000000>;
		label = "imu";
		spi-cpol;
		spi-cpha;
	};

	magnetometer: lis2mdl@1 {
		compatible = "st,lis2mdl";
		reg = <1>;
		spi-max-frequency = <8000000>;
		label = "magnetometer";
	};
};

microphone: &nordic_expansion_pdm {
	status = "okay";
};
