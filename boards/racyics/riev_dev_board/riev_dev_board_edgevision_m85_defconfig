CONFIG_XIP=n

# Enable console
CONFIG_CONSOLE=y
CONFIG_SERIAL=y

# Set UART as device used for both printf & printk 
CONFIG_STDOUT_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_UART_CONSOLE=y

#Enable Power Domain & Runtime Management
CONFIG_POWER_DOMAIN=y
CONFIG_PM_DEVICE=y
CONFIG_PM_DEVICE_RUNTIME=y
CONFIG_PM_DEVICE_POWER_DOMAIN=y

