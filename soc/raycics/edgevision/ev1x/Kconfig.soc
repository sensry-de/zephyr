config SOC_SERIES_EV1X
	bool
	select SOC_FAMILY_EDGEVISION

config SOC_SERIES
	default "ev1x" if SOC_SERIES_EV1X

config SOC_EV10
	bool
	select SOC_SERIES_EV1X

config SOC_EV10_M4
	bool
	select SOC_EV10
	help
	 Enable the Cortex-M4 core.

config SOC_EV10_M85
	bool
	select SOC_EV10
	help
	 Enable the Cortex-M85 core.

config SOC
	default "ev10" if SOC_EV10
