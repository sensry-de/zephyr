#include <mem.h>
#include <arm/armv8.1-m.dtsi>
#include <freq.h>

/ {
	sysclk: system-clock {
		compatible = "fixed-clock";
		clock-frequency = <DT_FREQ_M(40)>;
		#clock-cells = <0>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m85";
			reg = <0>;
			clock-frequency = <DT_FREQ_M(25)>;
			#address-cells = <1>;
			#size-cells = <1>;
		};

	};

	soc {
		uart0: uart@40048000 {
			compatible = "arm,cmsdk-uart";
			reg = <0x40048000 0x1000>;
			interrupts = <1 3>;
			clocks = <&sysclk &sysclk>;
			current-speed = <921600>;
			status = "okay";
		};

		dtimer1: dtimer@40050000 {
			compatible = "arm,cmsdk-dtimer";
			reg = <0x40050000 0x1000>;
			interrupts = <4 3>;
			status = "okay";
		};

		sram0: memory@1000000 {
			compatible = "mmio-sram";
			reg = <0x01000000 DT_SIZE_K(1024)>;
		};

	};
};

&nvic {
	arm,num-irq-priority-bits = <3>;
};
